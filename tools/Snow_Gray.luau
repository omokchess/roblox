local n = 0
for kind, d in pairs(DATA) do
	local old = kit:FindFirstChild(kind)
	if old then
		old:Destroy()
	end
	local m = Instance.new("Model")
	m.Name = kind
	for _, b in ipairs(d.boxes) do
		local mt = MATS[b[1]]
		local p = Instance.new("Part")
		p.Name = b[1]
		p.Anchored = true
		p.Size = Vector3.new(b[5], b[6], b[7])
		p.CFrame = CFrame.new(b[2], b[3], b[4])
		p.Color = mt[1]
		p.Material = mt[2]
		p.CanCollide = mt[3]
		p.CanQuery = mt[3]
		p.CanTouch = false
		p.Transparency = mt[4]
		p.CastShadow = mt[4] == 0
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = m
		n += 1
	end
	local s = d.sign
	local p = Instance.new("Part")
	p.Name = "Sign"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Size = Vector3.new(s[5], s[6], 0.5)
	p.CFrame = CFrame.new(s[2], s[3], s[4])
	p.Color = MATS.Sign[1]
	p.Material = MATS.Sign[2]
	p.Parent = m
	local g = Instance.new("SurfaceGui")
	g.Face = Enum.NormalId.Front
	g.CanvasSize = Vector2.new(s[5] * 40, s[6] * 40)
	g.LightInfluence = 0
	g.Parent = p
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Text = s[1]
	l.TextScaled = true
	l.Font = Enum.Font.GothamBold
	l.TextColor3 = Color3.fromRGB(255, 226, 150)
	l.Parent = g
	m.WorldPivot = CFrame.new()
	m.Parent = kit
end
