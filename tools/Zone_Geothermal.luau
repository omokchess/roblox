--=== 밑판 ===--
local S = workspace.Surface
local G = S.World["G_화산"]

local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Include
rp.FilterDescendantsInstances = { G }

local old = S:FindFirstChild("Zone_화산")
if old then
	old:Destroy()
end
local ROOT = Instance.new("Folder")
ROOT.Name = "Zone_화산"
ROOT.Parent = S

local function folder(name, parent)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent or ROOT
	return f
end

local n = 0
local miss = {}

-- 발밑 땅 높이. 바다면 적어 두었다가 끝에서 한꺼번에 알린다
local function ground(x, z, tag)
	local h = workspace:Raycast(Vector3.new(x, 1400, z), Vector3.new(0, -2400, 0), rp)
	if not h then
		miss[#miss + 1] = string.format("%s (%d, %d)", tag, x, z)
		return nil
	end
	return h.Position.Y
end

-- 파트 하나. 표의 한 줄이 이걸 한 번 부른다
local function make(parent, name, x, y, z, sx, sy, sz, yaw, color, mat, tr)
	assert(sx <= 400 and sy <= 400 and sz <= 400, name .. " 가 400 을 넘는다")
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = Vector3.new(sx, sy, sz)
	p.CFrame = CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(yaw), 0)
	p.Color = color
	p.Material = mat
	p.Transparency = tr or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	n = n + 1
	return p
end

-- 땅에 앉힌다. base 는 땅에서 잰 밑면 높이 (음수면 박힌다)
local function put(parent, name, x, z, base, sx, sy, sz, yaw, color, mat, tr)
	local g = ground(x, z, name)
	if not g then
		return nil
	end
	return make(parent, name, x, g + base + sy / 2, z, sx, sy, sz, yaw, color, mat, tr)
end

-- 윗면 높이를 맞춘다. 주상절리처럼 꼭대기를 나란히 깎을 때 쓴다
local function putTop(parent, name, x, z, top, sx, sy, sz, yaw, color, mat, tr)
	return make(parent, name, x, top - sy / 2, z, sx, sy, sz, yaw, color, mat, tr)
end

local function glow(part, col, range, bright)
	local l = Instance.new("PointLight")
	l.Color = col
	l.Range = range
	l.Brightness = bright
	l.Parent = part
end

local function steam(part, rate, size, speed, life, col, tr0)
	local e = Instance.new("ParticleEmitter")
	e.Name = "Steam"
	e.Rate = rate
	e.Lifetime = NumberRange.new(life * 0.6, life)
	e.Speed = NumberRange.new(speed * 0.6, speed)
	e.Size = NumberSequence.new(size)
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, tr0),
		NumberSequenceKeypoint.new(0.35, tr0 * 0.75 + 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Color = ColorSequence.new(col)
	e.LightEmission = 0.2
	e.Parent = part
	return e
end

