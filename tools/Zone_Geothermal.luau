assert(#miss == 0, "바다 위에 적은 자리가 " .. #miss .. "곳:\n  " .. table.concat(miss, "\n  "))

local function cnt(f)
	return #f:GetChildren()
end
assert(cnt(F_lake) == #LAKE, "용암호 판이 " .. cnt(F_lake) .. "장")
assert(cnt(F_rim) == #RIM, "화구턱이 " .. cnt(F_rim) .. "개")
assert(cnt(F_wall) == #WALL, "화구안벽이 " .. cnt(F_wall) .. "개")
assert(cnt(F_curt) == #CURTAIN + #FLANK, "폭포가 " .. cnt(F_curt) .. "개")
assert(cnt(F_lip) == #LIP, "단턱이 " .. cnt(F_lip) .. "개")
assert(cnt(F_water) == #WATER + 1, "더운물이 " .. cnt(F_water) .. "장")
assert(cnt(F_vent) == #STACK + #MOUTH, "굴뚝이 " .. cnt(F_vent) .. "개")
assert(cnt(F_crust) == #CRUSTS, "유황껍질이 " .. cnt(F_crust) .. "장")
assert(cnt(F_ca) + cnt(F_cb) + cnt(F_cc) == 42, "주상절리가 " .. (cnt(F_ca) + cnt(F_cb) + cnt(F_cc)) .. "개")

local line = {}
for _, f in ipairs(ROOT:GetChildren()) do
	local sub = 0
	for _, g in ipairs(f:GetChildren()) do
		if g:IsA("Folder") then
			sub = sub + #g:GetChildren()
		else
			sub = sub + 1
		end
	end
	line[#line + 1] = f.Name .. " " .. sub
end
table.sort(line)
print(string.format("[지열지대] 파트 %d개 / %s", n, table.concat(line, " · ")))
print("[지열지대] 손으로 적은 배치표대로 다 섰다")
