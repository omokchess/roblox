	},
	{
		Id = "Duelist_C_Sentry",
		Name = "파수",
		Description = "아군이 인접해 있을 때, 패링 범위가 {8}% 증가한다.",
		Grade = "Common",
		ClassId = CLASS_ID,
		Tags = { "Riposte", "Guard" },
	},
	{
		Id = "Duelist_C_LowStance",
		Name = "자세 낮추기",
		Description = "같은 태세를 두 턴 이상 유지하면 그 태세 효과가 턴당 {10}%씩, 최대 {30}%까지 증가한다.",
		Grade = "Common",
		ClassId = CLASS_ID,
		Tags = { "Guard" },
	},
	{
		Id = "Duelist_C_Restraint",
		Name = "절제",
