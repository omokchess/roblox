	건지도 헷갈렸다.
]]
local upgradeSkills: { Skill } = {
	-- 결투사. 준비 자세를 잡은 다음 턴에 열린다.
	{
		Id = "PointBlank",
		Name = "검 끝을 쏘아라",
		Description = "혼신을 다해 찌르고 피가 터지는 선을 남긴다. 사용 후 태세가 바뀐다.",
		Damage = 32,
		Range = "Melee",
		Shape = { Kind = "Row" },
		ClassId = "Duelist",
