		Name = "고중량 고반복",
		Description = "`벌크업` 패시브의 [가하는 피해량] 증가와 [받는 피해량] 증가가 각각 {2}% 상승한다.",
		Levels = { { 2, 2.5, 3, 3.5, 4, 4.5 } },
		Grade = "Common",
