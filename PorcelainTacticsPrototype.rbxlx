        <Properties>
          <string name="Name">MotionPlayer</string>
          <string name="Source"><![CDATA[--!strict

local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RotationUtil = require(ReplicatedStorage.Shared.RotationUtil)

local MotionPlayer = {}

local JOINT_ALIASES = {
	["Right Shoulder"] = true,
	["Left Shoulder"] = true,
	["Right Hip"] = true,
	["Left Hip"] = true,
	Neck = true,
	RootJoint = true,
}

local function findMotor(rig: Model, name: string): Motor6D?
	for _, descendant in rig:GetDescendants() do
		if descendant:IsA("Motor6D") and descendant.Name == name then
			return descendant
		end
	end
	return nil
end

local function poseAt(frames: { any }, time: number, jointName: string, motor: Motor6D): CFrame
	local before = frames[1]
	local after = frames[#frames]
	for index = 1, #frames - 1 do
		if time >= frames[index].Time and time <= frames[index + 1].Time then
			before = frames[index]
			after = frames[index + 1]
			break
		end
	end
	local duration = math.max(0.001, after.Time - before.Time)
	local alpha = math.clamp((time - before.Time) / duration, 0, 1)
	local beforePose = (before.Joints and before.Joints[jointName]) or { X = 0, Y = 0, Z = 0 }
	local afterPose = (after.Joints and after.Joints[jointName]) or beforePose
	local beforeOffset = (before.JointOffsets and before.JointOffsets[jointName]) or { X = 0, Y = 0, Z = 0 }
	local afterOffset = (after.JointOffsets and after.JointOffsets[jointName]) or beforeOffset
	local offset = Vector3.new(beforeOffset.X or 0, beforeOffset.Y or 0, beforeOffset.Z or 0)
		:Lerp(Vector3.new(afterOffset.X or 0, afterOffset.Y or 0, afterOffset.Z or 0), alpha)
	local beforeRotation = before.JointRotations and before.JointRotations[jointName]
	local afterRotation = after.JointRotations and after.JointRotations[jointName]
	local rotation
	if beforeRotation or afterRotation then
		rotation = RotationUtil.ToCFrame(beforeRotation, beforePose)
			:Lerp(RotationUtil.ToCFrame(afterRotation, afterPose), alpha)
	else
		-- Legacy motions keep numeric Euler interpolation so authored spins over
		-- 180 degrees retain their original playback path.
		rotation = CFrame.Angles(
			math.rad((beforePose.X or 0) + ((afterPose.X or 0) - (beforePose.X or 0)) * alpha),
			math.rad((beforePose.Y or 0) + ((afterPose.Y or 0) - (beforePose.Y or 0)) * alpha),
			math.rad((beforePose.Z or 0) + ((afterPose.Z or 0) - (beforePose.Z or 0)) * alpha)
		)
	end
	local pivot = motor.C1:Inverse().Position
	return CFrame.new(offset) * CFrame.new(pivot) * rotation * CFrame.new(-pivot)
end

local function vector(value: any): Vector3
	return Vector3.new(value and value.X or 0, value and value.Y or 0, value and value.Z or 0)
end

local function layerDepth(frame: any, key: string): number
	local order = frame.LayerOrder or {}
	local playerIndex = table.find(order, "Player") or 1
	local itemIndex = table.find(order, key) or playerIndex
	return (itemIndex - playerIndex) * 0.08
end

local function weaponCFrame(frame: any, key: string?): CFrame
	local weaponKey = key or "Weapon"
	local weapon = frame[weaponKey] or {}
	local position = vector(weapon.Position)
	local rotation = vector(weapon.Rotation)
	return CFrame.new(position + Vector3.new(0, 0, layerDepth(frame, weaponKey)))
		* CFrame.Angles(math.rad(rotation.X), math.rad(rotation.Y), math.rad(rotation.Z))
		* CFrame.Angles(weapon.FlipY and math.pi or 0, weapon.FlipX and math.pi or 0, 0)
end

local function weaponAt(frames: { any }, time: number, key: string?): CFrame
	local before = frames[1]
	local after = frames[#frames]
	for index = 1, #frames - 1 do
		if time >= frames[index].Time and time <= frames[index + 1].Time then
			before = frames[index]
			after = frames[index + 1]
			break
		end
	end
	local duration = math.max(0.001, after.Time - before.Time)
	local alpha = math.clamp((time - before.Time) / duration, 0, 1)
	return weaponCFrame(before, key):Lerp(weaponCFrame(after, key), alpha)
end

local function frameAt(frames: { any }, time: number): any
	local selected = frames[1]
	for _, frame in frames do
		if frame.Time <= time then
			selected = frame
		else
			break
		end
	end
	return selected
end

local function rootOffsetAt(frames: { any }, time: number): Vector3
	local before = frames[1]
	local after = frames[#frames]
	for index = 1, #frames - 1 do
		if time >= frames[index].Time and time <= frames[index + 1].Time then
			before = frames[index]
			after = frames[index + 1]
			break
		end
	end
	local duration = math.max(0.001, after.Time - before.Time)
	local alpha = math.clamp((time - before.Time) / duration, 0, 1)
	return vector(before.RootOffset):Lerp(vector(after.RootOffset or before.RootOffset), alpha)
end

local function syncWeaponVisual(weapon: BasePart, frame: any, key: string?, enabled: boolean?)
	local definition = frame[key or "Weapon"] or {}
	local size = definition.Size or {}
	weapon.Size = Vector3.new(
		math.clamp(tonumber(size.X) or 0.35, 0.1, 12),
		math.clamp(tonumber(size.Y) or 3, 0.1, 12),
		math.clamp(tonumber(size.Z) or 0.12, 0.05, 4)
	)
	local assetId = tostring(definition.AssetId or "")
	local digits = string.match(assetId, "%d+")
	assetId = digits and ("rbxassetid://" .. digits) or ""
	weapon.Transparency = enabled == false and 1 or (assetId == "" and 0 or 0.88)
	for _, data in
		{
			{ Name = "WeaponImageFront", Face = Enum.NormalId.Front },
			{ Name = "WeaponImageBack", Face = Enum.NormalId.Back },
		}
	do
		local decal = weapon:FindFirstChild(data.Name)
		if not decal then
			decal = Instance.new("Decal")
			decal.Name = data.Name
			decal.Parent = weapon
		end
		if decal:IsA("Decal") then
			decal.Face = data.Face
			decal.Texture = assetId
			decal.Transparency = (enabled == false or assetId == "") and 1 or 0
		end
	end
end

local function syncWeaponHands(rig: Model, mainMotor: Motor6D?, dualMotor: Motor6D?, swapped: boolean)
	local rightArm = rig:FindFirstChild("Right Arm")
	local leftArm = rig:FindFirstChild("Left Arm")
	if not rightArm or not leftArm or not rightArm:IsA("BasePart") or not leftArm:IsA("BasePart") then
		return
	end
	if mainMotor then
		mainMotor.Part0 = swapped and leftArm or rightArm
		mainMotor.C0 = CFrame.new(0, -1.25, 0) * CFrame.Angles(0, 0, math.rad(swapped and 10 or -10))
	end
	if dualMotor then
		dualMotor.Part0 = swapped and rightArm or leftArm
		dualMotor.C0 = CFrame.new(0, -1.25, 0) * CFrame.Angles(0, 0, math.rad(swapped and -10 or 10))
	end
end

local function showHitbox(rig: Model, hit: any)
	local root = rig:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local definition = hit.Hitbox or {}
	local size = vector(definition.Size)
	if size.Magnitude < 0.1 then
		size = Vector3.new(3, 3, 3)
	end
	local part = Instance.new("Part")
	part.Name = "MotionHitboxPreview"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Material = Enum.Material.ForceField
	part.Color = Color3.fromRGB(255, 75, 75)
	part.Transparency = 0.48
	part.Size = size
	local rotation = vector(definition.Rotation)
	part.CFrame = root.CFrame
		* CFrame.new(vector(definition.Offset))
		* CFrame.Angles(math.rad(rotation.X), math.rad(rotation.Y), math.rad(rotation.Z))
	part.Parent = rig.Parent
	Debris:AddItem(part, 0.16)
end

local function showFrameEvent(rig: Model, event: any, kind: string, target: Model?)
	local root = rig:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") or kind == "Teleports" then
		return
	end
	local size = vector(event.Size)
	local visual = Instance.new("Part")
	visual.Name = "Motion" .. kind .. "Preview"
	visual.Anchored = true
	visual.CanCollide = false
	visual.CanQuery = false
	visual.CanTouch = false
	visual.Material = Enum.Material.Neon
	local effectPreset = tostring(event.EffectPreset or "slash")
	if kind == "Effects" and (effectPreset == "spark" or effectPreset == "burst" or effectPreset == "smoke") then
		visual.Shape = Enum.PartType.Ball
	elseif kind == "Effects" and effectPreset == "ring" then
		visual.Shape = Enum.PartType.Cylinder
	else
		visual.Shape = Enum.PartType.Block
	end
	local colorValue = tostring(event.ColorHex or (kind == "Projectiles" and "#FFA050" or "#45F3FF"))
	local ok, color = pcall(Color3.fromHex, colorValue)
	visual.Color = ok and color
		or (kind == "Projectiles" and Color3.fromRGB(255, 160, 80) or Color3.fromRGB(69, 243, 255))
	local opacity = math.clamp(tonumber(event.Opacity) or 1, 0, 1)
	visual.Transparency = 1 - opacity * 0.65
	visual.Size = Vector3.new(math.max(0.1, math.abs(size.X)), math.max(0.1, math.abs(size.Y)), 0.12)
	local rotation = vector(event.Rotation)
	local startCFrame = root.CFrame
		* CFrame.new(vector(event.Offset))
		* CFrame.Angles(math.rad(rotation.X), math.rad(rotation.Y), math.rad(rotation.Z))
		* CFrame.Angles(event.FlipY and math.pi or 0, event.FlipX and math.pi or 0, 0)
	if kind == "Effects" and effectPreset == "ring" then
		startCFrame *= CFrame.Angles(0, math.pi * 0.5, 0)
	elseif kind == "Effects" and effectPreset == "spark" then
		visual.Size *= 0.45
	elseif kind == "Effects" and effectPreset == "burst" then
		visual.Size *= 0.8
	elseif kind == "Effects" and effectPreset == "smoke" then
		visual.Material = Enum.Material.SmoothPlastic
		visual.Transparency = math.max(visual.Transparency, 0.45)
	end
	visual.CFrame = startCFrame
	visual.Parent = rig.Parent
	local digits = string.match(tostring(event.AssetId or ""), "%d+")
	if digits then
		visual.Transparency = 1
		for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
			local decal = Instance.new("Decal")
			decal.Face = face
			decal.Texture = "rbxassetid://" .. digits
			decal.Color3 = visual.Color
			decal.Transparency = 1 - opacity
			decal.Parent = visual
		end
	end
	local duration = math.clamp(tonumber(event.Duration) or 0.35, 0.05, 10)
	if kind == "Projectiles" then
		local direction = root.CFrame.LookVector
		local targetRoot = target and target:FindFirstChild("HumanoidRootPart")
		if event.DirectionMode == "target" and targetRoot and targetRoot:IsA("BasePart") then
			direction = (targetRoot.Position - startCFrame.Position).Unit
		elseif event.DirectionMode == "fixed" then
			direction = CFrame.Angles(0, math.rad(tonumber(event.FixedAngle) or 0), 0):VectorToWorldSpace(direction)
		end
		local speed = math.clamp(tonumber(event.Speed) or 12, 1, 100)
		task.spawn(function()
			local started = os.clock()
			while visual.Parent and os.clock() - started < duration do
				local alpha = math.clamp((os.clock() - started) / duration, 0, 1)
				visual.CFrame = startCFrame + direction * (speed * duration * alpha)
				RunService.RenderStepped:Wait()
			end
		end)
	elseif kind == "Effects" then
		local initialSize = visual.Size
		local initialCFrame = visual.CFrame
		task.spawn(function()
			local started = os.clock()
			while visual.Parent and os.clock() - started < duration do
				local alpha = math.clamp((os.clock() - started) / duration, 0, 1)
				if effectPreset == "slash" then
					visual.Size =
						Vector3.new(math.max(0.1, initialSize.X * (0.35 + alpha * 0.65)), initialSize.Y, initialSize.Z)
				elseif effectPreset == "spark" then
					local pulse = 0.55 + math.sin(alpha * math.pi) * 0.85
					visual.Size = initialSize * pulse
				elseif effectPreset == "burst" or effectPreset == "ring" then
					visual.Size = initialSize * (0.25 + alpha * 1.25)
				elseif effectPreset == "smoke" then
					visual.Size = initialSize * (0.7 + alpha * 0.65)
					visual.CFrame = initialCFrame + Vector3.new(0, alpha * 1.4, 0)
				end
				local fade = math.clamp((alpha - 0.58) / 0.42, 0, 1)
				visual.Transparency = math.max(visual.Transparency, fade)
				for _, decal in visual:GetChildren() do
					if decal:IsA("Decal") then
						decal.Transparency = math.max(1 - opacity, fade)
					end
				end
				RunService.RenderStepped:Wait()
			end
		end)
	end
	Debris:AddItem(visual, duration)
end

local function createDecorationVisuals(rig: Model): { Part }
	local visuals = {}
	for index = 1, 5 do
		local visual = Instance.new("Part")
		visual.Name = "MotionDecorationPreview" .. index
		visual.Anchored = true
		visual.CanCollide = false
		visual.CanQuery = false
		visual.CanTouch = false
		visual.Size = Vector3.new(2, 2, 0.12)
		visual.Transparency = 1
		visual.Parent = rig.Parent
		for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
			local decal = Instance.new("Decal")
			decal.Face = face
			decal.Transparency = 1
			decal.Parent = visual
		end
		table.insert(visuals, visual)
	end
	return visuals
end

local function syncDecorations(rig: Model, visuals: { Part }, frame: any)
	for index, visual in visuals do
		local decoration = frame.Decorations and frame.Decorations[index]
		if not decoration then
			visual.Transparency = 1
			for _, decal in visual:GetChildren() do
				if decal:IsA("Decal") then
					decal.Transparency = 1
				end
			end
			continue
		end
		local parent = decoration.Attach == "Head" and rig:FindFirstChild("Head")
			or rig:FindFirstChild("HumanoidRootPart")
		if not parent or not parent:IsA("BasePart") then
			continue
		end
		local size = vector(decoration.Size)
		visual.Size = Vector3.new(math.max(0.1, math.abs(size.X)), math.max(0.1, math.abs(size.Y)), 0.12)
		local offset = vector(decoration.Offset)
		local rotation = vector(decoration.Rotation)
		visual.CFrame = parent.CFrame
			* CFrame.new(offset.X, offset.Y, offset.Z + layerDepth(frame, "Decoration:" .. index))
			* CFrame.Angles(math.rad(rotation.X), math.rad(rotation.Y), math.rad(rotation.Z))
		local digits = string.match(tostring(decoration.AssetId or ""), "%d+")
		visual.Transparency = digits and 0.9 or 0.4
		for _, decal in visual:GetChildren() do
			if decal:IsA("Decal") then
				decal.Texture = digits and ("rbxassetid://" .. digits) or ""
				decal.Transparency = digits and 0 or 1
			end
		end
	end
end

function MotionPlayer.Play(rig: Model, motion: any, target: Model?)
	if not rig or not motion or not motion.Frames or #motion.Frames < 2 then
		return
	end
	task.spawn(function()
		local motors: { [string]: Motor6D } = {}
		for name in JOINT_ALIASES do
			local motor = findMotor(rig, name)
			if motor then
				motors[name] = motor
			end
		end
		local weaponMotor = findMotor(rig, "MotionWeaponMotor")
		local dualWeaponMotor = findMotor(rig, "MotionDualWeaponMotor")
		local weaponPart = rig:FindFirstChild("MotionWeapon", true)
		local dualWeaponPart = rig:FindFirstChild("MotionDualWeapon", true)
		local root = rig:FindFirstChild("HumanoidRootPart")
		local rootStart = root and root:IsA("BasePart") and root.CFrame or nil
		local playedEvents: { [string]: boolean } = {}
		local teleportOffset = Vector3.zero
		local decorationVisuals = createDecorationVisuals(rig)
		local playedHits: { [number]: boolean } = {}
		local started = os.clock()
		-- Keep one render interval after Duration so events authored on the last frame are not skipped.
		while rig.Parent and os.clock() - started < motion.Duration + 0.05 do
			local elapsed = math.min(motion.Duration, os.clock() - started)
			local currentFrame = frameAt(motion.Frames, elapsed)
			for name, motor in motors do
				motor.Transform = poseAt(motion.Frames, elapsed, name, motor)
			end
			syncWeaponHands(rig, weaponMotor, dualWeaponMotor, currentFrame.HandSwap == true)
			if weaponMotor then
				weaponMotor.Transform = weaponAt(motion.Frames, elapsed)
			end
			if dualWeaponMotor then
				dualWeaponMotor.Transform = weaponAt(motion.Frames, elapsed, "DualWeapon")
			end
			if weaponPart and weaponPart:IsA("BasePart") then
				syncWeaponVisual(weaponPart, currentFrame)
			end
			if dualWeaponPart and dualWeaponPart:IsA("BasePart") then
				syncWeaponVisual(dualWeaponPart, currentFrame, "DualWeapon", motion.DualWield == true)
			end
			syncDecorations(rig, decorationVisuals, currentFrame)
			for _, kind in { "Effects", "Projectiles", "Teleports" } do
				for index, event in ((motion.Events and motion.Events[kind]) or {}) do
					local frame = motion.Frames[event.Frame]
					local key = kind .. index
					if frame and not playedEvents[key] and elapsed >= frame.Time then
						playedEvents[key] = true
						if kind == "Teleports" then
							teleportOffset += vector(event.Offset)
						else
							local renderedEvent = table.clone(event)
							local endFrame = motion.Frames[event.EndFrame or event.Frame]
							if endFrame and (event.EndFrame or event.Frame) > event.Frame then
								renderedEvent.Duration = math.max(0.05, endFrame.Time - frame.Time)
							end
							showFrameEvent(rig, renderedEvent, kind, target)
						end
					end
				end
			end
			if root and root:IsA("BasePart") and rootStart then
				local facing = rootStart
				local targetRoot = target and target:FindFirstChild("HumanoidRootPart")
				if targetRoot and targetRoot:IsA("BasePart") and currentFrame.CastDirection ~= "preserve" then
					local targetPosition =
						Vector3.new(targetRoot.Position.X, rootStart.Position.Y, targetRoot.Position.Z)
					if (targetPosition - rootStart.Position).Magnitude > 0.01 then
						facing = CFrame.lookAt(rootStart.Position, targetPosition)
						if currentFrame.CastDirection == "away" then
							facing *= CFrame.Angles(0, math.pi, 0)
						end
					end
				end
				root.CFrame = facing * CFrame.new(rootOffsetAt(motion.Frames, elapsed) + teleportOffset)
			end
			for index, hit in motion.Hits or {} do
				local frame = motion.Frames[hit.Frame]
				if frame and not playedHits[index] and elapsed >= frame.Time then
					playedHits[index] = true
					showHitbox(rig, hit)
				end
			end
			RunService.RenderStepped:Wait()
		end
		for _, motor in motors do
			motor.Transform = CFrame.identity
		end
		if weaponMotor then
			weaponMotor.Transform = CFrame.identity
		end
		if dualWeaponMotor then
			dualWeaponMotor.Transform = CFrame.identity
		end
		syncWeaponHands(rig, weaponMotor, dualWeaponMotor, false)
		if root and root:IsA("BasePart") and rootStart then
			root.CFrame = rootStart
		end
		for _, visual in decorationVisuals do
			visual:Destroy()
		end
	end)
end

return MotionPlayer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">MotionTimeline</string>
          <string name="Source"><![CDATA[--!strict

local MotionTimeline = {}

function MotionTimeline.FrameTime(motion: any, frameIndex: number): number
	local frames = motion and motion.Frames or {}
	local frame = frames[math.clamp(math.floor(frameIndex), 1, math.max(1, #frames))]
	return frame and math.max(0, tonumber(frame.Time) or 0) or 0
end

function MotionTimeline.DamageEvents(motion: any): { any }
	local groups: { [string]: any } = {}
	local order = {}
	for _, hit in (motion and motion.Hits or {}) do
		local attackId = tostring(hit.AttackId or "Hit")
		local frame = math.clamp(math.floor(tonumber(hit.Frame) or 1), 1, math.max(1, #(motion.Frames or {})))
		local existing = groups[attackId]
		if not existing then
			existing = {
				AttackId = attackId,
				Frame = frame,
				Time = MotionTimeline.FrameTime(motion, frame),
				Ratio = math.clamp(tonumber(hit.DamageRatio) or 0, 0, 1),
			}
			groups[attackId] = existing
			table.insert(order, existing)
		elseif frame < existing.Frame then
			existing.Frame = frame
			existing.Time = MotionTimeline.FrameTime(motion, frame)
		end
	end
	if #order == 0 then
		return {
			{
				AttackId = "Fallback",
				Frame = 1,
				Time = math.min(0.25, math.max(0, tonumber(motion and motion.Duration) or 0.25)),
				Ratio = 1,
			},
		}
	end
	local assigned = 0
	local automatic = 0
	for _, event in order do
		if event.Ratio > 0 then
			assigned += event.Ratio
		else
			automatic += 1
		end
	end
	if automatic > 0 then
		local automaticRatio = math.max(0, 1 - assigned) / automatic
		if assigned <= 0 then
			automaticRatio = 1 / automatic
		end
		for _, event in order do
			if event.Ratio <= 0 then
				event.Ratio = automaticRatio
			end
		end
	end
	table.sort(order, function(a, b)
		if a.Time == b.Time then
			return a.AttackId < b.AttackId
		end
		return a.Time < b.Time
	end)
	return order
end

function MotionTimeline.Duration(motion: any): number
	local duration = math.max(0.1, tonumber(motion and motion.Duration) or 0.6)
	for _, event in MotionTimeline.DamageEvents(motion) do
		duration = math.max(duration, event.Time + 0.1)
	end
	return duration
end

return MotionTimeline
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">PlayerProfile</string>
          <string name="Source"><![CDATA[--!strict
--[[
	PlayerProfile — 저장 데이터 스키마(v3)와 기본값·마이그레이션.

	사양 출처: 추가&수정.md 전반

	기존 v2는 모션 팩만 담고 있었다(Packs / Equipped / SelectedCharacterId / HighestFloor).
	여기에 육성·아이템·명예·탑 진행을 얹으면서 **저장 단위를 셋으로 나눴다.**

	  Account  계정 단위 — 슬롯을 새로 만들거나 죽어도 유지된다.
	           명예, 모션 팩, 모션 장착, 프리셋 슬롯 수, 최고 도달 층.
	           └ 사양 근거: "명예는 계정에 귀속되므로, 슬롯을 새로 만들거나
	                        사망 후 부활 해도 유지됨"

	  Slots    캐릭터(프리셋) 단위 — 스탯, 레벨, 아이템, 선행/악행 수치.
	           └ 사양 근거: "무료로 주어지는 프리셋은 최대 3개"

	  TowerRun 탑 등반 중에만 존재하는 일시 상태 — 능력 카드, 코스트, 리롤 횟수.
	           └ 사양 근거: "스탯은 탑을 모두 오른 시점에 변한다"
	                        → 등반 중 성장은 확정 전까지 여기 머문다.

	이 모듈은 순수 데이터라 서버·클라이언트 양쪽에서 같은 타입을 본다.
]]

local StatDefinitions = require(script.Parent.StatDefinitions)
local ItemDefinitions = require(script.Parent.ItemDefinitions)
local HonorDefinitions = require(script.Parent.HonorDefinitions)
local TowerRewardDefinitions = require(script.Parent.TowerRewardDefinitions)

local PROFILE_VERSION = 3

export type OwnedItem = {
	Id: string,
	Name: string,
	Rarity: ItemDefinitions.Rarity,
	PrimaryStat: StatDefinitions.StatId,
	StatRequirement: number,
	BaseDamage: number,
	StatBonus: { [string]: number }?,
	-- 새겨진 수식어. 장비당 최대 1개(사양).
	Affix: string?,
}

-- 탑 등반 중에만 유지되는 카드 진행도.
export type CardProgress = {
	CardId: string,
	Grade: string,
	Level: number,
}

export type TowerRun = {
	Active: boolean,
	Floor: number,
	Cost: number,
	-- 층을 옮기면 0으로 초기화된다(사양).
	RerollCount: number,
	Cards: { CardProgress },
	-- 등반 중 오른 레벨. 완주/이탈 시 슬롯에 확정 반영한다.
	PendingLevel: number,
	-- 입장 시 벗어둔 장비. 나가거나 클리어하면 돌려준다(사양).
	StoredItems: { OwnedItem },
	--[[
		이번 층에서 이미 고른 카드 수.

		사양: "층을 클리어 할 때마다 능력 카드중 한개를 얻을 수 있다.
		       5층 단위로 획득 가능한 능력 카드가 1개씩 증가한다."
		→ 층마다 몇 장까지인지는 AcquireSlotsForFloor가 정하고, 여기서 몇 장 썼는지를 센다.
		층을 옮길 때 0으로 되돌린다.
	]]
	AcquiredThisFloor: number,
	--[[
		등반 도중 이미 지급한 스탯 포인트 수.

		사양은 "스탯은 탑을 모두 오른 시점에 변한다"지만, 요청대로 **층마다 스탯을
		찍을 수 있어야** 등반 중의 선택이 된다. 그래서 포인트는 층 클리어 때 바로 주고,
		완주 확정 시 이미 준 만큼을 빼서 같은 포인트를 두 번 주지 않는다.
	]]
	GrantedPoints: number,
}

export type Slot = {
	Name: string,
	ClassId: string,
	RaceId: string,
	Level: number,
	Stats: StatDefinitions.StatBlock,
	-- 아직 쓰지 않은 스탯 포인트.
	UnspentPoints: number,
	Items: { OwnedItem },
	Gold: number,
	-- 사망 시 갈 차원을 정하는 값(세계관.md).
	GoodDeeds: number,
	EvilDeeds: number,
}

export type Account = {
	-- 계정 귀속. 기본 150, 최대 300.
	Honor: number,
	-- 구매로 늘어나는 프리셋 슬롯 수. 무료 3.
	PresetSlots: number,
	HighestFloor: number,
	-- v2에서 이어받는 모션 데이터.
	Packs: { [string]: any },
	Equipped: { [string]: string },
	SelectedCharacterId: string,
}

export type Profile = {
	Version: number,
	Account: Account,
	Slots: { Slot },
	ActiveSlot: number,
	TowerRun: TowerRun?,
}

local PlayerProfile = {}

PlayerProfile.VERSION = PROFILE_VERSION

--=== 기본값 ===--

function PlayerProfile.NewTowerRun(): TowerRun
	return {
		Active = false,
		Floor = 0,
		Cost = 0,
		RerollCount = 0,
		Cards = {},
		PendingLevel = 0,
		StoredItems = {},
		AcquiredThisFloor = 0,
		GrantedPoints = 0,
	}
end

function PlayerProfile.NewSlot(name: string, classId: string, raceId: string): Slot
	return {
		Name = name,
		ClassId = classId,
		RaceId = raceId,
		Level = 1,
		Stats = StatDefinitions.NewBlock(),
		UnspentPoints = 0,
		Items = {},
		Gold = 0,
		GoodDeeds = 0,
		EvilDeeds = 0,
	}
end

function PlayerProfile.New(): Profile
	return {
		Version = PROFILE_VERSION,
		Account = {
			Honor = HonorDefinitions.DEFAULT_HONOR,
			PresetSlots = TowerRewardDefinitions.FREE_PRESETS,
			HighestFloor = 0,
			Packs = {},
			Equipped = {},
			SelectedCharacterId = "Berserker",
		},
		Slots = { PlayerProfile.NewSlot("1번 프리셋", "Berserker", "Human") },
		ActiveSlot = 1,
		TowerRun = nil,
	}
end

--=== 마이그레이션 ===--

--[[
	v2(모션 전용) → v3.
	모션 데이터는 계정 쪽으로 옮기고, 육성 데이터는 기본값으로 시작한다.
	이미 v3면 손대지 않는다.
]]
function PlayerProfile.Migrate(raw: any): Profile
	if type(raw) ~= "table" then
		return PlayerProfile.New()
	end

	if raw.Version == PROFILE_VERSION and raw.Account and raw.Slots then
		return PlayerProfile.Sanitize(raw)
	end

	-- v2 형태를 흡수한다.
	local profile = PlayerProfile.New()
	profile.Account.Packs = if type(raw.Packs) == "table" then raw.Packs else {}
	profile.Account.Equipped = if type(raw.Equipped) == "table" then raw.Equipped else {}
	profile.Account.SelectedCharacterId = if type(raw.SelectedCharacterId) == "string"
		then raw.SelectedCharacterId
		else "Berserker"
	profile.Account.HighestFloor = if type(raw.HighestFloor) == "number" then raw.HighestFloor else 0

	return profile
end

--=== 검증 ===--

local function sanitizeStatBlock(raw: any): StatDefinitions.StatBlock
	local block = StatDefinitions.NewBlock()
	if type(raw) ~= "table" then
		return block
	end
	for _, id in StatDefinitions.Order do
		if type(raw.Main) == "table" and type(raw.Main[id]) == "number" then
			block.Main[id] = math.max(math.floor(raw.Main[id]), 0)
		end
		if type(raw.Sub) == "table" and type(raw.Sub[id]) == "number" then
			block.Sub[id] = math.max(math.floor(raw.Sub[id]), 0)
		end
	end
	return block
end

--[[
	저장본을 신뢰하지 않고 값 범위를 강제한다.
	DataStore가 오래된 값이나 조작된 값을 돌려줄 수 있기 때문이다.
]]
function PlayerProfile.Sanitize(raw: any): Profile
	local profile = PlayerProfile.New()

	if type(raw) ~= "table" then
		return profile
	end

	local account = if type(raw.Account) == "table" then raw.Account else {}

	profile.Account.Honor = HonorDefinitions.Clamp(
		if type(account.Honor) == "number" then account.Honor else HonorDefinitions.DEFAULT_HONOR
	)
	profile.Account.PresetSlots = math.max(
		if type(account.PresetSlots) == "number" then math.floor(account.PresetSlots) else 0,
		TowerRewardDefinitions.FREE_PRESETS
	)
	profile.Account.HighestFloor = math.clamp(
		if type(account.HighestFloor) == "number" then math.floor(account.HighestFloor) else 0,
		0,
		TowerRewardDefinitions.MAX_FLOOR
	)
	profile.Account.Packs = if type(account.Packs) == "table" then account.Packs else {}
	profile.Account.Equipped = if type(account.Equipped) == "table" then account.Equipped else {}
	profile.Account.SelectedCharacterId = if type(account.SelectedCharacterId) == "string"
		then account.SelectedCharacterId
		else "Berserker"

	-- 슬롯
	local slots: { Slot } = {}
	if type(raw.Slots) == "table" then
		for _, rawSlot in raw.Slots do
			if type(rawSlot) == "table" then
				local slot = PlayerProfile.NewSlot(
					if type(rawSlot.Name) == "string" then rawSlot.Name else "프리셋",
					if type(rawSlot.ClassId) == "string" then rawSlot.ClassId else "Berserker",
					if type(rawSlot.RaceId) == "string" then rawSlot.RaceId else "Human"
				)
				slot.Level = math.max(if type(rawSlot.Level) == "number" then math.floor(rawSlot.Level) else 1, 1)
				slot.Stats = sanitizeStatBlock(rawSlot.Stats)
				slot.UnspentPoints = math.max(
					if type(rawSlot.UnspentPoints) == "number" then math.floor(rawSlot.UnspentPoints) else 0,
					0
				)
				slot.Gold = math.max(if type(rawSlot.Gold) == "number" then math.floor(rawSlot.Gold) else 0, 0)
				slot.GoodDeeds =
					math.max(if type(rawSlot.GoodDeeds) == "number" then math.floor(rawSlot.GoodDeeds) else 0, 0)
				slot.EvilDeeds =
					math.max(if type(rawSlot.EvilDeeds) == "number" then math.floor(rawSlot.EvilDeeds) else 0, 0)
				slot.Items = if type(rawSlot.Items) == "table" then rawSlot.Items else {}
				table.insert(slots, slot)
			end
		end
	end

	if #slots == 0 then
		slots = { PlayerProfile.NewSlot("1번 프리셋", "Berserker", "Human") }
	end
	profile.Slots = slots
	profile.ActiveSlot =
		math.clamp(if type(raw.ActiveSlot) == "number" then math.floor(raw.ActiveSlot) else 1, 1, #slots)

	-- 탑 진행은 활성일 때만 이어받는다.
	if type(raw.TowerRun) == "table" and raw.TowerRun.Active == true then
		local run = PlayerProfile.NewTowerRun()
		run.Active = true
		run.Floor = math.clamp(
			if type(raw.TowerRun.Floor) == "number" then math.floor(raw.TowerRun.Floor) else 0,
			0,
			TowerRewardDefinitions.MAX_FLOOR
		)
		run.Cost = math.max(if type(raw.TowerRun.Cost) == "number" then math.floor(raw.TowerRun.Cost) else 0, 0)
		run.RerollCount =
			math.max(if type(raw.TowerRun.RerollCount) == "number" then math.floor(raw.TowerRun.RerollCount) else 0, 0)
		run.PendingLevel = math.max(
			if type(raw.TowerRun.PendingLevel) == "number" then math.floor(raw.TowerRun.PendingLevel) else 0,
			0
		)
		run.Cards = if type(raw.TowerRun.Cards) == "table" then raw.TowerRun.Cards else {}
		run.StoredItems = if type(raw.TowerRun.StoredItems) == "table" then raw.TowerRun.StoredItems else {}
		run.GrantedPoints = math.max(
			if type(raw.TowerRun.GrantedPoints) == "number" then math.floor(raw.TowerRun.GrantedPoints) else 0,
			0
		)
		run.AcquiredThisFloor = math.max(
			if type(raw.TowerRun.AcquiredThisFloor) == "number" then math.floor(raw.TowerRun.AcquiredThisFloor) else 0,
			0
		)
		profile.TowerRun = run
	end

	return profile
end

--=== 조회 도우미 ===--

function PlayerProfile.ActiveSlot(profile: Profile): Slot
	return profile.Slots[profile.ActiveSlot] or profile.Slots[1]
end

-- 프리셋을 하나 더 만들 수 있는지. 무료 3개를 넘으면 구매가 필요하다.
function PlayerProfile.CanAddSlot(profile: Profile): (boolean, number)
	local owned = #profile.Slots
	if owned < profile.Account.PresetSlots then
		return true, 0
	end
	return false, TowerRewardDefinitions.EXTRA_PRESET_ROBUX
end

return PlayerProfile
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">PrayerDefinitions</string>
          <string name="Source"><![CDATA[--!strict
--[[
	PrayerDefinitions — 이 세계의 '마법'(기도) 규칙과 그 대가.

	사양 출처: 세계관.md `## 이 세계의 마법`

	규칙 6가지
	  1. 마법이 아니라 **기도**다.
	  2. 기도를 이루는 어구는 절대로 줄여선 안 된다.
	  3. 기도는 무(無)에서 유(有)를 창조하지 않는다.
	     (공기가 없는 공간에서 얼음을 만들 수 없다)
	  4. 기도를 쓸 때는 오직 기도의 형태와 어구만을 생각한다.
	  5. 기도로 타인을 공격하는 것은 **금기**이며, 어기면 그 구역의 신이 죄를 묻는다.
	  6. 기도는 절대 기계로 구현할 수 없다.

	성능
	  기도 하나하나가 강력하다. 다만 어구를 외워야 해서 난발할 수 없고,
	  사용 후에는 **반드시** 일시적인 육체적·정신적 대가가 따른다.

	"바란다면, 이루어짐."
]]

export type PenaltyId = "Exhaustion" | "Bleed" | "Daze" | "Stun"

export type PenaltyDefinition = {
	Id: PenaltyId,
	Name: string,
	Description: string,
	DebuffName: string,
}

export type Prayer = {
	Id: string,
	Name: string,
	-- 반드시 완창해야 하는 어구. 줄이면 성립하지 않는다(규칙 2).
	Verse: string,
	-- 어구를 외는 데 걸리는 턴 수. 이것이 난발을 막는다.
	ChantTurns: number,
	BaseDamage: number,
	-- 이 기도가 성립하려면 주변에 있어야 하는 것 (규칙 3).
	-- 예: "Air", "Water", "Earth". 비어 있으면 조건 없음.
	RequiredMedium: { string },
	-- 사용 후 치르는 대가.
	Penalty: PenaltyId,
	-- 타인을 해치는 기도인가. 참이면 금기 판정 대상(규칙 5).
	IsOffensive: boolean,
}

local penalties: { PenaltyDefinition } = {
	{
		Id = "Exhaustion",
		Name = "강한 피로감",
		Description = "몸이 무거워져 행동이 둔해진다.",
		DebuffName = "탈진",
	},
	{
		Id = "Bleed",
		Name = "상당한 출혈",
		Description = "지혈될 때까지 피가 흐른다.",
		DebuffName = "출혈",
	},
	{
		Id = "Daze",
		Name = "정신적 붕괴",
		Description = "무엇을 겨누고 있었는지 흐려진다.",
		DebuffName = "현혹",
	},
	{
		Id = "Stun",
		Name = "극심한 나태",
		Description = "다음 행동을 할 수 없다.",
		DebuffName = "스턴",
	},
}

local PrayerDefinitions = {}

-- 규칙 6: 기계로는 구현할 수 없다. 기계 유닛의 기도 시도를 막는 데 쓴다.
PrayerDefinitions.MACHINE_CAN_PRAY = false

function PrayerDefinitions.AllPenalties(): { PenaltyDefinition }
	return penalties
end

function PrayerDefinitions.GetPenalty(id: PenaltyId): PenaltyDefinition?
	for _, penalty in penalties do
		if penalty.Id == id then
			return penalty
		end
	end
	return nil
end

--[[
	규칙 2 — 어구를 줄였는지 본다.
	외운 어구가 원문과 정확히 같아야 기도가 성립한다.
]]
function PrayerDefinitions.IsVerseComplete(prayer: Prayer, spoken: string): boolean
	return spoken == prayer.Verse
end

--[[
	규칙 3 — 무에서 유를 만들 수 없다.
	기도가 요구하는 매질이 주변에 다 있어야 성립한다.
]]
function PrayerDefinitions.HasRequiredMedium(prayer: Prayer, available: { [string]: boolean }): (boolean, string?)
	for _, medium in prayer.RequiredMedium do
		if not available[medium] then
			return false, medium
		end
	end
	return true, nil
end

--[[
	규칙 5 — 타인을 공격하는 기도는 금기다.
	금기를 저지르면 그 구역의 신이 죄를 묻는다.
	  targetIsPlayer: 대상이 사람인지 (짐승·괴수는 금기가 아니다)
]]
function PrayerDefinitions.IsTaboo(prayer: Prayer, targetIsPlayer: boolean): boolean
	return prayer.IsOffensive and targetIsPlayer
end

--[[
	기도를 시도할 수 있는지 종합 판정한다.

	반환: 성립 여부, 실패 사유
]]
function PrayerDefinitions.CanInvoke(
	prayer: Prayer,
	spoken: string,
	availableMedium: { [string]: boolean },
	isMachine: boolean
): (boolean, string?)
	-- 규칙 6
	if isMachine then
		return false, "기도는 기계로 구현할 수 없습니다."
	end

	-- 규칙 2
	if not PrayerDefinitions.IsVerseComplete(prayer, spoken) then
		return false, "어구를 줄이거나 틀렸습니다. 기도가 성립하지 않습니다."
	end

	-- 규칙 3
	local hasMedium, missing = PrayerDefinitions.HasRequiredMedium(prayer, availableMedium)
	if not hasMedium then
		return false,
			string.format("주변에 %s이(가) 없어 기도가 성립하지 않습니다.", tostring(missing))
	end

	return true, nil
end

--[[
	기도 대미지. 신앙심 스탯의 파생값을 곱한다.
	  prayerDamageBonus: StatDefinitions.Derive(...)의 PrayerDamage (0.8 = +80%)
]]
function PrayerDefinitions.EffectiveDamage(prayer: Prayer, prayerDamageBonus: number): number
	return prayer.BaseDamage * (1 + prayerDamageBonus)
end

--[[
	대가의 강도. 신앙심이 높을수록 줄어든다.
	  penaltyReduction: Derive(...)의 PrayerPenalty (음수. -0.15 = 15% 감소)
	사양상 기도 후에는 **반드시** 대가가 따르므로 0 아래로 내려가지 않게 최소치를 남긴다.
]]
function PrayerDefinitions.PenaltyScale(penaltyReduction: number): number
	return math.max(1 + penaltyReduction, 0.1)
end

return PrayerDefinitions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">ProgressionDefinitions</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ProgressionDefinitions — 레벨, 체력, 스테미나/신앙심 자원.

	사양 출처: 추가&수정.md `##### 플레이어`, `##### 층별 보상`

	체력
	  1레벨 기본 60. 레벨이 5 오를 때마다 최대 체력 +10. 매 턴 최대 체력의 5% 회복.
	스테미나
	  1레벨 기본 60. 매 턴 8 회복. **레벨이 올라도 회복량은 변하지 않는다.**
	  버프로 회복 효율을 높일 수 있다.
	  마법사 계열은 스테미나 대신 '신앙심'을 자원으로 쓴다(이름만 다르고 수치 규칙은 같다).
	레벨
	  탑에서만 오른다. 층 클리어마다 1레벨, 5층 단위마다 2레벨 추가.
	  1레벨당 스탯 포인트 3개.
]]

local StatDefinitions = require(script.Parent.StatDefinitions)

-- 마법사 계열인지에 따라 자원 이름이 바뀐다.
export type ResourceKind = "Stamina" | "Faith"

local BASE_HEALTH = 60
local HEALTH_PER_5_LEVELS = 10
local HEALTH_REGEN_RATIO = 0.05 -- 매 턴 최대 체력의 5%

local BASE_STAMINA = 60
local STAMINA_REGEN_FLAT = 8 -- 매 턴 8, 레벨 무관

local ProgressionDefinitions = {}

ProgressionDefinitions.BASE_HEALTH = BASE_HEALTH
ProgressionDefinitions.HEALTH_PER_5_LEVELS = HEALTH_PER_5_LEVELS
ProgressionDefinitions.HEALTH_REGEN_RATIO = HEALTH_REGEN_RATIO
ProgressionDefinitions.BASE_STAMINA = BASE_STAMINA
ProgressionDefinitions.STAMINA_REGEN_FLAT = STAMINA_REGEN_FLAT

--[[
	레벨 기준 최대 체력.
	레벨 1 → 60, 레벨 6 → 70, 레벨 11 → 80 …
	스탯(힘 +1/점, 체력 +4/점)은 별도로 더한다. → MaxHealthWithStats 참고.
]]
function ProgressionDefinitions.MaxHealth(level: number): number
	local steps = math.floor((math.max(level, 1) - 1) / 5)
	return BASE_HEALTH + steps * HEALTH_PER_5_LEVELS
end

-- 레벨 + 스탯을 모두 반영한 최대 체력.
function ProgressionDefinitions.MaxHealthWithStats(level: number, block: StatDefinitions.StatBlock): number
	local derived = StatDefinitions.Derive(block)
	return ProgressionDefinitions.MaxHealth(level) + (derived.MaxHealth or 0)
end

-- 매 턴 회복하는 체력량 (최대 체력의 5%).
function ProgressionDefinitions.HealthRegen(maxHealth: number): number
	return maxHealth * HEALTH_REGEN_RATIO
end

-- 최대 스테미나(= 신앙심). 현재 사양엔 레벨 증가분이 없다.
function ProgressionDefinitions.MaxStamina(_level: number): number
	return BASE_STAMINA
end

--[[
	매 턴 회복하는 스테미나량.
	기본 8 고정이며, 버프 효율(0.2 = +20%)만 이 값을 늘린다.
]]
function ProgressionDefinitions.StaminaRegen(buffEfficiency: number?): number
	return STAMINA_REGEN_FLAT * (1 + (buffEfficiency or 0))
end

-- 마법사면 '신앙심', 아니면 '스테미나'.
function ProgressionDefinitions.ResourceKind(isPrayerUser: boolean): ResourceKind
	return if isPrayerUser then "Faith" else "Stamina"
end

function ProgressionDefinitions.ResourceName(kind: ResourceKind): string
	return if kind == "Faith" then "신앙심" else "스테미나"
end

--[[
	층을 clearedFloors개 클리어했을 때의 레벨.
	층마다 1, 5층 단위마다 2 추가. 시작 레벨은 1이다.
	  5층 클리어  → 1 + 5 + 2  = 8
	  10층 클리어 → 1 + 10 + 4 = 15
	  30층 클리어 → 1 + 30 + 12 = 43
]]
function ProgressionDefinitions.LevelForFloors(clearedFloors: number): number
	local floors = math.max(clearedFloors, 0)
	return 1 + floors + math.floor(floors / 5) * 2
end

-- 한 층을 더 클리어했을 때 오르는 레벨 수 (5의 배수 층이면 3).
function ProgressionDefinitions.LevelGainForFloor(floor: number): number
	return 1 + (if floor % 5 == 0 then 2 else 0)
end

-- 해당 레벨까지 모았을 스탯 포인트 총량 (1레벨당 3개).
function ProgressionDefinitions.TotalStatPoints(level: number): number
	return math.max(level - 1, 0) * StatDefinitions.POINTS_PER_LEVEL
end

return ProgressionDefinitions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">QteDefinitions</string>
          <string name="Source"><![CDATA[--!strict
--[[
	QteDefinitions — QTE 판정 규칙.

	사양 출처
	  추가&수정.md `##### QTE`
	    "C:\Users\hhksh\Documents\Codex\2026-06-09\...\battleroyale 경로의 게임에서
	     QTE 시스템을 가져올 것."
	  추가&수정.md `###### 전투` — 배율과 그로기는 이쪽 사양을 따른다.

	원본: 그 프로젝트의 `game/sim/Qte.js`를 이식했다.
	  타입 5종(sweep / forge / mash / parry / directional), 진행도 수식, 판정 기준을
	  그대로 옮겼다.

	**배율만 이 게임 사양으로 바꿨다.** 원본은 스킬 실패가 0.6이지만,
	추가&수정.md는 "실패 시 대미지가 1/2이 되고 QTE가 취소된다"고 못박고 있다.

	  스킬 QTE   성공 1.2 / 보통 1.0 / 실패 0.5   ← 실패 0.5가 사양
	  회피 QTE   성공 0.0 / 방어 0.5 / 실패 1.0   ← 사양과 원본이 일치

	설계상 중요한 점
	  VisualState()를 **미리보기와 판정이 함께 쓴다.**
	  화면에 보이는 것과 서버가 매기는 결과가 같은 수식에서 나오므로 어긋날 수 없다.

	난이도 너프 (사용자 요청: "스트라타젬을 가린다던가, 깜빡이며 낚시를 한다던가 등을 삭제")
	  - 시야 방해(DisruptionEnabled)를 **완전히 제거**했다.
	    · 패리 표시가 깜빡이며 낚시하던 것 → 항상 선명하게 보인다
	    · 방향 커맨드(스트라타젬)를 가리던 것 → 항상 다 보인다
	  - 타이밍 창을 넓히고 링·바 속도를 낮췄다. 방향 커맨드도 10 → 5개로 줄였다.
	  '브라운 더스트 1' 톤에 맞춰 QTE를 관대하게 만든다.
]]

export type Grade = "Success" | "Partial" | "Fail"
export type Role = "Skill" | "Dodge"
export type QteType = "Sweep" | "Forge" | "Mash" | "Parry" | "Directional"
export type Direction = "Up" | "Right" | "Down" | "Left"

export type Challenge = {
	Id: string,
	Role: Role,
	Type: QteType,
	Title: string,
	StartedAt: number,
	DurationMs: number,
	InputCount: number,
	-- 상대가 실제 플레이어일 때만 시야 방해(깜빡임·화살표 은폐)를 건다.
	DisruptionEnabled: boolean,

	-- 타입별 파라미터
	ParryHitProgress: number?,
	RingSpeedMultiplier: number?,
	ObscurePhase: number?,
	SweepSpeedMultiplier: number?,
	SweepTargets: { number }?,
	SweepAttempts: number?,
	SweepMisses: number?,
	Goal: number?,
	ExpectedDirections: { Direction }?,
	CommandConcealOffset: number?,
	CommandRevealMs: number?,
	SequenceIndex: number?,
	Mistakes: number?,
}

--=== 상수 (원본 Qte.js와 동일) ===--
local DURATION_MS = 5000
local RING_SPEED_MULTIPLIER = 1.5
local SWEEP_SPEED_MIN = 1.5
local SWEEP_SPEED_MAX = 2.1
local SWEEP_ATTEMPTS = 3
local SWEEP_SUCCESS_GAP = 0.17
local PARRY_SUCCESS_GAP = 0.06
local PARRY_GUARD_GAP = 0.15
local COMMAND_COUNT = 5
local COMMAND_REVEAL_MS = 900
local COMMAND_GUARD_MISTAKES = 1

--[[
	배율. 추가&수정.md `###### 전투` 기준.

	스킬: "'이 스킬로 선택' 버튼을 누를 경우 스킬 QTE가 나오게 되며,
	       실패 시 대미지가 1/2이 되고 QTE가 취소된다."
	회피: "실패 시 대미지 그대로 / 방어 시 대미지의 1/2 / 패리·회피 성공 시 대미지를 받지 않는다."
]]
local MULTIPLIERS: { [Role]: { [Grade]: number } } = {
	Skill = { Success = 1.2, Partial = 1.0, Fail = 0.5 },
	Dodge = { Success = 0.0, Partial = 0.5, Fail = 1.0 },
}

-- 패리 성공 시 적에게 쌓이는 그로기 (사양: 15)
local PARRY_GROGGY_GAIN = 15

local SKILL_TYPES: { { Type: QteType, Title: string } } = {
	{ Type = "Sweep", Title = "스윕 바" },
	{ Type = "Forge", Title = "단조 링" },
	{ Type = "Mash", Title = "과열 연타" },
}

local DODGE_TYPES: { { Type: QteType, Title: string } } = {
	{ Type = "Parry", Title = "패링 윈도우" },
	{ Type = "Directional", Title = "방향 회피" },
}

local DIRECTIONS: { Direction } = { "Up", "Right", "Down", "Left" }

local QteDefinitions = {}

QteDefinitions.DURATION_MS = DURATION_MS
QteDefinitions.SWEEP_ATTEMPTS = SWEEP_ATTEMPTS
QteDefinitions.COMMAND_COUNT = COMMAND_COUNT
QteDefinitions.COMMAND_GUARD_MISTAKES = COMMAND_GUARD_MISTAKES
QteDefinitions.PARRY_GROGGY_GAIN = PARRY_GROGGY_GAIN
QteDefinitions.Multipliers = MULTIPLIERS

local function clamp01(value: number): number
	return math.clamp(value, 0, 1)
end

--[[
	QTE를 하나 만든다.

	rng는 0~1을 돌려주는 함수. 시드를 고정하면 재현 가능한 판정이 나오므로
	서버 권위 판정과 리플레이가 어긋나지 않는다.
]]
function QteDefinitions.Create(role: Role, rng: () -> number, now: number, id: string, pvp: boolean): Challenge
	local _ = pvp -- 너프 이후 미사용. 시그니처 호환을 위해 남긴다.
	local registry = if role == "Dodge" then DODGE_TYPES else SKILL_TYPES
	local pick = registry[math.clamp(math.floor(clamp01(rng()) * #registry) + 1, 1, #registry)]

	local challenge: Challenge = {
		Id = id,
		Role = role,
		Type = pick.Type,
		Title = pick.Title,
		StartedAt = now,
		DurationMs = DURATION_MS,
		InputCount = 0,
		DisruptionEnabled = false, -- 너프: 시야 방해 제거 (항상 선명)
	}

	-- 마감 시점이 곧 최적 타이밍이면 안 된다. 링은 서버가 정한 지점에서
	-- 목표에 닿고, 그 뒤로도 계속 줄어들어 실패 구간으로 들어간다.
	if pick.Type == "Parry" then
		challenge.ParryHitProgress = 0.58 + clamp01(rng()) * 0.2
		challenge.ObscurePhase = clamp01(rng())
	end

	if pick.Type == "Sweep" then
		challenge.SweepSpeedMultiplier = SWEEP_SPEED_MIN + clamp01(rng()) * (SWEEP_SPEED_MAX - SWEEP_SPEED_MIN)
		local targets: { number } = {}
		for _ = 1, SWEEP_ATTEMPTS do
			table.insert(targets, 0.18 + clamp01(rng()) * 0.64)
		end
		challenge.SweepTargets = targets
		challenge.SweepAttempts = 0
		challenge.SweepMisses = 0
	end

	if pick.Type == "Forge" or pick.Type == "Parry" then
		challenge.RingSpeedMultiplier = RING_SPEED_MULTIPLIER * (1 + clamp01(rng()) * 0.5)
	end

	if pick.Type == "Mash" then
		challenge.Goal = 7 + math.floor(clamp01(rng()) * 4)
	end

	if pick.Type == "Directional" then
		local expected: { Direction } = {}
		for _ = 1, COMMAND_COUNT do
			table.insert(expected, DIRECTIONS[math.clamp(math.floor(clamp01(rng()) * 4) + 1, 1, 4)])
		end
		challenge.ExpectedDirections = expected
		challenge.CommandConcealOffset = math.floor(clamp01(rng()) * 3)
		challenge.CommandRevealMs = COMMAND_REVEAL_MS
		challenge.SequenceIndex = 0
		challenge.Mistakes = 0
	end

	return challenge
end

--[[
	현재 화면 상태. **UI와 판정이 이 함수를 공유한다.**
	같은 수식에서 나오므로 보이는 것과 결과가 어긋날 수 없다.
]]
function QteDefinitions.VisualState(challenge: Challenge, elapsedMs: number): { [string]: any }
	local progress = clamp01(elapsedMs / math.max(1, challenge.DurationMs))
	local ringSpeed = challenge.RingSpeedMultiplier or RING_SPEED_MULTIPLIER

	if challenge.Type == "Sweep" then
		local sweepSpeed =
			math.clamp(challenge.SweepSpeedMultiplier or SWEEP_SPEED_MIN, SWEEP_SPEED_MIN, SWEEP_SPEED_MAX)
		-- 뒤로 갈수록 빨라져 난이도가 오른다.
		local acceleratedPhase = progress * (1.25 + progress * 1.35) * sweepSpeed
		local cycle = acceleratedPhase % 2
		local attempts = challenge.SweepAttempts or 0
		local attempt = math.clamp(math.floor(attempts), 0, SWEEP_ATTEMPTS - 1)
		local targets = challenge.SweepTargets or {}

		return {
			progress = progress,
			-- 0↔1을 왕복하는 바
			position = if cycle <= 1 then cycle else 2 - cycle,
			targetPosition = math.clamp(targets[attempt + 1] or 0.5, 0.09, 0.91),
			successGap = SWEEP_SUCCESS_GAP,
			attempt = attempt,
			attempts = SWEEP_ATTEMPTS,
			misses = math.max(challenge.SweepMisses or 0, 0),
		}
	end

	if challenge.Type == "Forge" then
		return {
			progress = progress,
			outerRadius = math.max(0, 1 - progress * 0.82 * ringSpeed),
			targetRadius = 0.3,
		}
	end

	if challenge.Type == "Mash" then
		return {
			progress = progress,
			count = math.max(challenge.InputCount, 0),
			goal = challenge.Goal or 8,
		}
	end

	if challenge.Type == "Parry" then
		local hitProgress = math.max(challenge.ParryHitProgress or 0.68, 0.1)
		local obscurePhase = clamp01(challenge.ObscurePhase or 0)
		local visibilityCycle = ((elapsedMs / 260) + obscurePhase) % 1
		local disruption = challenge.DisruptionEnabled

		return {
			progress = progress,
			outerRadius = math.max(0, 1 - progress * (0.8 / hitProgress) * ringSpeed),
			targetRadius = 0.2,
			successGap = PARRY_SUCCESS_GAP,
			partialGap = PARRY_GUARD_GAP,
			-- 표시를 깜빡이게 해 타이밍을 외우지 못하게 한다 (PvP 한정)
			indicatorOpacity = if (not disruption) or progress < 0.06 or visibilityCycle < 0.46 then 1 else 0.06,
		}
	end

	-- Directional
	local directions = challenge.ExpectedDirections or {}
	local sequenceIndex = math.max(challenge.SequenceIndex or 0, 0)
	local revealMs = math.max(challenge.CommandRevealMs or COMMAND_REVEAL_MS, 0)
	local concealOffset = math.max(math.floor(challenge.CommandConcealOffset or 0), 0) % 3
	local disruption = challenge.DisruptionEnabled

	local hidden: { number } = {}
	if disruption and elapsedMs >= revealMs then
		for index = 1, #directions do
			local zeroBased = index - 1
			if zeroBased >= sequenceIndex and (zeroBased + concealOffset) % 3 == 0 then
				table.insert(hidden, index)
			end
		end
	end

	return {
		progress = progress,
		expectedDirections = directions,
		sequenceIndex = sequenceIndex,
		mistakes = math.max(challenge.Mistakes or 0, 0),
		hiddenCommandIndexes = hidden,
	}
end

local function ringGrade(outerRadius: number, targetRadius: number, successGap: number, partialGap: number): Grade
	local gap = math.abs(outerRadius - targetRadius)
	if gap <= successGap then
		return "Success"
	end
	if gap <= partialGap then
		return "Partial"
	end
	return "Fail"
end

--[[
	판정. 서버가 권위를 갖는다.
	클라이언트가 보낸 시점(elapsedMs)을 그대로 믿지 말고 서버 시계로 검증할 것.
]]
function QteDefinitions.Judge(challenge: Challenge, elapsedMs: number): Grade
	local state = QteDefinitions.VisualState(challenge, elapsedMs)

	if challenge.Type == "Sweep" then
		return if math.abs(state.position - state.targetPosition) <= state.successGap then "Success" else "Fail"
	end

	if challenge.Type == "Forge" then
		return ringGrade(state.outerRadius, state.targetRadius, 0.11, 0.22)
	end

	if challenge.Type == "Parry" then
		return ringGrade(state.outerRadius, state.targetRadius, state.successGap, state.partialGap)
	end

	if challenge.Type == "Mash" then
		local count = math.max(challenge.InputCount, 0)
		local goal = challenge.Goal or 8
		if count == goal or count == goal + 1 then
			return "Success"
		end
		if count >= goal - 2 and count <= goal + 2 then
			return "Partial"
		end
		return "Fail"
	end

	if challenge.Type == "Directional" then
		local expected = state.expectedDirections
		-- 끝까지 입력하지 못했으면 실패
		if #expected == 0 or state.sequenceIndex < #expected then
			return "Fail"
		end
		if state.mistakes == 0 then
			return "Success"
		end
		if state.mistakes <= COMMAND_GUARD_MISTAKES then
			return "Partial"
		end
		return "Fail"
	end

	return "Fail"
end

-- 스윕은 3회 시도의 실수 횟수로 최종 등급을 낸다.
function QteDefinitions.SweepFinalGrade(misses: number): Grade
	local count = math.max(math.floor(misses), 0)
	if count == 0 then
		return "Success"
	end
	if count == 1 then
		return "Partial"
	end
	return "Fail"
end

-- 등급 → 대미지 배율.
function QteDefinitions.Multiplier(role: Role, grade: Grade): number
	return MULTIPLIERS[role][grade]
end

--[[
	이 QTE 결과로 적에게 쌓일 그로기.
	사양: "만약 패리를 할 시 적에게 15의 그로기 게이지가 추가된다."
	→ 패리(Parry) 타입을 성공했을 때만 준다.
]]
function QteDefinitions.GroggyGain(challenge: Challenge, grade: Grade): number
	if challenge.Type == "Parry" and grade == "Success" then
		return PARRY_GROGGY_GAIN
	end
	return 0
end

-- 이 타입에 유효한 입력인지.
function QteDefinitions.IsValidInput(qteType: QteType, input: string): boolean
	if qteType == "Directional" then
		for _, direction in DIRECTIONS do
			if direction == input then
				return true
			end
		end
		return false
	end
	if qteType == "Mash" then
		return input == "Mash" or input == "Tap"
	end
	return input == "Tap"
end

return QteDefinitions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">RotationUtil</string>
          <string name="Source"><![CDATA[--!strict

local RotationUtil = {}

export type Quaternion = { X: number, Y: number, Z: number, W: number }

function RotationUtil.FromEuler(pose: any): CFrame
	return CFrame.Angles(math.rad(pose and pose.X or 0), math.rad(pose and pose.Y or 0), math.rad(pose and pose.Z or 0))
end

function RotationUtil.ToCFrame(rotation: any, fallbackPose: any?): CFrame
	if typeof(rotation) ~= "table" then
		return RotationUtil.FromEuler(fallbackPose)
	end
	local x = tonumber(rotation.X) or 0
	local y = tonumber(rotation.Y) or 0
	local z = tonumber(rotation.Z) or 0
	local w = tonumber(rotation.W) or 1
	local magnitude = math.sqrt(x * x + y * y + z * z + w * w)
	if magnitude < 0.000001 then
		return RotationUtil.FromEuler(fallbackPose)
	end
	x /= magnitude
	y /= magnitude
	z /= magnitude
	w /= magnitude
	return CFrame.new(
		0,
		0,
		0,
		1 - 2 * (y * y + z * z),
		2 * (x * y - z * w),
		2 * (x * z + y * w),
		2 * (x * y + z * w),
		1 - 2 * (x * x + z * z),
		2 * (y * z - x * w),
		2 * (x * z - y * w),
		2 * (y * z + x * w),
		1 - 2 * (x * x + y * y)
	)
end

function RotationUtil.FromCFrame(rotation: CFrame): Quaternion
	local axis, angle = rotation:ToAxisAngle()
	local sine = math.sin(angle * 0.5)
	return {
		X = axis.X * sine,
		Y = axis.Y * sine,
		Z = axis.Z * sine,
		W = math.cos(angle * 0.5),
	}
end

function RotationUtil.ToEuler(rotation: CFrame): { X: number, Y: number, Z: number }
	local x, y, z = rotation:ToEulerAnglesXYZ()
	return { X = math.deg(x), Y = math.deg(y), Z = math.deg(z) }
end

return RotationUtil
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">RuneDefinitions</string>
          <string name="Source"><![CDATA[--!strict
--[[
	RuneDefinitions — 룬과 수식어(장비 강화).

	사양 출처: 추가&수정.md `### 룬`

	  - 무기 또는 방어구에 수식어를 새길 수 있고, 이는 **대장간에서만** 가능하다.
	  - 원하는 수식어에 맞는 룬을 줘야 그 수식어가 붙는다.
	  - 사용하고 남은 룬은 **돌덩이**가 된다.
	  - **장비 하나엔 최대 한 가지 수식어만** 들어간다. 겹칠 수 없다.
	  - 랜덤 룬은 모든 수식어 중 하나를 무작위로 붙인다.

	수식어 설계 원칙 (사양)
	  장비의 성능을 부각하기 위한 시스템으로, **리스크를 주는 대신 리턴을 준다.**
	  리스크 없이 리턴만 얻는 방식도 있지만, 그 경우 리턴의 양이 적어진다.
]]

export type RuneKind = "Fixed" | "Random"

export type Affix = {
	Id: string,
	Name: string,
	Description: string,
	-- 리스크가 없는 수식어는 그만큼 리턴이 작다.
	HasRisk: boolean,
	-- 배율은 곱연산 기준값이다. 1.0이 변화 없음.
	Modifiers: { [string]: number },
}

export type Rune = {
	Id: string,
	Name: string,
	Kind: RuneKind,
	-- Fixed면 붙일 수식어 Id. Random이면 nil.
	AffixId: string?,
}

-- 룬을 다 쓰고 남는 것 (사양: 돌덩이)
local SPENT_RUNE_ID = "Pebble"
local SPENT_RUNE_NAME = "돌덩이"

local affixes: { Affix } = {
	--=== 리스크 있는 수식어 — 리턴이 크다 ===--
	{
		Id = "Reckless",
		Name = "무모한",
		Description = "대미지 +35%, 받는 대미지 +20%",
		HasRisk = true,
		Modifiers = { Damage = 1.35, DamageTaken = 1.20 },
	},
	{
		Id = "Brittle",
		Name = "메마른",
		Description = "치명타 대미지 +50%, 최대 체력 -15%",
		HasRisk = true,
		Modifiers = { CritDamage = 1.50, MaxHealth = 0.85 },
	},
	{
		Id = "Ravenous",
		Name = "굶주린",
		Description = "가한 대미지의 12%를 회복, 매 턴 스테미나 회복 -30%",
		HasRisk = true,
		Modifiers = { Lifesteal = 0.12, StaminaRegen = 0.70 },
	},
	{
		Id = "Zealous",
		Name = "광신의",
		Description = "기도 대미지 +40%, 기도 패널티 +25%",
		HasRisk = true,
		Modifiers = { PrayerDamage = 1.40, PrayerPenalty = 1.25 },
	},
	{
		Id = "Unstable",
		Name = "불안정한",
		Description = "치명타 확률 +18%, 자동 회피 확률 -50%",
		HasRisk = true,
		Modifiers = { CritChance = 1.18, AutoDodge = 0.50 },
	},
	{
		Id = "Heavy",
		Name = "묵직한",
		Description = "물리 대미지 +28%, 이동속도 -12%",
		HasRisk = true,
		Modifiers = { PhysicalDamage = 1.28, MoveSpeed = 0.88 },
	},

	--=== 리스크 없는 수식어 — 리턴이 작다 ===--
	{
		Id = "Sturdy",
		Name = "단단한",
		Description = "최대 체력 +6%",
		HasRisk = false,
		Modifiers = { MaxHealth = 1.06 },
	},
	{
		Id = "Keen",
		Name = "예리한",
		Description = "대미지 +7%",
		HasRisk = false,
		Modifiers = { Damage = 1.07 },
	},
	{
		Id = "Swift",
		Name = "날랜",
		Description = "패리·회피 타이밍 +5%",
		HasRisk = false,
		Modifiers = { ParryWindow = 1.05, DodgeWindow = 1.05 },
	},
	{
		Id = "Devout",
		Name = "경건한",
		Description = "주는 회복량 +8%",
		HasRisk = false,
		Modifiers = { HealGiven = 1.08 },
	},
	{
		Id = "Fortunate",
		Name = "운좋은",
		Description = "드랍률 +9%",
		HasRisk = false,
		Modifiers = { DropRate = 1.09 },
	},
}

local RuneDefinitions = {}

RuneDefinitions.SPENT_RUNE_ID = SPENT_RUNE_ID
RuneDefinitions.SPENT_RUNE_NAME = SPENT_RUNE_NAME

function RuneDefinitions.AllAffixes(): { Affix }
	return affixes
end

function RuneDefinitions.GetAffix(id: string): Affix?
	for _, affix in affixes do
		if affix.Id == id then
			return affix
		end
	end
	return nil
end

--[[
	룬을 장비에 새길 수 있는지 본다.
	사양: 장비 하나엔 최대 한 가지 수식어. 이미 있으면 겹칠 수 없다.
]]
function RuneDefinitions.CanInscribe(existingAffixId: string?): (boolean, string?)
	if existingAffixId ~= nil then
		return false, "이미 수식어가 새겨져 있습니다. 수식어는 겹칠 수 없습니다."
	end
	return true, nil
end

--[[
	룬이 실제로 붙일 수식어를 정한다.
	  Fixed  → 룬에 새겨진 그 수식어
	  Random → 전체 수식어 중 하나를 무작위로
]]
function RuneDefinitions.ResolveAffix(rune: Rune, seed: number): Affix?
	if rune.Kind == "Fixed" then
		return if rune.AffixId then RuneDefinitions.GetAffix(rune.AffixId) else nil
	end

	local random = Random.new(seed)
	return affixes[random:NextInteger(1, #affixes)]
end

--[[
	대장간에서 룬을 새긴다.

	반환: 성공 여부, 붙은 수식어, 실패 사유
	성공하면 호출부는 룬 아이템을 '돌덩이'로 바꿔야 한다(사양).
]]
function RuneDefinitions.Inscribe(existingAffixId: string?, rune: Rune, seed: number): (boolean, Affix?, string?)
	local allowed, reason = RuneDefinitions.CanInscribe(existingAffixId)
	if not allowed then
		return false, nil, reason
	end

	local affix = RuneDefinitions.ResolveAffix(rune, seed)
	if not affix then
		return false, nil, "룬에서 수식어를 읽을 수 없습니다."
	end

	return true, affix, nil
end

return RuneDefinitions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">StatDefinitions</string>
          <string name="Source"><![CDATA[--!strict
--[[
	StatDefinitions — 육성 시스템의 스탯 6종과 그 파생 수치.

	사양 출처: 추가&수정.md `## 육성 시스템 > ### 스탯`

	스탯은 두 종류로 나뉜다.
	  메인 스탯 : 레벨업 포인트로 직접 올린 값. **아이템 착용 제한 판정에 쓰인다.**
	  서브 스탯 : 아이템·버프로 얻은 값. 능력치에는 반영되지만 **착용 제한에는 쓰이지 않는다.**

	표기 규칙(사양): [메인(+서브) = 최종]   예) [근력: 49(+23) = 72]
	→ StatDefinitions.Format 참고.
]]

export type StatId = "Strength" | "Intellect" | "Agility" | "Vitality" | "Luck" | "Faith"

-- 메인/서브를 분리해 담는 스탯 블록.
export type StatBlock = {
	Main: { [StatId]: number },
	Sub: { [StatId]: number },
}

export type StatDefinition = {
	Id: StatId,
	Name: string,
	Description: string,
}

-- 스탯 1점당 증가치. 전부 사양 표의 숫자를 그대로 옮긴 것이다.
-- 비율 값은 소수(0.05 = 5%)로 저장한다.
local PER_POINT = {
	Strength = {
		PhysicalDamage = 0.05, -- 물리 대미지 +5%
		MaxHealth = 1, -- 체력 +1
	},
	Intellect = {
		RangedDamage = 0.07, -- 원거리 대미지 +7%
		DropRate = 0.02, -- 드랍률 +2%
	},
	Agility = {
		PhysicalDamage = 0.03, -- 물리 대미지 +3%
		ParryWindow = 0.03, -- 패리 타이밍 +3%
		DodgeWindow = 0.03, -- 회피 타이밍 +3%
		MoveSpeed = 0.01, -- 이동속도 (사양에 수치 없음 → 1%로 잠정)
		BuffTaken = 0.03, -- 받는 버프 효율 +3%
	},
	Vitality = {
		MaxHealth = 4, -- 체력 +4
		ParryWindow = 0.01, -- 패리 타이밍 +1%
		HealTaken = 0.01, -- 받는 회복량 +1%
	},
	Luck = {
		CritChance = 0.007, -- 치명타 확률 +0.7%
		CritDamage = 0.012, -- 치명타 대미지 +1.2%
		DropRate = 0.04, -- 드랍률 +4%
		AutoDodge = 0.0005, -- 자동 회피 확률 +0.05%
	},
	Faith = {
		PrayerDamage = 0.08, -- 기도 대미지 +8%
		PrayerPenalty = -0.005, -- 기도 패널티 -0.5%
		DropRate = 0.02, -- 드랍률 +2%
		HealGiven = 0.01, -- 주는 회복량 +1%
		HealTaken = 0.002, -- 받는 회복량 +0.2%
		BuffGiven = 0.03, -- 주는 버프 효율 +3%
		BuffTaken = 0.01, -- 받는 버프 효율 +1%
	},
}

local definitions: { StatDefinition } = {
	{
		Id = "Strength",
		Name = "힘",
		Description = "물리 대미지 5%, 체력 1",
	},
	{
		Id = "Intellect",
		Name = "지력",
		Description = "원거리 대미지 7%, 드랍률 2%",
	},
	{
		Id = "Agility",
		Name = "민첩",
		Description = "물리 대미지 3%, 패리·회피 타이밍 3%, 이동속도, 받는 버프 효율 3%",
	},
	{
		Id = "Vitality",
		Name = "체력",
		Description = "체력 4, 패리 타이밍 1%, 받는 회복량 1%",
	},
	{
		Id = "Luck",
		Name = "운",
		Description = "치명타 확률 0.7%, 치명타 대미지 1.2%, 드랍률 4%, 자동 회피 0.05%",
	},
	{
		Id = "Faith",
		Name = "신앙심",
		Description = "기도 대미지 8%, 기도 패널티 -0.5%, 드랍률 2%, 회복·버프 효율",
	},
}

local ORDER: { StatId } = { "Strength", "Intellect", "Agility", "Vitality", "Luck", "Faith" }

local StatDefinitions = {}

StatDefinitions.Order = ORDER
StatDefinitions.PerPoint = PER_POINT

-- 레벨업으로 얻는 스탯 포인트: 1레벨당 3개 (사양)
StatDefinitions.POINTS_PER_LEVEL = 3

function StatDefinitions.All(): { StatDefinition }
	return definitions
end

function StatDefinitions.Get(id: StatId): StatDefinition?
	for _, definition in definitions do
		if definition.Id == id then
			return definition
		end
	end
	return nil
end

-- 빈 스탯 블록을 만든다.
function StatDefinitions.NewBlock(): StatBlock
	local main: { [StatId]: number } = {}
	local sub: { [StatId]: number } = {}
	for _, id in ORDER do
		main[id] = 0
		sub[id] = 0
	end
	return { Main = main, Sub = sub }
end

-- 착용 제한 판정용. **메인 스탯만** 본다(사양: 서브스탯은 제한에 영향 없음).
function StatDefinitions.MainValue(block: StatBlock, id: StatId): number
	return block.Main[id] or 0
end

-- 실제 능력치 계산용. 메인 + 서브.
function StatDefinitions.TotalValue(block: StatBlock, id: StatId): number
	return (block.Main[id] or 0) + (block.Sub[id] or 0)
end

--[[
	사양 표기 규칙대로 문자열을 만든다.
	  [근력: 49(+23) = 72]
	서브가 0이면 괄호를 생략한다.
]]
function StatDefinitions.Format(block: StatBlock, id: StatId): string
	local definition = StatDefinitions.Get(id)
	local name = definition and definition.Name or id
	local main = block.Main[id] or 0
	local sub = block.Sub[id] or 0

	if sub == 0 then
		return string.format("[%s: %d]", name, main)
	end
	return string.format("[%s: %d(+%d) = %d]", name, main, sub, main + sub)
end

--[[
	스탯 블록에서 파생 수치를 모두 계산한다.
	반환값의 비율 항목은 "증가분"이다. (0.35 = +35%)
]]
function StatDefinitions.Derive(block: StatBlock): { [string]: number }
	local derived: { [string]: number } = {}

	for _, id in ORDER do
		local points = StatDefinitions.TotalValue(block, id)
		if points ~= 0 then
			for key, perPoint in PER_POINT[id] do
				derived[key] = (derived[key] or 0) + perPoint * points
			end
		end
	end

	return derived
end

return StatDefinitions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">TowerArena</string>
          <string name="Source"><![CDATA[--!strict
--[[
	TowerArena — 탑 등반 전용 **등반실**의 자리 계산.

	요청
	  "탑 등반 할 땐 따로 등반 장소로 가서 등반 해야 해."
	  "멀티 플레이 할 때 겹침 현상 없애야 하니까 이것도 신경 써서 해줘."

	--------------------------------------------------------------------------
	겹침이 왜 생겼나

	예전에는 클라이언트가 **자기 캐릭터가 서 있던 자리**에 격자를 깔았다
	(`origin + (0, 0, -30)`). 격자 타일과 적 더미는 클라이언트가 만든 것이라
	자기 화면에만 보이지만, **캐릭터는 서버에 복제된다**.

	그래서 두 사람이 광장에서 나란히 서 있다가 동시에 등반을 시작하면
	  - 두 사람의 격자가 같은 공간에 겹치고
	  - 서로의 캐릭터가 남의 전장 한복판에 서 있게 되고
	  - 최악의 경우 같은 칸을 두 사람이 차지한다.

	--------------------------------------------------------------------------
	해결: 1인 1등반실

	하늘 높은 곳에 등반실을 SLOT_COUNT개 나란히 지어 두고, 등반을 시작한 사람에게
	**서버가 빈 방 하나를 배정한다.** 방과 방 사이는 격자 전체 폭보다 훨씬 넓어
	남의 방이 내 화면에 걸치지 않는다.

	      [1]      [2]      [3]   ...      ← SLOT_SPACING 간격
	     ┌───┐    ┌───┐    ┌───┐
	     │격자│    │격자│    │격자│           격자 가로폭 ARENA_ACROSS
	     └───┘    └───┘    └───┘

	이 모듈은 **순수 계산만** 한다(Lune에서 그대로 돌아간다). 방을 실제로 짓는 것은
	`TowerService`, 그 자리에 격자를 그리는 것은 `TowerBattleController`다.
	`BattleGrid`(논리) ↔ `BattleArena`(월드 좌표)를 나눈 것과 같은 이유다.
]]

local TowerArena = {}

--[[
	등반실을 하늘에 두는 이유.

	지상에는 이미 지형과 마을이 깔려 있어 빈 땅을 12칸이나 찾기 어렵고, 찾더라도
	나중에 그 자리에 무언가를 지으면 조용히 겹친다. 아무것도 없는 높이를 쓰면
	그런 충돌이 원천적으로 없다.
]]
TowerArena.ZONE_Y = 1400

-- 등반실이 늘어서는 줄의 중심 (X/Z). 월드 원점의 고대 대탑 바로 위다.
TowerArena.ZONE_CENTER_X = 0
TowerArena.ZONE_CENTER_Z = 0

--[[
	방 개수. 한 서버에서 동시에 등반할 수 있는 인원이다.

	방이 다 차면 등반을 거절한다 — 자리 없이 입장시키면 결국 누군가와 겹치므로,
	"겹침 없음"을 지키려면 여기서 막는 편이 맞다.
]]
TowerArena.SLOT_COUNT = 12

--[[
	방 간격.

	격자 가로폭은 `BattleArena.ArenaExtents`로 계산하면
	  Midline(8) + Width(6) * (CellSize(5) + Gap(1)) * 2 = 80
	이다. 240이면 방 사이에 160스터드가 비어, 카메라를 옆으로 돌려도 옆방이
	화면에 들어오지 않는다.
]]
TowerArena.SLOT_SPACING = 240

-- 바닥 판 크기. 격자(80 × 18)를 넉넉히 덮는다.
TowerArena.FLOOR_LENGTH = 150 -- X (양 진영 축)
TowerArena.FLOOR_WIDTH = 80 -- Z (세로 라인 축)
TowerArena.FLOOR_THICKNESS = 3

export type Point = { X: number, Y: number, Z: number }

--[[
	방 하나의 중심 좌표. index는 1..SLOT_COUNT.

	줄 전체가 ZONE_CENTER를 기준으로 좌우 대칭이 되도록 가운데 정렬한다.
]]
function TowerArena.SlotOrigin(index: number): Point
	local clamped = math.clamp(math.floor(index), 1, TowerArena.SLOT_COUNT)
	local offset = (clamped - (TowerArena.SLOT_COUNT + 1) / 2) * TowerArena.SLOT_SPACING
	return {
		X = TowerArena.ZONE_CENTER_X + offset,
		Y = TowerArena.ZONE_Y,
		Z = TowerArena.ZONE_CENTER_Z,
	}
end

--[[
	전투가 없을 때(보상 화면 등) 서 있을 자리.

	격자 한복판에 두면 카드 화면 뒤로 캐릭터가 어중간하게 걸치므로, 아군 진영
	바깥쪽으로 조금 물려 둔다.
]]
function TowerArena.SlotStand(index: number): Point
	local origin = TowerArena.SlotOrigin(index)
	return {
		X = origin.X - TowerArena.FLOOR_LENGTH / 2 + 12,
		Y = origin.Y,
		Z = origin.Z,
	}
end

--[[
	두 방이 실제로 떨어져 있는지 확인하는 계산.

	테스트에서 "간격이 격자 폭보다 넓은가"를 검사하는 데 쓴다. 나중에 격자를
	키우면서 SLOT_SPACING을 잊고 그대로 두면 여기서 걸린다.
]]
function TowerArena.SlotGap(): number
	return TowerArena.SLOT_SPACING - TowerArena.FLOOR_LENGTH
end

return TowerArena
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">TowerDefinitions</string>
          <string name="Source"><![CDATA[--!strict

export type FloorDefinition = {
	Floor: number,
	Name: string,
	Kind: "Normal" | "Elite" | "Boss",
	Enemies: { string },
	HealthScale: number,
	PowerScale: number,
	Gimmick: string,
	GimmickName: string,
	GimmickDescription: string,
}

local normalPools = {
	{ "ClayScout", "ClayScout" },
	{ "ClayScout", "ClayGuard", "KilnMage" },
	{ "ShardHound", "ClayScout", "KilnMage" },
	{ "GlazePriest", "ClayGuard", "ShardHound" },
	{ "CrackedKnight", "KilnMage", "GlazePriest" },
}

local gimmicks = {
	{ Id = "None", Name = "고요한 층", Description = "추가 규칙이 없습니다." },
	{
		Id = "EnemyShield",
		Name = "두꺼운 유약",
		Description = "적이 층 수에 비례한 보호막을 얻습니다.",
	},
	{
		Id = "OpeningBurn",
		Name = "과열 가마",
		Description = "전투 시작 시 파티에 약한 화상이 부여됩니다.",
	},
	{ Id = "EnemyPower", Name = "불안정 소성", Description = "적 공격력이 추가로 15% 증가합니다." },
	{
		Id = "PlayerShield",
		Name = "보호 코팅",
		Description = "파티가 전투 시작 시 보호막을 얻습니다.",
	},
	{ Id = "SkillHaste", Name = "빠른 회전판", Description = "파티 기술 쿨타임이 1턴 감소합니다." },
}

local floors: { FloorDefinition } = {}
for floor = 1, 30 do
	local boss = floor % 10 == 0
	local elite = not boss and floor % 5 == 0
	local enemies
	if floor == 30 then
		enemies = { "PorcelainDragon" }
	elseif floor == 20 then
		enemies = { "GlazeColossus" }
	elseif floor == 10 then
		enemies = { "KilnWarden" }
	elseif elite then
		enemies = { "CrackedKnight", floor >= 15 and "GlazePriest" or "ClayGuard" }
	else
		enemies = table.clone(normalPools[math.min(#normalPools, math.floor((floor - 1) / 6) + 1)])
	end
	local gimmick = gimmicks[(floor - 1) % #gimmicks + 1]
	table.insert(floors, {
		Floor = floor,
		Name = floor == 30 and "백자룡의 정상"
			or (boss and "수호자의 방" or (elite and "정예 공방" or "소성 계단")),
		Kind = boss and "Boss" or (elite and "Elite" or "Normal"),
		Enemies = enemies,
		HealthScale = 1 + (floor - 1) * 0.055 + (elite and 0.12 or 0),
		PowerScale = 1 + (floor - 1) * 0.032 + (boss and 0.12 or 0),
		Gimmick = gimmick.Id,
		GimmickName = gimmick.Name,
		GimmickDescription = gimmick.Description,
	})
end

local TowerDefinitions = {}

function TowerDefinitions.Get(floor: number): FloorDefinition
	return floors[math.clamp(math.floor(floor), 1, #floors)]
end

function TowerDefinitions.All(): { FloorDefinition }
	return table.clone(floors)
end

function TowerDefinitions.Count(): number
	return #floors
end

return TowerDefinitions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">TowerRewardDefinitions</string>
          <string name="Source"><![CDATA[--!strict
--[[
	TowerRewardDefinitions — 탑 층별 보상의 코스트와 리롤 규칙.

	사양 출처: 추가&수정.md `##### 층별 보상`, `#### 탑 시스템`

	코스트
	  층 클리어마다 30개 획득.
	리롤
	  횟수 제한 없음. 첫 리롤 10코스트, 이후 **50%씩 증가**한다.
	    10 → 15 → 22.5 → 33.75 …
	  실제 차감은 반올림한 값을 쓴다.
	  **층을 이동하면 가격이 초기화**된다.

	탑 진입 제약(사양 `#### 탑 시스템`)
	  - 솔로 플레이 전용. 원정대 시스템은 폐기.
	  - 레벨업은 오직 탑에서만 가능.
	  - 무기: 직업에 맞는 기본 무기가 자동 장착.
	  - 방어구: 전부 벗음.
	  - 스탯: 직업 베이스 스탯만 남기고 초기화.
	  - 직업 선택 / 모션 / 종족을 뺀 나머지 외부 요소는 전부 제한.
	  - 나가거나 클리어하면 아이템은 돌려받고, 스탯은 완주 시점에 반영.
]]

local COST_PER_FLOOR = 30
local REROLL_BASE_COST = 10
local REROLL_GROWTH = 1.5

local MAX_FLOOR = 30

-- 무료 프리셋 수와 추가 구매가(로벅스)
local FREE_PRESETS = 3
local EXTRA_PRESET_ROBUX = 100

local TowerRewardDefinitions = {}

TowerRewardDefinitions.COST_PER_FLOOR = COST_PER_FLOOR
TowerRewardDefinitions.REROLL_BASE_COST = REROLL_BASE_COST
TowerRewardDefinitions.REROLL_GROWTH = REROLL_GROWTH
TowerRewardDefinitions.MAX_FLOOR = MAX_FLOOR
TowerRewardDefinitions.FREE_PRESETS = FREE_PRESETS
TowerRewardDefinitions.EXTRA_PRESET_ROBUX = EXTRA_PRESET_ROBUX

--[[
	rerollCount번 리롤한 뒤, 다음 리롤의 **원가**(반올림 전).
	  0회 → 10
	  1회 → 15
	  2회 → 22.5
	  3회 → 33.75
]]
function TowerRewardDefinitions.RawRerollCost(rerollCount: number): number
	return REROLL_BASE_COST * REROLL_GROWTH ^ math.max(rerollCount, 0)
end

-- 실제로 차감할 리롤 비용 (반올림).
function TowerRewardDefinitions.RerollCost(rerollCount: number): number
	return math.round(TowerRewardDefinitions.RawRerollCost(rerollCount))
end

function TowerRewardDefinitions.CanReroll(cost: number, rerollCount: number): boolean
	return cost >= TowerRewardDefinitions.RerollCost(rerollCount)
end

--[[
	층 이동 시 리롤 카운터를 초기화한다(사양).
	층 진입 처리에서 이 값을 그대로 대입하면 된다.
]]
function TowerRewardDefinitions.ResetRerollCount(): number
	return 0
end

-- 프리셋 슬롯을 하나 더 살 때 드는 로벅스. 무료분 안이면 0.
function TowerRewardDefinitions.PresetSlotPrice(ownedSlots: number): number
	if ownedSlots < FREE_PRESETS then
		return 0
	end
	return EXTRA_PRESET_ROBUX
end

function TowerRewardDefinitions.IsFinalFloor(floor: number): boolean
	return floor >= MAX_FLOOR
end

return TowerRewardDefinitions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">TowerRun</string>
          <string name="Source"><![CDATA[--!strict
--[[
	TowerRun — 탑 등반의 **생명주기**.

	사양 출처: 추가&수정.md `#### 탑 시스템`, `##### 프리셋`, `##### 층별 보상`

	이미 있던 조각들
	  TowerDefinitions        30개 층의 적·배율·기믹
	  TowerRewardDefinitions  코스트 30/층, 리롤 10→15→23…, 프리셋 슬롯 값
	  AbilityCardDefinitions  카드 풀과 뽑기 규칙
	  CardDraft               뽑기 → 리롤 → 획득 흐름
	  PlayerProfile.TowerRun  등반 중 상태 그릇

	빠져 있던 것이 **그 조각들을 순서대로 굴리는 층**이라 여기서 맡는다.

	  입장  Start()      제약을 걸고 등반 상태를 연다
	  진행  ClearFloor() 층을 하나 올리고 보상을 제시한다
	  선택  Reroll() / Acquire()
	  종료  Exit() / Complete()

	전투에 의존하지 않는 **순수 로직**이다. 실제 전투 결과(이겼는가)는 호출하는 쪽이
	판단하고, 여기서는 "층을 클리어했다"는 사실만 받아 상태를 굴린다. 덕분에
	Studio 없이 PrototypeTests로 전부 검증된다.
]]

local AbilityCardDefinitions = require(script.Parent.AbilityCardDefinitions)
local CardDraft = require(script.Parent.CardDraft)
local CharacterDefinitions = require(script.Parent.CharacterDefinitions)
local PlayerProfile = require(script.Parent.PlayerProfile)
local StatDefinitions = require(script.Parent.StatDefinitions)
local TowerDefinitions = require(script.Parent.TowerDefinitions)
local TowerRewardDefinitions = require(script.Parent.TowerRewardDefinitions)

export type RunSummary = {
	ReturnedItems: number,
	GainedLevels: number,
	Floor: number,
	Completed: boolean,
}

local TowerRun = {}

--[[
	직업에 맞는 기본 무기.

	사양: "무기 — 선택한 직업에 맞는 기본 무기를 자동으로 장착하게 됨."
	직업 정의의 BasicPower를 그대로 공격력으로 쓴다. 요구 스탯 0·Common 등급이라
	초기화된 베이스 스탯으로도 반드시 들 수 있다(들지 못하면 입장 자체가 막힌다).
]]
function TowerRun.BasicWeaponFor(classId: string): PlayerProfile.OwnedItem
	local class = CharacterDefinitions.Get(classId)
	return {
		Id = string.format("TowerBasic_%s", class.Id),
		Name = string.format("%s 기본 무기", class.Name),
		Rarity = "Common" :: any,
		PrimaryStat = "Strength" :: any,
		StatRequirement = 0,
		BaseDamage = class.BasicPower,
		StatBonus = nil,
		Affix = nil,
	}
end

--[[
	등반을 시작한다.

	사양의 입장 제약을 여기서 한 번에 건다.
	  방어구 "모두 벗음"      → 슬롯의 장비를 통째로 StoredItems로 옮긴다
	  무기 자동 장착          → 직업 기본 무기만 남긴다
	  스탯 "베이스만, 초기화" → 스탯 블록과 미사용 포인트를 비우고 레벨 1로
	  레벨업은 탑에서만       → 등반 중 오른 레벨은 PendingLevel에만 쌓인다

	되돌리기 위한 값(장비)은 전부 run에 보관하므로, 도중에 나가도 잃지 않는다.
]]
function TowerRun.Start(profile: PlayerProfile.Profile): (boolean, string?)
	if profile.TowerRun and profile.TowerRun.Active then
		return false, "이미 등반 중입니다."
	end

	local slot = PlayerProfile.ActiveSlot(profile)
	if not CharacterDefinitions.IsValid(slot.ClassId) then
		return false, "직업이 올바르지 않습니다."
	end

	local run = PlayerProfile.NewTowerRun()
	run.Active = true
	run.Floor = 0

	-- 장비를 통째로 맡아 둔다. 나가거나 클리어하면 CardDraft.FinishRun이 돌려준다.
	for _, item in slot.Items do
		table.insert(run.StoredItems, item)
	end

	slot.Items = { TowerRun.BasicWeaponFor(slot.ClassId) }
	slot.Stats = StatDefinitions.NewBlock()
	slot.UnspentPoints = 0
	slot.Level = 1

	profile.TowerRun = run
	return true, nil
end

-- 지금 도전 중인(=다음에 오를) 층. 시작 직후면 1층.
function TowerRun.NextFloor(run: PlayerProfile.TowerRun): number
	return math.min(run.Floor + 1, TowerRewardDefinitions.MAX_FLOOR)
end

-- 다음 층의 구성(적·배율·기믹). 전투를 붙일 때 이 값을 쓴다.
function TowerRun.NextFloorDefinition(run: PlayerProfile.TowerRun): TowerDefinitions.FloorDefinition
	return TowerDefinitions.Get(TowerRun.NextFloor(run))
end

--[[
	층을 하나 클리어했다. 보상 화면으로 넘어간다.

	실제로 이겼는지는 호출하는 쪽(전투)이 판단한다. 여기서는 상태만 굴린다.
	  - 코스트 +30, 리롤 가격 초기화, 레벨 적립 → CardDraft.BeginFloor
	  - 이번 층 카드 획득 수를 0으로 되돌린다
]]
function TowerRun.ClearFloor(profile: PlayerProfile.Profile, seed: number): CardDraft.DraftResult
	local run = profile.TowerRun
	if not run or not run.Active then
		return {
			Ok = false,
			Reason = "등반 중이 아닙니다.",
			Cards = {},
			Cost = 0,
			NextRerollCost = TowerRewardDefinitions.RerollCost(0),
		}
	end

	local slot = PlayerProfile.ActiveSlot(profile)
	run.AcquiredThisFloor = 0
	return CardDraft.BeginFloor(run, slot.ClassId, TowerRun.NextFloor(run), seed)
end

-- 보상을 다시 뽑는다. 가격과 코스트 판정은 CardDraft가 맡는다.
function TowerRun.Reroll(profile: PlayerProfile.Profile, seed: number): CardDraft.DraftResult
	local run = profile.TowerRun
	if not run or not run.Active then
		return {
			Ok = false,
			Reason = "등반 중이 아닙니다.",
			Cards = {},
			Cost = 0,
			NextRerollCost = TowerRewardDefinitions.RerollCost(0),
		}
	end
	local slot = PlayerProfile.ActiveSlot(profile)
	return CardDraft.Reroll(run, slot.ClassId, seed)
end

--[[
	고른 카드를 얻는다(= 이미 있으면 강화).

	층당 몇 장까지인지는 AcquireSlotsForFloor가 정하고, 몇 장 썼는지는
	run.AcquiredThisFloor가 센다. 성공했을 때만 카운터를 올린다.
]]
function TowerRun.Acquire(profile: PlayerProfile.Profile, card: AbilityCardDefinitions.AbilityCard): (boolean, string?)
	local run = profile.TowerRun
	if not run or not run.Active then
		return false, "등반 중이 아닙니다."
	end

	local ok, reason = CardDraft.Acquire(run, card, run.AcquiredThisFloor)
	if ok then
		run.AcquiredThisFloor += 1
	end
	return ok, reason
end

-- 이번 층에 아직 더 고를 수 있는지.
function TowerRun.RemainingPicks(run: PlayerProfile.TowerRun): number
	local slots = AbilityCardDefinitions.AcquireSlotsForFloor(run.Floor)
	return math.max(slots - run.AcquiredThisFloor, 0)
end

-- 마지막 층까지 올랐는지(사양: 30층).
function TowerRun.IsCleared(run: PlayerProfile.TowerRun): boolean
	return TowerRewardDefinitions.IsFinalFloor(run.Floor)
end

--[[
	등반을 끝낸다.

	사양: "도중에 탑에서 나가거나, 탑을 클리어할 경우 아이템은 모두 돌려받지만,
	       스탯은 탑을 모두 오른 시점에 변한다."
	→ completed 여부와 무관하게 장비는 돌려주고, 레벨은 완주했을 때만 확정한다.
	   그 분기는 CardDraft.FinishRun이 이미 담고 있으므로 그대로 위임한다.
]]
function TowerRun.Finish(profile: PlayerProfile.Profile, completed: boolean): RunSummary
	local run = profile.TowerRun
	local floor = if run then run.Floor else 0
	local returned, gained = CardDraft.FinishRun(profile, completed)
	return {
		ReturnedItems = returned,
		GainedLevels = gained,
		Floor = floor,
		Completed = completed,
	}
end

-- 도중 이탈. 장비만 돌려받고 레벨은 날아간다(사양).
function TowerRun.Exit(profile: PlayerProfile.Profile): RunSummary
	return TowerRun.Finish(profile, false)
end

--[[
	완주. 30층을 오른 시점에만 부른다.
	아직 정상이 아니면 실패로 돌려주고 상태를 건드리지 않는다.
]]
function TowerRun.Complete(profile: PlayerProfile.Profile): (boolean, RunSummary?)
	local run = profile.TowerRun
	if not run or not run.Active then
		return false, nil
	end
	if not TowerRun.IsCleared(run) then
		return false, nil
	end
	return true, TowerRun.Finish(profile, true)
end

return TowerRun
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">UpgradeDefinitions</string>
          <string name="Source"><![CDATA[--!strict

export type UpgradeDefinition = {
	Id: string,
	Name: string,
	Description: string,
	Kind: "Basic" | "Skill" | "Vitality" | "Haste" | "Shield" | "Heal" | "Cleanse" | "Buff",
	Amount: number,
}

local upgrades: { UpgradeDefinition } = {
	{
		Id = "TemperedEdge",
		Name = "담금질",
		Description = "파티의 기본 공격력이 5 증가합니다.",
		Kind = "Basic",
		Amount = 5,
	},
	{
		Id = "FocusedGlaze",
		Name = "집중 유약",
		Description = "파티의 고유 기술 위력이 8 증가합니다.",
		Kind = "Skill",
		Amount = 8,
	},
	{
		Id = "ThickClay",
		Name = "두꺼운 점토",
		Description = "파티의 최대 체력과 현재 체력이 22 증가합니다.",
		Kind = "Vitality",
		Amount = 22,
	},
	{
		Id = "QuickFiring",
		Name = "급속 소성",
		Description = "고유 기술의 재사용 대기시간이 1턴 감소합니다.",
		Kind = "Haste",
		Amount = 1,
	},
	{
		Id = "ProtectiveCoat",
		Name = "보호 코팅",
		Description = "파티 전원이 보호막 18을 얻습니다.",
		Kind = "Shield",
		Amount = 18,
	},
	{
		Id = "RestorationGlaze",
		Name = "복원 유약",
		Description = "파티 전원의 체력을 최대 체력의 35%만큼 회복합니다.",
		Kind = "Heal",
		Amount = 35,
	},
	{
		Id = "PurifyingFlame",
		Name = "정화 소성",
		Description = "파티의 상태이상과 기절을 모두 제거합니다.",
		Kind = "Cleanse",
		Amount = 0,
	},
	{
		Id = "WarGlaze",
		Name = "전투 유약",
		Description = "다음 3번의 행동 동안 모든 대미지가 20% 증가합니다.",
		Kind = "Buff",
		Amount = 20,
	},
}

local UpgradeDefinitions = {}

function UpgradeDefinitions.Get(id: string): UpgradeDefinition?
	for _, upgrade in upgrades do
		if upgrade.Id == id then
			return upgrade
		end
	end
	return nil
end

function UpgradeDefinitions.PickThree(seed: number): { UpgradeDefinition }
	local pool = table.clone(upgrades)
	local random = Random.new(seed)
	for index = #pool, 2, -1 do
		local swap = random:NextInteger(1, index)
		pool[index], pool[swap] = pool[swap], pool[index]
	end
	return { pool[1], pool[2], pool[3] }
end

return UpgradeDefinitions
]]></string>
        </Properties>
      </Item>
