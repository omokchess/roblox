		Grade = "Common",
		ClassId = CLASS_ID,
		Tags = { "Riposte", "Execute" },
	},
	{
		Id = "Duelist_C_Bond",
		Name = "결속",
		Description = "자신이 얻는 패링 범위 증가의 {10}%를 인접한 아군 또한 받는다.",
		Grade = "Common",
		ClassId = CLASS_ID,
		Tags = { "Guard", "Riposte" },
	},
	{
		Id = "Duelist_C_BleedInduce",
		Name = "출혈 유도",
		Description = "자신이 부여하는 출혈의 지속 시간이 {1}턴 증가한다.",
		Grade = "Common",
		ClassId = CLASS_ID,
		Tags = { "Execute" },
	},
	{
		Id = "Duelist_C_Steady",
		Name = "안정",
		Description = "준비 자세(3스킬) 중 받는 피해량이 {8}% 더 감소한다.",
		Grade = "Common",
		ClassId = CLASS_ID,
		Tags = { "Guard", "Precision" },
	},
	{
		Id = "Duelist_C_BladeTip",
		Name = "칼끝",
		Description = "[집중] {1}스택당 치명타 확률이 {0.5}% 증가한다.",
		Grade = "Common",
		ClassId = CLASS_ID,
		Tags = { "Precision" },
	},
	{
		Id = "Duelist_C_StepBack",
		Name = "흐름",
		Description = "패링에 성공하면, 패링 범위가 {2.5}% 증가한다.",
		Grade = "Common",
		ClassId = CLASS_ID,
		Tags = { "Riposte" },
	},
	{
		Id = "Duelist_C_GripWrap",
		Name = "칼자루 감기",
		Description = "자동 패링이 발동되면, 대상에게 {1}턴 의 출혈을 부여한다.",
		Grade = "Common",
		ClassId = CLASS_ID,
		Tags = { "Guard", "Precision" },
	},
}

return {
	ClassId = CLASS_ID,
	Cards = cards,
}
]]></string>
