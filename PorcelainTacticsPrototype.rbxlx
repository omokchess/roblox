      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">AfterlifeDefinitions</string>
          <string name="Source"><![CDATA[--!strict
--[[
	AfterlifeDefinitions — 사망 처리와 사후 차원 분기.

	사양 출처: 추가&수정.md `## 사망 처리`, 세계관.md 38~64줄

	사망 시
	  아이템·골드·레벨은 **잃지 않는다.** 대신 살아있을 때의 행동에 따라
	  네 차원 중 한 곳으로 이동한다.

	분기 조건 (세계관.md)
	  천계(Heaven)            선행 100 이상
	  마계(Hell)              악행 100 이상
	  신계(The Astral Nexus)  선행·악행 **둘 다** 100 이상
	  영계(Spirit World)      둘 다 100 미만

	→ 둘 다 100을 넘으면 신계가 우선한다.
]]

export type Realm = "Heaven" | "Hell" | "AstralNexus" | "SpiritWorld"

export type RealmDefinition = {
	Id: Realm,
	Name: string,
	EnglishName: string,
	Description: string,
	-- 이 차원에서 부활할 때 일어나는 일
	ReviveEffect: string,
}

local THRESHOLD = 100

local realms: { RealmDefinition } = {
	{
		Id = "Heaven",
		Name = "천계",
		EnglishName = "Heaven",
		Description = "구름 위, 파괴된 로마 건축물이 흩뿌려진 단일 바이옴. 신은 없고 고위급 천사가 있다.",
		ReviveEffect = "고위급 천사가 플레이어를 부활시킨다.",
	},
	{
		Id = "Hell",
		Name = "마계",
		EnglishName = "Hell",
		Description = "용암 위 거대한 바위 형상. 7죄종을 관장하는 악마들이 있다.",
		ReviveEffect = "선택한 악마의 특성에 맞는 특전과, 초기화 전까지 지속되는 영구 디버프를 얻고 부활한다.",
	},
	{
		Id = "AstralNexus",
		Name = "신계",
		EnglishName = "The Astral Nexus",
		Description = "신 먹는 자(God Eater)가 침입해 있는 곳.",
		ReviveEffect = "신 먹는 자와 상호작용 시 종족을 한 번 바꾸고, 모든 아이템과 스탯을 유지한 채 부활한다.",
	},
	{
		Id = "SpiritWorld",
		Name = "영계",
		EnglishName = "Spirit World",
		Description = "먹히고 싶지 않은 신들이 도망쳐 온 곳. 대부분 겁에 질려 있다.",
		ReviveEffect = "신들 중 아무에게나 말을 걸면 죽어도 초기화되지 않는 퀘스트를 얻고 부활한다.",
	},
}

local AfterlifeDefinitions = {}

AfterlifeDefinitions.THRESHOLD = THRESHOLD

function AfterlifeDefinitions.All(): { RealmDefinition }
	return realms
end

function AfterlifeDefinitions.Get(id: Realm): RealmDefinition?
	for _, realm in realms do
		if realm.Id == id then
			return realm
		end
	end
	return nil
end

--[[
	선행/악행 수치로 갈 차원을 정한다.
	둘 다 임계값을 넘으면 신계가 우선한다.
]]
function AfterlifeDefinitions.ResolveRealm(goodDeeds: number, evilDeeds: number): Realm
	local good = goodDeeds >= THRESHOLD
	local evil = evilDeeds >= THRESHOLD

	if good and evil then
		return "AstralNexus"
	elseif good then
		return "Heaven"
	elseif evil then
		return "Hell"
	end
	return "SpiritWorld"
end

--[[
	사망 시 보존되는 것들(사양: 아이템·골드·레벨 유지).
	사망 처리 로직이 이 규칙을 참조하도록 명시해 둔다.
]]
AfterlifeDefinitions.PRESERVED_ON_DEATH = table.freeze({
	Items = true,
	Gold = true,
	Level = true,
	Honor = true, -- 명예는 계정 귀속이라 부활해도 유지된다
})

return AfterlifeDefinitions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">BattleArena</string>
          <string name="Source"><![CDATA[--!strict
--[[
	BattleArena — 6×3 격자를 **3D 월드 좌표**로 바꾸는 계산.

	요청: "이제 UI가 아니라 캐릭터가 직접 적이랑 싸우도록 3D에서 구현하면 돼."

	`BattleGrid`는 순수 논리(어느 칸에 누가 있는가)만 다룬다.
	여기서는 그 칸이 월드 어디인지를 정한다. 둘을 나눠 두면
	격자 규칙을 바꾸지 않고 배치 위치만 옮길 수 있다.

	배치
	  아군 진영과 적 진영이 서로 마주 본다.
	  전투 중심(origin)에서 아군은 -Z, 적은 +Z 쪽에 놓인다.

	      적진영   [1,1][2,1]...[6,1]     ← +Z (멀리)
	               [1,2]      ...
	               [1,3]      ...
	      ───────────  중앙선  ───────────
	      아군진영 [1,3]      ...
	               [1,2]      ...
	               [1,1][2,1]...[6,1]     ← -Z (가까이)

	  X는 양 진영 공통으로 좌→우가 1→6이다.
	  Y(세로 3칸)는 진영에서 멀어지는 방향으로 1→3.

	  전투는 지형 위에서 벌어지므로 각 칸의 높이는 레이캐스트로 지면을 찾아 맞춘다.
]]

local BattleGrid = require(script.Parent.BattleGrid)

export type Layout = {
	Origin: CFrame,
	CellSize: number,
	Gap: number,
	-- 양 진영 사이 간격
	Midline: number,
}

local BattleArena = {}

-- 칸은 캐릭터 한 명이 서는 크기다. R6 아바타가 폭 4·높이 5 정도라 그에 맞춘다.
-- (처음엔 14로 잡았더니 칸이 캐릭터보다 훨씬 커서 격자가 한 화면에 안 들어왔다)
BattleArena.DEFAULT_CELL_SIZE = 5
BattleArena.DEFAULT_GAP = 1
BattleArena.DEFAULT_MIDLINE = 8

function BattleArena.NewLayout(origin: CFrame): Layout
	return {
		Origin = origin,
		CellSize = BattleArena.DEFAULT_CELL_SIZE,
		Gap = BattleArena.DEFAULT_GAP,
		Midline = BattleArena.DEFAULT_MIDLINE,
	}
end

--[[
	칸 하나의 중심을 전투 원점 기준 로컬 좌표로 돌려준다.
	Y는 0이다. 지형 높이는 CellWorldCFrame()에서 맞춘다.
]]
function BattleArena.CellOffset(
	layout: Layout,
	side: BattleGrid.Side,
	x: number,
	y: number,
	width: number,
	height: number
): Vector3
	local pitch = layout.CellSize + layout.Gap

	--[[
		브라운 더스트 1처럼 **양 진영이 좌우로** 마주 본다.

		     아군 진영            중앙선            적 진영
		   [6][5][4][3][2][1]  │  [1][2][3][4][5][6]   ← 세로 라인 1 (위)
		   [6][5][4][3][2][1]  │  [1][2][3][4][5][6]   ← 세로 라인 2 (가운데)
		   [6][5][4][3][2][1]  │  [1][2][3][4][5][6]   ← 세로 라인 3 (아래)
		      ← 화면 왼쪽              화면 오른쪽 →

		  side 축(아군/적) = 로컬 X. 아군은 -X(왼쪽), 적은 +X(오른쪽).
		    각 진영의 6칸(x)도 X를 따라 뻗는다. x=1이 중앙선에 가장 가깝다(전열).
		  세로 라인(y, 1~3) = 로컬 Z. 화면에서는 세로로 늘어선다.

		  공격은 이 세로 라인(y)으로 정해진다. 자세한 건 BattleGrid.LaneTargets 참고.
	]]
	-- Z: 세로 라인 3칸. 가운데 정렬.
	local offsetZ = (y - (height + 1) / 2) * pitch

	-- X: 진영에 따라 좌우로 갈린다. x가 커질수록 자기 진영 뒤열(중앙에서 멀어짐).
	local column = layout.Midline / 2 + (x - 0.5) * pitch
	local offsetX = if side == "Enemy" then column else -column

	local _ = width
	return Vector3.new(offsetX, 0, offsetZ)
end

--[[
	격자 전체가 차지하는 크기.
	  X = 좌우 축 (양 진영 6칸씩 + 중앙선, 화면 가로)
	  Y = 세로 라인 축 (3칸, 화면 세로)
]]
function BattleArena.ArenaExtents(layout: Layout, width: number, height: number): Vector2
	local pitch = layout.CellSize + layout.Gap
	local across = layout.Midline + width * pitch * 2
	local lanes = height * pitch
	return Vector2.new(across, lanes)
end

--[[
	격자 전체가 화면에 들어오는 카메라 CFrame. (브라운 더스트식 측면 고정)

	로컬 X(좌우 축)가 화면 가로, 로컬 Z(세로 라인)가 화면 세로가 되도록
	카메라를 +Z 쪽에서 아래로 pitch만큼 기울여 내려다본다.
	→ 아군(-X)이 화면 왼쪽, 적(+X)이 오른쪽으로 보인다.
]]
function BattleArena.FitCameraCFrame(
	layout: Layout,
	width: number,
	height: number,
	fieldOfView: number,
	aspectRatio: number,
	pitchDegrees: number
): CFrame
	local extents = BattleArena.ArenaExtents(layout, width, height)
	local halfAcross = extents.X / 2 -- 로컬 X
	local halfLane = extents.Y / 2 -- 로컬 Z

	local halfVertical = math.rad(fieldOfView) / 2
	local halfHorizontal = math.atan(math.tan(halfVertical) * math.max(aspectRatio, 0.1))
	local pitch = math.rad(pitchDegrees)

	local center = layout.Origin.Position

	-- 카메라가 앉는 방향: 로컬 +Z(=-LookVector) 쪽에서 위로 pitch만큼.
	local back = -layout.Origin.LookVector
	local direction = (back * math.cos(pitch) + Vector3.new(0, math.sin(pitch), 0)).Unit

	-- 격자 네 모서리 (로컬). X=좌우, Z=세로 라인.
	local corners = {
		Vector3.new(halfAcross, 0, halfLane),
		Vector3.new(halfAcross, 0, -halfLane),
		Vector3.new(-halfAcross, 0, halfLane),
		Vector3.new(-halfAcross, 0, -halfLane),
	}

	-- 주어진 거리에서 화각을 얼마나 쓰는지 (1.0 초과면 화면 밖)
	local function usageAt(distance: number): number
		local eye = center + direction * distance
		local forward = (center - eye).Unit
		local right = Vector3.new(-forward.Z, 0, forward.X)
		if right.Magnitude < 1e-4 then
			right = Vector3.new(1, 0, 0)
		end
		right = right.Unit
		local up = forward:Cross(right)

		local worst = 0
		for _, corner in corners do
			local world = layout.Origin * CFrame.new(corner)
			local rel = world.Position - eye
			local depth = rel:Dot(forward)
			if depth <= 0.01 then
				return math.huge
			end
			local angleH = math.atan(math.abs(rel:Dot(right)) / depth)
			local angleV = math.atan(math.abs(rel:Dot(up)) / depth)
			worst = math.max(worst, angleH / halfHorizontal, angleV / halfVertical)
		end
		return worst
	end

	-- 평면 근사로 시작해(가로=X, 세로=Z가 pitch만큼 눕는다) 네 번 수렴시킨다.
	local distance =
		math.max(halfAcross / math.tan(halfHorizontal), (halfLane * math.sin(pitch)) / math.tan(halfVertical))
	for _ = 1, 4 do
		local usage = usageAt(distance)
		if usage == math.huge then
			distance *= 2
		else
			distance *= usage
		end
	end
	distance *= 1.08

	local eye = center + direction * distance
	return CFrame.lookAt(eye, center)
end

function BattleArena.CellWorldCFrame(
	layout: Layout,
	side: BattleGrid.Side,
	x: number,
	y: number,
	width: number,
	height: number,
	raycastParams: RaycastParams?
): CFrame
	local offset = BattleArena.CellOffset(layout, side, x, y, width, height)
	local world = layout.Origin * CFrame.new(offset)
	local position = world.Position

	if raycastParams then
		-- 위에서 아래로 쏴 지면에 맞춘다.
		local hit = workspace:Raycast(position + Vector3.new(0, 200, 0), Vector3.new(0, -600, 0), raycastParams)
		if hit then
			position = Vector3.new(position.X, hit.Position.Y, position.Z)
		end
	end

	-- 상대 진영을 바라보게 한다. 아군은 오른쪽(+X=RightVector)의 적을, 적은 왼쪽을 본다.
	local facing = if side == "Enemy" then -layout.Origin.RightVector else layout.Origin.RightVector
	return CFrame.lookAt(position, position + facing)
end

-- 격자 바닥 타일 하나의 크기.
function BattleArena.TileSize(layout: Layout): Vector3
	return Vector3.new(layout.CellSize, 0.4, layout.CellSize)
end

--[[
	월드 위치가 어느 칸인지 되짚는다. 캐릭터가 걸어 들어간 칸을 알아내는 데 쓴다.
	격자 밖이면 nil.
]]
function BattleArena.CellFromWorld(
	layout: Layout,
	position: Vector3,
	width: number,
	height: number
): (BattleGrid.Side?, number?, number?)
	local local_ = layout.Origin:PointToObjectSpace(position)
	local pitch = layout.CellSize + layout.Gap

	local x = math.round(local_.X / pitch + (width + 1) / 2)
	if x < 1 or x > width then
		return nil, nil, nil
	end

	local side: BattleGrid.Side = if local_.Z >= 0 then "Enemy" else "Ally"
	local depth = math.abs(local_.Z) - layout.Midline / 2
	if depth < 0 then
		return nil, nil, nil
	end

	local y = math.floor(depth / pitch) + 1
	if y < 1 or y > height then
		return nil, nil, nil
	end

	return side, x, y
end

return BattleArena
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">BattleGrid</string>
          <string name="Source"><![CDATA[--!strict
--[[
	BattleGrid — Brown Dust식 6×3 배치 격자.

	사양 출처: 추가&수정.md `###### 배치`

	  "Brown Dust의 방식을 채택, 기본적으로 6*3의 격자를 양 진영에 둔다.
	   적과 아군 진영에 6*3의 격자를 놓는다. 가로 6, 세로 3이다.
	   일부 특수한 보스전의 경우 칸을 제한하는 기믹을 추가할 것이기 때문에
	   이에 맞춰 유연하게 작업 한다."

	그래서 크기를 상수로 박지 않고 New()에서 받으며, 칸을 하나씩 막을 수 있게 했다.
	보스전 기믹은 SetEnabled()로 칸을 꺼서 표현한다.

	좌표계
	  X 1..6 (가로), Y 1..3 (세로). 진영(Side)마다 격자가 따로 있다.
	  같은 (x, y)라도 Ally/Enemy는 다른 칸이다.

	이 모듈은 순수 상태 관리다. 렌더링·입력은 다루지 않는다.
	스킬 범위 미리보기는 CellsInShape()가 돌려주는 칸 목록을 붉게 칠하면 된다.
]]

export type Side = "Ally" | "Enemy"

export type Cell = {
	Side: Side,
	X: number,
	Y: number,
}

export type Grid = {
	Width: number,
	Height: number,
	-- 보스 기믹으로 막힌 칸. 키는 CellKey().
	Disabled: { [string]: boolean },
	-- 칸 → 유닛 Id
	Occupants: { [string]: string },
	-- 유닛 Id → 칸 (역참조. 이동할 때 원래 칸을 찾는 데 쓴다)
	UnitCells: { [string]: Cell },
}

--[[
	스킬 범위 모양.
	미리보기와 실제 타격 대상이 **같은 함수**를 쓰도록 여기서 한 번만 정의한다.
	(미리보기와 실제가 어긋나는 것이 이런 시스템에서 가장 흔한 버그다)
]]
export type ShapeKind = "Single" | "Row" | "Column" | "Cross" | "Square" | "All" | "Line"

export type Shape = {
	Kind: ShapeKind,
	-- Square에서 쓰는 반경. Cross에서는 팔 길이. Line에서는 앞으로 뻗는 칸 수.
	Radius: number?,
	--[[
		**직접 찍은 칸 목록.** 기준점 (n,n)에서의 상대 좌표다.

		있으면 `Kind`와 `Radius`를 덮어쓴다. 이름 붙은 모양(십자·사각·직선)으로
		표현되지 않는 범위를 위해 둔다 — "앞 두 칸과 위 한 칸" 같은 것은 어떤
		Kind로도 안 된다.

		`config_editor.html`의 범위 편집기가 6×3 격자에서 칸을 찍어 만든다.
	]]
	Cells: { { X: number, Y: number } }?,
	--[[
		**조건부로 늘어나는 단계.** 캐스터가 들고 있는 자원(예: 음악가의
		16분음표) 개수가 `growCount`만큼 찼을 때, `Stages[1]`부터 `Stages
		[growCount]`까지 차례로 켜진다 — 각 단계는 `Cells`와 같은 형식(기준점
		(n,n)에서의 상대 좌표)의 **그 단계에서 새로 추가되는 칸**이다(이전
		단계 칸을 다시 안 적어도 된다. 누적으로 켜진다).

		이름 붙은 방향 공식 대신 칸을 직접 찍게 한 이유: 자라는 모양이 항상
		일직선이라는 보장이 없다(요청: "그 색깔에 따라서 단계별 범위지정" —
		`config_editor.html` 그림 그리기 격자에서 단계마다 다른 색으로 칸을
		찍는다). `Cells`가 있을 때만 의미가 있다.

		자원이 무엇인지는 여기서 모른다 — `BattleGrid`는 격자만 알고 직업
		자원은 모르므로, 실제 개수는 부르는 쪽(`BattleSkills.Cells`/`Targets`)이
		`growCount`로 넘긴다.
	]]
	Stages: { { { X: number, Y: number } } }?,
	--[[
		**어느 진영을 겨누는가.** 비우면 기존처럼 상대 진영(`Foe`)이다.
		`Ally`면 캐스터 **자기 진영**을 겨눈다 — 기준점 (n,n)도 상대가 아니라
		캐스터 자신이 선 칸이다(요청: "격자에서 찍기에 아군 진형에 스킬
		사용 누르면 아군 진형에 범위 지정"). 버프·회복처럼 아군을 대상으로
		하는 스킬이 실제로 아군 칸을 때린 것으로 잡히려면 이게 있어야 한다 —
		`Range = "Supporting"`은 연출·카드 조건일 뿐 겨누는 진영을 안 정한다.
	]]
	TargetSide: ("Foe" | "Ally")?,
}

local DEFAULT_WIDTH = 6
local DEFAULT_HEIGHT = 3

local BattleGrid = {}

BattleGrid.DEFAULT_WIDTH = DEFAULT_WIDTH
BattleGrid.DEFAULT_HEIGHT = DEFAULT_HEIGHT

function BattleGrid.CellKey(side: Side, x: number, y: number): string
	return string.format("%s:%d,%d", side, x, y)
end

function BattleGrid.New(width: number?, height: number?): Grid
	return {
		Width = width or DEFAULT_WIDTH,
		Height = height or DEFAULT_HEIGHT,
		Disabled = {},
		Occupants = {},
		UnitCells = {},
	}
end

function BattleGrid.InBounds(grid: Grid, x: number, y: number): boolean
	return x >= 1 and x <= grid.Width and y >= 1 and y <= grid.Height
end

--[[
	칸을 켜고 끈다. 보스전에서 칸을 제한할 때 쓴다(사양).
	막힌 칸에는 배치도 이동도 할 수 없다.
]]
function BattleGrid.SetEnabled(grid: Grid, side: Side, x: number, y: number, enabled: boolean): ()
	grid.Disabled[BattleGrid.CellKey(side, x, y)] = if enabled then nil else true
end

function BattleGrid.IsEnabled(grid: Grid, side: Side, x: number, y: number): boolean
	if not BattleGrid.InBounds(grid, x, y) then
		return false
	end
	return grid.Disabled[BattleGrid.CellKey(side, x, y)] ~= true
end

function BattleGrid.Occupant(grid: Grid, side: Side, x: number, y: number): string?
	return grid.Occupants[BattleGrid.CellKey(side, x, y)]
end

function BattleGrid.CellOf(grid: Grid, unitId: string): Cell?
	return grid.UnitCells[unitId]
end

--[[
	유닛을 칸에 놓는다.

	실패 사유를 문자열로 돌려주므로 UI가 그대로 띄울 수 있다.
	이미 다른 칸에 있던 유닛이면 그 칸을 비우고 옮긴다.
]]
function BattleGrid.Place(grid: Grid, unitId: string, side: Side, x: number, y: number): (boolean, string?)
	if not BattleGrid.InBounds(grid, x, y) then
		return false, "격자 밖입니다."
	end
	if not BattleGrid.IsEnabled(grid, side, x, y) then
		return false, "이 전투에서 막혀 있는 칸입니다."
	end

	local key = BattleGrid.CellKey(side, x, y)
	local existing = grid.Occupants[key]
	if existing ~= nil and existing ~= unitId then
		return false, "이미 다른 유닛이 있는 칸입니다."
	end

	-- 원래 있던 칸을 비운다.
	local previous = grid.UnitCells[unitId]
	if previous then
		grid.Occupants[BattleGrid.CellKey(previous.Side, previous.X, previous.Y)] = nil
	end

	grid.Occupants[key] = unitId
	grid.UnitCells[unitId] = { Side = side, X = x, Y = y }
	return true, nil
end

function BattleGrid.Remove(grid: Grid, unitId: string): ()
	local cell = grid.UnitCells[unitId]
	if not cell then
		return
	end
	grid.Occupants[BattleGrid.CellKey(cell.Side, cell.X, cell.Y)] = nil
	grid.UnitCells[unitId] = nil
end

--[[
	같은 진영 안에서 이동한다(사양: "매 턴마다 해당 격자 내에서 움직이며").
	진영을 넘어가는 이동은 막는다.
]]
function BattleGrid.Move(grid: Grid, unitId: string, x: number, y: number): (boolean, string?)
	local cell = grid.UnitCells[unitId]
	if not cell then
		return false, "격자에 없는 유닛입니다."
	end
	return BattleGrid.Place(grid, unitId, cell.Side, x, y)
end

--[[
	스킬 범위에 들어가는 칸 목록.

	**미리보기와 실제 타격이 이 함수를 함께 쓴다.**
	사양: "스킬 범위 미리보기의 경우 격자의 색깔을 붉게 표시해 미리보기를 표시"
	→ 반환된 칸을 붉게 칠하면 그것이 곧 맞을 칸이다.

	막힌 칸은 제외한다. `growCount`는 `shape.Stages`를 몇 단계까지 켤지다
	(자원 개수 등 — 부르는 쪽이 결정해 넘긴다. 기본 0).
]]
function BattleGrid.CellsInShape(
	grid: Grid,
	side: Side,
	originX: number,
	originY: number,
	shape: Shape,
	growCount: number?
): { Cell }
	local cells: { Cell } = {}
	local radius = shape.Radius or 1

	local function add(x: number, y: number)
		if BattleGrid.IsEnabled(grid, side, x, y) then
			table.insert(cells, { Side = side, X = x, Y = y })
		end
	end

	--[[
		직접 찍은 칸이 있으면 그것이 전부다. 기준점에서의 상대 좌표를 그대로 더한다.
		격자 밖으로 나가는 칸은 `add`가 걸러 낸다.
	]]
	if shape.Cells then
		for _, offset in shape.Cells do
			add(originX + offset.X, originY + offset.Y)
		end
		if shape.Stages and growCount and growCount > 0 then
			for stage = 1, math.min(growCount, #shape.Stages) do
				for _, offset in shape.Stages[stage] do
					add(originX + offset.X, originY + offset.Y)
				end
			end
		end
		return cells
	end

	if shape.Kind == "Single" then
		add(originX, originY)
	elseif shape.Kind == "Row" then
		for x = 1, grid.Width do
			add(x, originY)
		end
	elseif shape.Kind == "Column" then
		for y = 1, grid.Height do
			add(originX, y)
		end
	elseif shape.Kind == "Cross" then
		add(originX, originY)
		for step = 1, radius do
			add(originX - step, originY)
			add(originX + step, originY)
			add(originX, originY - step)
			add(originX, originY + step)
		end
	elseif shape.Kind == "Square" then
		for x = originX - radius, originX + radius do
			for y = originY - radius, originY + radius do
				add(x, y)
			end
		end
	elseif shape.Kind == "All" then
		for x = 1, grid.Width do
			for y = 1, grid.Height do
				add(x, y)
			end
		end
	elseif shape.Kind == "Line" then
		--[[
			origin(보통 상대가 실제로 서 있는 칸)에서 앞으로 radius칸을 뻗는다.
			요청: "공격 범위가 (n,n)부터 (n+1,n)인 공격은... 좌표가 그대로
			반영돼야 하는데 그냥 (n,n)이야." — origin이 격자 끝에 가까워 radius칸을
			다 못 뻗으면 ClampWindowStart로 창을 뒤로 당겨서 칸 수를 그대로 지킨다.
		]]
		local length = math.max(radius, 1)
		local startX = BattleGrid.ClampWindowStart(grid, originX, length)
		for x = startX, math.min(startX + length - 1, grid.Width) do
			add(x, originY)
		end
	end

	return cells
end

-- 위 칸들 중 실제로 유닛이 있는 것만. 대미지 계산 대상이다.
function BattleGrid.UnitsInShape(
	grid: Grid,
	side: Side,
	originX: number,
	originY: number,
	shape: Shape,
	growCount: number?
): { string }
	local units: { string } = {}
	for _, cell in BattleGrid.CellsInShape(grid, side, originX, originY, shape, growCount) do
		local occupant = BattleGrid.Occupant(grid, cell.Side, cell.X, cell.Y)
		if occupant then
			table.insert(units, occupant)
		end
	end
	return units
end

-- 반대 진영을 돌려준다.
function BattleGrid.Opposing(side: Side): Side
	return if side == "Ally" then "Enemy" else "Ally"
end

--[[
	그 라인에서 공격자 쪽(앞열, x=1)부터 훑어 **처음 걸리는** 점유 칸을 찾는다.
	라인에 유닛이 여럿(향후 "뒤에 있는 적" 기믹) 있어도 가장 가까운 것부터 나온다.
	없으면 nil.
]]
function BattleGrid.FirstOccupiedColumn(grid: Grid, side: Side, lane: number): (number?, string?)
	for x = 1, grid.Width do
		local occupant = BattleGrid.Occupant(grid, side, x, lane)
		if occupant then
			return x, occupant
		end
	end
	return nil, nil
end

--[[
	depth칸짜리 사거리 창이 격자를 벗어나지 않도록 시작 칸을 안으로 당긴다.

	요청: "공격 범위가 (n,n)부터 (n+1,n)인 공격은, 적을 조준했을 때 좌표가 그대로
	       반영돼야 하는데, 그냥 (n,n)이야." — anchor(적이 실제로 있는 칸)가 격자
	       끝에 가까워서 앞으로 depth칸을 다 못 뻗으면, 그냥 잘려서 1칸짜리가
	       되어버렸다. 그 대신 창을 뒤로 당겨서라도 depth칸을 항상 그대로
	       확보한다(격자 폭보다 depth가 크면 그때만 격자 폭만큼으로 줄어든다).
]]
function BattleGrid.ClampWindowStart(grid: Grid, anchor: number, depth: number): number
	local reach = math.max(depth, 1)
	return math.max(1, math.min(anchor, grid.Width - reach + 1))
end

--[[
	조준 칸. 그 라인에 상대가 있으면 그 칸(=가장 가까운 유닛), 없으면 맨 끝 칸.
	depth를 주면 그 사거리 창이 격자를 벗어나지 않게 당겨진 시작 칸을 돌려준다.

	사양: "적이 없는 칸에선 맨 끝 칸을 조준."
	빔 미리보기·판정 둘 다 이 함수로 "어디를 겨눌지"를 정한다.
]]
function BattleGrid.AimColumn(grid: Grid, attackerSide: Side, lane: number, depth: number?): number
	local targetSide = BattleGrid.Opposing(attackerSide)
	local startX = select(1, BattleGrid.FirstOccupiedColumn(grid, targetSide, lane))
	local anchor = startX or grid.Width
	return BattleGrid.ClampWindowStart(grid, anchor, depth or 1)
end

--[[
	세로 라인(lane) 공격 판정.

	사양: "공격 위치는 플레이어가 있는 세로 라인으로 정해진다.
	       플레이어가 세로 3칸 중 2번째 라인이면, 적 라인 중 2번째 라인의 적이 대상."

	즉 공격자는 **자기 세로 라인(y)과 같은 라인**의 상대 진영만 때린다.
	마우스로 조준하지 않는다 — 서 있는 라인이 곧 공격 라인이다.
	적도 같은 규칙을 쓴다(자기 y == 상대 y).

	요청: "스킬 시작 범위가 적한테 닿은 시점에서 시작되게. 적이 (1,2)에 있으면
	       플레이어가 (n,2)에 있을 때 스킬도 (1,2)에서 시작하도록. 뒤에 있는 적을
	       공격하는 로직도 추가할 거라 유연하게."

	그래서 depth를 "앞열(x=1)부터 몇 칸"이 아니라 **그 라인에서 처음 만나는 상대
	유닛부터** 몇 칸 훑을지로 바꿨다. 뒤로 물러나는 건 이제 사정거리 밖으로
	도망치는 회피가 아니다(라인=Splash 회피가 기본 방어 수단이 된다). 대신 depth가
	클수록 그 유닛 뒤에 또 있는 유닛까지 꿰뚫는다 — 나중에 라인에 유닛을 여러 개
	세우면 자연히 관통 공격이 된다. 라인에 아무도 없으면 빈 목록(조준 표시는
	AimColumn으로 맨 끝 칸을 쓴다).

	target이 격자 끝쪽이라 depth칸을 다 못 뻗을 상황이면 ClampWindowStart로
	창을 뒤로 당겨서, 선언된 depth만큼은 항상 그대로 반영되게 한다.
]]
function BattleGrid.LaneTargets(grid: Grid, attackerSide: Side, lane: number, depth: number?): { string }
	local targetSide = BattleGrid.Opposing(attackerSide)
	local reach = depth or grid.Width

	local startX = select(1, BattleGrid.FirstOccupiedColumn(grid, targetSide, lane))
	if not startX then
		return {}
	end

	local windowStart = BattleGrid.ClampWindowStart(grid, startX, reach)
	local units: { string } = {}
	for x = windowStart, math.min(windowStart + reach - 1, grid.Width) do
		local occupant = BattleGrid.Occupant(grid, targetSide, x, lane)
		if occupant then
			table.insert(units, occupant)
		end
	end
	return units
end

-- 해당 라인에 상대 진영 유닛이 하나라도 있는지 (없으면 그 라인 공격은 빗나간다).
function BattleGrid.LaneHasTarget(grid: Grid, attackerSide: Side, lane: number): boolean
	return #BattleGrid.LaneTargets(grid, attackerSide, lane, nil) > 0
end

--[[
	멀티플레이에서 같은 칸을 고른 경우의 처리 방식.

	사양: "같은 칸에 캐릭터를 놓는 경우가 생긴다면, 해당 팀 전체가 투표를 하게 된다.
	       듀오의 경우, 투표가 불가하므로 가위바위보를 통해 위치를 정한다."

	투표는 3인 이상에서만 성립한다(2인이면 1:1로 갈려 결론이 안 난다).
]]
export type ConflictResolution = "Vote" | "RockPaperScissors"

function BattleGrid.ConflictResolution(teamSize: number): ConflictResolution
	if teamSize <= 2 then
		return "RockPaperScissors"
	end
	return "Vote"
end

-- 배치 요청들 중 칸이 겹치는 것을 찾아낸다. 겹친 칸마다 경쟁자 목록을 돌려준다.
function BattleGrid.FindConflicts(
	requests: { { UnitId: string, Side: Side, X: number, Y: number } }
): { [string]: { string } }
	local byCell: { [string]: { string } } = {}
	for _, request in requests do
		local key = BattleGrid.CellKey(request.Side, request.X, request.Y)
		if not byCell[key] then
			byCell[key] = {}
		end
		table.insert(byCell[key], request.UnitId)
	end

	local conflicts: { [string]: { string } } = {}
	for key, unitIds in byCell do
		if #unitIds > 1 then
			conflicts[key] = unitIds
		end
	end
	return conflicts
end

return BattleGrid
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">BattleSkillEffects</string>
          <string name="Source"><![CDATA[--!strict
--[[
	BattleSkillEffects — 스킬 하나하나가 **실제로 무엇을 하는지**.

	사양 출처: `유저 아이디어(직업).md` 각 직업의 `스킬` 항목, `상태이상.md`

	--------------------------------------------------------------------------
	왜 GridBattle 밖에 있나

	직업 9개 × 스킬 3개 + 강화 스킬이라 효과가 서른 개 가까이 된다. 이걸 전부
	`GridBattle.ResolveSkill` 안에 if로 넣으면 그 함수가 혼자 수백 줄이 되고,
	격자 규칙과 직업 규칙이 한 덩어리로 엉킨다.

	그래서 **스킬 Id → 효과 함수** 표로 뺐다. `GridBattle`은 표를 찾아 부르기만 한다.
	순환 참조를 피하려고 GridBattle을 require하지 않고, 필요한 것만 `Context`로 받는다.

	--------------------------------------------------------------------------
	호출 순서

	  1. `Before(ctx)` — 피해 계산 **전**. 자원을 쓰고 **피해 배율**을 돌려준다.
	     (예: 크레셴도는 음표 1개당 +3%)
	  2. GridBattle이 피해를 넣는다.
	  3. `After(ctx)` — 피해 계산 **후**. 자원을 얻고 상태이상을 건다.
	     (예: 벨로체는 4분음표 2개를 얻고 보호막 2를 준다)

	자원을 쓰고 나서 그 양으로 배율을 정하는 스킬이 많아(특이점·알 포르테·허물다)
	`Before`가 소모까지 맡는다.

	--------------------------------------------------------------------------
	솔로 전투라는 전제

	사양이 "탑은 오직 솔로 플레이로만 등반 가능"이므로 아군은 플레이어 하나다.
	그래서 md의 "아군 전체" 효과(브릴란테·축성)는 **자기 자신에게만** 걸린다.
	파티가 생기면 `ctx.Allies`를 여럿으로 넘기면 그대로 동작한다.
]]

local BattleStatus = require(script.Parent.BattleStatus)
local ClassResources = require(script.Parent.ClassResources)

local R = ClassResources

--[[
	효과 함수가 받는 것.

	GridBattle의 타입을 직접 쓰지 않고 any로 받는다 — 그러면 이 모듈이 GridBattle을
	require하지 않아도 되고, 순환 참조가 생기지 않는다.
]]
export type Context = {
	-- 시전자 (아군)
	Ally: any,
	-- 시전자의 상태이상 그릇
	Status: BattleStatus.State,
	-- 이번에 실제로 맞은 유닛들
	Targets: { any },
	-- 아군 전체. 솔로에서는 Ally 하나뿐이다.
	Allies: { any },
	-- QTE 등급 ("Success" | "Partial" | "Fail")
	Grade: string,
	-- 결정적 난수. 같은 씨앗이면 같은 결과가 나와야 하므로 반드시 이걸 쓴다.
	Rng: () -> number,
	-- 유닛의 상태이상 그릇을 꺼낸다.
	StatusOf: (unit: any) -> BattleStatus.State,
	-- 피해를 넣는다. 죽지 않는 피해는 canKill=false.
	Damage: (unit: any, amount: number, element: BattleStatus.Element, canKill: boolean) -> number,
	-- 회복시킨다.
	Heal: (unit: any, amount: number) -> number,
	-- 스테미나를 채운다. 실제로 채워진 양을 돌려준다(명상).
	RestoreStamina: (amount: number) -> number,
	-- 로그 한 줄.
	Log: (message: string) -> (),
	-- 적을 시전자 쪽으로 끌어당긴다(퀘이사 붕괴).
	PullEnemies: (columns: number) -> number,
}

export type Effect = {
	-- 피해 계산 전. 배율을 돌려준다(1이면 보정 없음).
	Before: ((Context) -> number)?,
	-- 피해 계산 후.
	After: ((Context) -> ())?,
}

local BattleSkillEffects = {}

--=== 공용 도우미 ===--

-- 음표 총 개수. 종류가 셋이지만 한 곳에 모인 것으로 센다(md의 `!!` 주석).
local function totalNotes(status: BattleStatus.State): number
	local total = 0
	for _, id in R.NOTE_IDS do
		total += BattleStatus.Stack(status, id)
	end
	return total
end

-- 음표를 얻는다. 박자표가 정한 상한에서 멈춘다.
local function gainNote(status: BattleStatus.State, id: string, amount: number): number
	local meter = math.max(1, BattleStatus.Stack(status, R.METER))
	local cap = ClassResources.NoteCap(meter)
	local room = math.max(0, cap - totalNotes(status))
	local gained = math.min(amount, room)
	if gained > 0 then
		BattleStatus.AddStack(status, id, gained)
	end
	return gained
end

-- 음표를 종류 상관없이 전부 비운다. 소모한 총량을 돌려준다.
local function spendAllNotes(status: BattleStatus.State): number
	local spent = 0
	for _, id in R.NOTE_IDS do
		spent += BattleStatus.SpendAll(status, id)
	end
	return spent
end

--[[
	기도력(= 신앙심) 보정.

	`상태이상.md`: "기도력은 스탯 신앙심의 오타임."
	md의 월 필그림스 직업: "자신의 기도력 10당 이 수치가 10% 강해짐. (최대 +50%)"
]]
local function faithScale(ally: any): number
	local faith = ally.Faith or 0
	return 1 + math.min(math.floor(faith / 10) * 0.1, 0.5)
end

--=== 음악가 ===--

local musicianEffects: { [string]: Effect } = {
	-- 벨로체: 음표 1개당 피해 +2.5%. 사용 후 4분음표 2개, 자신에게 보호막 2.
	Veloce = {
		Before = function(ctx)
			return 1 + totalNotes(ctx.Status) * 0.025
		end,
		After = function(ctx)
			local gained = gainNote(ctx.Status, R.QUARTER, 2)
			-- md는 "자신과 무작위 아군"이지만 솔로라 자기 자신뿐이다.
			BattleStatus.AddShield(ctx.Status, 2)
			ctx.Log(string.format("4분음표 +%d · 보호막 +2", gained))
		end,
	},

	--[[
		브릴란테: 아군 전체에게 음표 수만큼 [브릴란테].
		브릴란테 = 치명타 확률·피해량 +(1.5 × 값)%.
	]]
	Brillante = {
		After = function(ctx)
			local notes = totalNotes(ctx.Status)
			local bonus = notes * 0.015
			for _, ally in ctx.Allies do
				local status = ctx.StatusOf(ally)
				BattleStatus.RemoveBySource(status, "브릴란테")
				BattleStatus.AddStack(status, R.BRILLANTE, notes)
				BattleStatus.AddModifier(status, "CritChance", bonus, 3, "브릴란테")
				BattleStatus.AddModifier(status, "CritDamage", bonus, 3, "브릴란테")
			end
			local gained = gainNote(ctx.Status, R.EIGHTH, 2)
			ctx.Log(string.format("브릴란테 %d (치명타 +%.1f%%) · 8분음표 +%d", notes, bonus * 100, gained))
		end,
	},

	--[[
		크레셴도: 음표 1개당 피해 +3%.
		음표가 최대치면 **전부 초기화**하고 개당 +4%, 사용 후 박자표 +1.
		16개 이상이면 알 포르테로 강화된다(개당 +7%, 전부 소모).
	]]
	Crescendo = {
		Before = function(ctx)
			local status = ctx.Status
			local notes = totalNotes(status)
			local meter = math.max(1, BattleStatus.Stack(status, R.METER))
			local cap = ClassResources.NoteCap(meter)

			if notes >= cap and notes > 0 then
				local spent = spendAllNotes(status)
				BattleStatus.AddStack(status, R.METER, 1, ClassResources.Cap(R.METER))
				ctx.Log(
					string.format(
						"음표 %d 초기화 — 박자표 %d (개당 +4%%)",
						spent,
						BattleStatus.Stack(status, R.METER)
					)
				)
				return 1 + spent * 0.04
			end

			return 1 + notes * 0.03
		end,
		After = function(ctx)
			local gained = gainNote(ctx.Status, R.SIXTEENTH, 1)
			if gained > 0 then
				ctx.Log("16분음표 +1")
			end
		end,
	},

	--[[
		크레셴도 알 포르테 (강화). 음표 16개 이상에서 크레셴도를 대신한다.
		모든 음표를 소모하고, 소모한 음표 1개당 피해 +7%.
	]]
	CrescendoAlForte = {
		Before = function(ctx)
			local spent = spendAllNotes(ctx.Status)
			ctx.Log(string.format("크레셴도 알 포르테 — 음표 %d 소모 (개당 +7%%)", spent))
			return 1 + spent * 0.07
		end,
		After = function(ctx)
			--[[
				md: "사용 후 자신이 가지고 있던 음표 개수 종류당 -4한 만큼의 버프를
				2턴 간 얻는다. (4이하인 경우 1로 보정됨.)"
				종류는 셋뿐이므로 보정이 거의 항상 걸린다 — 최소 1로 둔다.
			]]
			BattleStatus.AddModifier(ctx.Status, "DamageDealt", 0.01, 2, "알 포르테")
		end,
	},
}

--=== 결투사 ===--

--[[
	태세를 세운다. 하나만 켜져 있어야 하므로 이전 것을 떼고 새로 건다.

	공격 태세: 받는 피해 +15%, 피해 +(20 + 집중)%, 치명타 확률 +10%
	방어 태세: 받는 피해 −30%, 피해 −45%
]]
local function applyStance(ctx: Context, attack: boolean): ()
	local status = ctx.Status
	BattleStatus.RemoveBySource(status, "태세")
	BattleStatus.AddStack(status, R.STANCE_ATTACK, if attack then 1 else -99)

	if attack then
		local focus = BattleStatus.Stack(status, R.FOCUS)
		BattleStatus.AddModifier(status, "DamageTaken", 0.15, -1, "태세")
		BattleStatus.AddModifier(status, "DamageDealt", 0.2 + focus * 0.01, -1, "태세")
		BattleStatus.AddModifier(status, "CritChance", 0.1, -1, "태세")
		ctx.Log("공격 태세")
	else
		BattleStatus.AddModifier(status, "DamageTaken", -0.3, -1, "태세")
		BattleStatus.AddModifier(status, "DamageDealt", -0.45, -1, "태세")
		ctx.Log("방어 태세")
	end
end

local duelistEffects: { [string]: Effect } = {
	--[[
		앞뒤관통: 사용 후 2턴 간 아군 패링 범위 +(2×집중)%, 자신 받는 피해 −10%.
	]]
	FrontBackPierce = {
		After = function(ctx)
			local focus = BattleStatus.Stack(ctx.Status, R.FOCUS)
			for _, ally in ctx.Allies do
				BattleStatus.AddModifier(ctx.StatusOf(ally), "ParryWindow", focus * 0.02, 2, "앞뒤관통")
			end
			BattleStatus.AddModifier(ctx.Status, "DamageTaken", -0.1, 2, "앞뒤관통")
			ctx.Log(string.format("패링 범위 +%d%% · 받는 피해 −10%% (2턴)", focus * 2))
		end,
	},

	--[[
		찔러찔러또찔러: 대상에게 출혈. 3턴 간 방어·패링 범위 +(2.5×집중)%. 집중 +1.
	]]
	TripleThrust = {
		After = function(ctx)
			for _, target in ctx.Targets do
				BattleStatus.AddBleed(ctx.StatusOf(target), 3)
			end
			local focus = BattleStatus.Stack(ctx.Status, R.FOCUS)
			BattleStatus.AddModifier(ctx.Status, "ParryWindow", focus * 0.025, 3, "찔러찔러또찔러")
			BattleStatus.AddStack(ctx.Status, R.FOCUS, 1, ClassResources.Cap(R.FOCUS))
			ctx.Log(string.format("출혈 부여 · 집중 %d", BattleStatus.Stack(ctx.Status, R.FOCUS)))
		end,
	},

	--[[
		신경을 곤두세우고 깊은 호흡을 들여 (준비 자세).

		1턴 간 받는 버프·회복 +30%, 받는 피해 −25%, 방어·패링 범위 +(3×집중)%.
		집중 +3. 다음 턴에 이 슬롯은 **연계 스킬**로 강화된다.
	]]
	DeepBreath = {
		After = function(ctx)
			local status = ctx.Status
			local focus = BattleStatus.Stack(status, R.FOCUS)
			BattleStatus.AddModifier(status, "BuffTaken", 0.3, 1, "준비 자세")
			BattleStatus.AddModifier(status, "HealTaken", 0.3, 1, "준비 자세")
			BattleStatus.AddModifier(status, "DamageTaken", -0.25, 1, "준비 자세")
			BattleStatus.AddModifier(status, "ParryWindow", focus * 0.03, 1, "준비 자세")
			BattleStatus.AddStack(status, R.FOCUS, 3, ClassResources.Cap(R.FOCUS))
			BattleStatus.AddStack(status, R.READY, 1, 1)
			ctx.Log(
				string.format(
					"준비 자세 — 집중 %d, 다음 턴 연계 가능",
					BattleStatus.Stack(status, R.FOCUS)
				)
			)
		end,
	},

	--[[
		연계: 마지막까지 빛나는 점을 향해 검 끝을 쏘아라.

		치명타 확률 보정 +15%, 집중 1스택당 피해 +2.5%.
		3턴 간 아군 패링 +15% · 받는 피해 −10%. 출혈. **태세 변경.**
		2턴 간 받는 피해 −15% · 피해 +15%.
	]]
	PointBlank = {
		Before = function(ctx)
			local focus = BattleStatus.Stack(ctx.Status, R.FOCUS)
			BattleStatus.AddModifier(ctx.Status, "CritChance", 0.15, 1, "연계")
			return 1 + focus * 0.025
		end,
		After = function(ctx)
			local status = ctx.Status
			BattleStatus.SpendStack(status, R.READY, 1)
			for _, ally in ctx.Allies do
				local allyStatus = ctx.StatusOf(ally)
				BattleStatus.AddModifier(allyStatus, "ParryWindow", 0.15, 3, "연계")
				BattleStatus.AddModifier(allyStatus, "DamageTaken", -0.1, 3, "연계")
			end
			for _, target in ctx.Targets do
				BattleStatus.AddBleed(ctx.StatusOf(target), 3)
			end
			-- 태세를 뒤집는다.
			applyStance(ctx, BattleStatus.Stack(status, R.STANCE_ATTACK) <= 0)
			BattleStatus.AddModifier(status, "DamageTaken", -0.15, 2, "연계 여파")
			BattleStatus.AddModifier(status, "DamageDealt", 0.15, 2, "연계 여파")
		end,
	},
}

--=== 퀘이사 ===--

local quasarEffects: { [string]: Effect } = {
	--[[
		붕괴: 차징한다. 차징 중 적이 끌려오고 [중력]이 걸린다.
		다시 쓰면 발동한다. 차징 1턴당 피해 +25% (최대 2턴).
	]]
	Collapse = {
		Before = function(ctx)
			local charge = BattleStatus.Stack(ctx.Status, R.CHARGE)
			if charge <= 0 then
				--[[
					차징을 시작한다. 피해는 나가지 않는다(배율 0).
					`After`가 이번이 "발동"이었는지 알아야 하므로 여기서 표시해 둔다.
				]]
				BattleStatus.AddStack(ctx.Status, R.CHARGE, 1, 2)
				local pulled = ctx.PullEnemies(1)
				ctx.Log(string.format("붕괴 차징 1 — 적 %d기 끌어당김", pulled))
				return 0
			end

			-- 차징 중이면 발동한다. 차징 1턴당 피해 +25%.
			BattleStatus.SpendAll(ctx.Status, R.CHARGE)
			ctx.Log(string.format("붕괴 발동 — 차징 %d턴 (피해 +%d%%)", charge, charge * 25))
			return 1 + charge * 0.25
		end,
		After = function(ctx)
			-- 차징 중에는 적이 계속 끌려오고 [중력]이 걸린다.
			if BattleStatus.Stack(ctx.Status, R.CHARGE) <= 0 then
				return
			end
			for _, target in ctx.Targets do
				local status = ctx.StatusOf(target)
				BattleStatus.AddStack(status, R.GRAVITY, 2)
				BattleStatus.RemoveBySource(status, "중력")
				BattleStatus.AddModifier(status, "DamageTaken", 0.15, 2, "중력")
			end
		end,
	},

	--[[
		특이점: [질량]을 전부 태운다. 소모 스택 1개당 피해 +5%.
		소모량에 따라 3단계로 갈린다(연출·범위는 클라이언트가 그린다).
	]]
	Singularity = {
		Before = function(ctx)
			local spent = BattleStatus.SpendAll(ctx.Status, R.MASS)
			local tier = if spent >= 15 then 3 elseif spent >= 8 then 2 else 1
			ctx.Log(string.format("특이점 %d단계 — 질량 %d 소모 (피해 +%d%%)", tier, spent, spent * 5))
			return 1 + spent * 0.05
		end,
	},

	-- 낙하: 사용만 해도 질량 3. 이 스킬로 처치하면 5 추가.
	Infall = {
		After = function(ctx)
			local cap = ClassResources.Cap(R.MASS)
			BattleStatus.AddStack(ctx.Status, R.MASS, 3, cap)
			local killed = 0
			for _, target in ctx.Targets do
				if not target.Alive then
					killed += 1
				end
			end
			if killed > 0 then
				BattleStatus.AddStack(ctx.Status, R.MASS, 5, cap)
			end
			ctx.Log(string.format("질량 %d", BattleStatus.Stack(ctx.Status, R.MASS)))
		end,
	},
}

--=== 펄서 ===--

local pulsarEffects: { [string]: Effect } = {
	--[[
		자기권: 3턴 간 [자기장]. 받는 피해 −20%, 피격 시 반사 8 + [감극].
		반사와 감극 부여는 `GridBattle`이 피격 시 처리한다(FIELD 스택을 본다).
	]]
	Magnetosphere = {
		After = function(ctx)
			local status = ctx.Status
			BattleStatus.AddStack(status, R.FIELD, 3)
			BattleStatus.RemoveBySource(status, "자기장")
			BattleStatus.AddModifier(status, "DamageTaken", -0.2, 3, "자기장")
			BattleStatus.AddModifier(status, "Reflect", 8, 3, "자기장")
			ctx.Log("자기장 — 받는 피해 −20%, 반사 8 (3턴)")
		end,
	},

	--[[
		수렴: [공명] 스택 1당 피해 +30%. QTE 성공 시 감극 1중첩 추가.

		md는 "한 턴에 최대 3회 연속"이지만, 이 전투는 스킬 한 번에 턴이 넘어간다.
		그래서 **연속으로 수렴을 쓰면** 공명이 쌓이는 식으로 옮겼다 — 다른 스킬을
		쓰면 초기화되므로 "이어 쏠수록 강해진다"는 결은 그대로다.
	]]
	Converge = {
		Before = function(ctx)
			local stacks = BattleStatus.Stack(ctx.Status, R.RESONATE)
			return 1 + stacks * 0.3
		end,
		After = function(ctx)
			local status = ctx.Status
			BattleStatus.AddStack(status, R.RESONATE, 1, ClassResources.Cap(R.RESONATE))
			local extra = if ctx.Grade == "Success" then 2 else 1
			for _, target in ctx.Targets do
				BattleStatus.AddStack(ctx.StatusOf(target), R.DEPOLAR, extra, ClassResources.Cap(R.DEPOLAR))
			end
			ctx.Log(string.format("공명 %d · 감극 +%d", BattleStatus.Stack(status, R.RESONATE), extra))
		end,
	},

	--[[
		섬광: 피해는 없다. 2턴 간 대상의 명중률 −20%.

		이 전투에는 명중 판정이 없어서(적 공격은 회피 QTE로만 갈린다) 명중률을
		**그 적이 주는 피해 −20%** 로 옮겼다. 관측되는 결과가 같고 판정이 결정적이다.
	]]
	Flare = {
		After = function(ctx)
			for _, target in ctx.Targets do
				local status = ctx.StatusOf(target)
				BattleStatus.AddModifier(status, "Accuracy", -0.2, 2, "섬광")
				BattleStatus.AddModifier(status, "DamageDealt", -0.2, 2, "섬광")
			end
			ctx.Log(string.format("섬광 — 적 %d기 명중률 −20%% (2턴)", #ctx.Targets))
		end,
	},
}

--=== 월 필그림스 ===--

-- 광신을 건다. 중첩당 방어 −3% / 피해 −2%, 신앙심 10당 수치 +10%.
local function applyZeal(ctx: Context, target: any, stacks: number): ()
	local status = ctx.StatusOf(target)
	local scale = faithScale(ctx.Ally)
	local applied = BattleStatus.AddStack(status, R.ZEAL, stacks, ClassResources.Cap(R.ZEAL))
	BattleStatus.RemoveBySource(status, "광신")
	BattleStatus.AddModifier(status, "DamageDealt", -0.02 * applied * scale, 3, "광신")
	BattleStatus.AddModifier(status, "DamageTaken", 0.03 * applied * scale, 3, "광신")
end

local wallPilgrimEffects: { [string]: Effect } = {
	Nailing = {
		After = function(ctx)
			for _, target in ctx.Targets do
				applyZeal(ctx, target, 2)
			end
			ctx.Log(string.format("광신 2중첩 — 대상 %d기", #ctx.Targets))
		end,
	},
	SplitFlock = {
		After = function(ctx)
			for _, target in ctx.Targets do
				applyZeal(ctx, target, 1)
			end
			ctx.Log(string.format("광신 1중첩 — 대상 %d기", #ctx.Targets))
		end,
	},
	--[[
		합창: 대상에게 4중첩, 나머지에게 2중첩.
		맞은 순서의 첫 번째를 "대상"으로 본다(BattleSkills.Targets가 앞열부터 준다).
	]]
	Chorale = {
		After = function(ctx)
			for index, target in ctx.Targets do
				applyZeal(ctx, target, if index == 1 then 4 else 2)
			end
			ctx.Log(string.format("합창 — 대상 %d기에 광신", #ctx.Targets))
		end,
	},
}

--=== 월 메이슨 ===--

-- 벽을 준다. 중첩당 방어 +4% / 회피·패링 +2%, 신앙심 10당 수치 +10%.
local function applyWall(ctx: Context, ally: any, stacks: number): ()
	local status = ctx.StatusOf(ally)
	local scale = faithScale(ctx.Ally)
	local applied = BattleStatus.AddStack(status, R.WALL, stacks, ClassResources.Cap(R.WALL))
	BattleStatus.RemoveBySource(status, "벽")
	BattleStatus.AddModifier(status, "DamageTaken", -0.04 * applied * scale, 3, "벽")
	BattleStatus.AddModifier(status, "ParryWindow", 0.02 * applied * scale, 3, "벽")
end

local wallMasonEffects: { [string]: Effect } = {
	ChiselWork = {
		After = function(ctx)
			applyWall(ctx, ctx.Ally, 1)
			ctx.Log(string.format("벽 %d중첩", BattleStatus.Stack(ctx.Status, R.WALL)))
		end,
	},
	-- 뒷벽 허물기: [벽] 중첩 1당 피해 +6%.
	BreakBackWall = {
		Before = function(ctx)
			return 1 + BattleStatus.Stack(ctx.Status, R.WALL) * 0.06
		end,
	},
	-- 축성: 아군 전체에게 벽 3중첩. 솔로라 자기 자신뿐이다.
	Consecrate = {
		After = function(ctx)
			for _, ally in ctx.Allies do
				applyWall(ctx, ally, 3)
			end
			ctx.Log(string.format("축성 — 벽 %d중첩", BattleStatus.Stack(ctx.Status, R.WALL)))
		end,
	},
}

--=== 월 브레이커 ===--

-- 허물 벽을 쌓는다. 중첩당 피해 +5% / 받는 피해 +3%.
local function applyRuin(ctx: Context, stacks: number): ()
	local status = ctx.Status
	local applied = BattleStatus.AddStack(status, R.RUIN, stacks, ClassResources.Cap(R.RUIN))
	BattleStatus.RemoveBySource(status, "허물 벽")
	BattleStatus.AddModifier(status, "DamageDealt", 0.05 * applied, -1, "허물 벽")
	BattleStatus.AddModifier(status, "DamageTaken", 0.03 * applied, -1, "허물 벽")
end

local wallBreakerEffects: { [string]: Effect } = {
	-- 쪼개기 / 무너뜨리기: 허물 벽 중첩당 피해 +5%는 상시 보정으로 이미 걸려 있다.
	Cleave = {},
	BringDown = {},

	--[[
		제 살 깎기 (강화). **3번 오른쪽에 따로 놓인 버튼**이다.

		md의 강화 2스킬은 아군을 때려 허물 벽을 얻는 것인데, 솔로라 때릴 아군이
		자기 자신뿐이다(필수 카드 `자해`가 명시적으로 그렇게 만든다).
		최대 체력 15%(최대 30)를 스스로 깎고 허물 벽 3중첩을 얻는다.
	]]
	SelfCarve = {
		After = function(ctx)
			local cost = math.min(math.floor(ctx.Ally.MaxHealth * 0.15), 30)
			ctx.Damage(ctx.Ally, cost, "True", false)
			applyRuin(ctx, 3)
			ctx.Log(
				string.format(
					"제 살 깎기 — 체력 %d 소모, 허물 벽 %d중첩",
					cost,
					BattleStatus.Stack(ctx.Status, R.RUIN)
				)
			)
		end,
	},

	-- 허물다: 허물 벽 전부 소모. 소모 중첩 1당 피해 +12%.
	TearDown = {
		Before = function(ctx)
			local spent = BattleStatus.SpendAll(ctx.Status, R.RUIN)
			BattleStatus.RemoveBySource(ctx.Status, "허물 벽")
			ctx.Log(string.format("허물다 — 허물 벽 %d 소모 (피해 +%d%%)", spent, spent * 12))
			return 1 + spent * 0.12
		end,
	},
}

--=== 연금술사 ===--

local alchemistEffects: { [string]: Effect } = {
	--[[
		다지기: [약재]를 쓴다. 사용자 지시대로 **무조건 최대치**를 쓴다.

		소모량마다 이득과 대가가 같이 커진다(md의 표 그대로).
		  1개 → 원액 1
		  2개 → 원액 2, 주는 피해 +10%, 받는 피해 +10%
		  3개 → 원액 3, 주는 피해 +15%, 받는 피해 +15%
		  4개 → 원액 4, 주는 피해 +25%, 받는 피해 +25%
	]]
	Grind = {
		After = function(ctx)
			local status = ctx.Status
			local herbs = math.min(BattleStatus.Stack(status, R.HERB), 4)
			if herbs <= 0 then
				ctx.Log("약재가 없다")
				return
			end
			BattleStatus.SpendStack(status, R.HERB, herbs)
			BattleStatus.AddStack(status, R.EXTRACT, herbs, ClassResources.Cap(R.EXTRACT))

			local bonus = 0
			if herbs >= 4 then
				bonus = 0.25
			elseif herbs >= 3 then
				bonus = 0.15
			elseif herbs >= 2 then
				bonus = 0.1
			end
			if bonus > 0 then
				BattleStatus.AddModifier(status, "DamageDealt", bonus, -1, "다지기")
				BattleStatus.AddModifier(status, "DamageTaken", bonus, -1, "다지기")
			end
			ctx.Log(
				string.format(
					"다지기 %d — 원액 %d · 주는/받는 피해 +%d%%",
					herbs,
					BattleStatus.Stack(status, R.EXTRACT),
					bonus * 100
				)
			)
		end,
	},

	--[[
		섞기: [원액]을 전부 [빈 병]과 함께 태워 [꽉 찬 병]을 만든다.

		사용자 지시: **각 33% 확률로 독 병 / 화염병 / 기름 병 중 하나를 확정으로**
		하나 만든다. (회복 병은 이 목록에 없다)
	]]
	Mix = {
		After = function(ctx)
			local status = ctx.Status
			local extract = BattleStatus.Stack(status, R.EXTRACT)
			local bottles = math.min(extract, BattleStatus.Stack(status, R.EMPTY_BOTTLE))
			if bottles <= 0 then
				ctx.Log("원액이나 빈 병이 없다")
				return
			end
			BattleStatus.SpendStack(status, R.EXTRACT, bottles)
			BattleStatus.SpendStack(status, R.EMPTY_BOTTLE, bottles)

			local kinds = { R.POISON_BOTTLE, R.FIRE_BOTTLE, R.OIL_BOTTLE }
			local made = { 0, 0, 0 }
			for _ = 1, bottles do
				local pick = math.min(3, math.floor(ctx.Rng() * 3) + 1)
				made[pick] += 1
				BattleStatus.AddStack(status, kinds[pick], 1, ClassResources.Cap(kinds[pick]))
			end
			ctx.Log(
				string.format("섞기 %d병 — 독 %d · 화염 %d · 기름 %d", bottles, made[1], made[2], made[3])
			)
		end,
	},

	--[[
		던지기: [꽉 찬 병] 하나를 던진다. 그 병의 상태이상을 건다.
		  독 병   독 10
		  화염병  화상 10
		  기름 병 기름 10턴

		강화 스킬 `중독`은 3번 오른쪽에 **따로 놓인 버튼**이다(요청). 예전에는 이
		스킬이 조건에 따라 중독으로 바뀌었는데, 그러면 평범한 던지기를 쓸 수 없었다.
	]]
	Throw = {
		After = function(ctx)
			local status = ctx.Status
			local kinds = { R.POISON_BOTTLE, R.FIRE_BOTTLE, R.OIL_BOTTLE }
			local chosen: string? = nil
			for _, kind in kinds do
				if BattleStatus.Stack(status, kind) > 0 then
					chosen = kind
					break
				end
			end
			if not chosen then
				ctx.Log("던질 병이 없다")
				return
			end
			BattleStatus.SpendStack(status, chosen, 1)
			for _, target in ctx.Targets do
				local targetStatus = ctx.StatusOf(target)
				if chosen == R.POISON_BOTTLE then
					BattleStatus.AddPoison(targetStatus, 10)
				elseif chosen == R.FIRE_BOTTLE then
					BattleStatus.AddBurn(targetStatus, 10)
				else
					BattleStatus.AddOil(targetStatus, 10)
				end
			end
			ctx.Log(string.format("%s 사용", ClassResources.Label(chosen)))
		end,
	},

	--[[
		중독 (강화). 꽉 찬 병 3개 이상에서 열린다.

		보유한 병을 전부 태우고 **절반을 돌려받는다.** 종류마다 자신에게 버프와
		대가(체력 감소)가 함께 붙는다 — md의 `스킬 3-1` 표 그대로다.
	]]
	Poisoning = {
		Before = function(ctx)
			local status = ctx.Status
			local poison = BattleStatus.SpendAll(status, R.POISON_BOTTLE)
			local fire = BattleStatus.SpendAll(status, R.FIRE_BOTTLE)
			local oil = BattleStatus.SpendAll(status, R.OIL_BOTTLE)

			-- 절반을 돌려받는다.
			BattleStatus.AddStack(status, R.POISON_BOTTLE, poison // 2, ClassResources.Cap(R.POISON_BOTTLE))
			BattleStatus.AddStack(status, R.FIRE_BOTTLE, fire // 2, ClassResources.Cap(R.FIRE_BOTTLE))
			BattleStatus.AddStack(status, R.OIL_BOTTLE, oil // 2, ClassResources.Cap(R.OIL_BOTTLE))

			local bonus = 0
			if poison > 0 then
				-- 체력 30% 감소, 주는 피해 +15%. 이 효과로 죽지는 않는다.
				ctx.Damage(ctx.Ally, math.floor(ctx.Ally.MaxHealth * 0.3), "True", false)
				bonus += 0.15
			end
			if fire > 0 then
				ctx.Damage(ctx.Ally, math.floor(ctx.Ally.MaxHealth * 0.05), "True", false)
				bonus += 0.1
			end
			if oil > 0 then
				ctx.Damage(ctx.Ally, math.floor(ctx.Ally.MaxHealth * 0.05), "True", false)
				bonus += 0.05
				if fire > 0 then
					-- 화염병과 같이 태우면 추가 대가와 추가 화력.
					ctx.Damage(ctx.Ally, math.floor(ctx.Ally.MaxHealth * 0.2), "True", false)
					bonus += 0.15
				end
			end
			BattleStatus.AddModifier(status, "DamageDealt", bonus, -1, "중독")
			-- 3개 이상 태웠으므로 추가 대가가 붙는다(md: 5턴 받는 피해 증가).
			BattleStatus.AddModifier(status, "DamageTaken", 0.5, 3, "중독")
			ctx.Log(string.format("중독 — 병 %d 소모, 주는 피해 +%d%%", poison + fire + oil, bonus * 100))
			return 1.5
		end,
		After = function(ctx)
			-- 태운 종류에 맞춰 대상에게도 상태이상을 남긴다.
			for _, target in ctx.Targets do
				local targetStatus = ctx.StatusOf(target)
				BattleStatus.AddPoison(targetStatus, 10)
				BattleStatus.AddBurn(targetStatus, 10)
				BattleStatus.AddOil(targetStatus, 10)
			end
		end,
	},
}

--=== 공용 (모든 직업) ===--

--[[
	가드와 명상. 요청받은 수치를 그대로 쓴다.

	  가드  이번 턴 받는 피해 70% 감소
	  명상  이번 턴 받는 피해 25% 증가, 스테미나 30 즉시 회복

	"이번 턴"이라 Turns = 1이다. `EndTurn`이 한 번 깎으면 사라진다.
]]
local commonEffects: { [string]: Effect } = {
	Guard = {
		After = function(ctx)
			BattleStatus.AddModifier(ctx.Status, "DamageTaken", -0.7, 1, "가드")
			ctx.Log("가드 — 이번 턴 받는 피해 70% 감소")
		end,
	},
	Meditate = {
		After = function(ctx)
			BattleStatus.AddModifier(ctx.Status, "DamageTaken", 0.25, 1, "명상")
			local gained = ctx.RestoreStamina(30)
			-- `%%`로 이스케이프해야 한다. `25%`로 두면 string.format이 변환 지시자로 읽는다.
			ctx.Log(string.format("명상 — 스테미나 +%d, 이번 턴 받는 피해 25%% 증가", gained))
		end,
	},
}

--=== 표 ===--

local effects: { [string]: Effect } = {}

local function register(source: { [string]: Effect })
	for id, effect in source do
		effects[id] = effect
	end
end

register(musicianEffects)
register(duelistEffects)
register(quasarEffects)
register(pulsarEffects)
register(wallPilgrimEffects)
register(wallMasonEffects)
register(wallBreakerEffects)
register(alchemistEffects)
register(commonEffects)

function BattleSkillEffects.Get(skillId: string): Effect?
	return effects[skillId]
end

--[[
	이 직업이 **지금 쓸 수 있는 강화 스킬**의 Id. 조건이 안 차면 nil.

	3번을 갈아 끼우지 않고, 3번 오른쪽에 버튼이 하나 더 생긴다(요청). 그래서
	"바꿔치기"가 아니라 "추가로 열린다"는 뜻의 이름을 쓴다.
]]
function BattleSkillEffects.UpgradeFor(classId: string, status: BattleStatus.State): string?
	if classId == "Duelist" then
		-- 준비 자세를 잡은 다음 턴에만 연계가 열린다.
		return if BattleStatus.Stack(status, R.READY) >= 1 then "PointBlank" else nil
	elseif classId == "Musician" then
		return if totalNotes(status) >= 16 then "CrescendoAlForte" else nil
	elseif classId == "Alchemist" then
		local bottles = BattleStatus.Stack(status, R.POISON_BOTTLE)
			+ BattleStatus.Stack(status, R.FIRE_BOTTLE)
			+ BattleStatus.Stack(status, R.OIL_BOTTLE)
		return if bottles >= 3 then "Poisoning" else nil
	elseif classId == "WallBreaker" then
		--[[
			제 살 깎기는 조건이 없다. md가 조건을 적지 않았고, 이것이 이 직업이
			[허물 벽]을 마련하는 유일한 수단이라 항상 열려 있어야 한다.
		]]
		return "SelfCarve"
	end
	return nil
end

--[[
	지금 이 스킬이 화면에 뭐라고 보여야 하는지. 바뀔 게 없으면 nil.

	같은 슬롯에서 **모드만** 달라지는 것에 쓴다. 지금은 퀘이사 붕괴뿐이다
	(차징 중인지 발동 차례인지 버튼에 보여야 한다).
]]
function BattleSkillEffects.DisplayName(skillId: string, status: BattleStatus.State): string?
	if skillId == "Collapse" and BattleStatus.Stack(status, R.CHARGE) > 0 then
		return string.format("붕괴 발동 (차징 %d)", BattleStatus.Stack(status, R.CHARGE))
	end
	return nil
end

-- 효과가 붙어 있는 스킬 Id 전부. 테스트가 스킬 표와 대조하는 데 쓴다.
function BattleSkillEffects.Ids(): { string }
	local ids: { string } = {}
	for id in effects do
		table.insert(ids, id)
	end
	table.sort(ids)
	return ids
end

--[[
	전투를 시작할 때 자원을 채운다. 패시브에 적힌 초기값이다.
]]
function BattleSkillEffects.ApplyStartingStacks(status: BattleStatus.State, classId: string): ()
	for id, amount in ClassResources.StartingStacks(classId) do
		BattleStatus.AddStack(status, id, amount, ClassResources.Cap(id))
	end
	-- 결투사는 공격 태세로 시작한다(md: 태세 전환은 연계로 일어난다).
	if classId == "Duelist" then
		BattleStatus.AddStack(status, R.STANCE_ATTACK, 1, 1)
		BattleStatus.AddModifier(status, "DamageTaken", 0.15, -1, "태세")
		BattleStatus.AddModifier(status, "DamageDealt", 0.2, -1, "태세")
		BattleStatus.AddModifier(status, "CritChance", 0.1, -1, "태세")
	end
end

return BattleSkillEffects
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">BattleSkills</string>
          <string name="Source"><![CDATA[--!strict
--[[
	BattleSkills — 전투 스킬의 범위와 피해.

	사양 출처: 추가&수정.md `##### 배치 및 전투`, 그리고 사용자가 직접 지정한 범위표.

	원래 이 표는 `Battle3DController`(클라이언트 시험판) 안에 있었다. 서버가 판정을
	가지게 되면서 **양쪽이 같은 정의를 봐야** 하므로 공유로 끌어올렸다. 클라이언트가
	미리보기로 칠하는 칸과 서버가 실제로 때리는 칸이 갈라지면, 이런 시스템에서 가장
	고치기 어려운 종류의 버그가 된다.

	범위는 `BattleGrid.Shape`로 적는다. 기준점(origin)은 **그 라인에서 상대가 실제로
	서 있는 칸**이다. 즉 아래 좌표는 전부 "상대가 있는 칸을 (n,n)이라 할 때" 기준이다.

	  Line   Radius r  (n,n)~(n+r-1,n)   앞으로 r칸
	  Row              (0,n)~(6,n)       라인 전체
	  Cross  Radius 1  (n,n),(n±1,n),(n,n±1)
	  Square Radius 1  (n-1,n-1)~(n+1,n+1)

	--------------------------------------------------------------------------
	직업별 스킬

	원래 이 파일에는 스킬 목록이 **하나뿐**이었다. 그래서 어떤 직업을 골라도 똑같은
	5개(찌르기·라인 관통·쌍베기·십자 참·광역 폭발)를 썼다 — 직업 선택이 전투에
	아무 영향을 주지 않는 상태였다.

	이제 `유저 아이디어(직업).md`의 스킬 1·2·3을 직업마다 그대로 옮겨 담는다.
	적은 직업이 없으므로 예전 5개를 **적 전용 목록**으로 남긴다.

	주의: md에서 "피해량: 없음"인 스킬(자가 버프·아군 버프)은 Damage 0으로 들어간다.
	상태이상 로직이 아직 없어서 지금은 실제로 아무 일도 하지 않는다.
]]

local BattleGrid = require(script.Parent.BattleGrid)
local ClassResources = require(script.Parent.ClassResources)

--[[
	사거리 태그.

	  Melee       근거리. 붙어서 때리거나 자신·아군에게 쓰는 것.
	  Ranged      원거리. 활·빔·투척처럼 떨어져서 닿는 것.
	  Supporting  서포팅. 버프·회복처럼 아군을 대상으로 하는 것(요청).

	격자 규칙(라인)과는 별개다 — 사거리는 **연출과 카드 조건**을 가르는 값이고,
	실제로 어느 칸을 덮는지는 `Shape`가 정한다. 둘을 섞으면 "원거리인데 앞 1칸만
	때린다" 같은 조합을 표현할 수 없다. 아군을 향해 쏘는지는 이 값이 아니라
	`Shape.TargetSide`가 정한다 — Supporting이어도 자기 진영을 찍지 않을 수
	있고(예: 아군 전체 버프는 Shape가 필요 없다), 반대로 Melee인데
	`TargetSide = "Ally"`인 것도 있을 수 있다(예: 자해 스킬).
]]
export type SkillRange = "Melee" | "Ranged" | "Supporting"

export type Skill = {
	Id: string,
	Name: string,
	--[[
		한 줄 설명. 스킬 바에 마우스를 올리면 뜬다.

		`config_editor.html`에서 직접 고친다 — 스킬이 무엇을 하는지가 코드에만
		있으면 밸런스를 만지는 사람이 매번 소스를 열어야 한다.
	]]
	Description: string?,
	Damage: number,
	Range: SkillRange,
	Shape: BattleGrid.Shape,
	--[[
		강화 스킬(`upgradeSkills`)만 채운다 — 그 직업 3번 오른쪽에 열리는 스킬임을
		뜻한다. 기본 스킬은 이미 `classSkills[classId]`에 속해 있어 안 채운다.
		편집기가 "직업 능력" 탭에서 어느 직업 자리에 이 강화 스킬을 같이 보여줄지
		이 값 하나로 정한다.
	]]
	ClassId: string?,
	--[[
		**조건부로 범위가 늘어나는 자원.** `ClassResources`의 Id 문자열이다(예:
		음악가 16분음표). 캐스터가 이 자원을 든 개수만큼 `Shape.Stages`가 차례로
		켜진다. `BattleSkills`는 자원 상한·저장소를 모르므로 여기선 이름만
		들고, 실제 개수 세기는 부르는 쪽(`GridBattle`)이 한다 — Radius가 그렇듯
		"얼마나 커지는가"는 스킬 데이터에, "지금 몇인가"는 전투 상태에 둔다.
	]]
	GrowResource: string?,
	-- 자원 몇 개당 한 칸 느는지. 비우면 1개당 한 칸(기본값).
	GrowDivisor: number?,
	--[[
		**모션 단계.** 앞뒤관통처럼 한 번 쓸 때 서로 다른 칸을 순서대로 때리는
		스킬을 위한 것(요청: "모션상 단계... 결투사의 앞뒤관통의 경우에
		써야됨"). `Shape`가 첫 모션이고, 여기 담긴 것들이 그 뒤를 잇는다.

		`Shape.Stages`(조건부 단계)와는 다른 축이다 — 조건부 단계는 자원이
		쌓일수록 **범위가 넓어지는 것**(한 번의 타격)이고, 모션은 **몇 번,
		어디를 차례로 때리는가**(여러 번의 타격)다. 자원 조건과 무관하게 쓸
		때마다 전부 발동하고, **모션마다 `Damage`만큼 따로 입힌다** — 앞뒤관통이
		"9 × 2(합 18)"인 것처럼, `Damage`는 한 모션의 피해량이지 합계가 아니다.
	]]
	Motions: { BattleGrid.Shape }?,
	--[[
		**재사용 대기 턴.** `유저 아이디어(직업).md`에 스킬마다 "재사용 대기
		N턴"으로 이미 적혀 있던 값인데, 옮겨 담을 자리가 없어 빠져 있었다
		(요청: "직업 능력 탭에서 액티브 스킬 쿨타임 쓰는 칸이 없어"). 비우거나
		0이면 매 턴 다시 쓸 수 있다. 실제로 막는 것(캐스터가 지금 몇 턴
		남았는지 세는 것)은 `GridBattle`의 `Unit.Cooldowns`가 한다 — Radius가
		그렇듯 "얼마나 기다리는가"는 스킬 데이터에, "지금 몇 턴 남았는가"는
		전투 상태에 둔다.
	]]
	Cooldown: number?,
}

-- 적 전용. 적은 직업이 없으므로 이 다섯을 무작위로 고른다.
local enemySkills: { Skill } = {
	{
		Id = "Thrust",
		Name = "찌르기",
		Description = "앞으로 파고들어 한 점을 깊게 찌른다.",
		Damage = 40,
		Range = "Melee",
		Shape = { Kind = "Line", Radius = 2 },
