--[[
	한 카드가 여러 가지를 하는 경우, 표에 줄을 나눠 적고 여기서 묶는다.

	예: 벼랑 끝은 "피해 +8%"와 "받는 회복 −50%" 둘이라 `Berserker_E_Brink`와
	`Berserker_E_BrinkCost`로 나눠 적었다. 카드 Id 하나가 두 줄을 가리키게 한다.
]]
local EXTRA: { [string]: { string } } = {
	Berserker_E_Brink = { "Berserker_E_BrinkCost" },
	Berserker_C_BloodPact = { "Berserker_C_BloodPactCost" },
	Berserker_R_Reckless = { "Berserker_R_RecklessCost" },
}

--=== 계산 ===--

-- 레벨을 먹인 기본 수치.
local function amountFor(def: Def, level: number): number
	if def.StepFrom and def.StepValue then
		return if level >= def.StepFrom then def.StepValue else def.Base
	end
	return def.Base + (def.PerLevel or 0) * math.max(level - 1, 0)
end

local function stackTotal(status: BattleStatus.State, ids: { string }?): number
	local total = 0
	for _, id in ids or {} do
		total += BattleStatus.Stack(status, id)
	end
	return total
end

local function passes(def: Def, ctx: Context): boolean
	if def.When == nil then
		return true
	elseif def.When == "HealthBelow" then
		return ctx.MaxHealth > 0 and ctx.Health / ctx.MaxHealth < (def.WhenRatio or 0)
	elseif def.When == "StackAtLeast" then
		return stackTotal(ctx.Status, def.WhenIds) >= (def.WhenAmount or 1)
	elseif def.When == "NotesFull" then
		local notes = stackTotal(ctx.Status, R.NOTE_IDS)
		return notes > 0 and notes >= ClassResources.NoteCap(ctx.Meter)
	end
	return false
end

-- 비례 계수. Per가 없으면 1이다.
local function scale(def: Def, ctx: Context): number
	if def.Per == nil then
		return 1
	elseif def.Per == "Stack" then
		return stackTotal(ctx.Status, def.PerIds)
	elseif def.Per == "LostTenth" then
		if ctx.MaxHealth <= 0 then
			return 0
		end
		return math.floor((1 - ctx.Health / ctx.MaxHealth) * 10)
	elseif def.Per == "FaithTen" then
		return math.floor(ctx.Faith / 10)
	end
	return 0
end

local function runOne(def: Def, level: number, ctx: Context): boolean
	if not passes(def, ctx) then
		return false
	end

	local value = amountFor(def, level) * scale(def, ctx)
	if def.Cap then
		-- 상한은 절대값 기준이다. 감소 보정(−)도 같은 한 줄로 막힌다.
		value = math.clamp(value, -def.Cap, def.Cap)
	end
	if value == 0 then
		return false
	end

	if def.Modifier then
		BattleStatus.AddModifier(ctx.Status, def.Modifier, value, def.Turns or 1, "Card")
		return true
	end

	local give = def.Give
	if give == "Stack" and def.Id then
		--[[
			자원은 정수다. 메트로놈처럼 "3턴마다 1개"인 카드는 매 턴 0.34씩 넣어
			소수로 쌓아 두고, 1을 넘을 때만 실제로 얹는다 — 턴 카운터를 따로 들고
			다니지 않으려는 것이다.
		]]
		local pending = BattleStatus.Stack(ctx.Status, def.Id .. "Pending") + value
		local whole = math.floor(pending)
		if whole > 0 then
			BattleStatus.AddStack(ctx.Status, def.Id, whole, ClassResources.Cap(def.Id))
		end
		BattleStatus.SpendAll(ctx.Status, def.Id .. "Pending")
		BattleStatus.AddStack(ctx.Status, def.Id .. "Pending", pending - whole)
		return whole > 0
	elseif give == "Shield" then
		BattleStatus.AddShield(ctx.Status, math.floor(value))
		return true
	elseif give == "ShieldRatio" then
		BattleStatus.AddShield(ctx.Status, math.floor(ctx.MaxHealth * value))
		return true
	elseif give == "Faith" then
		ctx.AddFaith(math.floor(value))
		return true
	elseif give == "Stamina" then
		ctx.AddStamina(math.floor(value))
		return true
	elseif give == "Taunt" then
		ctx.AddTaunt(math.floor(value))
		return true
	elseif give == "Heal" then
		ctx.Heal(math.floor(ctx.MaxHealth * value))
		return true
	elseif give == "LoseHealth" then
		ctx.LoseHealth(math.floor(ctx.MaxHealth * value))
		return true
	end
	return false
end

--=== 바깥에서 쓰는 것 ===--

--[[
	이 훅에 걸린 카드를 전부 발동한다. 실제로 뭔가 일어난 카드 수를 돌려준다.

	보유 카드 목록(`TowerRun.Cards`)을 그대로 넘기면 된다. 표에 없는 Id는 조용히
	넘어간다 — 아직 붙지 않은 카드가 전투를 멈추면 안 된다.
]]
function CardEffects.Apply(hook: Hook, cards: { Owned }, ctx: Context): number
	local fired = 0
	for _, owned in cards do
		local ids = { owned.CardId }
		for _, extra in EXTRA[owned.CardId] or {} do
			table.insert(ids, extra)
		end
		for _, id in ids do
			local def = DEFS[id]
			if def and def.Hook == hook and runOne(def, owned.Level, ctx) then
				fired += 1
			end
		end
	end
	return fired
end

-- 이 카드에 붙은 효과가 있는지. UI가 "미구현" 표시를 하고 싶을 때 쓴다.
function CardEffects.IsWired(cardId: string): boolean
	return DEFS[cardId] ~= nil
end

--[[
	지금 몇 장이 붙어 있는지. 테스트와 개발용 로그가 쓴다.

	`EXTRA`로 나눠 적은 줄은 카드 한 장으로 센다.
]]
function CardEffects.WiredIds(): { string }
	local ids: { string } = {}
	for id in DEFS do
		local isExtra = false
		for _, extras in EXTRA do
			for _, extraId in extras do
				if extraId == id then
					isExtra = true
				end
			end
		end
		if not isExtra then
			table.insert(ids, id)
		end
	end
	table.sort(ids)
	return ids
end

function CardEffects.Coverage(): number
	return #CardEffects.WiredIds()
end

return CardEffects
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">CharacterDefinitions</string>
          <string name="Source"><![CDATA[--!strict
--[[
	직업 정의.

	출처: `유저 아이디어(직업).md`. 기준 직업은 **음악가**이고, 체력·스킬 위력은
	그 문서의 눈금(피해 18~40)을 그대로 쓴다.

	광전사만 이전 로스터에서 남았다. 나머지 9종(기사·수호자·사수·비전술사·성직자·
	연금술사·음유시인·암살자·공예가)은 문서의 직업들로 교체됐다.
]]

export type SkillDefinition = {
	Id: string,
	Name: string,
	Description: string,
	Power: number,
	CooldownTurns: number,
	Target: "Enemy" | "Self" | "Ally" | "Team",
	Effect: "Damage" | "DamageShield" | "Shield" | "Heal" | "Recoil" | "Poison" | "TeamBuff" | "Execute" | "TeamShield",
	MotionId: string,
}

export type CharacterDefinition = {
	Id: string,
	Name: string,
	Role: string,
	Description: string,
	MaxHealth: number,
	MoveSpeed: number,
	BasicPower: number,
	BasicMotionId: string,
	Skill: SkillDefinition,
	Color: Color3,
}

