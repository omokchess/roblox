			.. "추가로 얻은 [꽉 찬 병]이 없다면, 사용한 병 중 {1}개를 반환 한다.",
		Levels = { { 32, 34, 36, 38, 40, 42 }, { 1, 1, 1, 1, 1, 1 } },
