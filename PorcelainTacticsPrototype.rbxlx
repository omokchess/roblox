		Grade = "Essential",
		ClassId = CLASS_ID,
		Tags = { "Anchor" },
	},
	{
		Id = "Quasar_E_BlackHole",
		Name = "블랙홀",
		Description = "초대질량의 확률 발동이 사라지고 항상 발동하되, 감소폭이 {25}%가 된다. 추가로 {5}% 확률로 피해를 완전히 무효화한다.",
		Grade = "Essential",
		ClassId = CLASS_ID,
		Tags = { "Taunt", "Anchor" },
	},
	{
		Id = "Quasar_E_EventHorizon",
		Name = "사건의 지평선",
