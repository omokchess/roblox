--=== 전투 시작 / 종료 ===--

function Battle3DController:Start()
	local character = self.player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end

	self.active = true
	self.startButton.Text = "전투 종료"
	self.bar.Visible = true

	-- 전장 원점: 캐릭터가 선 자리에서 조금 앞
	local origin = CFrame.lookAt(root.Position, root.Position + root.CFrame.LookVector)
	self.layout = BattleArena.NewLayout(origin)

	self.folder = make("Folder", { Name = "Battle3DArena" }, workspace)

	-- 지형에 맞춰 타일을 놓기 위한 레이캐스트 필터 (전장 자체는 제외)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { self.folder, character }
	self.rayParams = params

	self.grid = BattleGrid.New()
	self.enemyGroggy = GroggyGauge.New()
	self.tiles = { Ally = {}, Enemy = {} }

	for _, side in { "Ally", "Enemy" } :: { BattleGrid.Side } do
		for y = 1, self.grid.Height do
			self.tiles[side][y] = {}
			for x = 1, self.grid.Width do
				local cf =
					BattleArena.CellWorldCFrame(self.layout, side, x, y, self.grid.Width, self.grid.Height, params)
				local tile = make("Part", {
					Name = string.format("Tile_%s_%d_%d", side, x, y),
					Anchored = true,
					CanCollide = false,
					Size = BattleArena.TileSize(self.layout),
					CFrame = cf + Vector3.new(0, 0.2, 0),
					Color = TILE_IDLE,
					Material = Enum.Material.SmoothPlastic,
					Transparency = 0.35,
					TopSurface = Enum.SurfaceType.Smooth,
					BottomSurface = Enum.SurfaceType.Smooth,
				}, self.folder)

				-- 아군 칸은 드래그로 옮긴다(_beginDrag). 공격 조준은 라인 자동이라 클릭이 없다.

				self.tiles[side][y][x] = tile
			end
		end
	end

	-- 적 더미를 세운다
	self.enemyModel = self:_spawnEnemy()
	BattleGrid.Place(self.grid, "enemy", "Enemy", self.enemyCell.X, self.enemyCell.Y)
	self:_pickEnemySkill()
	BattleGrid.Place(self.grid, "player", "Ally", self.playerCell.X, self.playerCell.Y)

	-- 캐릭터를 떠 있는 말로 만들고(조작 차단 + 앵커) 자기 칸에 놓는다
	self:_setBattlePose(true)
	self:_moveCharacterTo(self.playerCell.X, self.playerCell.Y)
	self:_faceRight() -- 사양: 턴 시작 시 항상 오른쪽(적 진영)을 바라본다

	-- 사양: 카메라를 Brown Dust식으로 고정
	self:_lockCamera()
	self:_paintTiles()

	-- 적 마우스오버 미리보기 루프
	self.hoverConn = RunService.RenderStepped:Connect(function()
		self:_updateHover()
	end)
end

function Battle3DController:Stop()
	self.active = false
	self:_endDrag()
	if self.hoverConn then
		self.hoverConn:Disconnect()
		self.hoverConn = nil
	end
	if self.hoverPanel then
		self.hoverPanel.Visible = false
	end

	-- 앵커를 풀기 전에 지면으로 내려놓는다. 안 그러면 떠 있던 높이에서 떨어진다.
	local root = self:_root()
	if root and self.rayParams then
		local hit = workspace:Raycast(root.Position, Vector3.new(0, -200, 0), self.rayParams)
		if hit then
			root.CFrame = CFrame.new(hit.Position + Vector3.new(0, 3.5, 0))
		end
	end

	self:_setBattlePose(false)
	self.startButton.Text = "전투 시작 (3D)"
	self.bar.Visible = false
	self:_endQte()

	if self.folder then
		self.folder:Destroy()
		self.folder = nil
	end
	if self.enemyModel then
		self.enemyModel:Destroy()
		self.enemyModel = nil
	end

	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	if self.player.Character then
		camera.CameraSubject = self.player.Character:FindFirstChildWhichIsA("Humanoid")
	end
end

-- 적 더미: R6 형태의 간단한 모델
function Battle3DController:_spawnEnemy(): Model
	local model = make("Model", { Name = "BattleDummy" }, workspace)
	local cf = BattleArena.CellWorldCFrame(
		self.layout,
		"Enemy",
		self.enemyCell.X,
		self.enemyCell.Y,
		self.grid.Width,
		self.grid.Height,
		self.rayParams
	)

	-- 칸(5스터드)에 들어가는 크기. R6 아바타와 비슷하게 잡는다.
	local torso = make("Part", {
		Name = "Torso",
		Anchored = true,
		CanCollide = false,
		Size = Vector3.new(2, 2, 1),
		CFrame = cf + Vector3.new(0, ENEMY_TORSO_HEIGHT, 0),
		Color = Color3.fromRGB(150, 60, 60),
		Material = Enum.Material.SmoothPlastic,
	}, model)
	make("Part", {
		Name = "Head",
		Anchored = true,
		CanCollide = false,
		Size = Vector3.new(1.2, 1.2, 1.2),
		CFrame = cf + Vector3.new(0, ENEMY_HEAD_HEIGHT, 0),
		Color = Color3.fromRGB(180, 90, 90),
		Material = Enum.Material.SmoothPlastic,
	}, model)

	model.PrimaryPart = torso

	-- 머리 위 체력·그로기 표시
	local billboard = make("BillboardGui", {
		Name = "Status",
		Size = UDim2.fromOffset(140, 36),
		StudsOffset = Vector3.new(0, 3.4, 0),
		AlwaysOnTop = true,
	}, torso)
	self.enemyLabel = make("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = Color3.fromRGB(255, 220, 220),
		Font = Enum.Font.GothamBold,
		TextSize = 14,
	}, billboard)

	return model
end

--[[
	적을 랜덤한 칸으로 옮긴다.

	요청: "매 턴마다 적이 랜덤한 위치로 이동하게도 해줘."
	→ 한 번의 공방(플레이어 스킬 + 적 반격, 또는 라인이 달라 빗나간 경우)이
	  끝날 때마다 부른다. `_endTurn()`이 호출 지점을 모은다.

	같은 칸으로 다시 뽑히지 않도록 다른 칸이 나올 때까지 다시 뽑는다
	(칸이 18개뿐이라 반복해도 금방 끝난다. 칸이 1개뿐이면 그냥 둔다).
]]
--[[
	적이 이번 턴에 쓸 스킬을 무작위로 고른다.

	요청: "사용하는 스킬도 랜덤이 되게 해줘."
	플레이어와 같은 SKILLS 목록을 공유한다 — 범위(Shape)·피해가 스킬마다 달라서,
	위협 범위 미리보기도 이제 라인 전체가 아니라 그 스킬이 실제로 닿는 칸만
	정확히 보여준다.
]]
function Battle3DController:_pickEnemySkill()
	self.enemySkill = SKILLS[self.enemyRng:NextInteger(1, #SKILLS)]
end

function Battle3DController:_repositionEnemy()
	if not self.active or not self.enemyModel or not self.layout then
		return
	end

	local totalCells = self.grid.Width * self.grid.Height
	if totalCells <= 1 then
		return
	end

	local nx, ny
	repeat
		nx = self.enemyRng:NextInteger(1, self.grid.Width)
		ny = self.enemyRng:NextInteger(1, self.grid.Height)
	until nx ~= self.enemyCell.X or ny ~= self.enemyCell.Y

	if not BattleGrid.Move(self.grid, "enemy", nx, ny) then
		return
	end
	self.enemyCell = { X = nx, Y = ny }

	local cf =
		BattleArena.CellWorldCFrame(self.layout, "Enemy", nx, ny, self.grid.Width, self.grid.Height, self.rayParams)
	-- PivotTo는 Torso(PrimaryPart)와 Head의 상대 위치를 유지한 채 모델 전체를 옮긴다.
	self.enemyModel:PivotTo(cf + Vector3.new(0, ENEMY_TORSO_HEIGHT, 0))
end

-- 한 공방이 끝날 때 부른다: 적을 새 위치로 옮기고 화면을 갱신한다.
function Battle3DController:_endTurn()
	self:_repositionEnemy()
	self:_pickEnemySkill()
	self:_paintTiles()
end

--=== 카메라 고정 (사양: Brown Dust식) ===--

-- 카메라를 내려다보는 각도. 45도면 격자가 마름모로 잘 보인다.
local CAMERA_PITCH = 45

function Battle3DController:_lockCamera()
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable

	local viewport = camera.ViewportSize
	local aspect = if viewport.Y > 0 then viewport.X / viewport.Y else 16 / 9

	-- 격자 크기와 화각으로 거리를 계산하므로 칸 크기를 바꿔도 전부 담긴다.
	camera.CFrame = BattleArena.FitCameraCFrame(
		self.layout,
		self.grid.Width,
		self.grid.Height,
		camera.FieldOfView,
		aspect,
		CAMERA_PITCH
	)
end

--=== 이동 ===--

function Battle3DController:_onTileClicked(_side: BattleGrid.Side, _x: number, _y: number)
	-- 사양: 공격은 플레이어가 선 세로 라인으로 자동 결정된다. 마우스 조준은 없다.
	-- (적 타일 클릭 기능은 제거됐다. 이 함수는 호출되지 않는다.)
end

--[[
	칸 위 '떠 있는' 위치. 지면에서 FLOAT_HEIGHT만큼 띄운다.
	마우스로 집어 옮기는 방식이라 캐릭터는 항상 공중에 있다.
]]
function Battle3DController:_cellAnchorCFrame(side: BattleGrid.Side, x: number, y: number): CFrame
	local cf = BattleArena.CellWorldCFrame(self.layout, side, x, y, self.grid.Width, self.grid.Height, self.rayParams)
	-- 위치는 칸, 회전은 항상 오른쪽(+X) 바라보기로 고정한다.
	local pos = (cf + Vector3.new(0, FLOAT_HEIGHT, 0)).Position
	local right = self.layout.Origin.RightVector
	return CFrame.lookAt(pos, pos + right)
end

--[[
	턴 시작 시 캐릭터가 항상 오른쪽(+X, 적 진영)을 바라보게 한다.
	아군은 화면 왼쪽에 있고 적은 오른쪽이므로 오른쪽을 봐야 마주 본다.
]]
function Battle3DController:_faceRight()
	local root = self:_root()
	if not root or not self.layout then
		return
	end
	local right = self.layout.Origin.RightVector -- +X = 적 방향
	root.CFrame = CFrame.lookAt(root.Position, root.Position + right)
end

function Battle3DController:_root(): BasePart?
	local character = self.player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

--[[
	캐릭터를 칸으로 옮긴다.

	사양: "마우스로 캐릭터를 잡았다가 원하는 칸에 놓는 식"
	→ 걸어가지 않는다. 집어서 놓는 것이므로 위치를 바로 바꾼다.
]]
function Battle3DController:_moveCharacterTo(x: number, y: number)
	local root = self:_root()
	if not root then
		return
	end
	root.CFrame = self:_cellAnchorCFrame("Ally", x, y)
	self:_syncStand()
end

--[[
	전투 중 캐릭터를 '떠 있는 말'로 만든다.

	사양 두 가지를 함께 처리한다.
	  "전투 시작을 했는데도 캐릭터를 움직일 수 있어" → 직접 조작을 막는다
	  "캐릭터가 공중에 떠있어야 해. 점프 판정이면 안 돼" → 앵커 + 낙하/점프 상태 차단

	HumanoidRootPart를 앵커하면 물리로 떨어지지 않는다. 다만 그것만으로는
	Humanoid가 Freefall로 판정해 낙하 애니메이션이 나오므로 관련 상태를 꺼 준다.
]]
--[[
	전투 중 캐릭터를 '떠 있는 말'로 만든다.

	사양 두 가지를 함께 처리한다.
	  "전투 시작을 했는데도 캐릭터를 움직일 수 있어"      → 직접 조작을 막는다
	  "캐릭터가 공중에 떠있어야 해. 점프 판정이면 안 돼"  → 낙하·점프 판정을 없앤다

	점프 판정을 막는 방법을 **두 겹으로** 둔다.
	  1) Freefall/Jumping/FallingDown 상태를 끈다
	  2) 발밑에 보이지 않는 받침을 깔아 Humanoid가 '땅에 서 있다'고 인식하게 한다

	2번이 필요한 이유: 앵커만 하고 상태만 끄면 리그(R6/R15)와 기본 Animate 스크립트에 따라
	낙하 자세가 남을 수 있다. 발밑에 바닥이 실제로 있으면 어떤 리그에서도 서 있는 판정이 된다.
]]
function Battle3DController:_setBattlePose(enabled: boolean)
	local character = self.player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildWhichIsA("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?

	if humanoid then
		humanoid.WalkSpeed = if enabled then 0 else 16
		humanoid.JumpPower = if enabled then 0 else 50
		humanoid.AutoRotate = not enabled

		for _, state in
			{
				Enum.HumanoidStateType.Freefall,
				Enum.HumanoidStateType.Jumping,
				Enum.HumanoidStateType.FallingDown,
			}
		do
			humanoid:SetStateEnabled(state, not enabled)
		end

		if enabled then
			humanoid:ChangeState(Enum.HumanoidStateType.Running)
		end
	end

	if enabled then
		-- 발밑 받침. 보이지 않지만 충돌은 한다.
		if not self.standPlatform then
			self.standPlatform = make("Part", {
				Name = "BattleStand",
				Anchored = true,
				CanCollide = true,
				Transparency = 1,
				Size = Vector3.new(4, 0.4, 4),
				CFrame = CFrame.new(0, -500, 0),
			}, self.folder)
		end
		self:_syncStand()
	else
		if self.standPlatform then
			self.standPlatform:Destroy()
			self.standPlatform = nil
		end
	end

	if root then
		root.Anchored = enabled
	end
end

-- 받침을 캐릭터 발밑으로 옮긴다. 캐릭터를 옮길 때마다 부른다.
function Battle3DController:_syncStand()
	local root = self:_root()
	if not root or not self.standPlatform then
		return
	end
	local character = self.player.Character
	local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
	local hipHeight = if humanoid then humanoid.HipHeight else 2
	-- 루트 밑 (엉덩이 높이 + 다리 절반)만큼 내려가면 발바닥이다
	self.standPlatform.CFrame = CFrame.new(root.Position - Vector3.new(0, hipHeight + 1.2, 0))
end

--=== 드래그 앤 드롭 ===--
--[[
	사양: "캐릭터는 마우스로 캐릭터를 잡았다가, 원하는 칸에 놓는 식"

	체스 말처럼 집어 옮긴다.
	  누르기  → 캐릭터를 집는다. 놓을 수 있는 아군 칸이 초록으로 표시된다
	  끌기    → 캐릭터가 커서를 따라 공중에 뜬 채 움직인다
	  떼기    → 커서 아래 아군 칸에 놓는다. 칸 밖이면 원래 자리로 돌아간다

	걸어가지 않으므로 이동 애니메이션도, 점프 판정도 생기지 않는다.
]]

-- 타일 파트만 모은다 (레이캐스트 필터용)
function Battle3DController:_allTiles(): { BasePart }
	local list: { BasePart } = {}
	for _, side in { "Ally", "Enemy" } :: { BattleGrid.Side } do
		local rows = self.tiles[side]
		if rows then
			for _, row in rows do
				for _, tile in row do
					table.insert(list, tile)
				end
			end
		end
	end
	return list
end

-- 커서 아래에 있는 타일을 찾는다. (타일만 맞도록 필터한다)
function Battle3DController:_tileUnderCursor(): (BattleGrid.Side?, number?, number?)
	local camera = workspace.CurrentCamera
	local mouse = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)

	--[[
		타일만 포함시킨다. folder 전체를 넣으면 발밑 받침(BattleStand)이
		커서 레이를 먼저 막아 타일을 못 찾는다.
	]]
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = self:_allTiles()

	local hit = workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
	if not hit then
		return nil, nil, nil
	end

	-- 타일 이름에 좌표를 박아 두었으므로 그대로 읽는다
	local side, x, y = hit.Instance.Name:match("^Tile_(%a+)_(%d+)_(%d+)$")
	if not side then
		return nil, nil, nil
	end
	return side :: BattleGrid.Side, tonumber(x), tonumber(y)
end

function Battle3DController:_beginDrag()
	if not self.active or self.qte or self.dragging then
		return
	end
	-- 캐릭터를 눌렀을 때만 집는다
	local side, x, y = self:_tileUnderCursor()
	local onSelf = side == "Ally" and x == self.playerCell.X and y == self.playerCell.Y
	if not onSelf and not self:_cursorOnCharacter() then
		return
	end

	self.dragging = true
	self.dragConn = RunService.RenderStepped:Connect(function()
		self:_updateDrag()
	end)
	self:_paintTiles()
end

-- 커서가 캐릭터 위에 있는지 (타일보다 캐릭터가 앞에 있을 때)
function Battle3DController:_cursorOnCharacter(): boolean
	local character = self.player.Character
	if not character then
		return false
	end
	local camera = workspace.CurrentCamera
	local mouse = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { character }

	return workspace:Raycast(ray.Origin, ray.Direction * 2000, params) ~= nil
end

-- 끄는 동안 캐릭터가 커서를 따라다닌다 (항상 공중)
function Battle3DController:_updateDrag()
	local root = self:_root()
	if not root or not self.dragging then
		return
	end

	local side, x, y = self:_tileUnderCursor()
	if side == "Ally" and x and y then
		-- 놓을 수 있는 칸 위면 그 칸에 스냅해 보여 준다
		root.CFrame = self:_cellAnchorCFrame("Ally", x, y)
		self:_syncStand()
		self.dragHover = { X = x, Y = y }
	else
		self.dragHover = nil
	end
	self:_paintTiles()
end

function Battle3DController:_endDrag()
	if self.dragConn then
		self.dragConn:Disconnect()
		self.dragConn = nil
	end
	if not self.dragging then
		return
	end
	self.dragging = false

	local hover = self.dragHover
	self.dragHover = nil

	if hover and BattleGrid.Move(self.grid, "player", hover.X, hover.Y) then
		self.playerCell = { X = hover.X, Y = hover.Y }
	end
	-- 놓지 못했으면 원래 칸으로 되돌린다
	self:_moveCharacterTo(self.playerCell.X, self.playerCell.Y)
	self:_paintTiles()
end

--=== 타일 색칠 (사양: 범위는 붉게) ===--

--[[
	스킬이 붉게 칠할 상대 칸 목록 (미리보기 = 실제 대상과 같은 규칙).

	origin은 **공격자가 선 라인(lane)에서 상대가 실제로 서 있는 칸**이다
	(요청: "적을 조준했을 때 좌표가 그대로 반영돼야 한다"). BattleGrid.CellsInShape가
	그 origin 기준으로 skill.Shape를 펼친다 — Cross·Square는 origin의 라인뿐
	아니라 위아래 라인까지도 이 한 번의 호출로 알아서 나온다.

	Row(라인 관통)는 origin의 X를 쓰지 않으므로 상대가 없어도 라인 전체를
	그대로 칠한다. 그 외 모양은 그 라인에 상대가 없으면 아예 칸을 넣지 않는다
	— 없는 상대 자리에 동떨어진 칸 하나가 붉게 뜨는 것("가중치 표시가
	이상하다")을 막는다.
]]
--[[
	계산은 공유 모듈에 맡긴다. 여기 있던 구현은 `BattleSkills.Cells`와 글자까지 같은
	사본이었다 — 스킬 표에 이어 **판정 규칙까지 두 벌**이었던 셈이다. 한쪽만 고치면
	클라가 칠하는 칸과 서버가 때리는 칸이 어긋난다.
]]
function Battle3DController:_skillCells(attackerSide: BattleGrid.Side, lane: number, skill): { BattleGrid.Cell }
	return BattleSkills.Cells(self.grid, attackerSide, lane, skill.Shape)
end

function Battle3DController:_skillTargets(attackerSide: BattleGrid.Side, lane: number, skill): { string }
	return BattleSkills.Targets(self.grid, attackerSide, lane, skill.Shape)
end

-- 스킬 사정을 사람이 읽는 문장으로.
local function skillRangeText(skill): string
	local shape = skill.Shape
	if shape.Kind == "Row" then
		return "라인 전체"
	elseif shape.Kind == "Line" then
		return string.format("앞 %d칸", shape.Radius or 1)
	elseif shape.Kind == "Cross" then
		return "십자 범위"
	elseif shape.Kind == "Square" then
		local width = (shape.Radius or 1) * 2 + 1
		return string.format("%d×%d 범위", width, width)
	end
	return "범위"
end

function Battle3DController:_paintTiles()
	if not self.active then
		return
	end
	local skill = SKILLS[self.selectedSkill]

	-- 공격 대상 라인 = 플레이어가 선 세로 라인 (사양: 마우스로 정하지 않는다)
	local inRange: { [string]: boolean } = {}
	for _, cell in self:_skillCells("Ally", self.playerCell.Y, skill) do
		inRange[cell.X .. "," .. cell.Y] = true
	end

	--[[
		적 공격 라인 상시 미리보기 (사양: 적 공격 범위도 미리보기).
		적도 이제 매 턴 스킬을 랜덤으로 고르므로, 위협 범위는 그 스킬의
		실제 범위(Shape)로 정확히 계산한다 — 라인 전체를 뭉뚱그리지 않는다.
		(_skillCells가 플레이어 스킬 미리보기와 같은 함수라 계산 방식이 어긋나지 않는다)
	]]
	local threatLane = self.enemyCell.Y
	local threatened_: { [string]: boolean } = {}
	for _, cell in self:_skillCells("Enemy", threatLane, self.enemySkill) do
		threatened_[cell.X .. "," .. cell.Y] = true
	end

	for y = 1, self.grid.Height do
		for x = 1, self.grid.Width do
			local allyTile = self.tiles.Ally[y][x]
			local isMe = self.playerCell.X == x and self.playerCell.Y == y
			local hovered = self.dragHover and self.dragHover.X == x and self.dragHover.Y == y
			local threatened = threatened_[x .. "," .. y] == true
			if self.dragging then
				-- 집고 있는 동안엔 놓을 수 있는 칸을 초록으로 보여 준다
				allyTile.Color = if hovered then TILE_DROP else TILE_IDLE
				allyTile.Transparency = if hovered then 0.05 else 0.3
			elseif isMe and threatened then
				-- 지금 서 있는 라인이 적의 공격 라인과 같다 → 위험
				allyTile.Color = TILE_DANGER
				allyTile.Transparency = 0.08
			elseif isMe then
				allyTile.Color = TILE_ALLY
				allyTile.Transparency = 0.15
			elseif threatened then
				allyTile.Color = TILE_THREAT
				allyTile.Transparency = 0.35
			else
				allyTile.Color = TILE_IDLE
				allyTile.Transparency = 0.45
			end

			local foeTile = self.tiles.Enemy[y][x]
			local hot = inRange[x .. "," .. y] == true
			local occupied = BattleGrid.Occupant(self.grid, "Enemy", x, y) ~= nil
			foeTile.Color = if hot then TILE_RANGE elseif occupied then TILE_OCCUPIED else TILE_IDLE
			foeTile.Transparency = if hot then 0.1 else 0.45
		end
	end

	for index, button in self.skillButtons do
		button.BackgroundColor3 = if index == self.selectedSkill
			then Color3.fromRGB(70, 90, 140)
			else Color3.fromRGB(48, 52, 62)
	end

	local targets = self:_skillTargets("Ally", self.playerCell.Y, skill)
	local playerInDanger = threatened_[self.playerCell.X .. "," .. self.playerCell.Y] == true
	local threatNote =
		string.format(" · 적 스킬 %s(사정 %s)", self.enemySkill.Name, skillRangeText(self.enemySkill))
	if playerInDanger then
		threatNote ..= " ⚠ 위험!"
	end
	self.status.Text = string.format(
		"%s · 기본 %d · 내 라인(%d)의 적 %d명   |   드래그로 라인 이동%s",
		skill.Name,
		skill.Damage,
		self.playerCell.Y,
		#targets,
		threatNote
	)
	self:_refreshEnemyLabel()
end

--=== 적 마우스오버 스킬 미리보기 ===--

--[[
	커서 아래의 적을 찾는다. 적 타일(Tile_Enemy_x_y)이나 적 모델을 맞히면
	그 적의 칸 (x, y)을 돌려준다. 없으면 nil.
]]
function Battle3DController:_enemyUnderCursor(): (number?, number?)
	local camera = workspace.CurrentCamera
	local mouse = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	local include: { Instance } = {}
	if self.folder then
		table.insert(include, self.folder)
	end
	if self.enemyModel then
		table.insert(include, self.enemyModel)
	end
	params.FilterDescendantsInstances = include

	local hit = workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
	if not hit then
		return nil, nil
	end

	-- 적 모델을 맞혔으면 적 칸을 그대로 쓴다.
	if self.enemyModel and hit.Instance:IsDescendantOf(self.enemyModel) then
		return self.enemyCell.X, self.enemyCell.Y
	end

	-- 적 타일이면 이름에서 좌표를 읽는다. 실제 유닛이 있는 칸만 대상.
	local sx, x, y = hit.Instance.Name:match("^Tile_(%a+)_(%d+)_(%d+)$")
	if sx == "Enemy" then
		local cx, cy = tonumber(x), tonumber(y)
		if BattleGrid.Occupant(self.grid, "Enemy", cx, cy) then
			return cx, cy
		end
	end
	return nil, nil
end

--[[
	미리보기 갱신. 전투 중 매 프레임 돈다.
	적 위에 커서가 있으면 지금 선택한 스킬이 그 적을 맞히는지, 예상 피해를 보여 준다.
	공격 대상은 마우스가 아니라 플레이어의 세로 라인으로 정해지므로,
	"이 적이 내 라인 안이라 맞는지"를 알려 주는 것이 핵심이다.
]]
function Battle3DController:_updateHover()
	if not self.active or self.qte or self.dragging or not self.hoverPanel then
		if self.hoverPanel then
			self.hoverPanel.Visible = false
		end
		return
	end

	local ex, ey = self:_enemyUnderCursor()
	if not ex then
		self.hoverPanel.Visible = false
		return
	end

	local skill = SKILLS[self.selectedSkill]
	-- 이 스킬이 실제로 맞히는 적 칸 목록 (플레이어 라인 기준)
	local hitCells = self:_skillCells("Ally", self.playerCell.Y, skill)
	local willHit = false
	for _, cell in hitCells do
		if cell.X == ex and cell.Y == ey then
			willHit = true
			break
		end
	end

	self.hoverTitle.Text = skill.Name
	if willHit then
		self.hoverTitle.TextColor3 = Color3.fromRGB(255, 210, 120)
		self.hoverBody.Text = string.format(
			"이 적을 맞힙니다\n피해 %d  (QTE ×0.5~1.2)  ·  사정 %s",
			skill.Damage,
			skillRangeText(skill)
		)
	else
		self.hoverTitle.TextColor3 = Color3.fromRGB(150, 155, 170)
		self.hoverBody.Text = string.format(
			"내 라인(%d)이 아니라 못 맞힙니다\n%d번 라인으로 이동하거나 다른 스킬을 고르세요",
			self.playerCell.Y,
			ey
		)
	end

	-- 패널을 커서 오른쪽 아래에 붙인다 (화면 밖으로 안 나가게)
	local mouse = UserInputService:GetMouseLocation()
	local vp = workspace.CurrentCamera.ViewportSize
	local px = math.min(mouse.X + 16, vp.X - 230)
	local py = math.min(mouse.Y + 12, vp.Y - 84)
	self.hoverPanel.Position = UDim2.fromOffset(px, py)
	self.hoverPanel.Visible = true
end

function Battle3DController:_refreshEnemyLabel()
	if not self.enemyLabel then
		return
	end
	self.enemyLabel.Text = string.format(
		"그로기 %d/%d%s",
		self.enemyGroggy.Value,
		GroggyGauge.MAX,
		if GroggyGauge.IsStunned(self.enemyGroggy) then "  [스턴]" else ""
	)
end

--=== QTE (BattleTestController와 같은 규칙) ===--

function Battle3DController:_startQte(role: QteDefinitions.Role)
	if not self.active or self.qte then
		return
	end
	self:_endQte()

	local random = Random.new(math.floor(os.clock() * 1000))
	local challenge = QteDefinitions.Create(role, function()
		return random:NextNumber()
	end, 0, "b3d", true)

	self.qte = challenge
	self.qteStart = os.clock()
	self.qteFrame.Visible = true
	self.qteTitle.Text =
		string.format("%s — %s", if role == "Skill" then "스킬" else "회피/패리", challenge.Title)

	self.sweepTrack.Visible = challenge.Type == "Sweep"
	self.ringHolder.Visible = challenge.Type == "Forge" or challenge.Type == "Parry"
	self.qteBig.Visible = challenge.Type == "Mash" or challenge.Type == "Directional"
	self.qteHint.Text = if challenge.Type == "Mash"
		then "스페이스 연타"
		elseif challenge.Type == "Directional" then "방향키 / WASD"
		else "스페이스 또는 클릭"

	self.qteConn = RunService.RenderStepped:Connect(function()
		self:_tickQte()
	end)
end

function Battle3DController:_tickQte()
	local challenge = self.qte
	if not challenge then
		return
	end
	local elapsed = (os.clock() - self.qteStart) * 1000
	local state = QteDefinitions.VisualState(challenge, elapsed)

	if challenge.Type == "Sweep" then
		self.sweepCursor.Position = UDim2.fromScale(state.position, 0)
		self.sweepTarget.Position = UDim2.fromScale(math.max(state.targetPosition - state.successGap, 0), 0)
		self.sweepTarget.Size = UDim2.fromScale(state.successGap * 2, 1)
	elseif challenge.Type == "Forge" or challenge.Type == "Parry" then
		local size = math.max(state.outerRadius, 0) * 110
		self.ringMoving.Size = UDim2.fromOffset(size, size)
		self.ringMoving.Position = UDim2.new(0.5, -size / 2, 0.5, -size / 2)
		local targetSize = state.targetRadius * 110
		self.ringTarget.Size = UDim2.fromOffset(targetSize, targetSize)
		self.ringTarget.Position = UDim2.new(0.5, -targetSize / 2, 0.5, -targetSize / 2)
		self.ringMoving.BackgroundTransparency = 1 - (state.indicatorOpacity or 1) * 0.65
	elseif challenge.Type == "Mash" then
		self.qteBig.Text = string.format("%d / %d", state.count, state.goal)
	elseif challenge.Type == "Directional" then
		local arrows = { Up = "↑", Right = "→", Down = "↓", Left = "←" }
		local parts: { string } = {}
		for index, direction in state.expectedDirections do
			local hidden = false
			for _, hiddenIndex in state.hiddenCommandIndexes do
				if hiddenIndex == index then
					hidden = true
					break
				end
			end
			local glyph = if index <= state.sequenceIndex then "·" elseif hidden then "?" else arrows[direction]
			table.insert(parts, glyph)
		end
		self.qteBig.Text = table.concat(parts, " ")
	end

	if elapsed >= challenge.DurationMs then
		self:_resolveQte(elapsed)
	end
end

function Battle3DController:_qteInput(input: string)
	local challenge = self.qte
	if not challenge or not QteDefinitions.IsValidInput(challenge.Type, input) then
		return
	end
	local elapsed = (os.clock() - self.qteStart) * 1000

	if challenge.Type == "Mash" then
		challenge.InputCount += 1
		return
	end

	if challenge.Type == "Directional" then
		local expected = challenge.ExpectedDirections or {}
		local nextIndex = (challenge.SequenceIndex or 0) + 1
		if expected[nextIndex] ~= input then
			challenge.Mistakes = (challenge.Mistakes or 0) + 1
		end
		challenge.SequenceIndex = nextIndex
		if nextIndex >= #expected then
			self:_resolveQte(elapsed)
		end
		return
	end

	self:_resolveQte(elapsed)
end

function Battle3DController:_resolveQte(elapsed: number)
	local challenge = self.qte
	if not challenge then
		return
	end

	local grade = QteDefinitions.Judge(challenge, elapsed)
	local multiplier = QteDefinitions.Multiplier(challenge.Role, grade)
	local gradeText = ({ Success = "성공", Partial = "보통/방어", Fail = "실패" })[grade]

	if challenge.Role == "Skill" then
		local skill = SKILLS[self.selectedSkill]
		--[[
			아군 공격도 적과 완전히 같은 함수(_castAttackRay)로 판정한다
			(요청: "플레이어랑 적이랑 거의 같은 로직을 쓴다고 생각해줘"). "레이저 표시 없애줘"
			요청으로 스킬 선택 중 계속 보이던 지속 조준 빔은 없앴다 — 맞았을 때만 잠깐
			1회성 섬광을 띄운다.
		]]
		local hit, hitPos, origin = self:_castAttackRay("Ally", self.playerCell.Y, skill)
		if hit and hitPos and origin then
			self:_showAttackRay(origin, hitPos, ALLY_HIT_FLASH)
		end
		local damage = math.floor(skill.Damage * multiplier)
		self.status.Text = string.format(
			"[스킬] %s → %s ×%.1f = %d, %s",
			skill.Name,
			gradeText,
			multiplier,
			damage,
			if hit then "명중" else "빗나감"
		)
		self:_flashEnemy(hit)
		self:_endQte()

		--[[
			적도 같은 규칙으로 반격한다. 같은 `_castAttackRay`를 attackerSide만
			"Enemy"로 바꿔 쓴다 — 적이 고른 랜덤 스킬의 범위(Shape)만큼
			아군 쪽으로 실제 레이를 쏴서, 플레이어 캐릭터에 물리적으로 닿는지 본다.
			(요청: "적의 공격 위치도 레이캐스트로 쭉 가다가 플레이어한테 닿았을 때
			 거기서부터 공격 위치를 정하도록")
		]]
		task.delay(0.5, function()
			if not self.active then
				return
			end
			local enemyLane = self.enemyCell.Y
			local playerHit, hitPosition, eOrigin = self:_castAttackRay("Enemy", enemyLane, self.enemySkill)
			self.lastEnemyHitPosition = hitPosition
			if playerHit and hitPosition and eOrigin then
				self:_showAttackRay(eOrigin, hitPosition, ENEMY_HIT_FLASH)
			end

			if playerHit then
				self:_startQte("Dodge") -- 레이가 실제로 닿았다 → 회피/패리 QTE
			else
				self.status.Text = string.format(
					"적이 %s(으)로 공격했지만 사정 밖이라 빗나갔다. (라인 %d, 사정 %s)",
					self.enemySkill.Name,
					enemyLane,
					skillRangeText(self.enemySkill)
				)
				-- 반격이 빗나가도 한 공방은 끝난 것이므로 적이 다음 위치로 옮긴다.
				self:_endTurn()
			end
		end)
		return
	end

	local taken = math.floor(self.enemySkill.Damage * multiplier)
	local groggyGain = QteDefinitions.GroggyGain(challenge, grade)
	local stunned = false
	if groggyGain > 0 then
		stunned = GroggyGauge.Add(self.enemyGroggy, groggyGain)
	end

	self.status.Text = string.format(
		"[피격] %s ×%.1f = %d 받음%s%s",
		gradeText,
		multiplier,
		taken,
		if groggyGain > 0 then string.format(" / 적 그로기 +%d", groggyGain) else "",
		if stunned then "  ★ 스턴!" else ""
	)

	if GroggyGauge.IsStunned(self.enemyGroggy) then
		GroggyGauge.TickTurn(self.enemyGroggy)
	end

	self:_endQte()
	-- 회피/패리 판정까지 끝나면 한 공방이 완전히 마무리된 것 → 적이 다음 위치로 옮긴다.
	self:_endTurn()
end

--[[
	skill.Shape가 펼치는 칸들을 라인(Y)별로 (최소 X ~ 최대 X) 구간으로 묶어,
	각 라인마다 그 구간을 잇는 레이 하나씩을 만든다.

	요청: "적의 공격 위치도 레이캐스트로 쭉 가다가 플레이어한테 닿았을 때
	       거기서부터 공격 위치를 정하도록. 플레이어랑 적이랑 거의 같은 로직을
	       쓴다고 생각해줘." → attackerSide만 바꾸면 아군·적이 같은 계산을 쓴다.

	레이는 라인당 직선 하나뿐이라, 십자·사각처럼 옆 라인까지 퍼지는 모양은
	라인별 구간으로 근사한다(그 라인에서 모양이 닿는 가장 앞~뒤 칸을 잇는다).
	_skillCells와 완전히 같은 칸 목록에서 뽑으므로 미리보기와 실제 판정이
	어긋나지 않는다.
]]
function Battle3DController:_shapeRaySegments(
	attackerSide: BattleGrid.Side,
	lane: number,
	skill
): { { Lane: number, From: Vector3, To: Vector3 } }
	if not self.layout then
		return {}
	end
	local targetSide = BattleGrid.Opposing(attackerSide)

	local byLane: { [number]: { MinX: number, MaxX: number } } = {}
	for _, cell in self:_skillCells(attackerSide, lane, skill) do
		local group = byLane[cell.Y]
		if not group then
			byLane[cell.Y] = { MinX = cell.X, MaxX = cell.X }
		else
			group.MinX = math.min(group.MinX, cell.X)
			group.MaxX = math.max(group.MaxX, cell.X)
		end
	end

	local segments = {}
	for laneY, range in byLane do
		local fromOffset =
			BattleArena.CellOffset(self.layout, targetSide, range.MinX - 0.5, laneY, self.grid.Width, self.grid.Height)
		local toOffset =
			BattleArena.CellOffset(self.layout, targetSide, range.MaxX + 0.5, laneY, self.grid.Width, self.grid.Height)
		local fromPos = (self.layout.Origin * CFrame.new(fromOffset)).Position + Vector3.new(0, 3, 0)
		local toPos = (self.layout.Origin * CFrame.new(toOffset)).Position + Vector3.new(0, 3, 0)
		table.insert(segments, { Lane = laneY, From = fromPos, To = toPos })
	end
	return segments
end

--[[
	공격 판정 — 아군과 적이 완전히 같은 함수를 쓴다(attackerSide로만 갈린다).

	요청: "적의 공격 위치도 레이캐스트로 쭉 가다가 플레이어한테 닿았을 때
	       거기서부터 공격 위치를 정하도록. 플레이어랑 적이랑 거의 같은 로직을 쓴다고 생각해줘."

	Ally가 쏘면 적 모델에, Enemy가 쏘면 플레이어 캐릭터에 닿는지를 물리적으로
	확인한다. 모양이 여러 라인에 걸치면(십자·사각) 라인마다 따로 쏜다.
	**순수 함수라 이 자체로는 아무것도 그리지 않는다** — 명중 순간의 1회성
	섬광(_showAttackRay)이 이 결과를 그린다.

	반환: 맞았는지, 맞았다면 그 지점(공격 위치)과 맞은 레이의 시작점(연출용).
]]
function Battle3DController:_castAttackRay(
	attackerSide: BattleGrid.Side,
	centerLane: number,
	skill
): (boolean, Vector3?, Vector3?)
	local targetInstance = if attackerSide == "Enemy" then self.player.Character else self.enemyModel
	if not targetInstance then
		return false, nil, nil
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { targetInstance }

	for _, segment in self:_shapeRaySegments(attackerSide, centerLane, skill) do
		local hit = workspace:Raycast(segment.From, segment.To - segment.From, params)
		if hit then
			return true, hit.Position, segment.From
		end
	end
	return false, nil, nil
end

--[[
	1회성 섬광 — 실제로 판정이 난 순간(QTE 결과가 나왔을 때)에만 잠깐 번쩍인다.
	"쭉 가다가 닿는" 과정을 눈으로 보여준다. 색을 진영별로 다르게 준다.
]]
function Battle3DController:_showAttackRay(from: Vector3, to: Vector3, color: Color3?)
	local length = (to - from).Magnitude
	if length < 0.05 then
		return
	end
	local mid = (from + to) / 2
	local beam = make("Part", {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		Size = Vector3.new(0.22, 0.22, length),
		CFrame = CFrame.new(mid, to),
		Color = color or Color3.fromRGB(255, 90, 60),
		Material = Enum.Material.Neon,
	}, workspace)
	TweenService:Create(beam, TweenInfo.new(0.25), { Transparency = 1 }):Play()
	task.delay(0.3, function()
		beam:Destroy()
	end)
end

function Battle3DController:_flashEnemy(hit: boolean)
	local model = self.enemyModel
	local torso = model and model.PrimaryPart
	if not torso then
		return
	end
	local original = torso.Color
	torso.Color = if hit then Color3.fromRGB(255, 220, 120) else Color3.fromRGB(90, 90, 90)
	TweenService:Create(torso, TweenInfo.new(0.35), { Color = original }):Play()
end

function Battle3DController:_endQte()
	if self.qteConn then
		self.qteConn:Disconnect()
		self.qteConn = nil
	end
	self.qte = nil
	if self.qteFrame then
		self.qteFrame.Visible = false
	end
end

function Battle3DController:_bindInput()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end

		-- QTE 중이면 QTE 입력으로 간다
		if self.qte then
			local challenge = self.qte
			local map: { [Enum.KeyCode]: string } = {
				[Enum.KeyCode.Space] = if challenge.Type == "Mash" then "Mash" else "Tap",
				[Enum.KeyCode.Up] = "Up",
				[Enum.KeyCode.W] = "Up",
				[Enum.KeyCode.Right] = "Right",
				[Enum.KeyCode.D] = "Right",
				[Enum.KeyCode.Down] = "Down",
				[Enum.KeyCode.S] = "Down",
				[Enum.KeyCode.Left] = "Left",
				[Enum.KeyCode.A] = "Left",
			}
			local mapped = map[input.KeyCode]
			if mapped then
				self:_qteInput(mapped)
			elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
				self:_qteInput(if challenge.Type == "Mash" then "Mash" else "Tap")
			end
			return
		end

		-- 전투 중 좌클릭 = 캐릭터 집기 (사양: 마우스로 잡았다가 놓는 방식)
		if self.active and input.UserInputType == Enum.UserInputType.MouseButton1 then
			self:_beginDrag()
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and self.dragging then
			self:_endDrag()
		end
	end)
end

return Battle3DController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">BattleController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	광장에 떠 있는 버튼과 카메라만 담당한다.

	원래 이 파일은 **원정대 시스템**(파티 편성 로비 · 행동 선택 · 업그레이드 고르기 ·
	3인 파티 전투 UI)이 전부 들어 있던 700줄짜리였다. 그 시스템을 걷어내면서 남은
	것은 두 가지뿐이다.

	  1. 모션 제작 / 모션 인벤토리 버튼 — `MotionEditorController`가 이 둘을 받아 쓴다
	  2. 광장 카메라 복귀 — 서버가 PlazaState를 쏘면 카메라를 원래대로 돌린다

	탑 등반 중에는 버튼을 감춰야 하므로 `SetTowerActive`도 남았다
	(`TowerBattleController`가 부른다).

	파일 이름은 그대로 둔다 — Rojo 경로와 require가 걸려 있어 옮기면 그쪽까지
	건드려야 하고, 얻는 것은 이름뿐이다.
]]

local Players = game:GetService("Players")

local BattleController = {}
BattleController.__index = BattleController

local function button(parent: Instance, text: string, width: number?, height: number?): TextButton
	local value = Instance.new("TextButton")
	value.Size = UDim2.fromOffset(width or 150, height or 48)
	value.BackgroundColor3 = Color3.fromRGB(32, 36, 46)
	value.BorderSizePixel = 0
	value.Font = Enum.Font.GothamBold
	value.Text = text
	value.TextColor3 = Color3.fromRGB(240, 220, 160)
	value.TextSize = 14
	value.TextWrapped = true
	value.Parent = parent
	return value
end

function BattleController.new(remotes: Folder)
	local self = setmetatable({}, BattleController)
	self.Remotes = remotes
	-- 광장 버튼(모션 제작·모션 인벤토리)의 상태.
	self.LobbyButtonsWanted = false
	self.TowerActive = false
	self:_buildUi()
	remotes.PlazaState.OnClientEvent:Connect(function()
		self:_showPlaza()
	end)
	return self
end

function BattleController:_buildUi()
	local gui = Instance.new("ScreenGui")
	gui.Name = "PlazaMotionGui"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.DisplayOrder = 5
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	self.Gui = gui

	self.EditorButton = button(gui, "모션 제작", 132, 42)
	self.EditorButton.Position = UDim2.new(1, -150, 0, 164)
	self.InventoryButton = button(gui, "모션 인벤토리", 132, 42)
	self.InventoryButton.Position = UDim2.new(1, -150, 0, 216)
	self.InventoryButton.BackgroundColor3 = Color3.fromRGB(66, 52, 82)

	self:_showPlaza()
end

--[[
	광장 버튼을 한 번에 켜고 끈다.

	원하는 상태를 `LobbyButtonsWanted`에 기억해 둔다. 탑 등반 중이면 무엇을 원하든
	감추기 때문에, 등반이 끝났을 때 "원래 켜져 있어야 했는지"를 알아야 한다.
]]
function BattleController:_setLobbyButtons(visible: boolean)
	self.LobbyButtonsWanted = visible
	local show = visible and not self.TowerActive
	self.EditorButton.Visible = show
	self.InventoryButton.Visible = show
end

--[[
	탑 등반 중에는 이 버튼들을 감춘다 (요청).

	`_showPlaza`가 버튼을 무조건 다시 켜는데, 등반 중에도 광장 상태가 올 수 있어
	한 번 숨기는 것만으로는 다시 튀어나온다. 그래서 플래그로 막는다.
]]
function BattleController:SetTowerActive(active: boolean)
	self.TowerActive = active
	self:_setLobbyButtons(self.LobbyButtonsWanted)
end

function BattleController:_showPlaza()
	self:_setLobbyButtons(true)
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = Enum.CameraType.Custom
		if humanoid then
			camera.CameraSubject = humanoid
		end
	end
end

return BattleController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">BattleTestController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	BattleTestController — 전투 시스템 시험용 임시 UI.

	요청: "전투 시험을 위해 임시로 전투 시작 버튼을 만들어줘"

	새로 만든 세 모듈을 **실제로 눌러서 확인**하기 위한 것이다.
	  BattleGrid       6×3 배치, 스킬 범위 미리보기(붉은 칸)
	  QteDefinitions   스킬 QTE / 회피·패리 QTE 판정
	  GroggyGauge      패리 시 15 누적, 100에서 한 턴 스턴

	**임시 UI다.** 서버 권위가 없고 전부 클라이언트에서 돈다.
	실제 전투를 붙일 때 이 파일은 지우거나 서버 전투로 교체할 것.

	쓰는 법
	  화면 좌하단 `전투 시험` 버튼 → 패널이 열린다.
	  1. 아군 격자(왼쪽) 칸을 눌러 내 위치를 옮긴다.
	  2. 스킬 버튼을 눌러 범위를 미리 본다. 적 격자(오른쪽)가 붉게 칠해진다.
	     — 여러 스킬을 눌러보며 비교만 할 수 있다(사양: 미리보기는 확정이 아니다).
	  3. `이 스킬로 선택`을 누르면 스킬 QTE가 뜬다.
	     성공 1.2배 / 보통 1.0배 / 실패 0.5배 (사양: 실패 시 1/2)
	  4. 이어서 적의 반격에 회피·패리 QTE가 뜬다.
	     성공 0배 / 방어 0.5배 / 실패 1.0배
	     패리 성공 시 적 그로기 +15. 100이 되면 적이 한 턴 스턴.

	QTE 입력
	  Sweep / Forge / Parry : 스페이스 또는 클릭
	  Mash                  : 스페이스 연타
	  Directional           : 방향키 또는 WASD
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local BattleGrid = require(ReplicatedStorage.Shared.BattleGrid)
local QteDefinitions = require(ReplicatedStorage.Shared.QteDefinitions)
local GroggyGauge = require(ReplicatedStorage.Shared.GroggyGauge)

local BattleTestController = {}
BattleTestController.__index = BattleTestController

local CELL = 46
local PAD = 4

-- 시험용 스킬 목록. 범위 모양만 다르게 해 미리보기를 확인한다.
local SKILLS: { { Name: string, Shape: BattleGrid.Shape, Damage: number } } = {
	{ Name = "찌르기", Shape = { Kind = "Single" }, Damage = 40 },
	{ Name = "횡베기", Shape = { Kind = "Row" }, Damage = 26 },
	{ Name = "관통", Shape = { Kind = "Column" }, Damage = 30 },
	{ Name = "충격파", Shape = { Kind = "Cross", Radius = 1 }, Damage = 22 },
	{ Name = "폭발", Shape = { Kind = "Square", Radius = 1 }, Damage = 18 },
}

local function make(class: string, props: { [string]: any }, parent: Instance?): any
	local instance = Instance.new(class)
	for key, value in props do
		(instance :: any)[key] = value
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function BattleTestController.new()
	local self = setmetatable({}, BattleTestController)

	self.grid = BattleGrid.New()
	self.enemyGroggy = GroggyGauge.New()
	self.selectedSkill = 1
	self.playerCell = { X = 2, Y = 2 }
	self.enemyCell = { X = 4, Y = 2 }
	self.qte = nil :: QteDefinitions.Challenge?
	self.qteStart = 0
	self.qteConnection = nil :: RBXScriptConnection?

	BattleGrid.Place(self.grid, "player", "Ally", self.playerCell.X, self.playerCell.Y)
	BattleGrid.Place(self.grid, "enemy", "Enemy", self.enemyCell.X, self.enemyCell.Y)

	self:_build()
	return self
end

function BattleTestController:_build()
	local player = Players.LocalPlayer
	local gui = make("ScreenGui", {
		Name = "BattleTestGui",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, player:WaitForChild("PlayerGui"))
	self.gui = gui

	-- 여는 버튼
	self.openButton = make("TextButton", {
		Name = "OpenBattleTest",
		Size = UDim2.fromOffset(150, 40),
		Position = UDim2.new(0, 16, 1, -120),
		BackgroundColor3 = Color3.fromRGB(150, 40, 44),
		TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		Text = "전투 시험",
		AutoButtonColor = true,
	}, gui)
	make("UICorner", { CornerRadius = UDim.new(0, 8) }, self.openButton)

	-- 패널
	self.panel = make("Frame", {
		Name = "Panel",
		Size = UDim2.fromOffset(760, 470),
		Position = UDim2.new(0.5, -380, 0.5, -235),
		BackgroundColor3 = Color3.fromRGB(22, 24, 30),
		Visible = false,
	}, gui)
	make("UICorner", { CornerRadius = UDim.new(0, 10) }, self.panel)

	make("TextLabel", {
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		Text = "전투 시험 (임시)  —  6×3 배치 · 스킬 QTE · 그로기",
		TextColor3 = Color3.fromRGB(230, 230, 240),
		Font = Enum.Font.GothamBold,
		TextSize = 15,
	}, self.panel)

	local close = make("TextButton", {
		Size = UDim2.fromOffset(28, 28),
		Position = UDim2.new(1, -34, 0, 4),
		BackgroundColor3 = Color3.fromRGB(60, 62, 72),
		Text = "X",
		TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.GothamBold,
		TextSize = 14,
	}, self.panel)
	make("UICorner", { CornerRadius = UDim.new(0, 6) }, close)

	self.openButton.Activated:Connect(function()
		self.panel.Visible = true
	end)
	close.Activated:Connect(function()
		self.panel.Visible = false
		self:_endQte()
	end)

	self:_buildGrids()
	self:_buildSkills()
	self:_buildStatus()
	self:_buildQteLayer()
	self:_refresh()
end

-- 격자 두 개(아군/적)를 만든다. 칸 버튼을 표로 들고 있다가 색만 바꾼다.
function BattleTestController:_buildGrids()
	self.cellButtons = { Ally = {}, Enemy = {} }

	local function buildSide(side: BattleGrid.Side, originX: number, title: string)
		make("TextLabel", {
			Size = UDim2.fromOffset(300, 20),
			Position = UDim2.fromOffset(originX, 44),
			BackgroundTransparency = 1,
			Text = title,
			TextColor3 = Color3.fromRGB(180, 185, 200),
			Font = Enum.Font.Gotham,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, self.panel)

		for y = 1, self.grid.Height do
			self.cellButtons[side][y] = {}
			for x = 1, self.grid.Width do
				local button = make("TextButton", {
					Size = UDim2.fromOffset(CELL, CELL),
					Position = UDim2.fromOffset(originX + (x - 1) * (CELL + PAD), 68 + (y - 1) * (CELL + PAD)),
					BackgroundColor3 = Color3.fromRGB(48, 52, 62),
					Text = "",
					AutoButtonColor = false,
				}, self.panel)
				make("UICorner", { CornerRadius = UDim.new(0, 4) }, button)

				if side == "Ally" then
					-- 아군 칸을 누르면 내 유닛이 이동한다 (사양: 매 턴 격자 내에서 이동)
					button.Activated:Connect(function()
						local ok = BattleGrid.Move(self.grid, "player", x, y)
						if ok then
							self.playerCell = { X = x, Y = y }
							self:_refresh()
						end
					end)
				else
					-- 적 칸을 누르면 스킬 원점을 옮겨 범위를 확인한다
					button.Activated:Connect(function()
						self.enemyCell = { X = x, Y = y }
						self:_refresh()
					end)
				end

				self.cellButtons[side][y][x] = button
			end
		end
	end

	buildSide("Ally", 24, "아군 진영 (칸을 눌러 이동)")
	buildSide("Enemy", 410, "적 진영 (칸을 눌러 조준)")
end

function BattleTestController:_buildSkills()
	self.skillButtons = {}
	for index, skill in SKILLS do
		local button = make("TextButton", {
			Size = UDim2.fromOffset(120, 28),
			Position = UDim2.fromOffset(24 + (index - 1) * 126, 232),
			BackgroundColor3 = Color3.fromRGB(48, 52, 62),
			Text = skill.Name,
			TextColor3 = Color3.fromRGB(220, 220, 230),
			Font = Enum.Font.Gotham,
			TextSize = 13,
		}, self.panel)
		make("UICorner", { CornerRadius = UDim.new(0, 6) }, button)

		button.Activated:Connect(function()
			-- 누르기만 하면 미리보기다. 확정이 아니다(사양).
			self.selectedSkill = index
			self:_refresh()
		end)
		self.skillButtons[index] = button
	end

	self.confirmButton = make("TextButton", {
		Size = UDim2.fromOffset(160, 34),
		Position = UDim2.fromOffset(24, 272),
		BackgroundColor3 = Color3.fromRGB(150, 40, 44),
		Text = "이 스킬로 선택",
		TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.GothamBold,
		TextSize = 14,
	}, self.panel)
	make("UICorner", { CornerRadius = UDim.new(0, 6) }, self.confirmButton)

	self.confirmButton.Activated:Connect(function()
		self:_startQte("Skill")
	end)
end

function BattleTestController:_buildStatus()
	self.infoLabel = make("TextLabel", {
		Size = UDim2.fromOffset(560, 44),
		Position = UDim2.fromOffset(196, 268),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = Color3.fromRGB(200, 205, 220),
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
	}, self.panel)

	make("TextLabel", {
		Size = UDim2.fromOffset(120, 18),
		Position = UDim2.fromOffset(24, 322),
		BackgroundTransparency = 1,
		Text = "적 그로기",
		TextColor3 = Color3.fromRGB(180, 185, 200),
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, self.panel)

	local track = make("Frame", {
		Size = UDim2.fromOffset(400, 16),
		Position = UDim2.fromOffset(24, 342),
		BackgroundColor3 = Color3.fromRGB(45, 48, 58),
	}, self.panel)
	make("UICorner", { CornerRadius = UDim.new(0, 4) }, track)

	self.groggyFill = make("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.fromRGB(230, 160, 60),
	}, track)
	make("UICorner", { CornerRadius = UDim.new(0, 4) }, self.groggyFill)

	self.groggyLabel = make("TextLabel", {
		Size = UDim2.fromOffset(220, 18),
		Position = UDim2.fromOffset(432, 341),
		BackgroundTransparency = 1,
		Text = "0 / 100",
		TextColor3 = Color3.fromRGB(200, 205, 220),
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, self.panel)

	self.logLabel = make("TextLabel", {
		Size = UDim2.fromOffset(712, 74),
		Position = UDim2.fromOffset(24, 372),
		BackgroundColor3 = Color3.fromRGB(30, 32, 40),
		Text = "",
		TextColor3 = Color3.fromRGB(190, 195, 210),
		Font = Enum.Font.Code,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
	}, self.panel)
	make("UICorner", { CornerRadius = UDim.new(0, 6) }, self.logLabel)
	make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingTop = UDim.new(0, 6) }, self.logLabel)
end

function BattleTestController:_buildQteLayer()
	self.qteFrame = make("Frame", {
		Size = UDim2.fromOffset(340, 190),
		Position = UDim2.new(0.5, -170, 0.5, -95),
		BackgroundColor3 = Color3.fromRGB(16, 18, 24),
		Visible = false,
		ZIndex = 20,
	}, self.gui)
	make("UICorner", { CornerRadius = UDim.new(0, 10) }, self.qteFrame)

	self.qteTitle = make("TextLabel", {
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = Color3.fromRGB(240, 240, 250),
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		ZIndex = 21,
	}, self.qteFrame)

	self.qteHint = make("TextLabel", {
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.fromOffset(0, 158),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = Color3.fromRGB(160, 165, 180),
		Font = Enum.Font.Gotham,
		TextSize = 12,
		ZIndex = 21,
	}, self.qteFrame)

	-- Sweep: 좌우로 왕복하는 바 + 목표 구간
	self.sweepTrack = make("Frame", {
		Size = UDim2.fromOffset(280, 26),
		Position = UDim2.fromOffset(30, 78),
		BackgroundColor3 = Color3.fromRGB(40, 43, 52),
		Visible = false,
		ZIndex = 21,
	}, self.qteFrame)
	self.sweepTarget = make("Frame", {
		Size = UDim2.fromScale(0.18, 1),
		BackgroundColor3 = Color3.fromRGB(60, 170, 90),
		ZIndex = 22,
	}, self.sweepTrack)
	self.sweepCursor = make("Frame", {
		Size = UDim2.fromOffset(5, 26),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 23,
	}, self.sweepTrack)

	-- Forge / Parry: 줄어드는 링
	self.ringOuter = make("Frame", {
		Size = UDim2.fromOffset(120, 120),
		Position = UDim2.fromOffset(110, 40),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 21,
	}, self.qteFrame)
	self.ringTarget = make("Frame", {
		Size = UDim2.fromOffset(48, 48),
		Position = UDim2.new(0.5, -24, 0.5, -24),
		BackgroundColor3 = Color3.fromRGB(60, 170, 90),
		BackgroundTransparency = 0.55,
		ZIndex = 21,
	}, self.ringOuter)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, self.ringTarget)
	self.ringMoving = make("Frame", {
		Size = UDim2.fromOffset(120, 120),
		Position = UDim2.new(0.5, -60, 0.5, -60),
		BackgroundColor3 = Color3.fromRGB(90, 150, 240),
		BackgroundTransparency = 0.35,
		ZIndex = 22,
	}, self.ringOuter)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, self.ringMoving)

	-- Mash / Directional 공용 텍스트
	self.qteBig = make("TextLabel", {
		Size = UDim2.fromOffset(320, 70),
		Position = UDim2.fromOffset(10, 66),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = Color3.fromRGB(240, 240, 250),
		Font = Enum.Font.GothamBold,
		TextSize = 22,
		Visible = false,
		ZIndex = 21,
	}, self.qteFrame)
end

--=== 갱신 ===--

function BattleTestController:_refresh()
	local skill = SKILLS[self.selectedSkill]

	-- 스킬 범위 미리보기: 사양대로 격자를 붉게 칠한다.
	-- 칠할 칸은 CellsInShape()가 주며, 실제 타격도 같은 함수를 쓴다.
	local highlighted: { [string]: boolean } = {}
	for _, cell in BattleGrid.CellsInShape(self.grid, "Enemy", self.enemyCell.X, self.enemyCell.Y, skill.Shape) do
		highlighted[cell.X .. "," .. cell.Y] = true
	end

	for y = 1, self.grid.Height do
		for x = 1, self.grid.Width do
			local ally = self.cellButtons.Ally[y][x]
			local isPlayer = self.playerCell.X == x and self.playerCell.Y == y
			ally.BackgroundColor3 = if isPlayer then Color3.fromRGB(70, 130, 220) else Color3.fromRGB(48, 52, 62)
			ally.Text = if isPlayer then "나" else ""
			ally.TextColor3 = Color3.new(1, 1, 1)
			ally.Font = Enum.Font.GothamBold
			ally.TextSize = 13

			local foe = self.cellButtons.Enemy[y][x]
			local inRange = highlighted[x .. "," .. y] == true
			local isEnemy = BattleGrid.Occupant(self.grid, "Enemy", x, y) ~= nil
			foe.BackgroundColor3 = if inRange
				then Color3.fromRGB(170, 55, 60) -- 사양: 범위는 붉게
				else Color3.fromRGB(48, 52, 62)
			foe.Text = if isEnemy then "적" else ""
			foe.TextColor3 = Color3.new(1, 1, 1)
			foe.Font = Enum.Font.GothamBold
			foe.TextSize = 13
		end
	end

	for index, button in self.skillButtons do
		button.BackgroundColor3 = if index == self.selectedSkill
			then Color3.fromRGB(70, 90, 140)
			else Color3.fromRGB(48, 52, 62)
	end

	local targets = BattleGrid.UnitsInShape(self.grid, "Enemy", self.enemyCell.X, self.enemyCell.Y, skill.Shape)
	self.infoLabel.Text = string.format(
		"선택: %s   기본 대미지 %d   범위 칸 %d   맞는 적 %d\n미리보기만으로는 확정되지 않습니다. '이 스킬로 선택'을 눌러야 QTE가 시작됩니다.",
		skill.Name,
		skill.Damage,
		#BattleGrid.CellsInShape(self.grid, "Enemy", self.enemyCell.X, self.enemyCell.Y, skill.Shape),
		#targets
	)

	self:_refreshGroggy()
end

function BattleTestController:_refreshGroggy()
	local ratio = GroggyGauge.Ratio(self.enemyGroggy)
	self.groggyFill.Size = UDim2.fromScale(ratio, 1)
	self.groggyLabel.Text = string.format(
		"%d / %d%s",
		self.enemyGroggy.Value,
		GroggyGauge.MAX,
		if GroggyGauge.IsStunned(self.enemyGroggy) then "   [스턴]" else ""
	)
end

function BattleTestController:_log(text: string)
	self.logLabel.Text = text .. "\n" .. string.sub(self.logLabel.Text, 1, 260)
end

--=== QTE ===--

function BattleTestController:_startQte(role: QteDefinitions.Role)
	self:_endQte()

	local random = Random.new(os.clock() * 1000)
	local challenge = QteDefinitions.Create(role, function()
		return random:NextNumber()
	end, 0, "test", true)

	self.qte = challenge
	self.qteStart = os.clock()
	self.qteFrame.Visible = true
	self.qteTitle.Text =
		string.format("%s — %s", if role == "Skill" then "스킬" else "회피/패리", challenge.Title)

	self.sweepTrack.Visible = challenge.Type == "Sweep"
	self.ringOuter.Visible = challenge.Type == "Forge" or challenge.Type == "Parry"
	self.qteBig.Visible = challenge.Type == "Mash" or challenge.Type == "Directional"

	if challenge.Type == "Mash" then
		self.qteHint.Text = "스페이스 연타"
	elseif challenge.Type == "Directional" then
		self.qteHint.Text = "방향키 / WASD"
	else
		self.qteHint.Text = "스페이스 또는 클릭"
	end

	self.qteConnection = RunService.RenderStepped:Connect(function()
		self:_tickQte()
	end)
end

function BattleTestController:_tickQte()
	local challenge = self.qte
	if not challenge then
		return
	end

	local elapsed = (os.clock() - self.qteStart) * 1000
	local state = QteDefinitions.VisualState(challenge, elapsed)

	if challenge.Type == "Sweep" then
		self.sweepCursor.Position = UDim2.fromScale(state.position, 0)
		self.sweepTarget.Position = UDim2.fromScale(math.max(state.targetPosition - state.successGap, 0), 0)
		self.sweepTarget.Size = UDim2.fromScale(state.successGap * 2, 1)
	elseif challenge.Type == "Forge" or challenge.Type == "Parry" then
		local size = math.max(state.outerRadius, 0) * 120
		self.ringMoving.Size = UDim2.fromOffset(size, size)
		self.ringMoving.Position = UDim2.new(0.5, -size / 2, 0.5, -size / 2)
		local targetSize = state.targetRadius * 120
		self.ringTarget.Size = UDim2.fromOffset(targetSize, targetSize)
		self.ringTarget.Position = UDim2.new(0.5, -targetSize / 2, 0.5, -targetSize / 2)
		-- 패리는 표시가 깜빡인다(PvP 방해 요소)
		self.ringMoving.BackgroundTransparency = 1 - (state.indicatorOpacity or 1) * 0.65
	elseif challenge.Type == "Mash" then
		self.qteBig.Text = string.format("%d / %d", state.count, state.goal)
	elseif challenge.Type == "Directional" then
		local parts: { string } = {}
		local arrows = { Up = "↑", Right = "→", Down = "↓", Left = "←" }
		for index, direction in state.expectedDirections do
			local hiddenHere = false
			for _, hidden in state.hiddenCommandIndexes do
				if hidden == index then
					hiddenHere = true
					break
				end
			end
			local glyph = if hiddenHere then "?" else arrows[direction]
			if index <= state.sequenceIndex then
				glyph = "·"
			end
			table.insert(parts, glyph)
		end
		self.qteBig.Text = table.concat(parts, " ")
	end

	-- 시간이 다 되면 자동 판정
	if elapsed >= challenge.DurationMs then
		self:_resolveQte(elapsed)
	end
end

function BattleTestController:_input(input: string)
	local challenge = self.qte
	if not challenge then
		return
	end
	if not QteDefinitions.IsValidInput(challenge.Type, input) then
		return
	end

	local elapsed = (os.clock() - self.qteStart) * 1000

	if challenge.Type == "Mash" then
		challenge.InputCount += 1
		return
	end

	if challenge.Type == "Directional" then
		local expected = challenge.ExpectedDirections or {}
		local nextIndex = (challenge.SequenceIndex or 0) + 1
		if expected[nextIndex] == input then
			challenge.SequenceIndex = nextIndex
		else
			challenge.Mistakes = (challenge.Mistakes or 0) + 1
			challenge.SequenceIndex = nextIndex
		end
		if (challenge.SequenceIndex or 0) >= #expected then
			self:_resolveQte(elapsed)
		end
		return
	end

	-- Sweep / Forge / Parry: 한 번 입력하면 그 시점으로 판정
	self:_resolveQte(elapsed)
end

function BattleTestController:_resolveQte(elapsed: number)
	local challenge = self.qte
	if not challenge then
		return
	end

	local grade = QteDefinitions.Judge(challenge, elapsed)
	local multiplier = QteDefinitions.Multiplier(challenge.Role, grade)
	local gradeText = ({ Success = "성공", Partial = "보통/방어", Fail = "실패" })[grade]

	if challenge.Role == "Skill" then
		local skill = SKILLS[self.selectedSkill]
		local targets = BattleGrid.UnitsInShape(self.grid, "Enemy", self.enemyCell.X, self.enemyCell.Y, skill.Shape)
		local damage = math.floor(skill.Damage * multiplier)
		self:_log(
			string.format(
				"[스킬] %s / %s → %s ×%.1f = %d 대미지, 대상 %d",
				skill.Name,
				challenge.Title,
				gradeText,
				multiplier,
				damage,
				#targets
			)
		)
		self:_endQte()
		-- 스킬을 쓰면 적이 반격한다 → 회피/패리 QTE
		task.delay(0.45, function()
			if self.panel.Visible then
				self:_startQte("Dodge")
			end
		end)
		return
	end

	-- 회피/패리
	local incoming = 35
	local taken = math.floor(incoming * multiplier)
	local groggyGain = QteDefinitions.GroggyGain(challenge, grade)
	local stunned = false
	if groggyGain > 0 then
		stunned = GroggyGauge.Add(self.enemyGroggy, groggyGain)
	end

	self:_log(
		string.format(
			"[피격] %s → %s ×%.1f = %d 받음%s%s",
			challenge.Title,
			gradeText,
			multiplier,
			taken,
			if groggyGain > 0 then string.format(" / 적 그로기 +%d", groggyGain) else "",
			if stunned then "  ★ 적 스턴!" else ""
		)
	)

	if GroggyGauge.IsStunned(self.enemyGroggy) then
		-- 스턴 한 턴을 소모시킨다
		GroggyGauge.TickTurn(self.enemyGroggy)
		self:_log("[턴] 적이 스턴으로 한 턴을 쉬고 게이지가 초기화됐다.")
	end

	self:_endQte()
	self:_refreshGroggy()
end

function BattleTestController:_endQte()
	if self.qteConnection then
		self.qteConnection:Disconnect()
		self.qteConnection = nil
	end
	self.qte = nil
	if self.qteFrame then
		self.qteFrame.Visible = false
	end
end

function BattleTestController:BindInput()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not self.qte then
			return
		end
		local map: { [Enum.KeyCode]: string } = {
			[Enum.KeyCode.Space] = if self.qte.Type == "Mash" then "Mash" else "Tap",
			[Enum.KeyCode.Up] = "Up",
			[Enum.KeyCode.W] = "Up",
			[Enum.KeyCode.Right] = "Right",
			[Enum.KeyCode.D] = "Right",
			[Enum.KeyCode.Down] = "Down",
			[Enum.KeyCode.S] = "Down",
			[Enum.KeyCode.Left] = "Left",
			[Enum.KeyCode.A] = "Left",
		}
		local mapped = map[input.KeyCode]
		if mapped then
			self:_input(mapped)
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
			self:_input(if self.qte.Type == "Mash" then "Mash" else "Tap")
		end
	end)
end

return BattleTestController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">MotionEditorController</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local CharacterDefinitions = require(ReplicatedStorage.Shared.CharacterDefinitions)
local MotionPlayer = require(ReplicatedStorage.Shared.MotionPlayer)
local RotationUtil = require(ReplicatedStorage.Shared.RotationUtil)

local MotionEditorController = {}
MotionEditorController.__index = MotionEditorController

local MAX_MOTION_DURATION = 30
local MAX_MOTION_FRAMES = 300

--[[
	조작 창 크기.

	요청: "UI 자체를 문 애니메이터처럼 하나의 작은 창에 다 때려박는 식으로 하자는거야.
	       큰 화면에선 모션을 크게 보면서 수정 하고."

	예전에는 편집기가 화면을 통째로 덮고, 캐릭터는 가운데 작은 상자에만 보였다.
	이제는 반대다 — 화면 전체가 모션이고, 조작은 이 크기의 떠 있는 창 하나가 맡는다.
	창이 좁으므로 포즈/미리보기/속성은 나란히 놓지 않고 메뉴 줄로 한 장씩 갈아 끼운다.
]]
local WINDOW_DEFAULT_WIDTH = 560
local WINDOW_DEFAULT_HEIGHT = 500
-- 요청: "UI 창 크기 조절을 할 수 있어야 함." 오른쪽 아래 손잡이로 늘린다.
-- 이보다 작아지면 하단 독의 타임라인이 잘려 나가므로 최소치를 둔다.
local WINDOW_MIN_WIDTH = 430
local WINDOW_MIN_HEIGHT = 420

local JOINTS = { "Right Shoulder", "Left Shoulder", "Right Hip", "Left Hip", "Neck", "RootJoint" }
local PRESET_ORDER = {
	{ Key = "Basic", Label = "평타" },
	{ Key = "Heavy", Label = "강공격" },
	{ Key = "Skill1", Label = "스킬 1" },
	{ Key = "Skill2", Label = "스킬 2" },
	{ Key = "Skill3", Label = "스킬 3" },
	{ Key = "Ultimate", Label = "궁극기" },
	{ Key = "Guard", Label = "가드" },
	{ Key = "Dash", Label = "대시" },
	{ Key = "Idle", Label = "대기" },
	{ Key = "Walk", Label = "걷기" },
	{ Key = "Jump", Label = "점프" },
	{ Key = "Hit", Label = "피격" },
}
local STATUS_TYPES = {
	{ Key = "slow", Label = "둔화" },
	{ Key = "bleed", Label = "출혈" },
	{ Key = "burn", Label = "화상" },
	{ Key = "stun", Label = "기절" },
	{ Key = "airborne", Label = "에어본" },
}
local BUFF_TYPES = {
	{ Key = "damageUp", Label = "대미지 증가" },
	{ Key = "dotGuard", Label = "도트 피해 감소" },
	{ Key = "skillGuard", Label = "스킬 피해 감소" },
	{ Key = "moveSpeed", Label = "이동속도 증가" },
	{ Key = "shield", Label = "방어막" },
	{ Key = "iframe", Label = "무적 프레임" },
}
local EFFECT_PRESETS = {
	{ Key = "slash", Label = "베기" },
	{ Key = "spark", Label = "반짝임" },
	{ Key = "burst", Label = "폭발" },
	{ Key = "ring", Label = "링" },
	{ Key = "smoke", Label = "연기" },
}
local GIZMO_PARTS = {
	["Torso"] = "RootJoint",
	["Head"] = "Neck",
	["Right Arm"] = "Right Shoulder",
	["Left Arm"] = "Left Shoulder",
	["Right Leg"] = "Right Hip",
	["Left Leg"] = "Left Hip",
}
local GIZMO_PART_OPTIONS = {
	{ Name = "Torso", Label = "몸통" },
	{ Name = "Head", Label = "머리" },
	{ Name = "Right Arm", Label = "오른팔" },
	{ Name = "Left Arm", Label = "왼팔" },
	{ Name = "Right Leg", Label = "오른다리" },
	{ Name = "Left Leg", Label = "왼다리" },
}

local TORSO_CHILD_JOINTS = { "Neck", "Right Shoulder", "Left Shoulder", "Right Hip", "Left Hip" }
local GIZMO_AXES = {
	{ Name = "X", Vector = Vector3.xAxis, Color = Color3.fromRGB(255, 82, 82) },
	{ Name = "Y", Vector = Vector3.yAxis, Color = Color3.fromRGB(94, 230, 112) },
	{ Name = "Z", Vector = Vector3.zAxis, Color = Color3.fromRGB(86, 145, 255) },
}
local GIZMO_REFERENCE_POINTS = {
	{ Id = "Up", Axis = "X", Direction = Vector3.yAxis, Color = Color3.fromRGB(255, 82, 82) },
	{ Id = "Down", Axis = "X", Direction = -Vector3.yAxis, Color = Color3.fromRGB(255, 82, 82) },
	{ Id = "Right", Axis = "Z", Direction = Vector3.xAxis, Color = Color3.fromRGB(86, 145, 255) },
	{ Id = "Left", Axis = "Z", Direction = -Vector3.xAxis, Color = Color3.fromRGB(86, 145, 255) },
	{ Id = "Front", Axis = "Y", Direction = -Vector3.zAxis, Color = Color3.fromRGB(94, 230, 112) },
	{ Id = "Back", Axis = "Y", Direction = Vector3.zAxis, Color = Color3.fromRGB(94, 230, 112) },
}
local GIZMO_RING_SEGMENTS = 32

--[[
	Moon Animator식 다크 에디터 팔레트.

	사양(추가&수정.md `## 모션 제작 기능`)
	  "UI를 Moon Animator의 UI를 베이스로 함."
	  "기존에 있던 얼불춤식 UIㅡ패널 형태는 폐기."

	예전 값은 나무·금박·양피지(공방 책상) 색이었다. 키 이름은 그대로 두고 **값만**
	바꾼다 — 6천 줄 전체가 이 표를 참조하므로, 이렇게 하면 위젯을 하나도 건드리지
	않고 화면 전체가 에디터 룩으로 바뀐다(기능 손실 0).

	키 이름은 이제 재질이 아니라 **역할**로 읽어야 한다:
	  Board/Wood/WoodDark = 창·독 배경 단계   WoodLight = 경계선
	  Panel/PanelAlt      = 패널·컨트롤 배경   Parchment = 본문 글자
	  Gold/GoldLight      = 키프레임 앰버(선택된 키)  Blue = 선택 하이라이트
]]
local THEME = {
	Board = Color3.fromRGB(24, 24, 26),
	Wood = Color3.fromRGB(37, 37, 40),
	WoodDark = Color3.fromRGB(18, 18, 20),
	WoodLight = Color3.fromRGB(62, 62, 70),
	Panel = Color3.fromRGB(30, 30, 33),
	PanelAlt = Color3.fromRGB(45, 45, 50),
	Gold = Color3.fromRGB(232, 179, 57),
	GoldLight = Color3.fromRGB(255, 205, 90),
	Parchment = Color3.fromRGB(228, 228, 232),
	Muted = Color3.fromRGB(150, 150, 158),
	Green = Color3.fromRGB(78, 201, 160),
	GreenDark = Color3.fromRGB(28, 90, 74),
	Cyan = Color3.fromRGB(79, 193, 255),
	Red = Color3.fromRGB(241, 76, 76),
	Blue = Color3.fromRGB(0, 122, 204),
}

local QUICK_TWEEN = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function cframeAlongX(startPosition: Vector3, endPosition: Vector3): CFrame
	local direction = endPosition - startPosition
	local right = direction.Magnitude > 0.001 and direction.Unit or Vector3.xAxis
	local seed = math.abs(right:Dot(Vector3.yAxis)) > 0.98 and Vector3.zAxis or Vector3.yAxis
	local back = right:Cross(seed).Unit
	local up = back:Cross(right).Unit
	return CFrame.fromMatrix((startPosition + endPosition) * 0.5, right, up, back)
end

local function pointToSegmentDistance(point: Vector2, startPoint: Vector2, endPoint: Vector2): number
	local segment = endPoint - startPoint
	local lengthSquared = segment:Dot(segment)
	if lengthSquared < 0.001 then
		return (point - startPoint).Magnitude
	end
	local alpha = math.clamp((point - startPoint):Dot(segment) / lengthSquared, 0, 1)
	return (point - (startPoint + segment * alpha)).Magnitude
end

local function centeredJointTransform(motor: Motor6D, offset: any, pose: any, rotationData: any?): CFrame
	-- Motor6D normally rotates around its attachment (shoulder, neck, hip).
	-- C1^-1 places Part1's center in joint space, so wrapping the rotation
	-- around that point keeps the selected body part's own center fixed.
	local pivot = motor.C1:Inverse().Position
	local rotation = RotationUtil.ToCFrame(rotationData, pose)
	return CFrame.new(offset.X or 0, offset.Y or 0, offset.Z or 0) * CFrame.new(pivot) * rotation * CFrame.new(-pivot)
end

local function addStroke(target: GuiObject, color: Color3, thickness: number?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness or 1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = target
	return stroke
end

local function addPadding(target: GuiObject, amount: number)
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, amount)
	padding.PaddingBottom = UDim.new(0, amount)
	padding.PaddingLeft = UDim.new(0, amount)
	padding.PaddingRight = UDim.new(0, amount)
	padding.Parent = target
end

local function makePanel(parent: Instance, color: Color3?, strokeColor: Color3?): Frame
	local panel = Instance.new("Frame")
	panel.BackgroundColor3 = color or THEME.Panel
	panel.BorderSizePixel = 0
	panel.Parent = parent
	-- Moon Animator 독은 평평하다. 예전의 양피지 그라디언트(위 흰색 → 아래 누런색)는
	-- 나무 책상 느낌을 내던 것이라 뺐다. 경계선도 2px 금테에서 1px 회색으로 낮춘다.
	addStroke(panel, strokeColor or THEME.WoodLight, 1)
	return panel
end

--[[
	예전에는 세로 나뭇결 + 가로 판자 이음새를 그려 "나무 책상"을 만들었다(얼불춤식).
	Moon Animator의 독은 무늬 없는 평면이라 이음새를 전부 걷어냈다.

	호출부가 30곳 가까이 되므로 **함수는 남겨 둔다** — 시그니처를 유지해야 호출부를
	하나도 안 고친다. 남은 역할은 두 가지다:
	  - ClipsDescendants: 예전 레이아웃이 이 값에 기대고 있어 그대로 둔다.
	  - 아래쪽 1px 구분선: 독과 독 사이를 가르는 에디터식 경계.
	columns는 이제 쓰지 않지만, 호출부 수정을 피하려고 인자만 받아 둔다.
]]
local function addWoodGrid(target: GuiObject, columns: number)
	target.ClipsDescendants = true
	local _ = columns

	local edge = Instance.new("Frame")
	edge.Name = "DockEdge"
	edge.Size = UDim2.new(1, 0, 0, 1)
	edge.Position = UDim2.new(0, 0, 1, -1)
	edge.BackgroundColor3 = THEME.WoodDark
	edge.BackgroundTransparency = 0.35
	edge.BorderSizePixel = 0
	edge.Active = false
	edge.ZIndex = 0
	edge.Parent = target
end

local function makeButton(parent: Instance, text: string, width: number?, height: number?): TextButton
	local button = Instance.new("TextButton")
	button.Size = UDim2.fromOffset(width or 110, height or 34)
	button.BackgroundColor3 = THEME.PanelAlt
	button.BorderSizePixel = 0
	button.TextColor3 = THEME.Parchment
	button.Font = Enum.Font.GothamBold
	button.TextSize = 12
	button.TextWrapped = true
	button.Text = text
	button.AutoButtonColor = false
	button.Parent = parent
	button:SetAttribute("BaseColor", THEME.PanelAlt)
	button:SetAttribute("StrokeColor", THEME.WoodLight)
	local stroke = addStroke(button, THEME.WoodLight, 1)
	button.MouseEnter:Connect(function()
		TweenService:Create(button, QUICK_TWEEN, { BackgroundColor3 = THEME.WoodLight }):Play()
		stroke.Color = THEME.Gold
	end)
	button.MouseLeave:Connect(function()
		TweenService
			:Create(button, QUICK_TWEEN, { BackgroundColor3 = button:GetAttribute("BaseColor") or THEME.PanelAlt })
			:Play()
		stroke.Color = button:GetAttribute("StrokeColor") or THEME.WoodLight
		button.TextTransparency = 0
	end)
	button.MouseButton1Down:Connect(function()
		button.TextTransparency = 0.18
	end)
	button.MouseButton1Up:Connect(function()
		button.TextTransparency = 0
	end)
	return button
end

local function styleButton(button: TextButton, accent: Color3, background: Color3?, textColor: Color3?)
	local base = background or THEME.PanelAlt
	button.BackgroundColor3 = base
	button.TextColor3 = textColor or accent
	button:SetAttribute("BaseColor", base)
	button:SetAttribute("StrokeColor", accent)
	local stroke = button:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = accent
	end
end

local function makeInput(parent: Instance, placeholder: string, width: number): TextBox
	local input = Instance.new("TextBox")
	input.Size = UDim2.fromOffset(width, 34)
	input.BackgroundColor3 = THEME.PanelAlt
	input.BorderSizePixel = 0
	input.TextColor3 = THEME.Parchment
	input.PlaceholderColor3 = THEME.Muted
	input.PlaceholderText = placeholder
	input.Font = Enum.Font.RobotoMono
	input.TextSize = 11
	input.TextXAlignment = Enum.TextXAlignment.Left
	input.ClearTextOnFocus = false
	input.Parent = parent
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 8)
	padding.PaddingRight = UDim.new(0, 6)
	padding.Parent = input
	local stroke = addStroke(input, THEME.WoodLight, 1)
	input.Focused:Connect(function()
		stroke.Color = THEME.Gold
	end)
	input.FocusLost:Connect(function()
		stroke.Color = THEME.WoodLight
	end)
	return input
end

local function clearButtons(parent: Instance)
	for _, child in parent:GetChildren() do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
end

local function vector(x: number?, y: number?, z: number?): any
	return { X = x or 0, Y = y or 0, Z = z or 0 }
end

local function defaultWeapon(): any
	return {
		Position = vector(),
		Rotation = vector(),
		AssetId = "",
		Size = vector(0.35, 3, 0.12),
		FlipX = false,
		FlipY = false,
	}
end

local function copyVector(source: any): any
	return vector(source and source.X, source and source.Y, source and source.Z)
end

local function copyWeapon(source: any): any
	local weapon = source or defaultWeapon()
	return {
		Position = copyVector(weapon.Position),
		Rotation = copyVector(weapon.Rotation),
		AssetId = tostring(weapon.AssetId or ""),
		Size = copyVector(weapon.Size or vector(0.35, 3, 0.12)),
		FlipX = weapon.FlipX == true,
		FlipY = weapon.FlipY == true,
	}
end

local function wantedLayerKeys(frame: any, dualWield: boolean): { string }
	local keys = { "Player", "Weapon" }
	if dualWield then
		table.insert(keys, "DualWeapon")
	end
	for index = 1, #(frame.Decorations or {}) do
		table.insert(keys, "Decoration:" .. index)
	end
	return keys
end

local function normalizeLayerOrder(frame: any, dualWield: boolean): { string }
	local wanted = wantedLayerKeys(frame, dualWield)
	local allowed = {}
	for _, key in wanted do
		allowed[key] = true
	end
	local result = {}
	local used = {}
	for _, key in frame.LayerOrder or {} do
		if allowed[key] and not used[key] then
			table.insert(result, key)
			used[key] = true
		end
	end
	for _, key in wanted do
		if not used[key] then
			table.insert(result, key)
		end
	end
	frame.LayerOrder = result
	return result
end

local function layerDepth(frame: any, dualWield: boolean, key: string): number
	local order = normalizeLayerOrder(frame, dualWield)
	local playerIndex = table.find(order, "Player") or 1
	local itemIndex = table.find(order, key) or playerIndex
	return (itemIndex - playerIndex) * 0.08
end

local function copyFrame(source: any): any
	local joints = {}
	for name, pose in source.Joints or {} do
		joints[name] = copyVector(pose)
	end
	local jointOffsets = {}
	for name, offset in source.JointOffsets or {} do
		jointOffsets[name] = copyVector(offset)
	end
	local jointRotations = {}
	for name, rotation in source.JointRotations or {} do
		jointRotations[name] = {
			X = tonumber(rotation.X) or 0,
			Y = tonumber(rotation.Y) or 0,
			Z = tonumber(rotation.Z) or 0,
			W = tonumber(rotation.W) or 1,
		}
	end
	local decorations = {}
	for _, decoration in source.Decorations or {} do
		table.insert(decorations, {
			Name = tostring(decoration.Name or "장식"),
			AssetId = tostring(decoration.AssetId or ""),
			Attach = decoration.Attach == "Head" and "Head" or "Root",
			Offset = copyVector(decoration.Offset),
			Rotation = copyVector(decoration.Rotation),
			Size = copyVector(decoration.Size or vector(2, 2, 0.12)),
			Layer = tonumber(decoration.Layer) or 1,
		})
	end
	local layerOrder = {}
	for _, key in source.LayerOrder or {} do
		table.insert(layerOrder, tostring(key))
	end
	return {
		Time = source.Time,
		Joints = joints,
		JointRotations = jointRotations,
		JointOffsets = jointOffsets,
		CastDirection = source.CastDirection,
		RootOffset = copyVector(source.RootOffset),
		Weapon = copyWeapon(source.Weapon),
		DualWeapon = source.DualWeapon and copyWeapon(source.DualWeapon) or nil,
		HandSwap = source.HandSwap == true,
		Decorations = decorations,
		LayerOrder = layerOrder,
	}
end

local function deepCopy(value: any): any
	if typeof(value) ~= "table" then
		return value
	end
	local result = {}
	for key, child in value do
		result[key] = deepCopy(child)
	end
	return result
end

local function normalizeAssetId(value: string): string
	local digits = string.match(value, "%d+")
	return digits and ("rbxassetid://" .. digits) or ""
end

local function normalizeHex(value: string): string
	local digits = string.upper(string.gsub(value, "[^%x]", ""))
	if #digits == 3 then
		digits = string.sub(digits, 1, 1):rep(2) .. string.sub(digits, 2, 2):rep(2) .. string.sub(digits, 3, 3):rep(2)
	end
	return #digits == 6 and ("#" .. digits) or "#FFFFFF"
end

local function colorFromHex(value: string): Color3
	local normalized = normalizeHex(value)
	return Color3.fromRGB(
		tonumber(string.sub(normalized, 2, 3), 16) or 255,
		tonumber(string.sub(normalized, 4, 5), 16) or 255,
		tonumber(string.sub(normalized, 6, 7), 16) or 255
	)
end

local function defaultCombat(presetKey: string): any
	local isUtility = presetKey == "Idle" or presetKey == "Walk" or presetKey == "Jump" or presetKey == "Hit"
	return {
		Enabled = not isUtility,
		Damage = presetKey == "Ultimate" and 60 or (presetKey == "Guard" or presetKey == "Dash") and 0 or 20,
		CooldownTurns = (presetKey == "Basic" or presetKey == "Heavy" or presetKey == "Ultimate") and 0 or 2,
		Knockback = 0,
		TargetCount = 1,
		CastDirection = "target",
		Ranged = false,
		UltimateGain = (presetKey == "Basic" or presetKey == "Heavy") and 5 or 10,
		DashDistance = presetKey == "Dash" and 120 or 0,
		HeavyAfter = presetKey == "Heavy" and 3 or 0,
		Statuses = {},
		Buffs = {},
	}
end

local function newMotion(id: string, name: string): any
	return {
		Id = id,
		Name = name,
		Description = "",
		Duration = 0.8,
		DualWield = false,
		Complete = false,
		Combat = defaultCombat(id),
		Frames = {
			{
				Time = 0,
				Joints = {},
				JointRotations = {},
				JointOffsets = {},
				CastDirection = "target",
				RootOffset = vector(),
				Weapon = defaultWeapon(),
				Decorations = {},
				LayerOrder = { "Player", "Weapon" },
			},
			{
				Time = 0.8,
				Joints = {},
				JointRotations = {},
				JointOffsets = {},
				RootOffset = vector(),
				Weapon = defaultWeapon(),
				Decorations = {},
				LayerOrder = { "Player", "Weapon" },
			},
		},
		Hits = {},
		Events = { Effects = {}, Projectiles = {}, Teleports = {} },
	}
end

local function makeSection(parent: Instance, text: string): TextButton
	local title = Instance.new("TextButton")
	title.Size = UDim2.new(1, 0, 0, 34)
	title.BackgroundColor3 = THEME.PanelAlt
	title.BorderSizePixel = 0
	title.TextColor3 = THEME.GoldLight
	title.Font = Enum.Font.RobotoMono
	title.TextSize = 12
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Text = "     ▼  " .. string.upper(text)
	title.AutoButtonColor = false
	title:SetAttribute("SectionTitle", string.upper(text))
	title:SetAttribute("IsSectionHeader", true)
	title:SetAttribute("Collapsed", false)
	title.Parent = parent
	addStroke(title, THEME.WoodLight, 1)
	local accent = Instance.new("Frame")
	accent.Name = "SectionAccent"
	accent.Size = UDim2.new(0, 4, 1, -8)
	accent.Position = UDim2.fromOffset(4, 4)
	accent.BackgroundColor3 = THEME.Green
	accent.BorderSizePixel = 0
	accent.Parent = title
	title.Activated:Connect(function()
		local collapsed = not title:GetAttribute("Collapsed")
		title:SetAttribute("Collapsed", collapsed)
		title.Text = string.format("     %s  %s", collapsed and "▶" or "▼", title:GetAttribute("SectionTitle"))
		local siblings = {}
		for _, child in title.Parent:GetChildren() do
			if child:IsA("GuiObject") then
				table.insert(siblings, child)
			end
		end
		table.sort(siblings, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		local found = false
		for _, sibling in siblings do
			if sibling == title then
				found = true
			elseif found and sibling:GetAttribute("IsSectionHeader") then
				break
			elseif found then
				sibling.Visible = not collapsed and sibling:GetAttribute("DetailActive") ~= false
			end
		end
	end)
	return title
end

local function makeDeskHeader(parent: Instance, index: string, titleText: string, caption: string, accent: Color3)
	local header = Instance.new("Frame")
	header.Name = "DeskHeader"
	header.Size = UDim2.new(1, 0, 0, 42)
	header.BackgroundColor3 = THEME.Wood
	header.BorderSizePixel = 0
