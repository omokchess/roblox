--[[
	모든 직업이 함께 쓰는 스킬 (요청).

	  가드  이번 턴 받는 피해 70% 감소
	  명상  이번 턴 받는 피해 25% 증가, 스테미나 30 즉시 회복

	직업 목록 뒤에 항상 붙으므로 어떤 직업으로도 쓸 수 있다.
]]
local commonSkills: { Skill } = {
	{
		Id = "Guard",
		Name = "가드",
		Description = "이번 턴 받는 피해가 70% 줄어든다.",
		Damage = 0,
		Range = "Melee",
		Shape = { Kind = "Line", Radius = 1 },
	},
	{
		Id = "Meditate",
		Name = "명상",
		Description = "이번 턴 받는 피해가 25% 늘지만 스테미나를 30 즉시 회복한다.",
		Damage = 0,
		Range = "Melee",
		Shape = { Kind = "Line", Radius = 1 },
	},
}
local BattleSkills = {}

-- `Shape`(첫 모션)과 `Motions`(그 뒤를 잇는 모션들)를 순서대로 하나의 목록으로.
function BattleSkills.AllShapes(skill: Skill): { BattleGrid.Shape }
	local shapes = { skill.Shape }
	for _, motion in skill.Motions or {} do
		table.insert(shapes, motion)
	end
	return shapes
end

-- 적이 고르는 스킬 목록.
function BattleSkills.Enemy(): { Skill }
	return enemySkills
end

-- 강화 스킬 목록. 테스트가 대조하는 데 쓴다.
function BattleSkills.Upgrades(): { Skill }
	return upgradeSkills
end

-- 모든 직업이 함께 쓰는 스킬(가드·명상).
function BattleSkills.Common(): { Skill }
	return commonSkills
end

--[[
	직업의 스킬 목록. 모르는 직업이면 적 목록으로 접는다 — 빈 목록을 돌려주면
	스킬 바가 통째로 사라지고 왜 그런지 알기 어렵다.
]]
function BattleSkills.ForClass(classId: any): { Skill }
	return classSkills[tostring(classId)] or enemySkills
end

-- 예전 이름. 적 목록을 가리킨다(시험판 `Battle3DController`가 아직 쓴다).
function BattleSkills.All(): { Skill }
	return enemySkills
end

--[[
	번호로 고른다. 범위를 벗어나면 첫 스킬로 접는다(클라이언트가 보낸 값을 믿지 않는다).

	목록을 인자로 받는다 — 직업마다 목록이 다르므로 "어느 목록의 몇 번인지"를
	같이 넘겨야 서버와 클라이언트가 같은 스킬을 가리킨다.
]]
function BattleSkills.ByIndex(list: { Skill }, index: any): Skill
	local number = tonumber(index)
	if not number then
		return list[1]
	end
	return list[math.clamp(math.floor(number), 1, #list)]
end

function BattleSkills.ById(id: string): Skill?
	for _, list in classSkills do
		for _, skill in list do
			if skill.Id == id then
				return skill
			end
		end
	end
	for _, list in { upgradeSkills, commonSkills, enemySkills } do
		for _, skill in list do
			if skill.Id == id then
				return skill
			end
		end
	end
	return nil
end

-- 사거리 태그를 사람이 읽는 말로. UI가 버튼에 함께 띄운다.
local RANGE_LABELS: { [string]: string } = {
	Melee = "근거리",
	Ranged = "원거리",
	Supporting = "서포팅",
}

function BattleSkills.RangeLabel(skill: Skill): string
	return RANGE_LABELS[skill.Range] or skill.Range
end

--[[
	범위를 사람이 읽는 한 줄로. 스킬 설명 아래에 붙는다.

	`Shape`는 Kind와 Radius 두 값인데, 그 조합이 무엇을 덮는지는 `Targets`를 읽어야
	알 수 있다. 그걸 매번 짐작하게 두지 않으려고 말로 풀어 둔다.
]]
local SHAPE_TEXT: { [string]: string } = {
	Single = "단일 대상",
	Row = "대상이 선 행 전체",
	Column = "대상이 선 열 전체",
	Cross = "십자 %d칸",
	Square = "주변 %d칸 사각",
	Line = "앞으로 %d칸 직선",
	All = "적 전체",
}

function BattleSkills.ShapeText(skill: Skill): string
	local text
	-- 직접 찍은 범위는 이름이 없다. 몇 칸인지만 알려 준다.
	if skill.Shape.Cells then
		text = string.format("지정 %d칸", #skill.Shape.Cells)
	else
		local template = SHAPE_TEXT[skill.Shape.Kind] or skill.Shape.Kind
		text = if template:find("%%d") then string.format(template, skill.Shape.Radius or 1) else template
	end
	-- 앞뒤관통처럼 모션이 여럿이면(요청: "모션상 단계") 몇 번 때리는지도 알려 준다.
	if skill.Motions and #skill.Motions > 0 then
		text ..= string.format(" · %d모션", #skill.Motions + 1)
	end
	return text
end

--[[
	스킬이 실제로 덮는 상대 칸 목록.

	origin은 그 라인에서 처음 걸리는 상대 칸이다(사양: "스킬 시작 범위가 적한테 닿은
	시점에서 시작"). 라인에 아무도 없으면 빈 목록 — 없는 상대 자리를 칠하지 않는다.
	단 Row(라인 관통)는 x를 쓰지 않으므로 상대가 없어도 라인 전체가 그대로 범위다.

	**미리보기와 실제 판정이 이 함수를 함께 쓴다.**

	`shape`는 `skill.Shape` 하나만 받는다 — 스킬 하나가 모션을 여럿 가질 수
	있어서(요청: "모션상 단계"), "이 스킬의 범위"가 아니라 "이 모션 하나의
	범위"를 묻는 함수가 됐다. 스킬 전체를 때리려면 `BattleSkills.AllShapes`로
	모션마다 이 함수를 부른다.

	`growCount`는 자원을 캐스터가 몇 개 들고 있는지다 — 그 값을 세는 것(자원
	상한, 캐스터가 누구인지)은 이 파일이 모를 일이라 부르는 쪽이 넘긴다.
	`shape.Stages`가 없는 모션은 넘겨도 무시된다.

	`casterX`는 캐스터 자신이 선 칸이다. `shape.TargetSide == "Ally"`일
	때만 쓴다 — 아군을 겨누는 스킬은 "상대가 처음 걸리는 칸"이 아니라 **캐스터
	자신의 칸**이 기준점이어야 한다(요청: "아군 진형에 스킬 사용"). 안 넘기면
	1번 칸으로 대충 잡는다 — 미리보기처럼 캐스터를 몰라도 대략은 보여야 하는
	자리에서 쓴다.
]]
function BattleSkills.Cells(
	grid: BattleGrid.Grid,
	attackerSide: BattleGrid.Side,
	lane: number,
	shape: BattleGrid.Shape,
	growCount: number?,
	casterX: number?
): { BattleGrid.Cell }
	if shape.TargetSide == "Ally" then
		return BattleGrid.CellsInShape(grid, attackerSide, casterX or 1, lane, shape, growCount)
	end
	local targetSide = BattleGrid.Opposing(attackerSide)
	if shape.Kind == "Row" then
		return BattleGrid.CellsInShape(grid, targetSide, 1, lane, shape, growCount)
	end
	local anchor = select(1, BattleGrid.FirstOccupiedColumn(grid, targetSide, lane))
	if not anchor then
		return {}
	end
	return BattleGrid.CellsInShape(grid, targetSide, anchor, lane, shape, growCount)
end

--[[
	`skill.GrowResource`를 `rawStack`개 들고 있을 때 몇 칸 자랄지.

	나누는 몫만 여기서 정한다 — 실제 스택 수를 읽는 것(누구의 상태를 볼지)은
	`GridBattle`·클라이언트 미리보기가 각자의 자리에서 한다. 여기 몰아 두는 건
	`GrowDivisor` 나눗셈 규칙이 부르는 쪽마다 따로 적히면 어긋나기 쉬워서다.
]]
function BattleSkills.GrowCount(skill: Skill, rawStack: number): number
	if not skill.GrowResource then
		return 0
	end
	return math.floor(rawStack / (skill.GrowDivisor or 1))
end

-- 위 칸들 중 실제로 유닛이 있는 것. 대미지 대상이다(아군을 겨누면 아군이 대상이다).
-- `shape`도 `Cells`와 같은 이유로 모션 하나만 받는다 — 스킬 전체는 `AllShapes`로 모아 부른다.
function BattleSkills.Targets(
	grid: BattleGrid.Grid,
	attackerSide: BattleGrid.Side,
	lane: number,
	shape: BattleGrid.Shape,
	growCount: number?,
	casterX: number?
): { string }
	local targetSide = if shape.TargetSide == "Ally" then attackerSide else BattleGrid.Opposing(attackerSide)
	local hit: { string } = {}
	local seen: { [string]: boolean } = {}
	for _, cell in BattleSkills.Cells(grid, attackerSide, lane, shape, growCount, casterX) do
		local occupant = BattleGrid.Occupant(grid, targetSide, cell.X, cell.Y)
		if occupant and not seen[occupant] then
			seen[occupant] = true
			table.insert(hit, occupant)
		end
	end
	return hit
end

-- 사거리를 사람이 읽는 문장으로. UI와 로그가 함께 쓴다.
function BattleSkills.RangeText(skill: Skill): string
	local shape = skill.Shape
	if shape.Kind == "Row" then
		return "라인 전체"
	elseif shape.Kind == "Line" then
		return string.format("앞 %d칸", shape.Radius or 1)
	elseif shape.Kind == "Cross" then
		return "십자 범위"
	elseif shape.Kind == "Square" then
		local width = (shape.Radius or 1) * 2 + 1
		return string.format("%d×%d 범위", width, width)
	end
	return "범위"
end

return BattleSkills
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">BattleStatus</string>
          <string name="Source"><![CDATA[--!strict
--[[
	BattleStatus — 유닛 하나가 지고 있는 **상태이상·자원·보정값** 전부.

	사양 출처: `상태이상.md` (지속 피해·보호막 정의), `유저 아이디어(직업).md` (직업 자원)

	--------------------------------------------------------------------------
	왜 따로 뺐나

	`GridBattle`은 원래 Health·Power·Groggy만 알았다. 그래서 어떤 스킬도 "버프를
	건다 / 자원을 쌓는다 / 3턴 뒤에 풀린다"를 표현할 수 없었고, 직업 스킬 절반이
	피해 0인 껍데기로 남아 있었다.

	이 모듈은 그 껍데기를 채우기 위한 것이며, **순수 계산만** 한다. Roblox 타입을
	쓰지 않으므로 Lune 테스트에서 그대로 돌아간다.

	--------------------------------------------------------------------------
	담는 것 네 가지

	  1. 보호막    추가 HP. 피해를 먼저 먹는다.
	  2. 지속 피해 출혈·독·화상·기름. 규칙은 전부 `상태이상.md`에서 왔다.
	  3. 스택      직업 자원. 음표·집중·질량·광신·벽·허물 벽·감극·공명·약재…
	               이름만 다르고 동작이 같아 하나의 표로 다룬다.
	  4. 보정값    기한이 있는 ±%. 같은 종류가 여럿이면 **합산**한다.

	--------------------------------------------------------------------------
	지속 피해 규칙 (`상태이상.md` 그대로)

	  출혈  매 턴 최대 체력의 5% 물리 피해. 턴 종료 시 1 감소.
	  독    매 턴 (독 수치)만큼 고정 피해. 턴 종료 시 3 감소.
	  화상  매 턴 (화상 수치)% 화염 피해. 턴 종료 시 1 감소.
	  기름  화염 속성으로 받는 피해 50% 증가. (남은 턴 수로 관리)

	**세 가지 모두 이 효과로는 죽지 않는다.** 그래서 `Tick`은 피해량을 돌려주기만
	하고, 체력을 깎는 것은 `GridBattle`이 "죽지 않게" 처리한다.
]]

local BattleStatus = {}

-- 출혈 한 번이 주는 피해: 최대 체력의 5%.
BattleStatus.BLEED_MAX_HEALTH_RATIO = 0.05
-- 턴 종료 시 각 지속 피해가 빠지는 양.
BattleStatus.BLEED_DECAY = 1
BattleStatus.POISON_DECAY = 3
BattleStatus.BURN_DECAY = 1
-- 기름이 화염 피해를 키우는 비율.
BattleStatus.OIL_FIRE_BONUS = 0.5

--[[
	피해 속성.

	  Physical  물리. 대부분의 스킬과 출혈.
	  Fire      화염. 기름과 맞물린다.
	  True      고정. 어떤 보정도 받지 않는다(독, 개발용 고정 피해).
]]
export type Element = "Physical" | "Fire" | "True"

--[[
	기한이 있는 보정값의 종류.

	모두 **비율**이다(0.2 = 20%). Reflect만 예외로 절대값이다.
]]
export type ModifierKind =
	"DamageDealt" -- 주는 피해
	| "DamageTaken" -- 받는 피해
	| "CritChance" -- 치명타 확률
	| "CritDamage" -- 치명타 피해
	| "ParryWindow" -- 패링·방어 판정 폭
	| "Accuracy" -- 명중률
	| "HealTaken" -- 받는 회복량
	| "BuffTaken" -- 받는 버프 효율
	| "Reflect" -- 피격 시 반사 피해 (절대값)

export type Modifier = {
	Kind: ModifierKind,
	Value: number,
	-- 남은 턴. -1이면 전투가 끝날 때까지.
	Turns: number,
	-- 로그·UI에 띄울 이름. 어떤 스킬이 걸었는지 알아보려고 둔다.
	Source: string,
}

export type State = {
	Shield: number,
	Bleed: number,
	Poison: number,
	Burn: number,
	Oil: number,
	Stacks: { [string]: number },
	Modifiers: { Modifier },
}

-- 지속 피해 한 턴치를 정리한 결과. GridBattle이 이걸 받아 체력을 깎는다.
export type TickResult = {
	-- 속성별 피해량. 이 피해로는 죽지 않는다.
	Physical: number,
	Fire: number,
	True: number,
	-- 로그에 남길 줄. 비어 있으면 이번 턴에 지속 피해가 없었다는 뜻이다.
	Notes: { string },
}

function BattleStatus.New(): State
	return {
		Shield = 0,
		Bleed = 0,
		Poison = 0,
		Burn = 0,
		Oil = 0,
		Stacks = {},
		Modifiers = {},
	}
end

--=== 스택 ===--

--[[
	스택을 쌓는다. cap이 있으면 그 값에서 멈춘다.

	**상한을 부르는 쪽이 넘긴다.** 자원마다 상한이 다르고(음표는 박자표에 따라
	4/8/16, 집중은 10, 질량은 20…) 그 규칙은 직업 쪽 관심사이기 때문이다.
	`유저 아이디어(직업).md` 규격의 "스택은 반드시 상한이 있을 것"은 부르는 쪽에서 지킨다.
]]
function BattleStatus.AddStack(state: State, id: string, amount: number, cap: number?): number
	local next_ = (state.Stacks[id] or 0) + amount
	if cap then
		next_ = math.min(next_, cap)
	end
	state.Stacks[id] = math.max(0, math.floor(next_))
	return state.Stacks[id]
end

function BattleStatus.Stack(state: State, id: string): number
	return state.Stacks[id] or 0
end

--[[
	스택을 쓴다. 가진 만큼만 빠지고, **실제로 쓴 양**을 돌려준다.

	"소모한 스택 1당 피해 +N%"류 스킬이 많아서, 요청량이 아니라 실제 소모량을
	알아야 계산이 맞는다.
]]
function BattleStatus.SpendStack(state: State, id: string, amount: number): number
	local have = state.Stacks[id] or 0
	local spent = math.min(have, math.max(0, math.floor(amount)))
	state.Stacks[id] = have - spent
	return spent
end

-- 스택을 전부 쓴다. 소모한 양을 돌려준다.
function BattleStatus.SpendAll(state: State, id: string): number
	local have = state.Stacks[id] or 0
	state.Stacks[id] = 0
	return have
end

--=== 보정값 ===--

--[[
	보정값을 붙인다. 같은 종류가 이미 있어도 **합쳐지지 않고 따로 쌓인다** —
	기한이 서로 다르기 때문이다. 합산은 조회할 때(`Total`) 한다.
]]
function BattleStatus.AddModifier(state: State, kind: ModifierKind, value: number, turns: number, source: string): ()
	table.insert(state.Modifiers, { Kind = kind, Value = value, Turns = turns, Source = source })
end

--[[
	같은 출처로 걸린 보정값을 모두 뗀다.

	태세(공격/방어)처럼 **하나만 켜져 있어야 하는** 것에 쓴다. 바꿀 때 이전 것을
	떼지 않으면 두 태세가 동시에 걸려 수치가 겹친다.
]]
function BattleStatus.RemoveBySource(state: State, source: string): ()
	local kept: { Modifier } = {}
	for _, modifier in state.Modifiers do
		if modifier.Source ~= source then
			table.insert(kept, modifier)
		end
	end
	state.Modifiers = kept
end

-- 그 종류의 보정값 합계.
function BattleStatus.Total(state: State, kind: ModifierKind): number
	local total = 0
	for _, modifier in state.Modifiers do
		if modifier.Kind == kind then
			total += modifier.Value
		end
	end
	return total
end

--=== 보호막 ===--

function BattleStatus.AddShield(state: State, amount: number): number
	state.Shield = math.max(0, state.Shield + math.floor(amount))
	return state.Shield
end

--[[
	보호막으로 피해를 먼저 먹는다. (흡수량, 남은 피해)를 돌려준다.
	`상태이상.md`: "(보호막 수치)만큼 추가 HP를 얻는다."
]]
function BattleStatus.Absorb(state: State, amount: number): (number, number)
	local absorbed = math.min(state.Shield, math.max(0, amount))
	state.Shield -= absorbed
	return absorbed, math.max(0, amount - absorbed)
end

--=== 지속 피해 ===--

function BattleStatus.AddBleed(state: State, amount: number): number
	state.Bleed = math.max(0, state.Bleed + math.floor(amount))
	return state.Bleed
end

function BattleStatus.AddPoison(state: State, amount: number): number
	state.Poison = math.max(0, state.Poison + math.floor(amount))
	return state.Poison
end

function BattleStatus.AddBurn(state: State, amount: number): number
	state.Burn = math.max(0, state.Burn + math.floor(amount))
	return state.Burn
end

-- 기름은 남은 턴으로 관리한다. 여러 번 걸면 더 긴 쪽이 남는다.
function BattleStatus.AddOil(state: State, turns: number): number
	state.Oil = math.max(state.Oil, math.floor(turns))
	return state.Oil
end

--[[
	이번 턴의 지속 피해를 정산한다. **체력은 건드리지 않는다** — 돌려준 값을
	`GridBattle`이 "죽지 않게" 적용한다(`상태이상.md`: "이 효과로 사망할 수 없다").

	감소는 여기서 함께 처리한다. 피해를 준 뒤 줄어드는 순서다.
]]
function BattleStatus.TickDots(state: State, maxHealth: number): TickResult
	local result: TickResult = { Physical = 0, Fire = 0, True = 0, Notes = {} }

	if state.Bleed > 0 then
		local damage = math.floor(maxHealth * BattleStatus.BLEED_MAX_HEALTH_RATIO)
		result.Physical += damage
		table.insert(result.Notes, string.format("출혈 %d (%d 피해)", state.Bleed, damage))
		state.Bleed = math.max(0, state.Bleed - BattleStatus.BLEED_DECAY)
	end

	if state.Poison > 0 then
		-- 독은 수치 그대로가 피해다. 그래서 감소가 3으로 크다.
		result.True += state.Poison
		table.insert(result.Notes, string.format("독 %d (%d 피해)", state.Poison, state.Poison))
		state.Poison = math.max(0, state.Poison - BattleStatus.POISON_DECAY)
	end

	if state.Burn > 0 then
		local damage = math.floor(maxHealth * state.Burn / 100)
		result.Fire += damage
		table.insert(result.Notes, string.format("화상 %d%% (%d 피해)", state.Burn, damage))
		state.Burn = math.max(0, state.Burn - BattleStatus.BURN_DECAY)
	end

	if state.Oil > 0 then
		state.Oil -= 1
	end

	return result
end

--=== 턴 넘기기 ===--

--[[
	기한이 있는 보정값을 한 턴 깎고, 다 된 것을 버린다.
	Turns == -1은 전투가 끝날 때까지 남는다.
]]
function BattleStatus.TickModifiers(state: State): ()
	local kept: { Modifier } = {}
	for _, modifier in state.Modifiers do
		if modifier.Turns < 0 then
			table.insert(kept, modifier)
		elseif modifier.Turns > 1 then
			modifier.Turns -= 1
			table.insert(kept, modifier)
		end
		-- Turns == 1이면 이번 턴이 마지막이었으므로 버린다.
	end
	state.Modifiers = kept
end

--=== 피해 계산 ===--

--[[
	공격 쪽 보정을 먹인 피해량.

	`DamageDealt`만 본다. 치명타는 부르는 쪽이 따로 굴린다 — 굴림 결과를 로그에
	남겨야 해서 여기서 숨기면 안 된다.
]]
function BattleStatus.OutgoingDamage(attacker: State, base: number): number
	return base * (1 + BattleStatus.Total(attacker, "DamageDealt"))
end

--[[
	방어 쪽 보정을 먹인 피해량. 보호막은 아직 빼지 않는다.

	  True 속성은 어떤 보정도 받지 않는다.
	  Fire 속성은 기름이 있으면 50% 늘어난다(`상태이상.md`).
]]
function BattleStatus.IncomingDamage(defender: State, amount: number, element: Element): number
	if element == "True" then
		return math.max(0, amount)
	end
	local scaled = amount * (1 + BattleStatus.Total(defender, "DamageTaken"))
	if element == "Fire" and defender.Oil > 0 then
		scaled *= 1 + BattleStatus.OIL_FIRE_BONUS
	end
	return math.max(0, scaled)
end

-- UI가 그릴 만큼만 추린 요약.
function BattleStatus.Snapshot(state: State): any
	local modifiers = {}
	for _, modifier in state.Modifiers do
		table.insert(modifiers, {
			Kind = modifier.Kind,
			Value = modifier.Value,
			Turns = modifier.Turns,
			Source = modifier.Source,
		})
	end
	local stacks = {}
	for id, amount in state.Stacks do
		if amount > 0 then
			stacks[id] = amount
		end
	end
	return {
		Shield = state.Shield,
		Bleed = state.Bleed,
		Poison = state.Poison,
		Burn = state.Burn,
		Oil = state.Oil,
		Stacks = stacks,
		Modifiers = modifiers,
	}
end

return BattleStatus
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">CardArt</string>
          <string name="Source"><![CDATA[--!strict
--[[
	CardArt — 능력 카드의 **그림**을 만드는 곳.

	요청: "희귀, 필수, 일반 카드들 그림 그리고".

	--------------------------------------------------------------------------
	왜 이미지 파일이 아니라 도형인가

	로블록스에서 그림을 쓰려면 PNG를 업로드해 에셋 ID를 받아야 한다. 카드가 340장이라
	업로드도 관리도 감당이 안 되고, 무엇보다 이 저장소만으로는 재현이 안 된다.
	그래서 **GUI 도형을 코드로 조립해** 그린다. 파일이 늘지 않고, 카드를 추가하면
	그림도 자동으로 생긴다.

	--------------------------------------------------------------------------
	무엇을 기준으로 다르게 그리나

	  등급(Grade) → 테두리 장식과 광채. 필수 > 희귀 > 일반 순으로 화려하다.
	  태그(Tags)  → 문양. 카드의 기믹 축이 곧 그림이 된다. 40종이 있다.
	  Id          → 같은 태그라도 회전·개수·색조가 조금씩 달라진다.

	즉 한눈에 "이건 필수구나 / 이건 화상 계열이구나"가 읽히고, 그러면서 카드마다
	다르게 보인다.

	--------------------------------------------------------------------------
	출력은 **순수한 표**다

	Roblox 인스턴스를 여기서 만들지 않는다. 좌표 0~1의 도형 목록만 돌려주고,
	실제 Frame 생성은 `TowerBattleController`가 한다.
	`BattleGrid`(논리) ↔ `BattleArena`(월드)를 나눈 것과 같은 이유로,
	이렇게 해 두면 Lune에서 그림을 검사할 수 있다.
]]

export type Shape = {
	-- 그림 영역을 한 변 1인 정사각형으로 본다. 중심 기준 좌표다.
	X: number,
	Y: number,
	W: number,
	H: number,
	Rotation: number,
	Color: Color3,
	Transparency: number,
	-- 모서리 둥글기 비율. 0.5면 원(또는 캡슐)이 된다.
	Corner: number,
	-- 0이면 채운 도형, 양수면 그 두께의 테두리만 그린다.
	Stroke: number,
	ZIndex: number,
}

export type Art = {
	Background: Color3,
	Accent: Color3,
	Shapes: { Shape },
}

local CardArtworks = require(script.Parent.CardArtworks)

local CardArt = {}

--=== 결정적 난수 ===--

--[[
	카드 Id에서 뽑는 변주값.

	Random을 쓰지 않는 이유는 **같은 카드가 항상 같은 그림**이어야 하기 때문이다.
	보상 화면을 다시 열 때마다 문양이 돌아가면 카드를 못 알아본다.
]]
--[[
	djb2. 비트 연산을 쓰지 않는 이유는 두 가지다.
	  - Luau에는 `~`(XOR) 연산자가 없다. bit32.bxor를 불러야 한다.
	  - 곱셈만 쓰면 Lune 테스트 환경에서도 그대로 돈다.

	31비트 안에서 굴려 배정밀도(2^53) 정밀도를 넘지 않게 한다.
]]
local MODULUS = 2147483647

local function hash(text: string): number
	local value = 5381
	for index = 1, #text do
		value = (value * 33 + string.byte(text, index)) % MODULUS
	end
	return value
end

-- hash에서 0~1 실수를 여러 개 뽑는다. stream을 바꾸면 서로 독립인 값이 나온다.
local function unit(seed: number, stream: number): number
	local mixed = (seed + stream * 374761) % MODULUS
	mixed = (mixed * 48271) % MODULUS
	return mixed / MODULUS
end

--=== 색 ===--

type Palette = { R: number, G: number, B: number }

local function rgb(r: number, g: number, b: number): Palette
	return { R = r, G = g, B = b }
end

-- "#rrggbb" 를 Color3 으로. 손으로 그린 그림이 색을 글자로 들고 있어서 필요하다.
local function fromHex(text: string): Color3
	local r, g, b = text:match("^#(%x%x)(%x%x)(%x%x)$")
	if not r then
		return Color3.fromRGB(255, 255, 255)
	end
	return Color3.fromRGB(tonumber(r, 16) :: number, tonumber(g, 16) :: number, tonumber(b, 16) :: number)
end

local function toColor(palette: Palette, scale: number): Color3
	return Color3.fromRGB(
		math.clamp(math.floor(palette.R * scale), 0, 255),
		math.clamp(math.floor(palette.G * scale), 0, 255),
		math.clamp(math.floor(palette.B * scale), 0, 255)
	)
end

--=== 문양 ===--

local function shape(
	x: number,
	y: number,
	w: number,
	h: number,
	rotation: number,
	color: Color3,
	corner: number,
	stroke: number,
	zIndex: number,
	transparency: number?
): Shape
	return {
		X = x,
		Y = y,
		W = w,
		H = h,
		Rotation = rotation,
		Color = color,
		Transparency = transparency or 0,
		Corner = corner,
		Stroke = stroke,
		ZIndex = zIndex,
	}
end

--[[
	문양 하나를 그리는 함수들.

	쓸 수 있는 도형은 **직사각형과 링 둘뿐**이다. 로블록스 GUI는 이미지 없이는
	삼각형을 그릴 수 없어서, 45도 돌린 사각형(마름모)과 캡슐형 막대를 겹쳐
	칼날·화살촉·불꽃을 만든다.

	--------------------------------------------------------------------------
	완성도를 위해 지키는 네 가지

	  1. **깊이**   모든 획은 어두운 그림자를 한 겹 깔고 그 위에 얹는다(`paint`).
	                납작한 흰 막대가 아니라 세워진 물체로 읽힌다.
	  2. **굵기**   획을 얇게 여러 개 늘어놓지 않고 굵게 적게 쓴다. 작게 줄여도
	                실루엣이 남는다.
	  3. **꽉 채움** 메달리온 안쪽(대략 0.2~0.8)을 채운다. 예전에는 문양이 작고
	                배경 무늬가 넓어 무엇이 주인공인지 흐렸다.
	  4. **한 초점** 장식을 흩뿌리지 않고 가운데 하나에 모은다.

	  rest = 변주값 (0~1). 같은 문양이라도 카드마다 조금씩 달라진다.
]]

-- 획 밑에 깔리는 그림자. 등급색 위에서 깊이를 만든다.
local SHADOW = Color3.fromRGB(18, 14, 30)
-- 그림자를 아래로 얼마나 밀지.
local SHADOW_DROP = 0.018

--[[
	획 하나를 **그림자 + 본체** 두 겹으로 찍는다.

	그림자를 따로 부르지 않고 여기 묶어 두는 이유: 한 군데서만 관리하면 문양을
	새로 추가할 때 깊이를 빼먹을 수 없다.
]]
local function paint(
	out: { Shape },
	x: number,
	y: number,
	w: number,
	h: number,
	rotation: number,
	color: Color3,
	corner: number,
	zIndex: number,
	transparency: number?
): ()
	table.insert(out, shape(x, y + SHADOW_DROP, w, h, rotation, SHADOW, corner, 0, zIndex - 1, 0.45))
	table.insert(out, shape(x, y, w, h, rotation, color, corner, 0, zIndex, transparency))
end

-- 테두리만 있는 링. 링은 그림자를 얕게 준다(속이 비어 있어 짙으면 탁해진다).
local function ring(
	out: { Shape },
	x: number,
	y: number,
	size: number,
	thickness: number,
	color: Color3,
	zIndex: number,
	transparency: number?
): ()
	table.insert(out, shape(x, y + SHADOW_DROP, size, size, 0, SHADOW, 0.5, thickness, zIndex - 1, 0.55))
	table.insert(out, shape(x, y, size, size, 0, color, 0.5, thickness, zIndex, transparency))
end

type Glyph = (color: Color3, dim: Color3, rest: (number) -> number) -> { Shape }

-- 문양은 이 z부터 쌓는다. 아래는 배경·메달리온 자리다.
local GZ = 6

--[[
	문양 32개. **태그 하나에 문양 하나**다.

	예전에는 14개 문양을 32개 태그가 나눠 썼다. "같은 축이면 같은 그림"이 읽히기를
	바랐지만, 실제로는 벽 부수는 자의 희귀·일반과 연금술사의 희귀가 똑같아 보였다.
	카드를 그림으로 구분하려는 것이 목적이므로, 축을 읽히게 하는 쪽보다 **카드가
	서로 달라 보이는 쪽**을 택한다. 축은 바탕색(등급)과 부호 보석이 맡는다.

	--------------------------------------------------------------------------
	그리는 규칙 (전부 사각형과 링으로만 만든다)

	  1. **깊이**   모든 획은 `paint`로 그림자를 한 겹 깔고 올린다.
	  2. **굵기**   획을 얇게 여러 개 늘어놓지 않는다. 작게 줄여도 실루엣이 남게.
	  3. **꽉 채움** 메달리온 안쪽(대략 0.15~0.85)을 채운다.
	  4. **한 초점** 장식을 흩뿌리지 않는다.

	  rest = 변주값 (0~1). 같은 문양이라도 카드마다 조금씩 달라진다.
]]

--=== 방어 계열 ===--

-- 방패(Guard): 몸판 + 아래 꼭지 + 중앙 보스 + 세로 리브.
local function shield(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local wide = 0.56 + rest(1) * 0.05

	paint(out, 0.5, 0.42, wide, 0.42, 0, color, 0.2, GZ)
	paint(out, 0.5, 0.66, wide * 0.78, wide * 0.78, 45, color, 0.14, GZ)
	table.insert(out, shape(0.5, 0.5, wide * 0.74, 0.62, 0, dim, 0.18, 0.022, GZ + 2, 0.25))
	paint(out, 0.5, 0.48, 0.055, 0.42, 0, dim, 0.5, GZ + 3)
	paint(out, 0.5, 0.44, 0.17, 0.17, 0, color, 0.5, GZ + 4)
	paint(out, 0.5, 0.44, 0.08, 0.08, 0, dim, 0.5, GZ + 5)
	return out
end

--[[
	이지스(Aegis): 겹겹이 두른 돔.

	살(spoke)을 쓰지 않는다 — 결계(Ward)가 링 + 살 + 마름모라서, 여기에 살을 두면
	둘이 같은 그림이 된다. 대신 **속이 찬 원을 겹쳐 쌓고** 아래를 받침으로 잘라
	돔으로 읽히게 한다.
]]
local function aegis(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local lift = rest(1) * 0.05

	ring(out, 0.5, 0.56 - lift, 0.92, 0.05, dim, GZ, 0.4)
	paint(out, 0.5, 0.56 - lift, 0.72, 0.72, 0, color, 0.5, GZ + 2)
	paint(out, 0.5, 0.56 - lift, 0.5, 0.5, 0, dim, 0.5, GZ + 3)
	paint(out, 0.5, 0.56 - lift, 0.3, 0.3, 45, color, 0.05, GZ + 4)
	paint(out, 0.5, 0.92, 0.94, 0.18, 0, color, 0.1, GZ + 5)
	return out
end

-- 도금(Plating): 비늘 갑옷 세 줄. 겹쳐 놓아 층이 보이게 한다.
local function plating(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local drift = rest(1) * 0.03

	for row = 1, 3 do
		local y = 0.34 + (row - 1) * 0.21 + drift
		local count = if row % 2 == 1 then 3 else 2
		for index = 1, count do
			local x = 0.5 + (index - (count + 1) / 2) * 0.25
			paint(out, x, y, 0.23, 0.27, 0, if row == 2 then color else dim, 0.4, GZ + row)
		end
	end
	paint(out, 0.5, 0.16, 0.82, 0.09, 0, color, 0.4, GZ + 5)
	return out
end

-- 결계(Ward): 룬 원. 겹친 링 + 네 방향 축 + 가운데 마름모.
local function ward(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local spin = rest(1) * 30

	ring(out, 0.5, 0.5, 0.84, 0.03, dim, GZ, 0.3)
	for index = 0, 3 do
		paint(out, 0.5, 0.5, 0.05, 0.9, spin + index * 45, dim, 0.5, GZ + 1)
	end
	ring(out, 0.5, 0.5, 0.6, 0.05, color, GZ + 3)
	paint(out, 0.5, 0.5, 0.3, 0.3, 45, color, 0.06, GZ + 5)
	paint(out, 0.5, 0.5, 0.13, 0.13, 45, dim, 0.03, GZ + 6)
	return out
end

-- 인내(Endure): 모래시계. 마름모 두 개를 꼭짓점끼리 맞대 허리를 만든다.
local function endure(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local sand = 0.16 + rest(1) * 0.08

	paint(out, 0.5, 0.23, 0.38, 0.38, 45, color, 0.06, GZ)
	paint(out, 0.5, 0.77, 0.38, 0.38, 45, color, 0.06, GZ)
	paint(out, 0.5, 0.5, 0.08, 0.3, 0, dim, 0.5, GZ + 2)
	paint(out, 0.5, 0.76, 0.26, sand, 0, dim, 0.2, GZ + 3)
	paint(out, 0.5, 0.1, 0.58, 0.09, 0, color, 0.3, GZ + 4)
	paint(out, 0.5, 0.9, 0.58, 0.09, 0, color, 0.3, GZ + 4)
	return out
end

-- 선봉(Vanguard): 앞으로 향한 쐐기 셋. 뒤로 갈수록 흐려 대열로 읽힌다.
local function vanguard(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local lean = 36 + rest(1) * 8

	for index = 0, 2 do
		local y = 0.32 + index * 0.23
		local thickness = 0.14 - index * 0.03
		local tone = if index == 0 then color else dim
		paint(out, 0.31, y, thickness, 0.52, lean, tone, 0.5, GZ + (2 - index) * 2)
		paint(out, 0.69, y, thickness, 0.52, -lean, tone, 0.5, GZ + (2 - index) * 2)
	end
	return out
end

-- 닻(Anchor): 고리 + 기둥 + 스톡 + 갈고리.
local function anchor(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local fluke = 0.3 + rest(1) * 0.05

	ring(out, 0.5, 0.18, 0.24, 0.05, color, GZ + 4)
	paint(out, 0.5, 0.56, 0.11, 0.62, 0, color, 0.5, GZ)
	paint(out, 0.5, 0.36, 0.56, 0.08, 0, color, 0.5, GZ + 2)
	paint(out, 0.27, 0.74, 0.09, fluke, 40, color, 0.5, GZ + 1)
	paint(out, 0.73, 0.74, 0.09, fluke, -40, color, 0.5, GZ + 1)
	paint(out, 0.5, 0.85, 0.42, 0.08, 0, dim, 0.5, GZ + 3)
	return out
end

--[[
	도발(Taunt): 오른쪽으로 벌어지는 확성기 + 퍼져 나가는 음파.

	음파를 동심원으로 그리면 나팔이 원 한가운데 박혀 방향이 사라진다. 길이가 다른
	세로 획 셋으로 대신해 **어느 쪽으로 지르고 있는지**가 읽히게 한다.
]]
local function taunt(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local reach = 0.16 + rest(1) * 0.06

	paint(out, 0.17, 0.5, 0.14, 0.16, 0, dim, 0.4, GZ)
	paint(out, 0.3, 0.5, 0.17, 0.32, 0, color, 0.2, GZ + 1)
	paint(out, 0.45, 0.5, 0.21, 0.58, 0, color, 0.14, GZ + 2)
	paint(out, 0.52, 0.5, 0.12, 0.44, 0, dim, 0.3, GZ + 3)
	for index = 1, 3 do
		paint(out, 0.67 + (index - 1) * 0.13, 0.5, 0.06, 0.2 + index * reach, 0, dim, 0.5, GZ + 4)
	end
	return out
end

--=== 근접 계열 ===--

-- 정밀(Precision): 레이피어. 컵 가드와 **가느다란** 날로 무게를 뺀다.
local function precision(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local tilt = -30 + rest(1) * 12
	local function along(distance: number): (number, number)
		local radians = math.rad(tilt)
		return 0.5 + math.sin(radians) * distance, 0.5 - math.cos(radians) * distance
	end

	local pommelX, pommelY = along(-0.36)
	paint(out, pommelX, pommelY, 0.11, 0.13, tilt, dim, 0.5, GZ)
	local gripX, gripY = along(-0.24)
	paint(out, gripX, gripY, 0.09, 0.2, tilt, dim, 0.4, GZ)
	local cupX, cupY = along(-0.11)
	ring(out, cupX, cupY, 0.32, 0.05, color, GZ + 2)
	local bladeX, bladeY = along(0.18)
	paint(out, bladeX, bladeY, 0.07, 0.5, tilt, color, 0.04, GZ + 3)
	local tipX, tipY = along(0.45)
	paint(out, tipX, tipY, 0.09, 0.09, tilt + 45, color, 0.02, GZ + 4)
	return out
end

-- 처형(Execute): 도끼. 무거운 날 판을 크게 잡아 정밀과 정반대로 읽히게.
local function execute(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local lean = -14 + rest(1) * 10

	paint(out, 0.44, 0.58, 0.1, 0.78, lean, dim, 0.4, GZ)
	paint(out, 0.56, 0.32, 0.46, 0.4, lean, color, 0.16, GZ + 2)
	paint(out, 0.76, 0.32, 0.22, 0.38, lean + 8, color, 0.5, GZ + 3)
	paint(out, 0.42, 0.13, 0.17, 0.17, lean + 45, dim, 0.03, GZ + 4)
	return out
end

-- 반격(Riposte): 엇갈린 검 두 자루 + 부딪친 자리의 불꽃.
local function riposte(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local spread = 28 + rest(1) * 10

	for _, side in { -1, 1 } do
		local angle = side * spread
		local tone = if side < 0 then color else dim
		paint(out, 0.5, 0.44, 0.1, 0.82, angle, tone, 0.05, GZ + (if side < 0 then 2 else 0))
		paint(out, 0.5 - side * 0.2, 0.72, 0.3, 0.075, angle, color, 0.4, GZ + 4)
	end
	paint(out, 0.5, 0.42, 0.19, 0.19, 45, color, 0.03, GZ + 6)
	return out
end

-- 심판(Judgment): 저울. 접시가 살짝 기울어 판정 중인 것으로 보이게 한다.
local function judgment(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local tip = rest(1) * 8 - 4

	paint(out, 0.5, 0.54, 0.1, 0.68, 0, color, 0.3, GZ + 2)
	paint(out, 0.5, 0.87, 0.46, 0.09, 0, color, 0.4, GZ + 3)
	paint(out, 0.5, 0.24, 0.8, 0.075, tip, color, 0.5, GZ + 4)
	for _, side in { -1, 1 } do
		local x = 0.5 + side * 0.35
		local y = 0.24 + side * math.rad(tip) * 0.35
		paint(out, x, y + 0.11, 0.04, 0.18, 0, dim, 0.5, GZ)
		paint(out, x, y + 0.24, 0.31, 0.15, 0, dim, 0.45, GZ + 1)
	end
	return out
end

-- 독주(Solo): 무대 조명 아래 혼자 선 사람.
local function solo(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local beam = 20 + rest(1) * 8

	paint(out, 0.34, 0.58, 0.13, 0.74, beam, dim, 0.3, GZ, 0.55)
	paint(out, 0.66, 0.58, 0.13, 0.74, -beam, dim, 0.3, GZ, 0.55)
	paint(out, 0.5, 0.6, 0.32, 0.66, 0, dim, 0.2, GZ + 1, 0.6)
	paint(out, 0.5, 0.15, 0.32, 0.15, 0, color, 0.3, GZ + 3)
	paint(out, 0.5, 0.78, 0.24, 0.3, 0, color, 0.4, GZ + 5)
	paint(out, 0.5, 0.58, 0.16, 0.16, 0, color, 0.5, GZ + 6)
	return out
end

--=== 불·분노 계열 ===--

-- 화상(Burn): 큰 불꽃 하나 + 옆으로 튄 불씨 둘.
local function burn(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local lean = -7 + rest(1) * 14

	paint(out, 0.24, 0.72, 0.26, 0.3, 45 + lean * 1.6, dim, 0.12, GZ)
	paint(out, 0.76, 0.72, 0.26, 0.3, 45 - lean * 1.6, dim, 0.12, GZ)
	paint(out, 0.5, 0.58, 0.48, 0.52, 45 + lean * 0.5, color, 0.14, GZ + 2)
	paint(out, 0.5, 0.44, 0.21, 0.25, 45 + lean, dim, 0.08, GZ + 4)
	return out
end

-- 분노(Rage): 치켜올린 눈썹 + 벌린 입의 이빨. 얼굴로 읽히게 한다.
local function rage(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local anger = 22 + rest(1) * 10

	paint(out, 0.28, 0.28, 0.42, 0.12, anger, color, 0.4, GZ + 2)
	paint(out, 0.72, 0.28, 0.42, 0.12, -anger, color, 0.4, GZ + 2)
	paint(out, 0.5, 0.66, 0.58, 0.38, 0, dim, 0.3, GZ)
	for index = 1, 3 do
		paint(out, 0.28 + (index - 1) * 0.22, 0.6, 0.15, 0.15, 45, color, 0.02, GZ + 3)
	end
	return out
end

-- 광란(Frenzy): 소용돌이. 길이가 다른 획을 60도씩 돌려 회전으로 읽히게.
local function frenzy(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local spin = rest(1) * 60

	for index = 0, 2 do
		local tone = if index == 0 then color else dim
		paint(out, 0.5, 0.5, 0.17, 0.9 - index * 0.16, spin + index * 60, tone, 0.5, GZ + index)
	end
	ring(out, 0.5, 0.5, 0.5, 0.055, color, GZ + 4)
	paint(out, 0.5, 0.5, 0.19, 0.19, 45, color, 0.03, GZ + 6)
	return out
end

-- 촉매(Catalyst): 결정 + 위로 튀는 스파크.
local function catalyst(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local facet = rest(1) * 10 - 5

	paint(out, 0.5, 0.48, 0.48, 0.48, 45 + facet, color, 0.05, GZ)
	paint(out, 0.5, 0.68, 0.42, 0.42, 45 + facet, color, 0.05, GZ + 1)
	paint(out, 0.5, 0.58, 0.15, 0.46, facet, dim, 0.06, GZ + 3)
	paint(out, 0.38, 0.19, 0.06, 0.26, 26, dim, 0.5, GZ + 4)
	paint(out, 0.62, 0.19, 0.06, 0.26, -26, dim, 0.5, GZ + 4)
	return out
end

-- 과부하(Overload): 터지는 별. 살이 여덟, 가운데 핵.
local function overload(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local spin = rest(1) * 30

	for index = 0, 3 do
		local tone = if index % 2 == 0 then color else dim
		paint(out, 0.5, 0.5, 0.11, 0.98, spin + index * 45, tone, 0.5, GZ)
	end
	ring(out, 0.5, 0.5, 0.5, 0.05, color, GZ + 3)
	paint(out, 0.5, 0.5, 0.3, 0.3, 0, color, 0.5, GZ + 5)
	paint(out, 0.5, 0.5, 0.13, 0.13, 45, dim, 0.03, GZ + 6)
	return out
end

--=== 피·희생 계열 ===--

-- 피(Blood): 큰 방울 + 아래로 튄 작은 방울들.
local function blood(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local splash = 2 + math.floor(rest(1) * 2)

	paint(out, 0.5, 0.56, 0.46, 0.46, 0, color, 0.5, GZ)
	paint(out, 0.5, 0.28, 0.31, 0.31, 45, color, 0.05, GZ)
	paint(out, 0.41, 0.52, 0.13, 0.16, -12, dim, 0.5, GZ + 3)
	for index = 1, splash do
		local x = 0.5 + (index - (splash + 1) / 2) * 0.3
		paint(out, x, 0.88, 0.11, 0.13, 0, dim, 0.5, GZ + 2)
	end
	return out
end

-- 벼랑(Brink): 갈라진 절벽과 떨어지는 조각. 체력이 깎인 상태를 나타낸다.
local function brink(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local crack = 0.07 + rest(1) * 0.04

	paint(out, 0.25, 0.74, 0.44, 0.42, 0, color, 0.05, GZ)
	paint(out, 0.31, 0.52, 0.32, 0.2, 0, color, 0.05, GZ + 1)
	paint(out, 0.79, 0.79, 0.36, 0.34, 0, dim, 0.05, GZ)
	paint(out, 0.54, 0.66, crack, 0.56, 9, dim, 0.5, GZ + 3)
	paint(out, 0.58, 0.34, 0.16, 0.16, 30, color, 0.04, GZ + 4)
	paint(out, 0.69, 0.17, 0.1, 0.1, 14, dim, 0.04, GZ + 4)
	return out
end

-- 희생(Sacrifice): 제단에 꽂힌 단검 + 떨어지는 방울.
local function sacrifice(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local drift = rest(1) * 8 - 4

	paint(out, 0.5, 0.82, 0.68, 0.15, 0, dim, 0.08, GZ)
	paint(out, 0.5, 0.14, 0.13, 0.17, drift, dim, 0.4, GZ + 1)
	paint(out, 0.5, 0.25, 0.38, 0.08, drift, color, 0.4, GZ + 3)
	paint(out, 0.5, 0.49, 0.17, 0.42, drift, color, 0.05, GZ + 2)
	paint(out, 0.5, 0.69, 0.15, 0.15, drift + 45, color, 0.02, GZ + 4)
	paint(out, 0.29, 0.93, 0.1, 0.12, 0, color, 0.5, GZ + 5)
	paint(out, 0.71, 0.93, 0.08, 0.1, 0, color, 0.5, GZ + 5)
	return out
end

--=== 원거리 계열 ===--

-- 연사(Volley): 나란히 날아가는 화살 셋. 가운데만 밝게 한다.
local function volley(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local fan = 9 + rest(1) * 10

	for index = -1, 1 do
		local angle = index * fan
		local x = 0.5 + index * 0.27
		local tone = if index == 0 then color else dim
		paint(out, x, 0.58, 0.08, 0.6, angle, tone, 0.5, GZ + 2 + index)
		paint(out, x + index * 0.06, 0.24, 0.19, 0.19, angle + 45, tone, 0.03, GZ + 4 + index)
	end
	return out
end

-- 표식(Mark): 조준 십자선. 링 두 겹 + 십자 + 가운데 점.
local function mark(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local spin = rest(1) * 16 - 8

	ring(out, 0.5, 0.5, 0.8, 0.045, color, GZ)
	for index = 0, 1 do
		paint(out, 0.5, 0.5, 0.06, 1.0, spin + index * 90, dim, 0.5, GZ + 1)
	end
	ring(out, 0.5, 0.5, 0.4, 0.055, dim, GZ + 3)
	-- 가운데는 마름모가 아니라 점이다. 결계(Ward)의 마름모 핵과 겹치지 않게.
	paint(out, 0.5, 0.5, 0.17, 0.17, 0, color, 0.5, GZ + 5)
	return out
end

-- 확산(Spread): 가운데에서 네 방향으로 뻗는 화살.
local function spread(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local spin = rest(1) * 30

	for index = 0, 3 do
		local angle = spin + index * 90
		local radians = math.rad(angle)
		paint(out, 0.5 + math.sin(radians) * 0.28, 0.5 - math.cos(radians) * 0.28, 0.08, 0.26, angle, dim, 0.5, GZ)
		paint(
			out,
			0.5 + math.sin(radians) * 0.44,
			0.5 - math.cos(radians) * 0.44,
			0.18,
			0.18,
			angle + 45,
			color,
			0.03,
			GZ + 2
		)
	end
	paint(out, 0.5, 0.5, 0.28, 0.28, 0, color, 0.5, GZ + 4)
	paint(out, 0.5, 0.5, 0.12, 0.12, 0, dim, 0.5, GZ + 6)
	return out
end

-- 충전(Charge): 번개 + 바깥 궤도 링.
local function charge(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local zag = 24 + rest(1) * 12

	ring(out, 0.5, 0.5, 0.88, 0.035, dim, GZ, 0.45)
	paint(out, 0.58, 0.27, 0.15, 0.42, zag, color, 0.05, GZ + 2)
	paint(out, 0.42, 0.7, 0.15, 0.42, zag, color, 0.05, GZ + 2)
	paint(out, 0.5, 0.48, 0.38, 0.13, -16, color, 0.05, GZ + 4)
	return out
end

--=== 신앙 계열 ===--

-- 기도력(Faith): 십자가 + 후광.
local function faith(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local spin = rest(1) * 8 - 4

	ring(out, 0.5, 0.27, 0.46, 0.04, dim, GZ, 0.35)
	paint(out, 0.5, 0.53, 0.19, 0.78, spin, color, 0.1, GZ + 2)
	paint(out, 0.5, 0.43, 0.62, 0.19, spin, color, 0.1, GZ + 2)
	paint(out, 0.5, 0.43, 0.19, 0.19, spin + 45, dim, 0.04, GZ + 4)
	paint(out, 0.5, 0.86, 0.32, 0.06, spin, dim, 0.5, GZ + 3)
	return out
end

--=== 음악 계열 ===--

-- 음표(Melody): 한 개짜리 8분음표.
local function melody(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local lean = -14 + rest(1) * 10

	paint(out, 0.58, 0.44, 0.09, 0.6, 0, color, 0.3, GZ)
	paint(out, 0.4, 0.7, 0.35, 0.27, lean, color, 0.5, GZ + 2)
	paint(out, 0.4, 0.7, 0.17, 0.12, lean, dim, 0.5, GZ + 4)
	paint(out, 0.72, 0.19, 0.27, 0.09, 28, color, 0.4, GZ + 3)
	paint(out, 0.7, 0.31, 0.21, 0.08, 28, dim, 0.4, GZ + 3)
	return out
end

-- 합창(Chorus): 보표 위에 늘어선 음표 셋. 음표 하나짜리와 확실히 구분된다.
local function chorus(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local sway = rest(1) * 10 - 5

	for index = 1, 3 do
		local x = 0.25 + (index - 1) * 0.25
		local y = 0.68 - (index - 2) * 0.11
		local tone = if index == 2 then color else dim
		paint(out, x + 0.1, y - 0.19, 0.06, 0.36, 0, tone, 0.3, GZ)
		paint(out, x, y, 0.23, 0.18, sway, tone, 0.5, GZ + 2)
	end
	paint(out, 0.5, 0.92, 0.9, 0.045, 0, color, 0.5, GZ + 4)
	paint(out, 0.5, 0.12, 0.9, 0.035, 0, dim, 0.5, GZ + 4, 0.4)
	return out
end

-- 박자표(Tempo): 메트로놈. 진자가 기울어 박자가 도는 것으로 읽힌다.
local function tempo(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local swing = -18 + rest(1) * 36
	local radians = math.rad(swing)

	paint(out, 0.5, 0.64, 0.54, 0.5, 0, color, 0.1, GZ)
	paint(out, 0.5, 0.32, 0.28, 0.3, 0, color, 0.1, GZ + 1)
	paint(out, 0.5, 0.56, 0.06, 0.62, swing, dim, 0.4, GZ + 3)
	paint(out, 0.5 + math.sin(radians) * 0.22, 0.56 - math.cos(radians) * 0.22, 0.17, 0.1, swing, dim, 0.2, GZ + 4)
	paint(out, 0.5, 0.88, 0.64, 0.09, 0, dim, 0.3, GZ + 5)
	return out
end

--=== 연쇄·제작 계열 ===--

-- 사슬(Chain): 맞물린 링 셋.
local function chain(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local tilt = -18 + rest(1) * 36

	for index = 1, 3 do
		local t = (index - 2) * 0.23
		local radians = math.rad(tilt)
		local x = 0.5 + math.cos(radians) * t
		local y = 0.5 + math.sin(radians) * t
		ring(out, x, y, 0.33, 0.05, if index % 2 == 0 then dim else color, GZ + index * 2)
	end
	return out
end

-- 조합(Brew): 목이 긴 플라스크 + 안의 액체와 기포.
local function brew(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local bubble = 0.07 + rest(1) * 0.04

	paint(out, 0.5, 0.66, 0.6, 0.58, 0, color, 0.5, GZ)
	paint(out, 0.5, 0.38, 0.44, 0.44, 45, color, 0.05, GZ)
	paint(out, 0.5, 0.17, 0.19, 0.26, 0, color, 0.2, GZ + 1)
	paint(out, 0.5, 0.07, 0.29, 0.1, 0, dim, 0.3, GZ + 2)
	paint(out, 0.5, 0.76, 0.48, 0.3, 0, dim, 0.35, GZ + 4)
	paint(out, 0.39, 0.6, bubble, bubble, 0, color, 0.5, GZ + 5)
	paint(out, 0.61, 0.53, bubble * 0.7, bubble * 0.7, 0, color, 0.5, GZ + 5)
	return out
end

-- 축조(Construct): 엇갈려 쌓은 벽돌 + 갓돌.
local function construct(color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local out: { Shape } = {}
	local shift = rest(1) * 0.06

	for row = 0, 2 do
		local y = 0.34 + row * 0.22
		local offset = if row % 2 == 0 then 0 else 0.16
		for index = -1, 1 do
			local tone = if row == 1 then color else dim
			paint(out, 0.5 + index * 0.32 + offset - shift, y, 0.29, 0.2, 0, tone, 0.05, GZ + row)
		end
	end
	paint(out, 0.5, 0.15, 0.86, 0.11, 0, color, 0.1, GZ + 4)
	return out
end

--=== 태그 → 문양·색 ===--

type Family = { Glyph: Glyph, Base: Palette }

local BLADE_COLOR = rgb(226, 232, 240)
local IRON_COLOR = rgb(150, 172, 196)
local EMBER_COLOR = rgb(255, 138, 62)
local BLOOD_COLOR = rgb(214, 66, 82)
local LEAF_COLOR = rgb(126, 206, 132)
local ARCANE_COLOR = rgb(158, 128, 246)
local GOLD_COLOR = rgb(238, 190, 84)
local SHADE_COLOR = rgb(126, 118, 168)
local AQUA_COLOR = rgb(96, 198, 214)
local ROSE_COLOR = rgb(232, 132, 176)

--[[
	태그 32개를 문양에 붙인다. **1대1이다.**

	예전에는 40개 태그가 14개 문양을 나눠 썼다. 같은 축이면 같은 그림이라는 규칙은
	말은 되지만, 실제로 쓰이는 태그는 32개뿐이고 그중 서로 다른 직업의 카드가
	같은 그림으로 나오는 일이 잦았다(예: `Brink`·`Sacrifice`가 둘 다 물약병).
	그림의 목적은 축 분류가 아니라 **카드 구분**이므로 전부 갈랐다.

	색(`Base`)은 이제 두 번째 태그 부호에만 쓴다 — 바탕은 등급색 고정이다.
]]
local FAMILIES: { [string]: Family } = {
	-- 방어
	Guard = { Glyph = shield, Base = IRON_COLOR },
	Aegis = { Glyph = aegis, Base = AQUA_COLOR },
	Ward = { Glyph = ward, Base = ARCANE_COLOR },
	Plating = { Glyph = plating, Base = GOLD_COLOR },
	Endure = { Glyph = endure, Base = LEAF_COLOR },
	Vanguard = { Glyph = vanguard, Base = BLADE_COLOR },
	Anchor = { Glyph = anchor, Base = IRON_COLOR },
	Taunt = { Glyph = taunt, Base = EMBER_COLOR },

	-- 근접
	Precision = { Glyph = precision, Base = BLADE_COLOR },
	Execute = { Glyph = execute, Base = BLOOD_COLOR },
	Riposte = { Glyph = riposte, Base = AQUA_COLOR },
	Judgment = { Glyph = judgment, Base = GOLD_COLOR },
	Solo = { Glyph = solo, Base = ROSE_COLOR },

	-- 불·분노
	Burn = { Glyph = burn, Base = EMBER_COLOR },
	Rage = { Glyph = rage, Base = BLOOD_COLOR },
	Frenzy = { Glyph = frenzy, Base = ROSE_COLOR },
	Catalyst = { Glyph = catalyst, Base = GOLD_COLOR },
	Overload = { Glyph = overload, Base = ARCANE_COLOR },

	-- 피·희생
	Blood = { Glyph = blood, Base = BLOOD_COLOR },
	Brink = { Glyph = brink, Base = SHADE_COLOR },
	Sacrifice = { Glyph = sacrifice, Base = ROSE_COLOR },

	-- 원거리
	Volley = { Glyph = volley, Base = GOLD_COLOR },
	Mark = { Glyph = mark, Base = BLOOD_COLOR },
	Spread = { Glyph = spread, Base = EMBER_COLOR },
	Charge = { Glyph = charge, Base = ARCANE_COLOR },

	-- 신앙
	Faith = { Glyph = faith, Base = GOLD_COLOR },

	-- 음악
	Melody = { Glyph = melody, Base = ROSE_COLOR },
	Chorus = { Glyph = chorus, Base = GOLD_COLOR },
	Tempo = { Glyph = tempo, Base = AQUA_COLOR },

	-- 연쇄·제작
	Chain = { Glyph = chain, Base = ARCANE_COLOR },
	Brew = { Glyph = brew, Base = LEAF_COLOR },
	Construct = { Glyph = construct, Base = IRON_COLOR },
}

local FALLBACK: Family = { Glyph = ward, Base = IRON_COLOR }

--=== 손으로 고친 도형 ===--

--[[
	**도형 하나하나의 값을 덮어쓰는 표** (요청: "벡터 위치도 직접 바꿀 수 있게").

	문양은 절차적으로 그려진다 — 반복문과 카드별 변주가 섞여 있어서 좌표를 통째로
	데이터로 빼면 그 변주가 죽는다. 그래서 **그린 뒤에 덮어쓰는** 층을 하나 둔다.
	적어 넣은 값만 바뀌고, 적지 않은 값은 그대로 절차적으로 남는다.

	  [태그] = { [도형번호] = { X = 0.42, Rotation = -20 } }

	도형 번호는 그 문양이 내놓는 순서다. `config_editor.html`의 아이콘 탭이 번호를
	보여주고, 값을 고치면 `apply_config_edits.luau`가 이 표에 적는다.

	좌표는 **메달리온에 넣기 전** 문양 자신의 0~1 좌표다.
]]
export type ShapeOverride = {
	X: number?,
	Y: number?,
	W: number?,
	H: number?,
	Rotation: number?,
}

local SHAPE_OVERRIDES: { [string]: { [number]: ShapeOverride } } = {}

--[[
	그림자를 함께 옮긴다.

	`paint`는 획 하나를 **그림자 + 본체** 두 겹으로 찍는다. 본체만 옮기면 그림자가
	제자리에 남아 획이 두 개로 보인다. 앞 도형이 이 도형의 그림자인지(같은 크기·각도에
	Y만 SHADOW_DROP만큼 아래) 보고, 맞으면 같은 값을 먹인다.
]]
local function isShadowOf(shadow: Shape, body: Shape): boolean
	return math.abs(shadow.W - body.W) < 1e-6
		and math.abs(shadow.H - body.H) < 1e-6
		and math.abs(shadow.Rotation - body.Rotation) < 1e-6
		and math.abs((shadow.Y - body.Y) - SHADOW_DROP) < 1e-6
end

local function applyOverride(item: Shape, patch: ShapeOverride)
	item.X = patch.X or item.X
	item.Y = patch.Y or item.Y
	item.W = patch.W or item.W
	item.H = patch.H or item.H
	item.Rotation = patch.Rotation or item.Rotation
end

--[[
	문양의 도형 목록. **덮어쓴 값이 이미 반영되어 있다.**

	`CardArt.For`가 쓰고, 편집기가 번호를 매겨 보여주는 것도 이 목록이다.
	둘이 같은 함수를 봐야 편집기에서 3번이라고 적힌 것이 게임에서도 3번이다.
]]
function CardArt.Glyph(tag: string, color: Color3, dim: Color3, rest: (number) -> number): { Shape }
	local family = FAMILIES[tag] or FALLBACK
	local shapes = family.Glyph(color, dim, rest)

	for index, patch in SHAPE_OVERRIDES[tag] or {} do
		local item = shapes[index]
		if item then
			--[[
				그림자 판정은 **본체를 고치기 전에** 한다. 먼저 고치면 크기와 각도가
				이미 달라져 있어 짝을 못 알아본다(실제로 한 번 밟았다).
			]]
			local ahead = shapes[index - 1]
			local hasShadow = ahead ~= nil and isShadowOf(ahead :: Shape, item)

			applyOverride(item, patch)
			if hasShadow and ahead then
				applyOverride(ahead, patch)
				ahead.Y += SHADOW_DROP
			end
		end
	end

	return shapes
end

--=== 등급 ===--

type GradeStyle = {
	--[[
		바탕색. **등급마다 고정이다** (요청).
		  일반  회색
		  희귀  파란색
		  필수  보라색
	]]
	Backdrop: Palette,
	-- 메달리온 테두리 링 개수. 등급이 높을수록 겹이 많다.
	Rims: number,
	-- 메달리온 뒤로 뻗는 살 개수. 필수만 쓴다.
	Spokes: number,
	-- 네 귀퉁이 보석. 필수만 쓴다.
	Gems: boolean,
}

--[[
	등급별 고정 색 (요청).

	예전에는 태그 계열 색에서 바탕까지 뽑아 카드마다 바탕색이 달랐다. 그래서
	등급이 색으로 읽히지 않았다 — 파란 바탕이 희귀인지 물 계열 일반인지 알 수 없었다.
	이제 **바탕은 등급만, 문양은 흰색으로 고정**하고, 태그 색은 작은 부호에만 남긴다.
]]
local GRADES: { [string]: GradeStyle } = {
	Common = { Backdrop = rgb(78, 80, 88), Rims = 1, Spokes = 0, Gems = false },
	Rare = { Backdrop = rgb(38, 74, 150), Rims = 2, Spokes = 0, Gems = false },
	Essential = { Backdrop = rgb(96, 52, 154), Rims = 2, Spokes = 8, Gems = true },
}

-- 문양은 등급과 무관하게 흰색이다(요청: "흰 아이콘").
local GLYPH_COLOR = rgb(255, 255, 255)

-- 메달리온 지름. 문양이 이 안에 들어앉는다.
local MEDALLION = 0.78

-- 문양을 메달리온 안으로 줄여 넣는 비율. 편집기가 같은 값을 써야 미리보기가 맞는다.
CardArt.INSET = MEDALLION * 0.94

--[[
	카드 하나의 그림을 만든다.

	card는 `AbilityCard`면 되지만, 필드 세 개(Id · Grade · Tags)만 본다. 보유 카드
	목록처럼 설명 없이 요약만 들고 있는 표에도 그대로 쓸 수 있게 하려는 것이다.
]]
function CardArt.For(card: { Id: string, Grade: string, Tags: { string }?, Art: string? }): Art
	local seed = hash(card.Id or "")
	local function rest(stream: number): number
		return unit(seed, stream)
	end

	local tags = card.Tags or {}
	local grade = GRADES[card.Grade] or GRADES.Common

	--[[
		바탕은 등급색, 문양은 흰색으로 고정한다(요청).

		태그 색(`family.Base`)은 이제 **두 번째 태그 부호에만** 쓴다. 바탕까지 태그
		색으로 칠하면 등급이 색으로 읽히지 않는다.
	]]
	local backdrop = toColor(grade.Backdrop, 1)
	local accent = toColor(GLYPH_COLOR, 1)
	-- 문양의 어두운 부분. 흰색을 그대로 낮춰 회색으로 쓴다.
	local dim = toColor(GLYPH_COLOR, 0.7)

	local shapes: { Shape } = {}

	--[[
		**메달리온 액자.**

		예전에는 대각선 띠 네 줄과 네 귀퉁이 `+` 표식이 카드 전면에 깔려 있었다.
		그게 문양과 같은 흰색이라 무엇이 주인공인지 흐려지고 "미완성" 느낌을 줬다.

		이제 가운데 원판 하나로 시선을 모은다. 잠재력 노드 계열 아이콘이 공통으로
		쓰는 문법이다 — 어두운 원판 + 밝은 테두리 + 그 안에 굵은 실루엣.
	]]

	-- 필수 카드의 살. 메달리온 **뒤에서** 뻗는다.
	for index = 1, grade.Spokes do
		table.insert(shapes, shape(0.5, 0.5, 0.05, 1.16, (index / grade.Spokes) * 180, accent, 0.5, 0, 1, 0.78))
	end

	-- 원판. 바탕 등급색을 어둡게 눌러 문양이 뜨게 한다.
	table.insert(shapes, shape(0.5, 0.5, MEDALLION + 0.06, MEDALLION + 0.06, 0, accent, 0.5, 0, 2, 0.72))
	table.insert(shapes, shape(0.5, 0.5, MEDALLION, MEDALLION, 0, toColor(grade.Backdrop, 0.55), 0.5, 0, 3))

	-- 테두리 링. 등급이 높을수록 한 겹 더 두른다.
	for index = 1, grade.Rims do
		local size = MEDALLION + 0.02 - (index - 1) * 0.12
		table.insert(shapes, shape(0.5, 0.5, size, size, 0, accent, 0.5, 0.022, 4, if index == 1 then 0 else 0.55))
	end

	--[[
		문양. 메달리온 안에 앉는다.

		`Glyph`는 0~1 좌표로 그리므로 그대로 쓰면 원판을 넘친다. 메달리온 비율만큼
		가운데로 줄여 넣는다 — 그래야 어떤 문양이든 액자 안에 담긴다.
	]]
	--[[
		**손으로 그린 그림이 있으면 그것을 쓴다** (요청).

		`Art`가 가리키는 그림이 태그 문양을 대신한다. 가리키지 않은 카드는 예전처럼
		태그로 그려지므로, 306장을 다 그려 넣지 않아도 게임이 돌아간다.
		액자와 바탕은 어느 쪽이든 등급이 정한다 — 그림은 안쪽만 채운다.
	]]
	local inset = CardArt.INSET
	local drawn: { Shape }
	local artwork = if card.Art then CardArtworks.Get(card.Art) else nil
	if artwork then
		drawn = {}
		for _, item in artwork.Shapes do
			table.insert(
				drawn,
				shape(
					item.X,
					item.Y,
					item.W,
					item.H,
					item.Rotation,
					fromHex(item.Color),
					item.Corner,
					item.Stroke,
					item.ZIndex,
					item.Transparency
				)
			)
		end
	else
		drawn = CardArt.Glyph(tags[1] or "", accent, dim, rest)
	end

	for _, item in drawn do
		item.X = 0.5 + (item.X - 0.5) * inset
		item.Y = 0.5 + (item.Y - 0.5) * inset
		item.W *= inset
		item.H *= inset
		if item.Stroke > 0 then
			item.Stroke *= inset
		end
		table.insert(shapes, item)
	end

	--[[
		두 번째 태그가 있으면 작은 보석으로 오른쪽 아래에 얹는다.
		"[Blood, Rage]"처럼 두 축에 걸친 카드를 그림만으로 알아볼 수 있게 한다.
		메달리온 바깥 테두리에 걸쳐 두어 문양을 가리지 않는다.
	]]
	local second = FAMILIES[tags[2] or ""]
	if second then
		local tone = toColor(second.Base, 1)
		table.insert(shapes, shape(0.855, 0.845, 0.2, 0.2, 45, accent, 0.06, 0, 20))
		table.insert(shapes, shape(0.855, 0.845, 0.15, 0.15, 45, tone, 0.05, 0, 21))
	end

	-- 필수 카드의 귀퉁이 보석. 액자를 고정하는 못처럼 보이게 둔다.
	if grade.Gems then
		for _, spot in { { 0.115, 0.115 }, { 0.885, 0.115 }, { 0.115, 0.885 } } do
			table.insert(shapes, shape(spot[1], spot[2], 0.1, 0.1, 45, accent, 0.04, 0, 20, 0.25))
			table.insert(shapes, shape(spot[1], spot[2], 0.05, 0.05, 45, accent, 0.04, 0, 21))
		end
	end

	return {
		Background = backdrop,
		Accent = accent,
		Shapes = shapes,
	}
end

-- 태그가 문양에 붙어 있는지. 새 태그를 만들고 매핑을 잊는 것을 테스트로 잡는다.
function CardArt.HasFamily(tag: string): boolean
	return FAMILIES[tag] ~= nil
end

--[[
	문양이 붙어 있는 태그 전부. 이름순이다.

	테스트가 **태그마다 그림이 다른지**를 보려면 목록이 필요하다. 예전에는 여러
	태그가 한 문양을 나눠 써서 서로 다른 직업의 카드가 같아 보였고, 그걸 잡을
	수단이 없었다.
]]
function CardArt.Tags(): { string }
	local names: { string } = {}
	for tag in FAMILIES do
		table.insert(names, tag)
	end
	table.sort(names)
	return names
end

return CardArt
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">CardArtworks</string>
          <string name="Source"><![CDATA[--!strict
--[[
	CardArtworks — 손으로 그린 **카드 그림** 보관소.

	`CardArt`는 태그를 보고 문양을 **절차적으로** 만든다. 32개 태그에 32개 그림이라
	카드가 늘어도 그림이 저절로 생기지만, "이 카드만 이렇게 그리고 싶다"는 안 된다.

	이 모듈은 그 구멍을 메운다. 편집기(`config_editor.html`)의 그림 탭에서 도형을
	끌어다 놓아 만든 것을 이름 붙여 여기 담고, 카드가 `Art = "이름"`으로 가리킨다.
	가리키지 않은 카드는 예전처럼 태그 문양으로 그려진다.

	--------------------------------------------------------------------------
	좌표

	`CardArt.Shape`와 같다 — 한 변 1인 정사각형, 중심 기준. 메달리온 액자는
	`CardArt`가 등급을 보고 따로 깔아 주므로 여기엔 **문양만** 담는다.
]]

export type Shape = {
	X: number,
	Y: number,
	W: number,
	H: number,
	Rotation: number,
	-- "#rrggbb". 등급색과 무관하게 그대로 칠한다.
	Color: string,
	Corner: number,
	Stroke: number,
	ZIndex: number,
	Transparency: number,
}

export type Artwork = {
	Id: string,
	Name: string,
	Shapes: { Shape },
}

local CardArtworks = {}

--[[
	기본 템플릿.

	새 그림을 시작할 때 빈 화면부터 두면 무엇을 할 수 있는지 알기 어렵다.
	등급마다 어울리는 출발점을 하나씩 둔다 (요청: "희귀 카드의 경우 파란 배경에 원").

	여기 담긴 것은 **문양뿐**이다. 바탕과 액자는 `CardArt`가 등급을 보고 깐다.
]]
local TEMPLATES: { [string]: { Shape } } = {
	Common = {
		{
			X = 0.5,
			Y = 0.5,
			W = 0.42,
			H = 0.42,
			Rotation = 0,
			Color = "#ffffff",
			Corner = 0.5,
			Stroke = 0,
			ZIndex = 6,
			Transparency = 0,
		},
	},
	--[[
		희귀: **기본 원 안에 또 다른 불투명한 원**(요청). 바깥 원은 채운 반투명이
		아니라 **선으로 그은 원**(요청: "꽉 찬 원이 아니라 선으로 그은 원"),
		안쪽 원은 완전히 불투명해 "원 안의 원"이 뚜렷이 갈린다.
	]]
	Rare = {
		{
			X = 0.5,
			Y = 0.5,
			W = 0.64,
			H = 0.64,
			Rotation = 0,
			Color = "#ffffff",
			Corner = 0.5,
			Stroke = 0.03,
			ZIndex = 6,
			Transparency = 0,
		},
		{
			X = 0.5,
			Y = 0.5,
			W = 0.3,
			H = 0.3,
			Rotation = 0,
			Color = "#ffffff",
			Corner = 0.5,
			Stroke = 0,
			ZIndex = 7,
			Transparency = 0,
		},
	},
	--[[
		필수: 문양 두 겹만 담는다.

		살(반짝이는 효과)·원판·테두리 링·귀퉁이 보석은 `CardArt.luau`가 등급만
		보고 **모든 카드에 자동으로** 깐다 — 손으로 그리든 안 그리든 상관없이
		이미 있다. 여기 담으면 그 위에 또 한 겹 겹쳐 그려져 두 배로 진해진다.
		그래서 그림 그리기 탭 캔버스에 그 자동 층을 **참고용으로 비쳐 보이게**
		하고(`autoDecorShapes`), 여기 템플릿에는 문양만 남긴다.
	]]
	Essential = {
		{
			X = 0.5,
			Y = 0.5,
			W = 0.62,
			H = 0.62,
			Rotation = 45,
			Color = "#ffffff",
			Corner = 0.06,
			Stroke = 0.03,
			ZIndex = 6,
			Transparency = 0,
		},
		{
			X = 0.5,
			Y = 0.5,
			W = 0.3,
			H = 0.3,
			Rotation = 45,
			Color = "#ffffff",
			Corner = 0.04,
			Stroke = 0,
			ZIndex = 7,
			Transparency = 0,
		},
	},
}

function CardArtworks.Template(grade: string): { Shape }
	local source = TEMPLATES[grade] or TEMPLATES.Common
	local copy: { Shape } = {}
	for _, item in source do
		table.insert(copy, table.clone(item))
	end
	return copy
end

--[[
	손으로 만든 그림들.

	편집기에서 저장하면 `apply_config_edits.luau`가 이 표에 적는다.
	비어 있는 것이 정상이다 — 아무도 아직 그리지 않았다는 뜻이다.
]]
local ARTWORKS: { [string]: Artwork } = {}

function CardArtworks.Get(id: string): Artwork?
	return ARTWORKS[id]
end

function CardArtworks.All(): { Artwork }
	local list: { Artwork } = {}
	for _, artwork in ARTWORKS do
		table.insert(list, artwork)
	end
	table.sort(list, function(a, b)
		return a.Id < b.Id
	end)
	return list
end

return CardArtworks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">CardDraft</string>
          <string name="Source"><![CDATA[--!strict
--[[
	CardDraft — 층별 보상 흐름(뽑기 → 리롤 → 업그레이드)의 순수 로직.

	사양 출처: 추가&수정.md `##### 층별 보상`, `###### 능력 카드`

	이 모듈은 **데이터와 저장 사이를 잇는 층**이다.
	  AbilityCardDefinitions  뽑기·상한 규칙과 카드 풀
	  PlayerProfile.TowerRun  등반 중 상태(코스트·리롤 횟수·보유 카드)
	  CardDraft (여기)        그 둘을 실제 흐름으로 묶는다

	전투 로직에 의존하지 않아 Studio 없이 전부 검증된다.
	카드의 *효과*를 적용하는 것은 전투 시스템 재구성 때 별도로 붙인다.
	여기서는 **무엇을 얼마나 얻고 올릴 수 있는지**만 다룬다.

	흐름
	  층 클리어 → BeginFloor()  코스트 30 지급, 리롤 횟수 초기화, 카드 제시
	  마음에 안 들면 → Reroll()  코스트 차감(10 → 15 → 23 …), 다시 제시
	  하나 고르면 → Acquire()   카드 획득. **같은 카드를 또 얻으면 강화된다**
	                            (상한: 필수 2 / 나머지 6, 도달 시 이후 등장 안 함)
]]

local AbilityCardDefinitions = require(script.Parent.AbilityCardDefinitions)
local PlayerProfile = require(script.Parent.PlayerProfile)
local ProgressionDefinitions = require(script.Parent.ProgressionDefinitions)
local StatDefinitions = require(script.Parent.StatDefinitions)
local TowerRewardDefinitions = require(script.Parent.TowerRewardDefinitions)

export type DraftResult = {
	Ok: boolean,
	Reason: string?,
	Cards: { AbilityCardDefinitions.AbilityCard },
	Cost: number,
	NextRerollCost: number,
}

local CardDraft = {}

--[[
	이미 최대 레벨에 도달한 카드 Id 목록.
	뽑기에서 제외해 쓸모없는 선택지가 나오지 않게 한다.
]]
function CardDraft.MaxedCardIds(run: PlayerProfile.TowerRun): { [string]: boolean }
	local maxed: { [string]: boolean } = {}
	for _, progress in run.Cards do
		local card = AbilityCardDefinitions.Get(progress.CardId)
		local cap = if card
			then AbilityCardDefinitions.MaxLevelFor(card)
			else AbilityCardDefinitions.MaxLevel(progress.Grade :: any)
		if progress.Level >= cap then
			maxed[progress.CardId] = true
		end
	end
	return maxed
end

-- 이 등반에서 해당 카드가 몇 레벨인지. 없으면 0.
function CardDraft.CardLevel(run: PlayerProfile.TowerRun, cardId: string): number
	for _, progress in run.Cards do
		if progress.CardId == cardId then
			return progress.Level
		end
	end
	return 0
end

--[[
	층을 클리어하고 다음 층 보상 화면에 들어간다.

	  - 코스트 30 지급 (사양)
	  - 리롤 가격 초기화 (사양: "층 이동 시 가격은 초기화된다")
	  - 층수에 맞는 카드 제시 (10층 단위면 필수 3종이 확정 추가)
	  - 레벨 상승분을 PendingLevel에 쌓는다
	    (사양: "스탯은 탑을 모두 오른 시점에 변한다")
]]
function CardDraft.BeginFloor(run: PlayerProfile.TowerRun, classId: string, floor: number, seed: number): DraftResult
	run.Floor = floor
	run.Cost += TowerRewardDefinitions.COST_PER_FLOOR
	run.RerollCount = TowerRewardDefinitions.ResetRerollCount()
	run.PendingLevel += ProgressionDefinitions.LevelGainForFloor(floor)

	--[[
		층에 막 들어왔으므로 아직 아무것도 고르지 않았다(0). 필수 층이면 이 화면이
		필수 3종이고, 한 장을 고르면 다음 화면에서 희귀·일반이 나온다.
	]]
	local cards = AbilityCardDefinitions.DrawForFloor(classId, floor, seed, CardDraft.MaxedCardIds(run), 0)

	return {
		Ok = true,
		Reason = nil,
		Cards = cards,
		Cost = run.Cost,
		NextRerollCost = TowerRewardDefinitions.RerollCost(run.RerollCount),
	}
end

--[[
	보상을 다시 뽑는다. 횟수 제한은 없고 가격만 오른다(사양).
	코스트가 모자라면 아무것도 바꾸지 않고 실패를 돌려준다.
]]
function CardDraft.Reroll(run: PlayerProfile.TowerRun, classId: string, seed: number): DraftResult
	local price = TowerRewardDefinitions.RerollCost(run.RerollCount)

	if run.Cost < price then
		return {
			Ok = false,
			Reason = string.format("코스트가 부족합니다. (필요 %d, 보유 %d)", price, run.Cost),
			Cards = {},
			Cost = run.Cost,
			NextRerollCost = price,
		}
	end

	run.Cost -= price
	run.RerollCount += 1

	--[[
		리롤할 때마다 다른 조합이 나오도록 seed에 횟수를 섞는다.

		`AcquiredThisFloor`를 함께 넘겨 **지금 보고 있는 화면을 그대로 다시 뽑는다** —
		필수 화면에서 리롤했는데 희귀·일반이 나오면 리롤로 단계를 건너뛰게 된다.
	]]
	local cards = AbilityCardDefinitions.DrawForFloor(
		classId,
		run.Floor,
		seed + run.RerollCount * 31337,
		CardDraft.MaxedCardIds(run),
		run.AcquiredThisFloor
	)

	return {
		Ok = true,
		Reason = nil,
		Cards = cards,
		Cost = run.Cost,
		NextRerollCost = TowerRewardDefinitions.RerollCost(run.RerollCount),
	}
end

--[[
	고른 카드를 **얻는다**.

	사양: "층을 클리어 할 때마다 능력 카드중 한개를 얻을 수 있다.
	       5층 단위로 획득 가능한 능력 카드가 1개씩 증가한다.
	       똑같은 카드를 한번 더 얻으면 강화 되며,
	       해당 카드가 최대 레벨에 도달 시 다음 층부터는 등장하지 않는다."

	즉 별도의 '업그레이드' 행동이 없다. **획득이 곧 강화**다.
	  처음 얻으면      → 레벨 1
	  또 얻으면        → 레벨 +1 (강화)
	  최대 레벨에 닿으면 → 이후 뽑기에서 제외 (MaxedCardIds가 처리)

	이번 층의 획득 가능 장수는 AcquireSlotsForFloor(floor)이며,
	usedThisFloor로 이미 얻은 장수를 넘겨받아 판정한다.
]]
function CardDraft.Acquire(
	run: PlayerProfile.TowerRun,
	card: AbilityCardDefinitions.AbilityCard,
	usedThisFloor: number
): (boolean, string?)
	local slots = AbilityCardDefinitions.AcquireSlotsForFloor(run.Floor)
	if usedThisFloor >= slots then
		return false,
			string.format(
				"이번 층에서 얻을 수 있는 카드를 모두 얻었습니다. (%d/%d)",
				usedThisFloor,
				slots
			)
	end

	local current = CardDraft.CardLevel(run, card.Id)
	local cap = AbilityCardDefinitions.MaxLevelFor(card)
	if current >= cap then
		return false, string.format("이미 최대 레벨입니다. (%d/%d)", current, cap)
	end

	-- 이미 가지고 있으면 강화(레벨 +1), 없으면 레벨 1로 새로 넣는다.
	for _, progress in run.Cards do
		if progress.CardId == card.Id then
			progress.Level += 1
			return true, nil
		end
	end

	table.insert(run.Cards, {
		CardId = card.Id,
		Grade = card.Grade,
		Level = 1,
	})
	return true, nil
end

--[[
	등반을 마치거나 도중에 나간다.

	사양: "도중에 탑에서 나가거나, 탑을 클리어할 경우 아이템은 모두 돌려받지만,
	       스탯은 탑을 모두 오른 시점에 변한다."
	→ 보관했던 장비는 항상 돌려주고,
	  레벨·스탯 포인트는 **완주했을 때만** 슬롯에 반영한다.
]]
function CardDraft.FinishRun(profile: PlayerProfile.Profile, completed: boolean): (number, number)
	local run = profile.TowerRun
	if not run then
		return 0, 0
	end

	local slot = PlayerProfile.ActiveSlot(profile)

	-- 장비는 나가는 방식과 무관하게 돌려준다.
	local returned = 0
	for _, item in run.StoredItems do
		table.insert(slot.Items, item)
		returned += 1
	end

	--[[
		레벨은 완주했을 때만 확정된다.

		스탯 포인트는 등반 **도중에** 이미 지급됐을 수 있다(층마다 찍을 수 있어야
		선택이 되기 때문이다). 그만큼은 빼고 남은 몫만 준다 — 안 그러면 완주 시
		같은 포인트를 두 번 받는다.
	]]
	local gainedLevels = 0
	if completed then
		gainedLevels = run.PendingLevel
		slot.Level += gainedLevels
		local owed = gainedLevels * StatDefinitions.POINTS_PER_LEVEL - run.GrantedPoints
		slot.UnspentPoints += math.max(owed, 0)
	end

	-- 최고 도달 층은 계정에 남는다.
	if run.Floor > profile.Account.HighestFloor then
		profile.Account.HighestFloor = run.Floor
	end

	profile.TowerRun = nil
	return returned, gainedLevels
end

return CardDraft
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">CardEffects</string>
          <string name="Source"><![CDATA[--!strict
--[[
	CardEffects — 능력 카드가 **전투에서 실제로 하는 일**.

	`AbilityCardDefinitions`와 직업별 카드 파일은 지금까지 이름·설명·등급만 들고
	있었다. 보상 화면에서 고르면 `TowerRun.Cards`에 쌓이기만 하고 전투는 그 사실을
	모르는 상태였다. 이 모듈이 그 구멍을 메운다.

	--------------------------------------------------------------------------
	왜 카드마다 함수를 쓰지 않는가

	306장에 함수를 하나씩 달면 파일이 수천 줄이 되고, 그중 대부분이 "전투 시작 시
	자원 N개" 같은 같은 모양이다. 그래서 **카드 하나를 한 줄짜리 표**로 적고
	엔진이 해석한다. 새 카드를 붙일 때 표에 한 줄만 더하면 된다.

	  Musician_C_Prelude = { Hook = "BattleStart", Give = "Stack", Id = R.QUARTER, Base = 2, PerLevel = 1 }

	--------------------------------------------------------------------------
	발동 지점(Hook) 넷

	  BattleStart  전투가 만들어질 때 한 번
	  TurnStart    턴이 시작할 때마다
	  TurnEndIdle  스킬을 쓰지 않고 턴을 마쳤을 때 ("행동하지 않고 턴을 마치면")
	  OnKill       적을 처치했을 때
	  OnDamaged    자신이 피해를 받았을 때

	조건이 붙은 상시 효과("체력 30% 아래면 피해 +12%")는 따로 훅을 두지 않고
	**TurnStart에서 1턴짜리 보정값으로 다시 건다.** 조건이 턴 중간에 바뀌어도
	다음 턴에 맞춰지므로 충분하고, 붙였다 떼는 추적 코드가 통째로 사라진다.

	--------------------------------------------------------------------------
	적용 범위에 대한 정직한 이야기

	여기 실린 것은 **자기 자신에게 자원·보호막·보정값을 주는 카드**다.
	아래 두 부류는 아직 붙지 못했고, 붙이려면 각각 선행 작업이 필요하다.

	  1. 스킬 내부 수치를 바꾸는 카드
	     ("2스킬의 중첩당 피해 6%→9%", "재사용 대기 −1턴", "지속 +1턴")
	     → `BattleSkills`·`BattleSkillEffects`가 수치를 상수로 들고 있어서,
	       카드가 끼어들 자리가 없다. 스킬 파라미터를 표로 빼는 작업이 먼저다.

	  2. 적에게 거는 카드
	     ("전투 시작 시 가장 가까운 적에게 [광신] 3중첩")
	     → 이 엔진은 대상 선택을 하지 않는다. 훅에 대상 정보를 넘기는 것이 먼저다.

	`CardEffects.Coverage()`가 지금 몇 장이 붙어 있는지 세어 준다.
]]

local BattleStatus = require(script.Parent.BattleStatus)
local ClassResources = require(script.Parent.ClassResources)

local R = ClassResources

export type Hook = "BattleStart" | "TurnStart" | "TurnEndIdle" | "OnKill" | "OnDamaged"

--[[
	카드 한 장이 하는 일.

	수치는 `Base + PerLevel × (레벨 − 1)`로 자란다. 카드는 레벨 1로 들어오므로
	레벨 1이면 Base 그대로다.

	설명이 "(레벨 4부터 2)"처럼 **계단**인 카드는 StepFrom·StepValue를 쓴다.
	이때 PerLevel은 보지 않는다.
]]
export type Def = {
	Hook: Hook,

	--[[
		주는 것. 아래 중 하나이거나, Modifier가 대신 온다.

		  Stack        직업 자원 (Id 필요)
		  Shield       보호막 (절대값)
		  ShieldRatio  보호막 (최대 체력 비율)
		  Faith        신앙심
		  Stamina      스테미나
		  Heal         회복 (최대 체력 비율)
		  LoseHealth   체력 소모 (최대 체력 비율)
		  Taunt        도발 스택
	]]
	Give: string?,
	Id: string?,

	-- 보정값을 거는 카드. Give 대신 온다.
	Modifier: BattleStatus.ModifierKind?,
	-- 보정값이 유지되는 턴. 생략하면 조건부 효과라 보고 1턴만 건다.
	Turns: number?,

	Base: number,
	PerLevel: number?,
	StepFrom: number?,
	StepValue: number?,

	--[[
		수치를 무엇에 비례시킬지.

		  nil         그대로
		  "Stack"     PerIds 자원의 합에 비례
		  "LostTenth" 잃은 체력 10%마다
		  "FaithTen"  신앙심 10마다
	]]
	Per: string?,
	PerIds: { string }?,
	-- 비례 계산 결과의 절대값 상한.
	Cap: number?,

	--[[
		발동 조건. 없으면 항상.

		  HealthBelow   Ratio 아래
		  StackAtLeast  WhenIds 자원의 합이 Amount 이상
		  NotesFull     음표가 박자표 상한까지 찼을 때 (음악가 전용)
	]]
	When: string?,
	WhenRatio: number?,
	WhenIds: { string }?,
	WhenAmount: number?,
}

--[[
	훅이 엔진에게 넘기는 도구.

	`GridBattle`을 require하지 않는다 — 순환 참조가 나고, Lune 테스트에서
	이 모듈만 따로 돌릴 수도 없어진다.
]]
export type Context = {
	Status: BattleStatus.State,
	Health: number,
	MaxHealth: number,
	Faith: number,
	Meter: number,
	Heal: (amount: number) -> number,
	LoseHealth: (amount: number) -> number,
	AddFaith: (amount: number) -> (),
	AddStamina: (amount: number) -> (),
	AddTaunt: (amount: number) -> (),
}

export type Owned = { CardId: string, Level: number }

local CardEffects = {}

--=== 표 ===--

local DEFS: { [string]: Def } = {
	--== 음악가 — 음표를 들고 시작하고, 박자표로 굴린다 ==--
	Musician_C_Prelude = { Hook = "BattleStart", Give = "Stack", Id = R.QUARTER, Base = 2, PerLevel = 1 },
	Musician_C_Score = { Hook = "BattleStart", Give = "Stack", Id = R.QUARTER, Base = 3, PerLevel = 1 },
	Musician_R_Overture = { Hook = "BattleStart", Give = "Stack", Id = R.METER, Base = 1 },
	Musician_C_Applause = { Hook = "OnKill", Give = "Stack", Id = R.QUARTER, Base = 1, StepFrom = 4, StepValue = 2 },
	Musician_R_Metronome = { Hook = "TurnStart", Give = "Stack", Id = R.QUARTER, Base = 0.34, PerLevel = 0.16 },
	Musician_R_Cadenza = {
		Hook = "TurnStart",
		Modifier = "DamageDealt",
		Base = 0.25,
		PerLevel = 0.05,
		When = "NotesFull",
	},
	Musician_C_Encore = {
		Hook = "TurnStart",
		Modifier = "DamageDealt",
		Base = 0.12,
		PerLevel = 0.03,
		When = "StackAtLeast",
		WhenIds = { R.METER },
		WhenAmount = 3,
	},
	Musician_C_Rest = { Hook = "TurnEndIdle", Give = "Stamina", Base = 6, PerLevel = 2 },
	Musician_C_Tuning = {
		Hook = "TurnStart",
		Modifier = "DamageTaken",
		Base = -0.04,
		PerLevel = -0.01,
		Per = "Stack",
		PerIds = { R.METER },
	},

	--== 결투사 — [집중]을 벌고 스택 자체를 값으로 쓴다 ==--
	Duelist_C_WarmUp = { Hook = "BattleStart", Give = "Stack", Id = R.FOCUS, Base = 2, PerLevel = 1 },
	Duelist_R_FocusBreath = { Hook = "TurnStart", Give = "Stack", Id = R.FOCUS, Base = 1, StepFrom = 4, StepValue = 2 },
	Duelist_C_Conclusion = { Hook = "OnKill", Give = "Stack", Id = R.FOCUS, Base = 2, StepFrom = 4, StepValue = 3 },
	Duelist_C_Composure = {
		Hook = "TurnStart",
		Modifier = "DamageTaken",
		Base = -0.002,
		PerLevel = -0.0005,
		Per = "Stack",
		PerIds = { R.FOCUS },
	},
	Duelist_C_BladeTip = {
		Hook = "TurnStart",
		Modifier = "CritChance",
		Base = 0.005,
		PerLevel = 0.0015,
		Per = "Stack",
		PerIds = { R.FOCUS },
	},

	--== 광전사 — 체력을 태워 [분노]로 바꾼다 ==--
	Berserker_C_Ember = { Hook = "BattleStart", Give = "Stack", Id = R.RAGE, Base = 2, PerLevel = 1 },
	Berserker_C_BloodPact = { Hook = "BattleStart", Give = "Stack", Id = R.RAGE, Base = 4, PerLevel = 1 },
	Berserker_C_BloodPactCost = { Hook = "BattleStart", Give = "LoseHealth", Base = 0.08 },
	Berserker_R_Wrath = { Hook = "OnDamaged", Give = "Stack", Id = R.RAGE, Base = 1 },
	Berserker_C_RageFuel = { Hook = "OnDamaged", Give = "Stack", Id = R.RAGE, Base = 1, StepFrom = 4, StepValue = 2 },
	Berserker_C_Devour = { Hook = "OnKill", Give = "Heal", Base = 0.06, PerLevel = 0.02 },
	Berserker_C_Boiling = {
		Hook = "TurnStart",
		Modifier = "CritChance",
		Base = 0.01,
		PerLevel = 0.003,
		Per = "Stack",
		PerIds = { R.RAGE },
	},
	Berserker_E_Brink = {
		Hook = "TurnStart",
		Modifier = "DamageDealt",
		Base = 0.08,
		PerLevel = 0.04,
		Per = "LostTenth",
	},
	Berserker_E_BrinkCost = { Hook = "TurnStart", Modifier = "HealTaken", Base = -0.5 },
	Berserker_R_Scars = {
		Hook = "TurnStart",
		Modifier = "DamageTaken",
		Base = -0.04,
		PerLevel = -0.01,
		Per = "LostTenth",
		Cap = 0.4,
	},
	Berserker_C_DeathWish = {
		Hook = "TurnStart",
		Modifier = "CritChance",
		Base = 0.25,
		PerLevel = 0.04,
		When = "HealthBelow",
		WhenRatio = 0.25,
