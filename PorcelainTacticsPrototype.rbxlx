		Grade = "Rare",
		ClassId = CLASS_ID,
		Tags = { "Judgment", "Faith" },
	},

	--=== 일반 (20) ===--
	{
		Id = "WallPilgrim_C_Setting",
		Name = "고착",
		Description = "[광신] 지속시간이 {1}턴 연장된다.",
		Grade = "Common",
		ClassId = CLASS_ID,
		Tags = { "Judgment" },
	},
	{
		Id = "WallPilgrim_C_NailHole",
		Name = "못 자국 넓히기",
		Description = "못 자국으로 옮기는 중첩이 {2} 증가한다.",
		Grade = "Common",
