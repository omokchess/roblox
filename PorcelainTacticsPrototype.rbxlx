		Description = "적 처치 시 [약재]를 {2} 얻는다.",
		Levels = { { 2, 3, 4, 5, 6, 7 } },
		Grade = "Common",
		ClassId = CLASS_ID,
		Tags = { "Brew" },
	},
	{
		Id = "Alchemist_C_Cooldown",
		Name = "시간 날 때 해둬야지",
		Description = "매 턴, [약재]를 {1}씩 소모해 [원액]을 {1} 얻는다.",
		Levels = { { 1, 1, 1, 1, 1, 1 }, { 1, 1, 1, 2, 2, 2 } },
		Grade = "Common",
		ClassId = CLASS_ID,
		Tags = { "Catalyst" },
	},
	{
		Id = "Alchemist_C_Lowhp",
		Name = "절박함",
		Description = "체력이 {30}% 이하일 때 가하는 피해량이 {8}% 증가한다.",
		Levels = { { 30, 30, 30, 30, 30, 30 }, { 8, 11, 14, 17, 20, 23 } },
		LevelKeywords = { "", "DamageDealt" },
		Grade = "Common",
		ClassId = CLASS_ID,
