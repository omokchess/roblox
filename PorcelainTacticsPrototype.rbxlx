	"WallBreaker",
	"Alchemist",
	"Berserker",
}

local CharacterDefinitions = {}

CharacterDefinitions.DEFAULT_ID = "Berserker"

function CharacterDefinitions.Get(id: string): CharacterDefinition
	return definitions[id] or definitions.Berserker
end

function CharacterDefinitions.All(): { CharacterDefinition }
	local result = {}
	for _, id in order do
		table.insert(result, definitions[id])
	end
	return result
end

function CharacterDefinitions.IsValid(id: string): boolean
	return definitions[id] ~= nil
end

return CharacterDefinitions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">ClassPassives</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ClassPassives — 직업마다 늘 켜져 있는 **패시브**와, 그 직업의 **전용 상태이상**.

	출처: `유저 아이디어(직업).md` 각 직업의 `## 패시브` · `## 전용 상태이상`

	--------------------------------------------------------------------------
	왜 이제야 데이터가 되나

	패시브는 오래도록 md 문서에만 있었다. 카드 설명이 "벌크업의 피해량 증가가…"
	처럼 패시브 이름을 부르는데, 그 패시브가 무엇인지는 코드 어디에도 없어서
	편집기로 고칠 수도, 게임에서 띄울 수도 없었다.

	--------------------------------------------------------------------------
	전용 상태이상은 **여기 두지 않는다**

	[광신]·[벽]·[질량] 같은 것은 이미 `Keywords`에 이름과 설명이 있고, 상한은
	`ClassResources`가 들고 있다. 여기서 또 적으면 세 곳이 서로 어긋난다.
	대신 `StatusKeywords`로 **가리키기만** 한다 — 편집은 키워드 탭에서 한다.
]]

export type Passive = {
	Id: string,
	Name: string,
	Description: string,
}

export type ClassKit = {
	ClassId: string,
	Passives: { Passive },
	-- 이 직업의 전용 상태이상. `Keywords`의 Id를 가리킨다.
	StatusKeywords: { string },
}

local ClassPassives = {}

local KITS: { [string]: ClassKit } = {
	Musician = {
		ClassId = "Musician",
		StatusKeywords = { "Note", "Meter", "Brillante" },
		Passives = {
			{
				Id = "Musician_Listener",
				Name = "청중",
				Description = "2번 스킬에 피격될 때마다 무작위 [음표]를 1개 얻는다.",
			},
			{
				Id = "Musician_Refrain",
				Name = "후렴",
				Description = "[음표]를 4개 얻을 때마다 최대 체력의 2.5%를 회복한다.",
			},
			{
				Id = "Musician_Downbeat",
				Name = "첫 박",
				Description = "전투 시작 시 [박자표]를 1 얻는다.",
			},
		},
	},

	Duelist = {
		ClassId = "Duelist",
		StatusKeywords = { "Focus", "AttackStance", "DefenseStance" },
		Passives = {
			{
				Id = "Duelist_Read",
				Name = "간파",
				Description = "4번 피격될 때마다 다음 공격을 확정으로 패링한다. 궁극기와 패링 불가 스킬은 빼고 센다.",
			},
			{
				Id = "Duelist_Slip",
				Name = "흘림",
				Description = "방어의 피해 감소가 절반이 된다. 대신 방어 범위 증가가 사라지고 그 3분의 1만큼 [패링 범위]를 얻는다.",
			},
			{
				Id = "Duelist_Count",
				Name = "머릿수 읽기",
				Description = "전투 시작 시 적이 3기 이하면 [가하는 피해량] 증가 5%, 4기 이상이면 [받는 피해량] 감소 5%. 적 수가 바뀌면 다시 판정한다.",
			},
		},
	},

	Berserker = {
		ClassId = "Berserker",
		StatusKeywords = { "Rage" },
		Passives = {
			{
				Id = "Berserker_Fury",
				Name = "핏발",
				Description = "체력을 소모할 때마다 [분노]를 1 얻는다.",
			},
			{
				Id = "Berserker_Thickening",
				Name = "굳는 피",
				Description = "잃은 체력 10%마다 [가하는 피해량] 증가 4%. 최대 20%다.",
			},
			{
				Id = "Berserker_Bloodlust",
				Name = "피에 취함",
				Description = "[분노]가 상한에 닿으면 그 턴 동안 [치명타 확률] 15%를 얻는다.",
			},
		},
	},

	Quasar = {
		ClassId = "Quasar",
		StatusKeywords = { "Mass", "Gravity" },
		Passives = {
			{
				Id = "Quasar_FarLight",
				Name = "아득한 빛",
				Description = "피해를 주거나 받으면 그 양의 10%만큼 [질량]을 얻는다.",
			},
			{
				Id = "Quasar_Supermassive",
				Name = "초대질량",
				Description = "20% 확률로 받는 피해가 절반이 된다.",
			},
			{
				Id = "Quasar_LoneLight",
				Name = "고독한 빛",
				Description = "아군이 모두 쓰러지면 [가하는 피해량] 증가 25%를 영구히 얻고 [질량] 획득량이 2배가 된다.",
			},
		},
	},

	Pulsar = {
		ClassId = "Pulsar",
		StatusKeywords = { "Field", "Depolar", "Resonate" },
		Passives = {
			{
				Id = "Pulsar_Beacon",
				Name = "별들의 등대",
				Description = "전투 시작 시 아군 전체가 2턴 동안 [가하는 피해량] 증가 10%를 얻는다. 같은 직업이 여럿이어도 겹치지 않는다.",
			},
			{
				Id = "Pulsar_Neutron",
				Name = "중성자",
				Description = "적이 대상을 고를 때 자신이 뽑힐 확률이 30% 오른다.",
			},
			{
				Id = "Pulsar_Spin",
				Name = "자전",
				Description = "[자기장]이 유지되는 동안 매 턴 스테미나를 4 더 회복한다.",
			},
		},
	},

	WallPilgrim = {
		ClassId = "WallPilgrim",
		StatusKeywords = { "Zeal", "Brand" },
		Passives = {
			{
				Id = "WallPilgrim_Road",
				Name = "순례길",
				Description = "같은 행에 월 필그림스 아군이 있으면 그 아군의 신앙심이 8 오른다.",
			},
			{
				Id = "WallPilgrim_Sigil",
				Name = "각인",
				Description = "[광신]이 상한에 닿은 적에게 2턴 동안 [낙인]을 남긴다.",
			},
			{
				Id = "WallPilgrim_NailMark",
				Name = "못 자국",
				Description = "[광신]이 걸린 적을 처치하면 남은 중첩이 가장 가까운 적에게 그대로 옮겨간다.",
			},
		},
	},

	WallMason = {
		ClassId = "WallMason",
		StatusKeywords = { "Wall" },
		Passives = {
			{
				Id = "WallMason_Road",
				Name = "순례길",
				Description = "같은 행에 월 필그림스 아군이 있으면 그 아군의 신앙심이 8 오른다.",
			},
			{
				Id = "WallMason_Stacking",
				Name = "쌓기",
				Description = "아군이 [벽]을 유지한 채 턴을 마치면 자신이 [벽]을 1중첩 얻는다. 턴당 1회다.",
			},
			{
				Id = "WallMason_Brace",
				Name = "버팀목",
				Description = "[벽]이 상한까지 찬 아군은 치명타를 맞지 않는다.",
			},
		},
	},

	WallBreaker = {
		ClassId = "WallBreaker",
		StatusKeywords = { "Ruin" },
		Passives = {
			{
				Id = "WallBreaker_MadOath",
				Name = "광적인 맹세",
				Description = "잃은 체력에 비례해 [가하는 피해량] 증가를 얻는다. 최대 20%다.",
			},
			{
				Id = "WallBreaker_Road",
				Name = "순례길",
				Description = "같은 행에 월 필그림스 아군이 있으면 그 아군의 신앙심이 8 오른다.",
			},
			{
				Id = "WallBreaker_Debris",
				Name = "잔해",
				Description = "[허물 벽]을 소모해 적을 처치하면 소모한 중첩의 절반을 돌려받는다.",
			},
		},
	},

	Alchemist = {
		ClassId = "Alchemist",
		StatusKeywords = {
			"Herb",
			"Extract",
			"EmptyBottle",
			"FullBottle",
			"HealBottle",
			"PoisonBottle",
			"FireBottle",
			"OilBottle",
			"Overheal",
		},
		Passives = {
			{
				Id = "Alchemist_Insurance",
				Name = "보험",
				Description = "체력이 5% 이하로 떨어지면 [회복 병]을 1 소모해 체력을 30% 회복한다.",
			},
			{
				Id = "Alchemist_BulkUp",
				Name = "벌크업",
				Description = "`섞기`를 쓸 때마다 [가하는 피해량] 증가 5%와 [받는 피해량] 증가 5%를 얻는다. 최대 5중첩이다.",
			},
			{
				Id = "Alchemist_SideEffect",
				Name = "부작용",
				Description = "`중독`을 쓸 때마다 [받는 피해량] 증가 10%를 얻는다. 최대 5중첩이다.",
			},
		},
	},
}

function ClassPassives.Get(classId: string): ClassKit?
	return KITS[classId]
end

function ClassPassives.All(): { ClassKit }
	local list: { ClassKit } = {}
	for _, kit in KITS do
		table.insert(list, kit)
	end
	table.sort(list, function(a, b)
		return a.ClassId < b.ClassId
	end)
	return list
end

-- 패시브 하나를 Id로. 편집기가 고친 값을 되먹일 때 쓴다.
function ClassPassives.Passive(passiveId: string): Passive?
	for _, kit in KITS do
		for _, passive in kit.Passives do
			if passive.Id == passiveId then
				return passive
			end
		end
	end
	return nil
end

return ClassPassives
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">ClassResources</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ClassResources — 직업 자원의 **이름과 상한**.

	사양 출처: `유저 아이디어(직업).md` 각 직업의 `전용 상태이상`

	`BattleStatus`는 "이름 붙은 스택"을 담기만 하고 상한을 모른다. 상한은 직업마다
	다르고(음표는 박자표에 따라 4/8/16, 집중은 10, 질량은 20…) 규격이
	"스택은 반드시 상한이 있을 것"을 요구하므로, 그 값을 여기 한곳에 모아 둔다.

	스킬 효과(`BattleSkillEffects`)가 이 표를 보고 쌓는다. 상한을 바꿀 때 고칠 곳이
	한 군데뿐이도록 하려는 것이다.
]]

local ClassResources = {}

--=== 자원 Id ===--

-- 음악가
ClassResources.QUARTER = "Quarter" -- 4분음표
ClassResources.EIGHTH = "Eighth" -- 8분음표
ClassResources.SIXTEENTH = "Sixteenth" -- 16분음표
ClassResources.METER = "Meter" -- 박자표
ClassResources.BRILLANTE = "Brillante" -- 브릴란테 값

-- 결투사
ClassResources.FOCUS = "Focus" -- 집중
ClassResources.STANCE_ATTACK = "StanceAttack" -- 공격 태세 (1이면 켜짐)
ClassResources.READY = "Ready" -- 준비 자세 (3스킬)

-- 퀘이사
ClassResources.MASS = "Mass" -- 질량
ClassResources.CHARGE = "Charge" -- 붕괴 차징 턴
ClassResources.GRAVITY = "Gravity" -- 중력 (적에게)

-- 펄서
ClassResources.FIELD = "Field" -- 자기장 (남은 턴)
ClassResources.DEPOLAR = "Depolar" -- 감극 (적에게)
ClassResources.RESONATE = "Resonate" -- 공명 (같은 턴 연속 사용)

-- 월 필그림스
ClassResources.ZEAL = "Zeal" -- 광신 (적에게)
ClassResources.WALL = "Wall" -- 벽
ClassResources.RUIN = "Ruin" -- 허물 벽

-- 연금술사
ClassResources.HERB = "Herb" -- 약재
ClassResources.EXTRACT = "Extract" -- 원액
ClassResources.EMPTY_BOTTLE = "EmptyBottle" -- 빈 병
ClassResources.POISON_BOTTLE = "PoisonBottle" -- 독 병
ClassResources.FIRE_BOTTLE = "FireBottle" -- 화염병
ClassResources.OIL_BOTTLE = "OilBottle" -- 기름 병
ClassResources.OVERHEAL = "Overheal" -- 과다 회복

-- 광전사
--[[
	[분노]. `유저 아이디어(직업).md`에는 광전사 항목이 없지만(전사 직업은 남겨 둔
	것이라 문서가 없다), 카드 여러 장이 "[분노] 최대 8스택"을 전제로 쓰여 있다.
	카드 효과를 붙이려면 자원이 실재해야 하므로 카드 쪽 수치를 따라 여기 둔다.
]]
ClassResources.RAGE = "Rage"

--=== 상한 ===--

--[[
	상한 표. 음표는 박자표에 따라 달라지므로 여기 없고 `NoteCap`이 계산한다.
]]
local CAPS: { [string]: number } = {
	[ClassResources.METER] = 3, -- 박자표는 1에서 3까지
	[ClassResources.FOCUS] = 10,
	[ClassResources.RAGE] = 8,
	[ClassResources.MASS] = 20,
	[ClassResources.DEPOLAR] = 3,
	[ClassResources.RESONATE] = 3,
	[ClassResources.ZEAL] = 10,
	[ClassResources.WALL] = 5,
	[ClassResources.RUIN] = 5,
	[ClassResources.HERB] = 6,
	[ClassResources.EXTRACT] = 4,
	[ClassResources.EMPTY_BOTTLE] = 8,
	[ClassResources.POISON_BOTTLE] = 4,
	[ClassResources.FIRE_BOTTLE] = 4,
	[ClassResources.OIL_BOTTLE] = 4,
	[ClassResources.OVERHEAL] = 3,
}

function ClassResources.Cap(id: string): number?
	return CAPS[id]
end

--[[
	음표 최대 보유 수. 박자표 값에 비례한다.
	`유저 아이디어(직업).md`: "1일 때는 4개, 2일 때는 8개, 3일 때는 16개"
]]
function ClassResources.NoteCap(meter: number): number
	if meter >= 3 then
		return 16
	elseif meter >= 2 then
		return 8
	end
	return 4
end

--[[
	음표는 종류가 셋이지만 **한 곳에 욱여넣어진다**(md의 `!!` 주석).
	그래서 "총 개수"가 곧 버프 계산의 기준이다.
]]
ClassResources.NOTE_IDS = { ClassResources.QUARTER, ClassResources.EIGHTH, ClassResources.SIXTEENTH }

--=== 사람이 읽는 이름 ===--

local LABELS: { [string]: string } = {
	[ClassResources.QUARTER] = "4분음표",
	[ClassResources.EIGHTH] = "8분음표",
	[ClassResources.SIXTEENTH] = "16분음표",
	[ClassResources.METER] = "박자표",
	[ClassResources.BRILLANTE] = "브릴란테",
	[ClassResources.FOCUS] = "집중",
	[ClassResources.RAGE] = "분노",
	[ClassResources.STANCE_ATTACK] = "공격 태세",
	[ClassResources.READY] = "준비 자세",
	[ClassResources.MASS] = "질량",
	[ClassResources.CHARGE] = "차징",
	[ClassResources.GRAVITY] = "중력",
	[ClassResources.FIELD] = "자기장",
	[ClassResources.DEPOLAR] = "감극",
	[ClassResources.RESONATE] = "공명",
	[ClassResources.ZEAL] = "광신",
	[ClassResources.WALL] = "벽",
	[ClassResources.RUIN] = "허물 벽",
	[ClassResources.HERB] = "약재",
	[ClassResources.EXTRACT] = "원액",
	[ClassResources.EMPTY_BOTTLE] = "빈 병",
	[ClassResources.POISON_BOTTLE] = "독 병",
	[ClassResources.FIRE_BOTTLE] = "화염병",
	[ClassResources.OIL_BOTTLE] = "기름 병",
	[ClassResources.OVERHEAL] = "과다 회복",
}

function ClassResources.Label(id: string): string
	return LABELS[id] or id
end

--[[
	전투를 시작할 때 들고 있는 자원. `유저 아이디어(직업).md`의 패시브에서 왔다.

	  음악가   전투 시작 시 박자표를 1 얻는다
	  연금술사 전투 시작 시 약재 3, 빈 병 5
]]
function ClassResources.StartingStacks(classId: string): { [string]: number }
	if classId == "Musician" then
		return { [ClassResources.METER] = 1 }
	elseif classId == "Alchemist" then
		return { [ClassResources.HERB] = 3, [ClassResources.EMPTY_BOTTLE] = 5 }
	end
	return {}
end

--[[
	매 턴 자동으로 차는 자원. 역시 패시브에서 왔다.

	  연금술사 약재는 매 턴 1, 빈 병은 2턴마다 1
]]
function ClassResources.TurnGain(classId: string, turn: number): { [string]: number }
	if classId == "Alchemist" then
		local gain = { [ClassResources.HERB] = 1 }
		if turn % 2 == 0 then
			gain[ClassResources.EMPTY_BOTTLE] = 1
		end
		return gain
	end
	return {}
end

return ClassResources
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Constants</string>
          <string name="Source"><![CDATA[--!strict

local Constants = {
	REMOTE_FOLDER = "PorcelainRemotes",
	REMOTES = {
		-- 광장에 세워졌다는 신호. 카메라를 되돌리는 데 쓴다.
		PlazaState = "PlazaState",
		SaveMotion = "SaveMotion",
		RequestMotion = "RequestMotion",
		MotionSaved = "MotionSaved",
		RequestInventory = "RequestInventory",
		InventoryState = "InventoryState",
		EquipMotion = "EquipMotion",
		--[[
			탑 등반 + 격자 전투 (추가&수정.md `#### 탑 시스템`, `#### 전투 시스템`).

			판정은 전부 서버가 한다. 클라이언트는 TowerAction/GridAction으로 **의도만**
			보내고, TowerState/GridState로 내려온 스냅샷을 그린다.
		]]
		TowerAction = "TowerAction",
		TowerState = "TowerState",
		GridAction = "GridAction",
		GridState = "GridState",
	},
	MAX_MOTION_FRAMES = 300,
	MAX_MOTION_DURATION = 30,
}

return table.freeze(Constants)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">EnemyDefinitions</string>
          <string name="Source"><![CDATA[--!strict

export type EnemyDefinition = {
	Id: string,
	Name: string,
	MaxHealth: number,
	Power: number,
	Color: Color3,
	MotionId: string,
	Behavior: "Strike" | "Guard" | "Focus" | "Boss",
}

local definitions: { [string]: EnemyDefinition } = {
	ClayScout = {
		Id = "ClayScout",
		Name = "도자기 척후병",
		MaxHealth = 46,
		Power = 10,
		Color = Color3.fromRGB(205, 118, 82),
		MotionId = "BasicSlash",
		Behavior = "Strike",
	},
	ClayGuard = {
		Id = "ClayGuard",
		Name = "유약 수문장",
		MaxHealth = 76,
		Power = 9,
		Color = Color3.fromRGB(85, 145, 190),
		MotionId = "HeavySlash",
		Behavior = "Guard",
	},
	KilnMage = {
		Id = "KilnMage",
		Name = "가마술사",
		MaxHealth = 54,
		Power = 15,
		Color = Color3.fromRGB(185, 85, 160),
		MotionId = "RangedShot",
		Behavior = "Focus",
	},
	ShardHound = {
		Id = "ShardHound",
		Name = "파편 사냥개",
		MaxHealth = 64,
		Power = 14,
		Color = Color3.fromRGB(165, 125, 95),
		MotionId = "BasicSlash",
		Behavior = "Focus",
	},
	GlazePriest = {
		Id = "GlazePriest",
		Name = "유약 사제",
		MaxHealth = 72,
		Power = 13,
		Color = Color3.fromRGB(105, 180, 170),
		MotionId = "RangedShot",
		Behavior = "Guard",
	},
	CrackedKnight = {
		Id = "CrackedKnight",
		Name = "균열 기사",
		MaxHealth = 98,
		Power = 18,
		Color = Color3.fromRGB(135, 105, 100),
		MotionId = "HeavySlash",
		Behavior = "Strike",
	},
	KilnWarden = {
		Id = "KilnWarden",
		Name = "가마의 수호자",
		MaxHealth = 190,
		Power = 23,
		Color = Color3.fromRGB(155, 60, 45),
		MotionId = "HeavySlash",
		Behavior = "Boss",
	},
	GlazeColossus = {
		Id = "GlazeColossus",
		Name = "유약 거상",
		MaxHealth = 260,
		Power = 28,
		Color = Color3.fromRGB(60, 125, 155),
		MotionId = "HeavySlash",
		Behavior = "Boss",
	},
	PorcelainDragon = {
		Id = "PorcelainDragon",
		Name = "백자룡",
		MaxHealth = 350,
		Power = 34,
		Color = Color3.fromRGB(215, 215, 225),
		MotionId = "RangedShot",
		Behavior = "Boss",
	},
}

local EnemyDefinitions = {}

function EnemyDefinitions.Get(id: string): EnemyDefinition
	return definitions[id] or definitions.ClayScout
end

function EnemyDefinitions.IsValid(id: string): boolean
	return definitions[id] ~= nil
end

function EnemyDefinitions.FirstEncounter(): { string }
	return { "ClayScout", "ClayGuard", "KilnMage" }
end

function EnemyDefinitions.Boss(): EnemyDefinition
	return definitions.KilnWarden
end

return EnemyDefinitions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">GridBattle</string>
          <string name="Source"><![CDATA[--!strict
--[[
	GridBattle — 격자 전투의 **서버 권위 상태 기계**.

	사양 출처: 추가&수정.md `#### 전투 시스템`, `##### 배치 및 전투`

	  "턴제 시스템은 그대로 가지고 감."
	  "카메라 방식을 Brown Dust(1편)의 방식처럼 고정."
	  "싸우는 건 플레이어 본인의 아바타여야 함."
	  "6*3의 격자를 양 진영에 둔다."
	  "공격 위치는 플레이어가 있는 세로 라인으로 정해진다."
	  "탑은 오직 솔로 플레이로만 등반 가능."

	기존 `BattleService`는 파티 3인·행동 선택·업그레이드 방식인데, 사양이
	"현재 전투 방식을 전면 폐기"라고 못박았다. 그래서 새 규칙을 이 모듈에 담는다.

	**연출과 입력이 전혀 없는 순수 로직이다.**
	  - 난수는 전부 인자로 받은 rng를 쓴다 → 같은 씨앗이면 같은 전투가 재현된다
	  - QTE는 '언제 눌렀나'가 아니라 이미 판정된 **등급(Grade)** 만 받는다
	  - 그래서 Studio 없이 PrototypeTests로 전부 검증된다

	클라이언트(`Battle3DController`)는 이 상태를 그리고 입력만 보낸다. 판정은 서버 몫이다.

	한 턴의 흐름 — **적은 한 턴 먼저 예고한다.**
	  0. (전투 시작 / 지난 턴 끝) EnemyPlan(rng)  적이 옮기고 쓸 스킬을 고른다
	  1. 플레이어 이동      MoveAlly()      예고된 라인을 보고 피할 수 있다
	  2. 스킬 선택 → QTE    ResolveSkill(grade)
	  3. 예고된 공격 해소   PlannedThreats() → ResolveDodge(grade)
	  4. 턴 마무리          EndTurn() → 다시 EnemyPlan(rng)

	예고를 따로 둔 이유: 예전에는 적이 **움직이는 것과 때리는 것이 한 순간**이라,
	플레이어가 라인을 보고 비켜설 틈이 없었다. 회피가 QTE 하나로만 갈려서 사양의
	라인 규칙("공격 위치는 플레이어가 있는 세로 라인으로 정해진다")이 사실상 죽어
	있었다. 이제 예고를 보고 라인을 바꾸는 것이 실제 선택이 된다.
]]

local BattleGrid = require(script.Parent.BattleGrid)
local BattleSkillEffects = require(script.Parent.BattleSkillEffects)
local BattleSkills = require(script.Parent.BattleSkills)
local BattleStatus = require(script.Parent.BattleStatus)
local CardEffects = require(script.Parent.CardEffects)
local ClassResources = require(script.Parent.ClassResources)
local EnemyDefinitions = require(script.Parent.EnemyDefinitions)
local GroggyGauge = require(script.Parent.GroggyGauge)
local ProgressionDefinitions = require(script.Parent.ProgressionDefinitions)
local QteDefinitions = require(script.Parent.QteDefinitions)
local TowerDefinitions = require(script.Parent.TowerDefinitions)

export type Outcome = "Ongoing" | "Victory" | "Defeat"

export type Unit = {
	Id: string,
	Name: string,
	Side: BattleGrid.Side,
	Health: number,
	MaxHealth: number,
	Power: number,
	Groggy: GroggyGauge.State,
	--[[
		[도발] 스택. **다른 아군에게 갈 공격을 자기 쪽으로 돌린다.**

		라인은 건드리지 않는다 — 라인을 유도하면 회피가 곧 무력화라 이 게임의
		핵심 선택(어느 라인에 설지)이 통째로 죽는다. 도발은 "누구를 때리는가"만 바꾼다.
	]]
	Taunt: number,
	-- 보호막·지속 피해·직업 자원·기한부 보정값. 자세한 건 `BattleStatus` 참고.
	Status: BattleStatus.State,
	--[[
		신앙심(= md의 "기도력"). 월 필그림스 직업이 이 값으로 버프·디버프를 키운다.
		`상태이상.md`: "기도력은 스탯 신앙심의 오타임."
	]]
	Faith: number,
	--[[
		스테미나. 지금은 **쓰는 곳이 없고 명상이 채우는 자원**이다.

		md와 카드들이 "스테미나 소모"를 자주 말하지만, 스킬에 소모량을 붙이는 것은
		밸런스 결정이라 여기서 임의로 정하지 않았다. 값과 매 턴 회복만 굴려 두고,
		소모를 붙일 때 이 필드를 그대로 쓰면 된다.
	]]
	Stamina: number,
	MaxStamina: number,
	-- 적만 쓴다. 이번 턴에 고른 스킬 번호.
	SkillIndex: number,
	Alive: boolean,
	--[[
		스킬 Id → 남은 재사용 대기 턴. 없거나 0이면 바로 쓸 수 있다(요청:
		"직업 능력 탭에서 액티브 스킬 쿨타임 쓰는 칸이 없어" — md에 "재사용
		대기 N턴"으로 이미 적혀 있던 값인데 `BattleSkills.Skill`에 자리가
		없어 옮길 데가 없었다). `EndTurn`이 매 턴 1씩 줄이고,
		`ResolveSkill`이 쓸 때 `skill.Cooldown`만큼 다시 채운다.
	]]
	Cooldowns: { [string]: number },
}

export type State = {
	Floor: number,
	Grid: BattleGrid.Grid,
	Units: { [string]: Unit },
	AllyId: string,
	--[[
		아군의 직업. 이 값이 스킬 목록을 정한다.

		예전에는 없었고 모두가 같은 5개를 썼다 — 직업을 골라도 전투가 똑같았다.
	]]
	AllyClassId: string,
	Turn: number,
	Outcome: Outcome,
	--[[
		아군이 직전에 쓴 스킬 Id. 펄서 [공명]처럼 "같은 스킬을 이어 쓰는가"를
		보는 효과가 있어서 기억해 둔다.
	]]
	LastSkillId: string,
	--[[
		공격을 **예고해 둔** 적들의 Id.

		`EnemyPlan`이 채우고, 그 공격이 해소되거나 턴이 끝나면 비워진다. 이 목록이
		있어야 "예고했지만 아직 안 때린 적"과 "그로기라 예고조차 못 한 적"을 가릴 수
		있다.
	]]
	Planned: { string },
	--[[
		등반 중 모은 능력 카드. `TowerRun.Cards`를 그대로 받는다.

		전투가 카드를 **직접** 들고 있어야 하는 이유: 카드 효과는 턴마다·처치마다
		발동하는데, 그때마다 프로필을 뒤지면 전투 로직이 저장 구조에 묶인다.
		여기 복사해 두면 GridBattle은 여전히 순수 로직으로 남는다.
	]]
	Cards: { CardEffects.Owned },
	--[[
		이번 턴에 스킬을 썼는지. `행동하지 않고 턴을 마치면` 카드가 이 값을 본다.
		`EndTurn`에서 판정하고 그 자리에서 다시 false로 돌린다.
	]]
	Acted: boolean,
	-- 마지막 판정 기록. UI가 그대로 띄운다.
	Log: { string },
}

local ALLY_ID = "player"

--[[
	카드 훅을 쏘는 함수. **전방 선언**이다.

	카드는 회복과 체력 소모를 하므로 `damageUnit`·`healUnit`이 필요한데, 그 둘은
	격자와 로그를 쓰느라 이 파일 아래쪽에 있다. Luau의 지역 변수는 선언보다 위에서
	보이지 않으므로(이 프로젝트에서 이미 몇 번 밟은 함정), 이름만 먼저 잡아 두고
	본체는 아래에서 채운다.
]]
local applyCardHook: (state: State, hook: CardEffects.Hook) -> number

--[[
	카드 훅 안에서 또 훅이 돌지 않게 막는 빗장.

	`피의 맹약`은 전투 시작 시 체력을 무는데, 체력이 깎이면 `OnDamaged`가 돈다.
	그 안에 다시 체력을 무는 카드가 있으면 서로를 부르며 멈추지 않는다.
	카드 효과는 한 겹까지만 돌게 한다.
]]
local cardHookDepth = 0

local GridBattle = {}

GridBattle.ALLY_ID = ALLY_ID

local function pushLog(state: State, message: string)
	table.insert(state.Log, message)
	-- 무한히 쌓이면 복제 비용이 커진다. 최근 것만 남긴다.
	while #state.Log > 12 do
		table.remove(state.Log, 1)
	end
end

--[[
	층 하나에 대한 전투를 만든다.

	적은 층 정의(TowerDefinitions)에서 가져오고, 체력·공격력에 층 배율을 곱한다.
	배치는 사양의 6×3 격자다. 적이 여럿이면 라인을 갈라 세워, 라인 회피가 실제로
	의미를 갖게 한다(같은 라인에 몰아 두면 한 번에 쓸린다).
]]
function GridBattle.New(
	floor: number,
	allyName: string,
	allyHealth: number,
	allyPower: number,
	allyClassId: string?,
	allyFaith: number?,
	allyStamina: number?,
	allyCards: { CardEffects.Owned }?
): State
	local definition = TowerDefinitions.Get(floor)
	local grid = BattleGrid.New()

	local state: State = {
		Floor = definition.Floor,
		Grid = grid,
		Units = {},
		AllyId = ALLY_ID,
		AllyClassId = allyClassId or "Berserker",
		Turn = 1,
		Outcome = "Ongoing",
		LastSkillId = "",
		Planned = {},
		Cards = allyCards or {},
		Acted = false,
		Log = {},
	}

	state.Units[ALLY_ID] = {
		Id = ALLY_ID,
		Name = allyName,
		Side = "Ally",
		Health = allyHealth,
		MaxHealth = allyHealth,
		Power = allyPower,
		Groggy = GroggyGauge.New(),
		Taunt = 0,
		Status = BattleStatus.New(),
		Faith = allyFaith or 0,
		Stamina = allyStamina or 60,
		MaxStamina = allyStamina or 60,
		SkillIndex = 1,
		Alive = true,
		Cooldowns = {},
	}
	-- 패시브로 들고 시작하는 자원(음악가 박자표, 연금술사 약재·빈 병 등).
	BattleSkillEffects.ApplyStartingStacks(state.Units[ALLY_ID].Status, state.AllyClassId)
	-- 아군은 전열 가운데 라인에서 시작한다.
	BattleGrid.Place(grid, ALLY_ID, "Ally", 1, 2)

	for index, enemyId in definition.Enemies do
		local enemy = EnemyDefinitions.Get(enemyId)
		local id = string.format("enemy%d", index)
		local health = math.max(1, math.floor(enemy.MaxHealth * definition.HealthScale))
		state.Units[id] = {
			Id = id,
			Name = enemy.Name,
			Side = "Enemy",
			Health = health,
			MaxHealth = health,
			Power = math.max(1, math.floor(enemy.Power * definition.PowerScale)),
			Groggy = GroggyGauge.New(),
			Taunt = 0,
			Status = BattleStatus.New(),
			Faith = 0,
			Stamina = 0,
			MaxStamina = 0,
			SkillIndex = 1,
			Alive = true,
			Cooldowns = {},
		}
		-- 라인을 돌려가며 세운다. 1번 적은 가운데, 그다음은 위/아래.
		local lane = ((index - 1) % grid.Height) + 1
		local column = math.floor((index - 1) / grid.Height) + 1
		BattleGrid.Place(grid, id, "Enemy", math.min(column, grid.Width), lane)
	end

	pushLog(state, string.format("%d층 %s — %s", definition.Floor, definition.Name, definition.GimmickName))

	--[[
		카드의 `전투 시작 시` 효과. 적을 세운 **뒤에** 쏜다 — 도발처럼 적이 있어야
		뜻이 있는 것이 있고, 로그도 층 안내 다음에 오는 편이 읽기 좋다.

		이어서 1턴 몫의 `매 턴` 효과도 한 번 쏜다. 이게 없으면 조건부 보정값
		("체력 30% 아래면 피해 +12%")이 1턴에는 통째로 빠진 채 시작한다.
	]]
	local started = applyCardHook(state, "BattleStart") + applyCardHook(state, "TurnStart")
	if started > 0 then
		pushLog(state, string.format("능력 카드 %d개 발동", started))
	end
	return state
end

--=== 조회 ===--

function GridBattle.Unit(state: State, id: string): Unit?
	return state.Units[id]
end

function GridBattle.Ally(state: State): Unit
	return state.Units[state.AllyId]
end

function GridBattle.AliveEnemies(state: State): { Unit }
	local alive: { Unit } = {}
	for _, unit in state.Units do
		if unit.Side == "Enemy" and unit.Alive then
			table.insert(alive, unit)
		end
	end
	-- 순서를 고정한다. 해시 순회는 실행마다 달라서 재현이 깨진다.
	table.sort(alive, function(a, b)
		return a.Id < b.Id
	end)
	return alive
end

function GridBattle.CellOf(state: State, id: string): BattleGrid.Cell?
	return BattleGrid.CellOf(state.Grid, id)
end

--[[
	지금 아군이 쓸 수 있는 스킬 목록. **번호의 유일한 기준이다.**

	  1~3  직업 스킬
	  4    강화·연계 (조건이 찼을 때만. 요청: 3번 오른쪽에 따로 생긴다)
	  그 뒤 가드 · 명상 (모든 직업 공용)

	서버와 클라이언트가 같은 함수를 보므로 번호가 어긋나지 않는다. 강화가 열리고
	닫힐 때 가드·명상의 번호가 밀리는데, 그 때문에 `ResolveSkill`은 번호보다
	**Id를 먼저** 믿는다.
]]
function GridBattle.SkillList(state: State): { BattleSkills.Skill }
	local list: { BattleSkills.Skill } = {}
	for _, skill in BattleSkills.ForClass(state.AllyClassId) do
		table.insert(list, skill)
	end

	local upgradeId = BattleSkillEffects.UpgradeFor(state.AllyClassId, GridBattle.Ally(state).Status)
	if upgradeId then
		local upgrade = BattleSkills.ById(upgradeId)
		if upgrade then
			table.insert(list, upgrade)
		end
	end

	for _, skill in BattleSkills.Common() do
		table.insert(list, skill)
	end
	return list
end

--=== 도발 ===--

--[[
	[도발] 상한. 이 값에서 다른 아군에게 갈 공격을 100% 가로챈다.

	카드가 한 번에 1~5씩 주므로 20이면 서너 턴 쌓아야 최대가 된다.
]]
GridBattle.TAUNT_MAX = 20

-- 턴이 끝날 때 빠지는 양.
GridBattle.TAUNT_DECAY = 2

--[[
	도발을 쌓는다. 카드·스킬이 부르는 유일한 진입점이다.

	여기서 상한을 강제하므로, 부르는 쪽이 상한을 몰라도 규격("스택은 반드시 상한이
	있을 것")이 깨지지 않는다.
]]
function GridBattle.AddTaunt(state: State, id: string, amount: number): number
	local unit = state.Units[id]
	if not unit or not unit.Alive then
		return 0
	end
	unit.Taunt = math.clamp(unit.Taunt + math.floor(amount), 0, GridBattle.TAUNT_MAX)
	return unit.Taunt
end

-- 이 유닛이 남의 공격을 가로챌 확률. 0~1.
function GridBattle.TauntChance(state: State, id: string): number
	local unit = state.Units[id]
	if not unit or not unit.Alive then
		return 0
	end
	return math.clamp(unit.Taunt / GridBattle.TAUNT_MAX, 0, 1)
end

--[[
	공격이 실제로 누구에게 갈지 정한다.

	원래 대상이 아닌 아군 중 [도발]이 가장 높은 쪽이 확률로 가로챈다. **라인은 보지
	않는다** — 도발은 대상만 바꾸는 효과다.

	탑은 솔로라 지금은 아군이 하나뿐이고, 그때는 원래 대상을 그대로 돌려준다.
	파티가 붙으면 이 함수 하나만 거치면 도발이 그대로 동작한다.
]]
function GridBattle.RedirectTarget(state: State, intendedId: string, rng: () -> number): string
	local intended = state.Units[intendedId]
	if not intended or intended.Side ~= "Ally" then
		return intendedId
	end

	local best: Unit? = nil
	for _, unit in state.Units do
		if unit.Side == "Ally" and unit.Alive and unit.Id ~= intendedId and unit.Taunt > 0 then
			-- 동점이면 Id 순으로 고른다. 해시 순회는 실행마다 달라서 재현이 깨진다.
			if not best or unit.Taunt > best.Taunt or (unit.Taunt == best.Taunt and unit.Id < best.Id) then
				best = unit
			end
		end
	end

	if not best then
		return intendedId
	end
	if rng() < GridBattle.TauntChance(state, best.Id) then
		pushLog(state, string.format("%s 도발 — 공격을 대신 받는다", best.Name))
		return best.Id
	end
	return intendedId
end

--=== 이동 ===--

--[[
	아군을 자기 진영 안에서 옮긴다(사양: "매 턴마다 해당 격자 내에서 움직이며").
	진영을 넘어가는 이동은 BattleGrid.Move가 막는다.
]]
function GridBattle.MoveAlly(state: State, x: number, y: number): (boolean, string?)
	if state.Outcome ~= "Ongoing" then
		return false, "전투가 끝났습니다."
	end
	local ally = GridBattle.Ally(state)
	if GroggyGauge.IsStunned(ally.Groggy) then
		return false, "그로기 상태에서는 움직일 수 없습니다."
	end
	return BattleGrid.Move(state.Grid, state.AllyId, x, y)
end

--=== 대미지 ===--

--[[
	피해를 넣는다. 순서가 중요하다.

	  1. 받는 피해 보정 (+기름이면 화염 피해 50% 증가)
	  2. 보호막 흡수 — `상태이상.md`: "(보호막 수치)만큼 추가 HP를 얻는다"
	  3. 남은 만큼 체력 차감

	canKill이 false면 체력 1에서 멈춘다. `상태이상.md`가 출혈·독·화상에 대해
	"이 효과로 사망할 수 없다"고 못박았고, 연금술사 자해도 같은 규칙을 쓴다.
]]
local function damageUnit(
	state: State,
	unit: Unit,
	amount: number,
	element: BattleStatus.Element?,
	canKill: boolean?
): number
	local kind: BattleStatus.Element = element or "Physical"
	local scaled = BattleStatus.IncomingDamage(unit.Status, amount, kind)
	local absorbed, remaining = BattleStatus.Absorb(unit.Status, scaled)
	if absorbed > 0 then
		pushLog(state, string.format("%s 보호막이 %d 막았다", unit.Name, math.floor(absorbed)))
	end

	local dealt = math.max(0, math.floor(remaining))
	local floorHealth = if canKill == false then 1 else 0
	unit.Health = math.max(floorHealth, unit.Health - dealt)

	--[[
		카드의 `피해를 받으면` 효과. 격노처럼 맞을 때마다 자원을 버는 카드가 쓴다.
		실제로 체력이 깎였을 때만 — 보호막이 전부 막았으면 맞은 것이 아니다.
	]]
	if unit.Id == ALLY_ID and dealt > 0 and unit.Alive then
		applyCardHook(state, "OnDamaged")
	end

	if unit.Health <= 0 and unit.Alive then
		unit.Alive = false
		BattleGrid.Remove(state.Grid, unit.Id)
		pushLog(state, string.format("%s 쓰러짐", unit.Name))
		-- 카드의 `적을 처치하면` 효과.
		if unit.Side == "Enemy" then
			applyCardHook(state, "OnKill")
		end
	end
	return dealt
end

local function healUnit(unit: Unit, amount: number): number
	local scaled = amount * (1 + BattleStatus.Total(unit.Status, "HealTaken"))
	local before = unit.Health
	unit.Health = math.min(unit.MaxHealth, unit.Health + math.floor(scaled))
	return unit.Health - before
end

--[[
	카드 훅 본체(위쪽 전방 선언의 짝).

	카드는 **아군에게만** 붙는다. 적은 직업도 등반도 없다.
	체력 소모는 canKill=false로 넣는다 — `피의 맹약`처럼 전투 시작 시 체력을 무는
	카드가 그 자리에서 플레이어를 죽이면 안 된다.
]]
applyCardHook = function(state: State, hook: CardEffects.Hook): number
	local ally = state.Units[ALLY_ID]
	if not ally or not ally.Alive or #state.Cards == 0 or cardHookDepth > 0 then
		return 0
	end

	cardHookDepth += 1
	local fired = CardEffects.Apply(hook, state.Cards, {
		Status = ally.Status,
		Health = ally.Health,
		MaxHealth = ally.MaxHealth,
		Faith = ally.Faith,
		Meter = BattleStatus.Stack(ally.Status, ClassResources.METER),
		Heal = function(amount)
			return healUnit(ally, amount)
		end,
		LoseHealth = function(amount)
			return damageUnit(state, ally, amount, "True", false)
		end,
		AddFaith = function(amount)
			ally.Faith += amount
		end,
		AddStamina = function(amount)
			ally.Stamina = math.min(ally.MaxStamina, ally.Stamina + amount)
		end,
		AddTaunt = function(amount)
			ally.Taunt += amount
		end,
	})
	cardHookDepth -= 1
	return fired
end

local function refreshOutcome(state: State)
	if state.Outcome ~= "Ongoing" then
		return
	end
	if not GridBattle.Ally(state).Alive then
		state.Outcome = "Defeat"
		pushLog(state, "패배")
		return
	end
	if #GridBattle.AliveEnemies(state) == 0 then
		state.Outcome = "Victory"
		pushLog(state, "층 클리어")
	end
end

--=== 아군 공격 ===--

--[[
	아군이 스킬을 쓴다. QTE **등급만** 받는다 — 언제 눌렀는지는 클라이언트가 판정해
	보내는 것이 아니라, 서버가 만든 챌린지에 대한 결과를 받는 구조다.

	사양: 공격 라인은 아군이 선 세로 라인이다. 마우스 조준이 없다.
]]
--[[
	rng는 연금술사 `섞기`처럼 결과가 갈리는 효과에만 쓴다. 넘기지 않으면 0.5로
	고정돼 결정적으로 동작한다 — 기존 테스트가 그대로 통과하도록 두려는 것이다.
]]
function GridBattle.ResolveSkill(
	state: State,
	skillIndex: any,
	grade: QteDefinitions.Grade,
	rng: (() -> number)?,
	skillId: string?
): (boolean, string?)
	if state.Outcome ~= "Ongoing" then
		return false, "전투가 끝났습니다."
	end
	local ally = GridBattle.Ally(state)
	if GroggyGauge.IsStunned(ally.Groggy) then
		return false, "그로기 상태입니다."
	end
	local cell = BattleGrid.CellOf(state.Grid, state.AllyId)
	if not cell then
		return false, "격자에 없습니다."
	end

	--[[
		쓸 수 있는 목록에서 고른다. 강화가 열려 있으면 4번이 그 자리다.

		**skillId가 오면 그것을 먼저 믿는다.** 강화가 열리고 닫힐 때 가드·명상의
		번호가 한 칸씩 밀리는데, 그 사이에 도착한 요청이 번호만 보고 엉뚱한 스킬을
		쏘면 안 된다. 물론 목록에 없는 Id는 무시한다(클라이언트를 그대로 믿지 않는다).
	]]
	local allySkills = GridBattle.SkillList(state)
	local skill = BattleSkills.ByIndex(allySkills, skillIndex)
	if type(skillId) == "string" then
		for _, candidate in allySkills do
			if candidate.Id == skillId then
				skill = candidate
				break
			end
		end
	end
	for index, candidate in allySkills do
		if candidate.Id == skill.Id then
			ally.SkillIndex = index
			break
		end
	end

	-- 재사용 대기 중이면 아예 못 쓴다. 여기서 막아야 그 뒤의 자원 소모·공명 처리도 같이 막힌다.
	local cooldownLeft = ally.Cooldowns[skill.Id] or 0
	if cooldownLeft > 0 then
		return false,
			string.format("%s은(는) 아직 재사용 대기 중입니다 (%d턴 남음).", skill.Name, cooldownLeft)
	end

	--[[
		펄서 [공명]처럼 "같은 스킬을 이어 쓰는가"를 보는 효과가 있다.
		다른 스킬로 넘어가면 그 자원을 비운다.
	]]
	if state.LastSkillId ~= skill.Id then
		BattleStatus.SpendAll(ally.Status, ClassResources.RESONATE)
	end
	state.LastSkillId = skill.Id
	-- 스킬을 썼다. `행동하지 않고 턴을 마치면` 카드가 이번 턴에는 발동하지 않는다.
	state.Acted = true
	if skill.Cooldown and skill.Cooldown > 0 then
		ally.Cooldowns[skill.Id] = skill.Cooldown
	end

	local multiplier = QteDefinitions.Multiplier("Skill", grade)
	local growCount = skill.GrowResource
			and BattleSkills.GrowCount(skill, BattleStatus.Stack(ally.Status, skill.GrowResource))
		or 0

	--[[
		앞뒤관통처럼 모션이 여럿이면(요청: "모션상 단계") 모션마다 범위를 따로
		구한다 — 같은 칸이라도 모션마다 겹칠 수 있어(예: 두 모션이 같은 대상을
		또 때리는 경우) 목록을 모션별로 나눠 들고 있는다. 상태이상 효과
		(`context.Targets`)는 "누구를 맞췄는가"만 보면 되므로 합집합 한 번이면
		되고, 피해는 모션마다 따로 준다(아래 2단계).
	]]
	local motionHitUnits: { { Unit } } = {}
	local hitUnits: { Unit } = {}
	local seenUnit: { [string]: boolean } = {}
	for _, shape in BattleSkills.AllShapes(skill) do
		local targets = BattleSkills.Targets(state.Grid, "Ally", cell.Y, shape, growCount, cell.X)
		local aliveHits: { Unit } = {}
		for _, targetId in targets do
			local target = state.Units[targetId]
			if target and target.Alive then
				table.insert(aliveHits, target)
				if not seenUnit[targetId] then
					seenUnit[targetId] = true
					table.insert(hitUnits, target)
				end
			end
		end
		table.insert(motionHitUnits, aliveHits)
	end

	local context: BattleSkillEffects.Context = {
		Ally = ally,
		Status = ally.Status,
		Targets = hitUnits,
		Allies = { ally },
		Grade = grade,
		Rng = rng or function()
			return 0.5
		end,
		StatusOf = function(unit)
			return unit.Status
		end,
		Damage = function(unit, amount, element, canKill)
			return damageUnit(state, unit, amount, element, canKill)
		end,
		Heal = function(unit, amount)
			return healUnit(unit, amount)
		end,
		RestoreStamina = function(amount)
			local before = ally.Stamina
			ally.Stamina = math.min(ally.MaxStamina, ally.Stamina + math.floor(amount))
			return ally.Stamina - before
		end,
		Log = function(message)
			pushLog(state, message)
		end,
		PullEnemies = function(columns)
			return GridBattle.PullEnemies(state, columns)
		end,
	}

	local effect = BattleSkillEffects.Get(skill.Id)

	-- 1) 피해 계산 전. 자원을 쓰고 배율을 받는다.
	local skillBonus = 1
	if effect and effect.Before then
		skillBonus = effect.Before(context)
	end

	--[[
		2) 피해. 주는 피해 보정(태세·허물 벽·다지기…)을 함께 먹인다.

		**피해 0인 스킬은 때리지 않는다.** 예전에는 `ally.Power + skill.Damage`가
		0보다 크면 무조건 때렸는데, 무기 공격력이 얹히니 브릴란테·자기권·축성 같은
		버프 스킬이 20 넘는 피해를 주고 적을 죽이기까지 했다.
		skillBonus가 0인 것(붕괴 차징)도 같이 걸러진다.
	]]
	local total = 0
	local hitCount = 0
	if skill.Damage > 0 and skillBonus > 0 then
		local base = BattleStatus.OutgoingDamage(ally.Status, (ally.Power + skill.Damage) * multiplier * skillBonus)
		--[[
			모션마다 `base`만큼 **따로** 입힌다(요청: "모션마다 따로 대미지") —
			앞뒤관통의 "9 × 2(합 18)"처럼, `skill.Damage`는 모션 하나의 몫이다.
			같은 대상이 두 모션에 다 걸리면 두 번 맞는다.
		]]
		for _, aliveHits in motionHitUnits do
			for _, target in aliveHits do
				total += damageUnit(state, target, base, "Physical", true)
				hitCount += 1
				-- 맞으면 그로기가 찬다. 패리만큼은 아니지만 누적되면 스턴이 난다.
				GroggyGauge.AddFrom(target.Groggy, "Hit")
			end
		end
		pushLog(state, string.format("%s ×%.1f — %d명에게 %d 피해", skill.Name, multiplier, hitCount, total))
	else
		-- 피해가 없는 스킬(버프·자원)이다. 대상이 없어도 효과는 나간다.
		pushLog(state, skill.Name)
	end

	-- 3) 피해 계산 후. 자원을 얻고 상태이상을 건다.
	if effect and effect.After then
		effect.After(context)
	end

	refreshOutcome(state)
	return true, nil
end

--[[
	적을 아군 쪽으로 끌어당긴다(퀘이사 붕괴). 실제로 옮겨진 수를 돌려준다.

	x가 작을수록 중앙선에 가깝다(BattleArena 주석). 그래서 x를 1씩 줄이면 끌려온다.
]]
function GridBattle.PullEnemies(state: State, columns: number): number
	local moved = 0
	for _, enemy in GridBattle.AliveEnemies(state) do
		local cell = BattleGrid.CellOf(state.Grid, enemy.Id)
		if cell and cell.X > 1 then
			local goal = math.max(1, cell.X - columns)
			if BattleGrid.Move(state.Grid, enemy.Id, goal, cell.Y) then
				moved += 1
			end
		end
	end
	return moved
end

--=== 적 턴 ===--

--[[
	적이 움직이고 **다음에 쓸 스킬을 예고한다.** 아직 때리지는 않는다.

	사양: "매 턴마다 해당 격자 내에서 움직이며". 매 턴 자리와 스킬이 바뀌어야
	라인 회피가 살아 있는 선택이 된다.

	이 함수가 플레이어 행동 **전에** 돌아야 한다. 예고를 보고 라인을 비켜서는 것이
	이 전투의 핵심 선택이기 때문이다.

	rng는 인자로 받는다 — 서버가 씨앗을 쥐고 있어야 재현·검증이 된다.
]]
function GridBattle.EnemyPlan(state: State, rng: () -> number): { Unit }
	local planned: { Unit } = {}
	state.Planned = {}
	if state.Outcome ~= "Ongoing" then
		return planned
	end

	for _, enemy in GridBattle.AliveEnemies(state) do
		if GroggyGauge.IsStunned(enemy.Groggy) then
			pushLog(state, string.format("%s 그로기 — 행동 불가", enemy.Name))
		else
			-- 빈 칸을 찾을 때까지 몇 번만 시도한다. 격자가 꽉 찰 일이 없어 금방 끝난다.
			-- [도발]은 여기에 개입하지 않는다. 라인 선택은 순수하게 유지한다.
			for _ = 1, 8 do
				local x = math.floor(rng() * state.Grid.Width) + 1
				local y = math.floor(rng() * state.Grid.Height) + 1
				if BattleGrid.Move(state.Grid, enemy.Id, x, y) then
					break
				end
			end
			enemy.SkillIndex = math.floor(rng() * #BattleSkills.Enemy()) + 1
			table.insert(planned, enemy)
			table.insert(state.Planned, enemy.Id)
		end
	end
	return planned
end

--[[
	예고해 둔 공격 중 **지금 아군에게 닿는 것**만 골라낸다.

	플레이어가 이동한 **뒤에** 부른다. 예고된 라인에서 비켜섰으면 그 공격은
	여기서 빠진다 — 그게 위치로 피한다는 뜻이다.
]]
function GridBattle.PlannedThreats(state: State): { Unit }
	local threats: { Unit } = {}
	if state.Outcome ~= "Ongoing" then
		return threats
	end
	for _, enemyId in state.Planned do
		local enemy = state.Units[enemyId]
		if enemy and enemy.Alive and GridBattle.EnemyThreatensAlly(state, enemy) then
			table.insert(threats, enemy)
		end
	end
	return threats
end

--[[
	적 하나의 공격이 아군에게 닿는지. 닿으면 회피/패리 QTE를 띄울 차례다.
	사양의 라인 규칙을 그대로 쓰므로, 아군이 다른 라인에 있으면 그냥 빗나간다.
]]
function GridBattle.EnemyThreatensAlly(state: State, enemy: Unit): boolean
	local cell = BattleGrid.CellOf(state.Grid, enemy.Id)
	if not cell then
		return false
	end
	local skill = BattleSkills.ByIndex(BattleSkills.Enemy(), enemy.SkillIndex)
	local growCount = skill.GrowResource
			and BattleSkills.GrowCount(skill, BattleStatus.Stack(enemy.Status, skill.GrowResource))
		or 0
	-- 모션이 여럿이면 그중 하나라도 나를 걸면 위협이다.
	for _, shape in BattleSkills.AllShapes(skill) do
		for _, targetId in BattleSkills.Targets(state.Grid, "Enemy", cell.Y, shape, growCount, cell.X) do
			if targetId == state.AllyId then
				return true
			end
		end
	end
	return false
end

--[[
	적 공격에 대한 회피/패리 결과를 적용한다.

	사양: 패리 성공 시 상대 그로기가 오른다(QteDefinitions.PARRY_GROGGY_GAIN).
	Dodge 배율은 Success 0 / Partial 0.5 / Fail 1.0 — 즉 성공하면 아예 안 맞는다.
]]
function GridBattle.ResolveDodge(state: State, enemyId: string, grade: QteDefinitions.Grade): (boolean, string?)
	if state.Outcome ~= "Ongoing" then
		return false, "전투가 끝났습니다."
	end
	local enemy = state.Units[enemyId]
	if not enemy or not enemy.Alive or enemy.Side ~= "Enemy" then
		return false, "그런 적이 없습니다."
	end

	local ally = GridBattle.Ally(state)
	local skill = BattleSkills.ByIndex(BattleSkills.Enemy(), enemy.SkillIndex)
	local multiplier = QteDefinitions.Multiplier("Dodge", grade)
	-- 적에게 걸린 주는 피해 보정(광신·섬광·중력)을 먹인다.
	local incoming = BattleStatus.OutgoingDamage(enemy.Status, (enemy.Power + skill.Damage) * multiplier)
	local taken = damageUnit(state, ally, incoming, "Physical", true)

	--[[
		실제로 맞았으면 반사가 나간다(펄서 자기권).
		`Reflect`는 비율이 아니라 절대값이고, [자기장]이 걸린 동안만 붙어 있다.
	]]
	if taken > 0 then
		local reflect = BattleStatus.Total(ally.Status, "Reflect")
		if reflect > 0 then
			local dealt = damageUnit(state, enemy, reflect, "Physical", true)
			-- 자기권은 반사와 함께 [감극]도 건다.
			BattleStatus.AddStack(enemy.Status, ClassResources.DEPOLAR, 1, ClassResources.Cap(ClassResources.DEPOLAR))
			BattleStatus.RemoveBySource(enemy.Status, "감극")
			local stacks = BattleStatus.Stack(enemy.Status, ClassResources.DEPOLAR)
			BattleStatus.AddModifier(enemy.Status, "DamageTaken", 0.05 * stacks, 2, "감극")
			pushLog(
				state,
				string.format("자기장 반사 — %s에게 %d 피해, 감극 %d", enemy.Name, dealt, stacks)
			)
		end
	end

	if grade == "Success" then
		-- 완전 회피 = 패리로 본다. 상대 그로기를 채운다(사양).
		GroggyGauge.Add(enemy.Groggy, QteDefinitions.PARRY_GROGGY_GAIN)
		pushLog(
			state,
			string.format(
				"%s의 %s를 받아넘겼다 (적 그로기 +%d)",
				enemy.Name,
				skill.Name,
				QteDefinitions.PARRY_GROGGY_GAIN
			)
		)
	else
		pushLog(state, string.format("%s의 %s — %d 피해", enemy.Name, skill.Name, taken))
	end

	refreshOutcome(state)
	return true, nil
end

--[[
	턴을 마무리한다.

	  1. 지속 피해 (출혈·독·화상) — `상태이상.md`. 이 피해로는 죽지 않는다.
	  2. 기한부 보정값을 한 턴 깎는다.
	  3. 그로기·도발 감소.
	  4. 직업 자원 자동 회복 (연금술사 약재·빈 병).

	사양: 스턴은 STUN_TURNS만큼 지속되고, 풀리면 게이지가 0으로 돌아간다.
]]
function GridBattle.EndTurn(state: State)
	if state.Outcome ~= "Ongoing" then
		return
	end
	for _, unit in state.Units do
		if unit.Alive then
			--[[
				지속 피해. `TickDots`는 피해량만 돌려주고 감소까지 처리한다.
				죽지 않아야 하므로 canKill=false로 넣는다.
			]]
			local tick = BattleStatus.TickDots(unit.Status, unit.MaxHealth)
			local total = 0
			total += damageUnit(state, unit, tick.Physical, "Physical", false)
			total += damageUnit(state, unit, tick.Fire, "Fire", false)
			total += damageUnit(state, unit, tick.True, "True", false)
			if #tick.Notes > 0 then
				pushLog(state, string.format("%s — %s", unit.Name, table.concat(tick.Notes, " · ")))
			end

			BattleStatus.TickModifiers(unit.Status)
			GroggyGauge.TickTurn(unit.Groggy)
			-- 도발은 유지비다. 매 턴 빠지므로 계속 쌓아야 유지된다.
			unit.Taunt = math.max(0, unit.Taunt - GridBattle.TAUNT_DECAY)
			-- 쿨타임 감소. 0 밑으로는 안 내려간다.
			for id, remaining in unit.Cooldowns do
				unit.Cooldowns[id] = math.max(0, remaining - 1)
			end
		end
	end

	-- 직업 자원 자동 회복. 아군만 해당한다(적은 직업이 없다).
	local ally = GridBattle.Ally(state)
	if ally.Alive then
		for id, amount in ClassResources.TurnGain(state.AllyClassId, state.Turn) do
			BattleStatus.AddStack(ally.Status, id, amount, ClassResources.Cap(id))
		end
		--[[
			스테미나는 사양대로 매 턴 고정 8씩 찬다
			(`ProgressionDefinitions.StaminaRegen`, 받는 버프 효율이 반영된다).
		]]
		local regen = ProgressionDefinitions.StaminaRegen(BattleStatus.Total(ally.Status, "BuffTaken"))
		ally.Stamina = math.min(ally.MaxStamina, ally.Stamina + regen)
	end

	--[[
		카드의 `행동하지 않고 턴을 마치면` 효과. 턴을 넘기기 **전에** 판정한다.
		페르마타·묵상처럼 한 턴을 통째로 쉬는 대신 자원을 받는 카드가 여기 걸린다.
	]]
	if not state.Acted then
		applyCardHook(state, "TurnEndIdle")
	end
	state.Acted = false

	--[[
		예고를 비운다. 이번 턴 몫은 이미 해소됐으므로, 남겨 두면 다음 턴에 같은
		공격이 한 번 더 나간다.
	]]
	state.Planned = {}
	state.Turn += 1

	--[[
		카드의 `매 턴` 효과. **턴 번호를 올린 뒤**에 쏜다 — 여기서 거는 조건부
		보정값은 1턴짜리라, 새 턴이 시작한 시점에 붙어야 그 턴 내내 유효하다.
		직전 `TickModifiers`가 지난 턴 몫을 이미 걷어 갔으므로 겹치지도 않는다.
	]]
	applyCardHook(state, "TurnStart")

	refreshOutcome(state)
end

--[[
	클라이언트로 보낼 만큼만 추린 스냅샷.
	상태 표를 통째로 보내면 서버 내부 구조가 그대로 새어 나간다.
]]
function GridBattle.Snapshot(state: State): any
	local units = {}
	for id, unit in state.Units do
		local cell = BattleGrid.CellOf(state.Grid, id)
		units[id] = {
			Id = unit.Id,
			Name = unit.Name,
			Side = unit.Side,
			Health = unit.Health,
			MaxHealth = unit.MaxHealth,
			Alive = unit.Alive,
			Groggy = unit.Groggy.Value,
			Stunned = GroggyGauge.IsStunned(unit.Groggy),
			Taunt = unit.Taunt,
			SkillIndex = unit.SkillIndex,
			-- 적에게 걸린 것도 보여야 한다(광신·감극·화상 등).
			Shield = unit.Status.Shield,
			Bleed = unit.Status.Bleed,
			Poison = unit.Status.Poison,
			Burn = unit.Status.Burn,
			Oil = unit.Status.Oil,
			X = cell and cell.X or nil,
			Y = cell and cell.Y or nil,
		}
	end
	--[[
		아군 스킬 목록을 함께 보낸다.

		클라이언트가 `BattleSkills.All()`로 직접 만들면 직업과 무관한 목록이 뜬다
		(그래서 어떤 직업을 골라도 스킬 바가 똑같았다). **무엇을 쓸 수 있는지도
		서버가 정한다.**
	]]
	local ally = GridBattle.Ally(state)
	local allyStatus = ally.Status

	--[[
		쓸 수 있는 스킬 그대로 내려보낸다. `SkillList`가 유일한 기준이므로 클라이언트
		버튼 번호와 서버 판정이 어긋날 수 없다.
	]]
	local classCount = #BattleSkills.ForClass(state.AllyClassId)
	local commonCount = #BattleSkills.Common()
	local allySkills = {}
	local resolved = GridBattle.SkillList(state)
	for index, skill in resolved do
		local override = BattleSkillEffects.DisplayName(skill.Id, allyStatus)
		--[[
			종류를 함께 보낸다.
			  Class    직업 스킬 1~3
			  Upgrade  강화·연계 (3번 오른쪽)
			  Common   가드·명상
		]]
		local kind = "Class"
		if index > #resolved - commonCount then
			kind = "Common"
		elseif index > classCount then
			kind = "Upgrade"
		end

		table.insert(allySkills, {
			Index = index,
			Id = skill.Id,
			Name = override or skill.Name,
			-- 스킬 바에서 마우스를 올렸을 때 띄울 설명과 범위.
			Description = skill.Description or "",
			ShapeText = BattleSkills.ShapeText(skill),
			Damage = skill.Damage,
			Range = BattleSkills.RangeText(skill),
			-- 근거리 / 원거리 (요청).
			RangeKind = skill.Range,
			RangeLabel = BattleSkills.RangeLabel(skill),
			Kind = kind,
			Upgraded = kind == "Upgrade" or override ~= nil,
			-- 쿨타임. UI가 이걸로 스킬 바를 잠그거나 "N턴 남음"을 띄운다.
			Cooldown = skill.Cooldown or 0,
			CooldownLeft = ally.Cooldowns[skill.Id] or 0,
		})
	end

	return {
		Floor = state.Floor,
		Turn = state.Turn,
		Outcome = state.Outcome,
		Units = units,
		AllyClassId = state.AllyClassId,
		AllySkills = allySkills,
		-- 자원·보호막·지속 피해. UI가 이걸로 상태 표시를 그린다.
		AllyStatus = BattleStatus.Snapshot(allyStatus),
		AllyStamina = ally.Stamina,
		AllyMaxStamina = ally.MaxStamina,
		--[[
			공격을 예고한 적들. 클라이언트가 이걸로 위협 칸을 칠한다.

			예고한 적만 담으므로, 그로기로 못 움직인 적의 칸은 칠해지지 않는다 —
			예전에는 유닛의 SkillIndex를 그대로 보고 칠해서 이미 지난 공격이나
			행동 불가인 적의 공격까지 표시됐다.
		]]
		Planned = table.clone(state.Planned),
		Log = table.clone(state.Log),
	}
end

return GridBattle
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">GroggyGauge</string>
          <string name="Source"><![CDATA[--!strict
--[[
	GroggyGauge — 그로기 게이지.

	사양 출처: 추가&수정.md `###### 전투`

	  "그로기 게이지: 100까지 찰 경우 한 턴 스턴에 빠지며,
	   피격, 패리 등과 같은 여러 요소로 찰 수 있다."
	  "만약 패리를 할 시 적에게 15의 그로기 게이지가 추가된다."

	사양이 명시한 것은 두 가지뿐이다.
	  - 상한 100, 도달 시 **한 턴 스턴**
	  - 패리 성공 시 적에게 **15**

	"피격, 패리 등과 같은 여러 요소"라고 열어 두었으므로,
	원인(Source)별 수치를 표로 빼서 나중에 조정하기 쉽게 했다.
	패리 15만 사양 확정값이고 나머지는 잠정치다 — 아래 표에 표시해 두었다.

	스턴 처리
	  100에 닿으면 Stunned가 되고 한 턴을 쉰다.
	  스턴이 끝나면 게이지를 0으로 되돌린다(계속 스턴에 걸리는 것을 막기 위함).
]]

export type Source = "Parry" | "Hit" | "CriticalHit" | "Counter" | "Skill" | "Break"

export type State = {
	Value: number,
	-- 스턴 상태이며 남은 턴 수. 0이면 정상.
	StunTurns: number,
}

local MAX = 100
local STUN_TURNS = 1

--[[
	원인별 증가량.

	| 원인 | 값 | 근거 |
	|---|---|---|
	| Parry | 15 | **사양 확정** — "패리를 할 시 적에게 15의 그로기 게이지가 추가" |
	| 나머지 | 잠정 | 사양이 "피격, 패리 등과 같은 여러 요소"로만 열어 둔 부분 |
]]
local GAIN: { [Source]: number } = {
	Parry = 15, -- 사양 확정값
	Hit = 4, -- 잠정
	CriticalHit = 8, -- 잠정
	Counter = 10, -- 잠정
	Skill = 6, -- 잠정
	Break = 20, -- 잠정
}

local GroggyGauge = {}

GroggyGauge.MAX = MAX
GroggyGauge.STUN_TURNS = STUN_TURNS
GroggyGauge.Gain = GAIN

function GroggyGauge.New(): State
	return { Value = 0, StunTurns = 0 }
end

function GroggyGauge.IsStunned(state: State): boolean
	return state.StunTurns > 0
end

--[[
	게이지를 채운다.

	반환: 이번 호출로 스턴에 빠졌는지.
	이미 스턴 중이면 더 쌓지 않는다(스턴 중 누적으로 연속 스턴이 되는 것을 막는다).
]]
function GroggyGauge.Add(state: State, amount: number): boolean
	if GroggyGauge.IsStunned(state) then
		return false
	end

	state.Value = math.clamp(state.Value + math.max(amount, 0), 0, MAX)

	if state.Value >= MAX then
		state.StunTurns = STUN_TURNS
		return true
	end
	return false
end

-- 원인으로 채운다. 표에 없는 원인이면 아무 일도 없다.
function GroggyGauge.AddFrom(state: State, source: Source): boolean
	local amount = GAIN[source]
	if not amount then
		return false
	end
	return GroggyGauge.Add(state, amount)
end

--[[
	턴이 끝날 때 부른다.

	스턴이 걸려 있으면 남은 턴을 하나 줄이고,
	다 풀리는 순간 게이지를 0으로 되돌린다.

	반환: 이번 턴에 행동할 수 없는지 (= 스턴이었는지)
]]
function GroggyGauge.TickTurn(state: State): boolean
	if not GroggyGauge.IsStunned(state) then
		return false
	end

	state.StunTurns -= 1
	if state.StunTurns <= 0 then
		state.StunTurns = 0
		-- 스턴을 마쳤으니 게이지를 비운다.
		state.Value = 0
	end
	return true
end

-- UI용 0~1 비율.
function GroggyGauge.Ratio(state: State): number
	return state.Value / MAX
end

return GroggyGauge
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">HonorDefinitions</string>
          <string name="Source"><![CDATA[--!strict
--[[
	HonorDefinitions — 명예 수치와 거래 가능 등급.

	사양 출처: 추가&수정.md `## 거래 > ### 명예`

	  - 계정 생성 시 기본값 150. **계정 귀속**이라 슬롯을 새로 만들거나
	    사망 후 부활해도 유지된다.
	  - 최대 300.
	  - 값어치가 같거나 더 주는 거래로 올릴 수 있다.
	  - 너무 싼 물건(예: 나뭇가지)을 반복 거래해 올리는 것은 막는다.

	거래 가능 등급 (사양 표 그대로)
	     ~50  커먼
	    ~100  언커먼
	    ~150  레어
	    ~200  에픽
	    ~220  유니크
	    ~260  슈프림
	    ~280  레전더리
	     300  전부
]]

local ItemDefinitions = require(script.Parent.ItemDefinitions)

local DEFAULT_HONOR = 150
local MAX_HONOR = 300
local MIN_HONOR = 0

-- 명예 상한선별 거래 가능 최고 등급. 낮은 순으로 둔다.
local TRADE_TIERS: { { Threshold: number, MaxRarity: ItemDefinitions.Rarity } } = {
	{ Threshold = 50, MaxRarity = "Common" },
	{ Threshold = 100, MaxRarity = "Uncommon" },
	{ Threshold = 150, MaxRarity = "Rare" },
	{ Threshold = 200, MaxRarity = "Epic" },
	{ Threshold = 220, MaxRarity = "Unique" },
	{ Threshold = 260, MaxRarity = "Supreme" },
	{ Threshold = 280, MaxRarity = "Legendary" },
	{ Threshold = 300, MaxRarity = "Abyss" },
}

-- 명예 획득을 인정하는 거래의 최소 가치.
-- 이보다 싼 물건은 반복 거래해도 명예가 오르지 않는다(사양의 나뭇가지 방지).
local MIN_TRADE_VALUE_FOR_HONOR = 50

local HonorDefinitions = {}

HonorDefinitions.DEFAULT_HONOR = DEFAULT_HONOR
HonorDefinitions.MAX_HONOR = MAX_HONOR
HonorDefinitions.MIN_HONOR = MIN_HONOR
HonorDefinitions.MIN_TRADE_VALUE_FOR_HONOR = MIN_TRADE_VALUE_FOR_HONOR
HonorDefinitions.TradeTiers = TRADE_TIERS

function HonorDefinitions.Clamp(honor: number): number
	return math.clamp(honor, MIN_HONOR, MAX_HONOR)
end

-- 이 명예로 거래할 수 있는 최고 등급.
function HonorDefinitions.MaxTradableRarity(honor: number): ItemDefinitions.Rarity
	local clamped = HonorDefinitions.Clamp(honor)
	local result: ItemDefinitions.Rarity = "Common"
	for _, tier in TRADE_TIERS do
		if clamped <= tier.Threshold then
			return tier.MaxRarity
		end
		result = tier.MaxRarity
	end
	return result
end

-- 해당 등급 아이템을 거래할 수 있는지.
function HonorDefinitions.CanTrade(honor: number, rarity: ItemDefinitions.Rarity): boolean
	local allowed = HonorDefinitions.MaxTradableRarity(honor)
	return ItemDefinitions.RarityTier(rarity) <= ItemDefinitions.RarityTier(allowed)
end

--[[
	거래가 명예를 올릴 자격이 있는지 판정한다.

	  givenValue   내가 준 것의 가치
	  receivedValue 내가 받은 것의 가치

	사양: "값어치가 똑같은, 혹은 더 주는 식의 거래"만 인정하고,
	      너무 싼 물건의 반복 거래는 인정하지 않는다.
]]
function HonorDefinitions.QualifiesForHonorGain(givenValue: number, receivedValue: number): boolean
	if givenValue < MIN_TRADE_VALUE_FOR_HONOR then
		return false
	end
	return givenValue >= receivedValue
end

return HonorDefinitions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">ItemDefinitions</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ItemDefinitions — 아이템 등급 8종과 착용 제한 규칙.

	사양 출처: 추가&수정.md `## 육성 시스템 > ### 아이템`

	핵심 규칙
	  - 탑에서는 **특별(Epic)** 등급까지만 획득. 고유(Unique)부터는 필드 수급.
	  - 각 아이템은 취급 스탯에 대한 제한이 걸린다. (예: 힘 40 이상)
	  - 제한 미달이어도 착용은 가능하되 **그 무기 대미지가 50% 감소**한다.
	  - 제한 판정에는 **메인 스탯만** 쓴다. 아이템이 준 스탯(서브)은 제한 충족으로 치지 않는다.
	  - 스탯 제한은 100을 넘길 수 없다.
	  - 대장간 제작은 통달(Supreme)까지. 전설은 고급 재료 조달 퀘스트 완료 시 해금.
]]

local StatDefinitions = require(script.Parent.StatDefinitions)

export type Rarity = "Common" | "Uncommon" | "Rare" | "Epic" | "Unique" | "Supreme" | "Legendary" | "Abyss"

export type RarityDefinition = {
	Id: Rarity,
	Name: string,
	Tier: number, -- 1(일반) ~ 8(심연)
	Color: Color3,
	MaxStatRequirement: number, -- 이 등급 아이템이 걸 수 있는 스탯 제한 상한
	TowerObtainable: boolean, -- 탑에서 얻을 수 있는가
	Craftable: boolean, -- 대장간에서 제작 가능한가
	CraftMaterialCount: number, -- 제작 시 필요 재료 수 (등급이 오를수록 증가)
}

export type Item = {
	Id: string,
	Name: string,
	Rarity: Rarity,
	-- 이 아이템이 다루는 스탯. 제한 판정 대상이다.
	PrimaryStat: StatDefinitions.StatId,
	StatRequirement: number,
	BaseDamage: number,
	-- 아이템이 부여하는 스탯. 전부 서브스탯 판정이다.
	StatBonus: { [StatDefinitions.StatId]: number }?,
	-- 새겨진 수식어 룬 (RuneDefinitions.Affix의 Id). 장비당 최대 1개.
	Affix: string?,
}

-- 제한 미달 시 대미지 배율 (50% 감소)
local UNDER_REQUIREMENT_MULTIPLIER = 0.5

-- 스탯 제한 절대 상한
local MAX_STAT_REQUIREMENT = 100

local rarities: { RarityDefinition } = {
	{
		Id = "Common",
		Name = "일반",
		Tier = 1,
		Color = Color3.fromRGB(158, 158, 158), -- 회색
		MaxStatRequirement = 15,
		TowerObtainable = true,
		Craftable = true,
		CraftMaterialCount = 2,
	},
	{
		Id = "Uncommon",
		Name = "응가",
		Tier = 2,
		Color = Color3.fromRGB(140, 200, 90), -- 연두색
		MaxStatRequirement = 28,
		TowerObtainable = true,
		Craftable = true,
		CraftMaterialCount = 4,
	},
	{
		Id = "Rare",
		Name = "희귀",
		Tier = 3,
		Color = Color3.fromRGB(70, 130, 220), -- 파란색
		MaxStatRequirement = 42,
		TowerObtainable = true,
		Craftable = true,
		CraftMaterialCount = 7,
	},
	{
		Id = "Epic",
		Name = "특별",
		Tier = 4,
		Color = Color3.fromRGB(150, 90, 210), -- 보라색
		MaxStatRequirement = 56,
		TowerObtainable = true, -- 탑에서 얻을 수 있는 마지막 등급
		Craftable = true,
		CraftMaterialCount = 11,
	},
	{
		Id = "Unique",
		Name = "고유",
		Tier = 5,
		Color = Color3.fromRGB(200, 60, 60), -- 붉은색
		MaxStatRequirement = 70,
		TowerObtainable = false, -- 여기부터 필드 수급
		Craftable = true,
		CraftMaterialCount = 16,
	},
	{
		Id = "Supreme",
		Name = "통달",
		Tier = 6,
		Color = Color3.fromRGB(230, 140, 50), -- 주황색
		MaxStatRequirement = 82,
		TowerObtainable = false,
		Craftable = true, -- 대장간 제작 상한
		CraftMaterialCount = 22,
	},
	{
		Id = "Legendary",
		Name = "전설",
		Tier = 7,
		Color = Color3.fromRGB(240, 210, 70), -- 노란색
		MaxStatRequirement = 92,
		TowerObtainable = false,
		Craftable = false, -- 고급 재료 조달 퀘스트 완료 시에만 해금
		CraftMaterialCount = 30,
	},
	{
		Id = "Abyss",
		Name = "심연",
		Tier = 8,
		Color = Color3.fromRGB(30, 45, 110), -- 남색
		MaxStatRequirement = 100, -- 상한
		TowerObtainable = false,
		Craftable = false,
		CraftMaterialCount = 40,
	},
}

local ItemDefinitions = {}

ItemDefinitions.MAX_STAT_REQUIREMENT = MAX_STAT_REQUIREMENT
ItemDefinitions.UNDER_REQUIREMENT_MULTIPLIER = UNDER_REQUIREMENT_MULTIPLIER

-- 탑에서 얻을 수 있는 최고 등급 (사양: 특별까지)
ItemDefinitions.TOWER_MAX_RARITY = "Epic" :: Rarity

-- 대장간에서 제작 가능한 최고 등급 (사양: 통달까지)
ItemDefinitions.CRAFT_MAX_RARITY = "Supreme" :: Rarity

function ItemDefinitions.AllRarities(): { RarityDefinition }
	return rarities
end

function ItemDefinitions.GetRarity(id: Rarity): RarityDefinition?
	for _, rarity in rarities do
		if rarity.Id == id then
			return rarity
		end
	end
	return nil
end

function ItemDefinitions.RarityTier(id: Rarity): number
	local rarity = ItemDefinitions.GetRarity(id)
	return rarity and rarity.Tier or 0
end

-- 스탯 제한 값을 등급 상한과 절대 상한(100) 안으로 조인다.
function ItemDefinitions.ClampRequirement(rarityId: Rarity, requirement: number): number
	local rarity = ItemDefinitions.GetRarity(rarityId)
	local cap = rarity and rarity.MaxStatRequirement or MAX_STAT_REQUIREMENT
	return math.clamp(requirement, 0, math.min(cap, MAX_STAT_REQUIREMENT))
end

--[[
	착용 제한을 만족하는지 본다.
	**메인 스탯만** 비교한다 — 아이템이 준 서브스탯으로는 제한을 뚫을 수 없다(사양).
]]
function ItemDefinitions.MeetsRequirement(item: Item, block: StatDefinitions.StatBlock): boolean
	local main = StatDefinitions.MainValue(block, item.PrimaryStat)
	return main >= item.StatRequirement
end

--[[
	제한 반영 후의 실제 무기 대미지.
	미달이면 50% 감소.
]]
function ItemDefinitions.EffectiveDamage(item: Item, block: StatDefinitions.StatBlock): number
	if ItemDefinitions.MeetsRequirement(item, block) then
		return item.BaseDamage
	end
	return item.BaseDamage * UNDER_REQUIREMENT_MULTIPLIER
end

function ItemDefinitions.IsTowerObtainable(rarityId: Rarity): boolean
	local rarity = ItemDefinitions.GetRarity(rarityId)
	return rarity ~= nil and rarity.TowerObtainable
end

--[[
	대장간 제작 가능 여부.
	통달까지는 항상 가능하고, 전설은 고급 재료 조달 퀘스트를 끝냈을 때만 가능하다.
	심연 등급은 제작할 수 없다.
]]
function ItemDefinitions.IsCraftable(rarityId: Rarity, hasAdvancedMaterialQuest: boolean): boolean
	local rarity = ItemDefinitions.GetRarity(rarityId)
	if not rarity then
		return false
	end
	if rarity.Craftable then
		return true
	end
	if rarityId == "Legendary" then
		return hasAdvancedMaterialQuest
	end
	return false
end

--[[
	아이템이 부여하는 스탯을 스탯 블록의 **서브** 칸에 더한다.
	(사양: 아이템으로 얻는 스탯은 서브스탯 판정)
]]
function ItemDefinitions.ApplyBonus(block: StatDefinitions.StatBlock, item: Item): ()
	if not item.StatBonus then
		return
	end
	for statId, amount in item.StatBonus do
		block.Sub[statId] = (block.Sub[statId] or 0) + amount
	end
end

return ItemDefinitions
]]></string>
