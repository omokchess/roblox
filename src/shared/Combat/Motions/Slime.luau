--!strict
--[[
	슬라임 모션. (2026-09-28)

	관절이 없는 젤리라 채널이 다르다(Client/Combat/Slime.luau 가 입힌다):
	  Root = { x, y, z, rx, ry, rz }   몸 전체(바닥 가운데 기준). z+ = 뒤(아군 반대쪽), 회전은 도
	  Body = { sx, sy, sz }            늘고 줄기(%). 0 = 그대로, -20 = 20% 납작, 30 = 30% 길쭉
	  Eyes = { blink, angry }          0~100. blink 100 = 눈 감음, angry 100 = 눈꼬리 치켜뜸
	부피를 지키는 느낌이 나도록 Body 는 대개 sx·sz 를 sy 와 반대로 준다(눌리면 퍼지고, 늘면 좁아짐).
]]
local function S(t: number, e: string?, sx: number, sy: number, sz: number, root: { number }?, eyes: { number }?)
	return { t = t, e = e, Body = { sx, sy, sz }, Root = root, Eyes = eyes }
end

